<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback banner (320x180dp nominal): paper background with the Jularr mark on the left.
     No wordmark is rasterized here; see docs/ANDROID_CLIENTS.md if a text lockup is added later. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="132dp"
        android:height="132dp"
        android:left="24dp"
        android:gravity="center_vertical|left"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
