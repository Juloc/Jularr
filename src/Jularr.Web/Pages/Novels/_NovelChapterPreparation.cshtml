@model Jularr.Web.Pages.Novels.ReadModel
@* Shown instead of the reader when the chapter text is not cached yet. The page itself
   never contacts the source provider; the action queues a download operation. *@
@{
    var ui = Model.Ui;
    var chapter = Model.Chapter;
    var preparation = Model.Preparation;
    var pending = preparation?.IsActive == true;
    var failed = preparation is not null && !pending;
    var returnUrl = Url.Page("/Novels/Read", new
    {
        id = chapter.Id,
        bookmark = Model.ReturnBookmarkId,
        highlight = Model.ReturnHighlightId
    });
}
<section class="novel-chapter-preparation"
         data-novel-chapter-preparation
         data-pending="@pending.ToString().ToLowerInvariant()"
         data-status-url="@Url.Page("/Novels/Read", "ChapterStatus", new { id = chapter.Id, prepare = preparation?.Id })"
         data-ready-url="@returnUrl"
         data-failed-text="@ui["novels.read.prep.failed"]"
         data-retry-text="@ui["novels.read.prep.retry"]"
         data-stalled-text="@ui["novels.read.prep.stalled"]">
    <a class="back-link" href="/Novels/Work/@chapter.WorkId">← @chapter.WorkTitle</a>

    <header class="novel-preparation-header">
        <span class="novel-chapter-label">@ui.Format("novels.read.chapterLabel", ("number", chapter.Number))</span>
        <h1 lang="ja">@chapter.Title</h1>
    </header>

    <p class="novel-preparation-message" data-preparation-message role="status" aria-live="polite">
        @if (pending)
        {
            <text>@ui["novels.read.prep.downloading"]</text>
        }
        else if (failed)
        {
            <text>@ui["novels.read.prep.failed"]</text>
        }
        else
        {
            <text>@ui["novels.read.prep.notDownloaded"]</text>
        }
    </p>

    <form method="post"
          asp-page-handler="PrepareChapter"
          asp-route-id="@chapter.Id"
          asp-route-bookmark="@Model.ReturnBookmarkId"
          asp-route-highlight="@Model.ReturnHighlightId"
          data-preparation-form>
        <button class="button button-primary"
                type="submit"
                data-preparation-action
                disabled="@pending">
            @(failed ? ui["novels.read.prep.retry"] : ui["novels.read.prep.download"])
        </button>
    </form>

    <nav class="novel-preparation-nav" aria-label="@ui["novels.read.prep.navigationAria"]">
        @if (chapter.PreviousChapterId is Guid previous)
        {
            <a href="/Novels/Read/@previous">@ui["novels.read.previousChapterLink"]</a>
        }
        else
        {
            <span></span>
        }
        @if (chapter.NextChapterId is Guid next)
        {
            <a href="/Novels/Read/@next">@ui["novels.read.nextChapterLink"]</a>
        }
    </nav>
</section>
