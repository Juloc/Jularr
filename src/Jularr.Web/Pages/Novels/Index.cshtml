@page "/Novels"
@model Jularr.Web.Pages.Novels.IndexModel
@using Jularr.Web.Features.Acquisition.Access
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["novels.index.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/novel-library.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reading.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reading-catalog.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/novel-file-picker.js" asp-append-version="true"></script>
}

<header class="novel-library-header novel-library-hero">
    <div class="novel-library-title-block">
        <div class="reading-type-switch" aria-label="@ui["novels.nav.readingTypeAria"]">
            <a class="active" href="/Novels">@ui["reading.novels.title"]</a>
            <a href="/Manga">@ui["reading.manga.title"]</a>
        </div>
        <h1>@ui["novels.index.title"]</h1>
    </div>

    @if (Model.Access.CanRequest)
    {
        <details class="novel-import-popover" open="@(Model.SearchQuery.Length > 0)">
            <summary class="novel-add-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                @ui["discover.card.request"]
            </summary>
            <div class="novel-import-panel">
                <form method="get" class="reading-catalog-form">
                    <label class="novel-visually-hidden" for="novelCatalogQuery">@ui["discover.search.srLabel"]</label>
                    <input id="novelCatalogQuery"
                           name="q"
                           type="search"
                           value="@Model.SearchQuery"
                           autocomplete="off"
                           placeholder="@ui["discover.search.placeholder"]" />
                    <button class="button button-primary" type="submit">@ui["common.search"]</button>
                </form>

                @if (Model.SearchQuery.Length > 0)
                {
                    @if (Model.UnavailableSources.Count > 0)
                    {
                        <div class="reading-catalog-empty" role="status">
                            @ui.Format("novels.index.sourcesUnavailable", ("sources", string.Join(", ", Model.UnavailableSources)))
                        </div>
                    }

                    @if (Model.SearchResults.Count == 0)
                    {
                        <div class="reading-catalog-empty">@ui["discover.results.emptyTitle"]</div>
                    }
                    else
                    {
                        <div class="reading-catalog-results">
                            @foreach (var result in Model.SearchResults)
                            {
                                <article class="reading-catalog-result">
                                    <div class="reading-catalog-cover">
                                        @if (!string.IsNullOrWhiteSpace(result.Item.CoverImageUrl))
                                        {
                                            <img src="@result.Item.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                        }
                                        else
                                        {
                                            <span>文</span>
                                        }
                                    </div>

                                    <div class="reading-catalog-copy">
                                        <span class="reading-catalog-title">@result.Item.Title</span>
                                        <span class="reading-catalog-tags">
                                            <span class="reading-catalog-source" title="@ui[result.Source.DescriptionKey]">@result.Source.Name</span>
                                            <span class="reading-catalog-source" title="@ui[result.Source.LicensingKey]">@ui[result.Source.CapabilityKey]</span>
                                            @if (result.Item.AccessKey is { } accessKey)
                                            {
                                                <span class="reading-catalog-source">@ui[accessKey]</span>
                                            }
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(result.Item.NativeTitle) &&
                                             !string.Equals(result.Item.NativeTitle, result.Item.Title, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="reading-catalog-native">@result.Item.NativeTitle</span>
                                        }
                                        <span class="reading-catalog-meta">
                                            @if (!string.IsNullOrWhiteSpace(result.Item.Author))
                                            {
                                                @result.Item.Author
                                            }
                                            @if (result.Item.FirstPublishYear is int year)
                                            {
                                                <text> · @year</text>
                                            }
                                            @if (result.Item.VolumeCount is int volumes)
                                            {
                                                <text> · </text>
                                                @ui.Format("novels.card.volumeCount", ("count", volumes))
                                            }
                                            @if (result.Item.ChapterCount is int chapters)
                                            {
                                                <text> · </text>
                                                @ui.Format("manga.card.chapterCount", ("count", chapters))
                                            }
                                        </span>
                                    </div>

                                    <div class="reading-catalog-action">
                                        @if (result.LocalUrl is { Length: > 0 } localUrl)
                                        {
                                            <a class="button" href="@localUrl">@ui["books.add.inLibrary"]</a>
                                        }
                                        else if (result.RequestStatus is { Length: > 0 } requestStatus)
                                        {
                                            <button class="button" type="button" disabled>
                                                @ui[ConsumerAcquisitionLabels.StatusKey(requestStatus)]
                                            </button>
                                        }
                                        else if (!result.Source.CanAdd)
                                        {
                                            @* Discovery-only source: the result lives on the source's own site. *@
                                            @if (result.Item.SourceUrl is { Length: > 0 } sourceUrl)
                                            {
                                                <a class="button" href="@sourceUrl" target="_blank" rel="noopener noreferrer">@ui["novels.index.openSource"]</a>
                                            }
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="AddCatalog">
                                                <input type="hidden" name="provider" value="@result.Item.Provider" />
                                                <input type="hidden" name="externalId" value="@result.Item.ExternalId" />
                                                <input type="hidden" name="title" value="@result.Item.Title" />
                                                <input type="hidden" name="nativeTitle" value="@result.Item.NativeTitle" />
                                                <input type="hidden" name="author" value="@result.Item.Author" />
                                                <input type="hidden" name="coverImageUrl" value="@result.Item.CoverImageUrl" />
                                                <input type="hidden" name="q" value="@Model.SearchQuery" />
                                                <button class="button button-primary" type="submit">
                                                    @ui["discover.card.request"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }

                @if (Model.IsOwner)
                {
                    <div class="reading-catalog-divider">@ui["novels.index.sourcesHeading"]</div>
                    <a class="button" asp-page="/Admin/ReadingSources">@ui["novels.index.configureSources"]</a>
                }

                @if (Model.Access.CanRequest && Model.Access.AutoApproves)
                {
                    <div class="reading-catalog-divider">@ui["books.add.manual"]</div>

                    <form method="post" asp-page-handler="Import" class="novel-import-form">
                        <label for="sourceUrl">@ui["novels.index.sourceUrlLabel"]</label>
                        <input id="sourceUrl"
                               type="url"
                               name="sourceUrl"
                               required
                               inputmode="url"
                               placeholder="https://ncode.syosetu.com/n9669bk/" />
                        <button class="button" type="submit">@ui["novels.index.importSubmit"]</button>
                    </form>
                }

                @if (Model.IsOwner)
                {
                    <form method="post"
                          asp-page-handler="UploadEpub"
                          enctype="multipart/form-data"
                          class="novel-import-form">
                        <label for="epubs">@ui["novels.index.epubLabel"]</label>
                        <div class="novel-file-picker" data-novel-file-picker>
                            <input id="epubs"
                                   type="file"
                                   name="epubs"
                                   accept=".epub,application/epub+zip"
                                   multiple
                                   required />
                            <label class="button" for="epubs">@ui["novels.index.chooseEpubs"]</label>
                            <span class="novel-file-names"
                                  data-novel-file-names
                                  data-empty="@ui["novels.index.noEpubChosen"]"
                                  data-several="@ui["novels.index.epubsChosen"]"></span>
                        </div>
                        <button class="button" type="submit">@ui["novels.index.uploadSubmit"]</button>
                    </form>
                    @if (Model.IsInboxConfigured)
                    {
                        <form method="post" asp-page-handler="ScanInbox" class="novel-import-form">
                            <label>@ui["novels.index.inboxLabel"] · <code>@Model.InboxPath</code></label>
                            <button class="button" type="submit">@ui["novels.index.importFromInbox"]</button>
                        </form>
                    }
                }
            </div>
        </details>
    }
</header>

@if (Model.ContinueReading.Count > 0)
{
    <section class="novel-shelf" aria-labelledby="continue-reading-heading">
        <div class="novel-section-heading">
            <h2 id="continue-reading-heading">@ui["home.continueReading"]</h2>
        </div>

        <div class="novel-continue-list">
            @foreach (var work in Model.ContinueReading)
            {
                <a class="novel-continue-row" href="/Novels/Read/@work.CurrentChapterId">
                    <div class="novel-continue-cover">
                        @if (!string.IsNullOrWhiteSpace(work.CoverImageUrl))
                        {
                            <img src="@work.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <span>文</span>
                        }
                    </div>
                    <div class="novel-continue-copy">
                        <strong>@work.Title</strong>
                        <span>@(work.CurrentVolumeNumber is int currentVolume
                            ? ui.Format("novels.card.volumeChapterLocation", ("volume", currentVolume), ("chapter", work.CurrentChapterNumber), ("title", work.CurrentChapterTitle))
                            : ui.Format("novels.card.chapterLocation", ("chapter", work.CurrentChapterNumber), ("title", work.CurrentChapterTitle)))</span>
                        @* The percentage sits at the end of its short bar, not at the far edge of the row. *@
                        <div class="novel-continue-progress">
                            <div class="novel-progress-track" aria-label="@ui["novels.card.progressAria"]">
                                <span style="width:@(work.ProgressPermille / 10)%"></span>
                            </div>
                            <span class="novel-continue-percent">@(work.ProgressPermille / 10)%</span>
                        </div>
                    </div>
                    <svg class="novel-row-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </a>
            }
        </div>
    </section>
}

<section class="novel-shelf" aria-labelledby="library-heading">
    <div class="novel-section-heading">
        <h2 id="library-heading">@ui["nav.library"]</h2>
    </div>

    @if (Model.Works.Count == 0)
    {
        <div class="novel-empty">@ui["novels.index.empty"]</div>
    }
    else
    {
        @* Offline is purely client-side, browser-local state (#221): the filter only shows/hides
           already-rendered cards, it never asks the server what is downloaded on this device. *@
        <div data-offline-library-filter>
            <div class="novel-library-filter" role="group" aria-label="@ui["novels.index.filterAria"]">
                <button type="button" class="active" data-library-filter-option="all">@ui["novels.index.filterAll"]</button>
                <button type="button" data-library-filter-option="offline">@ui["novels.index.filterOffline"]</button>
            </div>
        <div class="novel-library-grid">
            @foreach (var work in Model.Works)
            {
                <article class="novel-library-card" data-work-id="@work.Id">
                    <a class="novel-library-cover" href="/Novels/Work/@work.Id" aria-label="@work.Title">
                        @if (!string.IsNullOrWhiteSpace(work.CoverImageUrl))
                        {
                            <img src="@work.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            @* Like the Books shelf: a paper tile with the title, not a black block. *@
                            <span class="novel-cover-placeholder">@work.Title</span>
                        }

                        @if (work.HasProgress)
                        {
                            <div class="novel-cover-progress">
                                <span style="width:@(work.ProgressPermille / 10)%"></span>
                            </div>
                        }
                    </a>

                    <div class="novel-library-copy">
                        <a href="/Novels/Work/@work.Id" class="novel-library-title">@work.Title</a>

                        <div class="novel-library-meta">
                            @if (work.VolumeCount > 0)
                            {
                                <span>@(work.MetadataVolumeCount is int totalVolumes
                                    ? ui.Format("novels.card.volumeCountOfTotal", ("count", work.VolumeCount), ("total", totalVolumes))
                                    : ui.Format("novels.card.volumeCount", ("count", work.VolumeCount)))</span>
                            }
                            else if (work.MetadataVolumeCount is int volumes)
                            {
                                <span>@ui.Format("novels.card.volumeCount", ("count", volumes))</span>
                            }
                            <span>@ui.Format("manga.card.chapterCount", ("count", work.ChapterCount))</span>
                            @if (!string.IsNullOrWhiteSpace(work.MetadataStatus))
                            {
                                <span>@work.MetadataStatus.Replace("_", " ").ToLowerInvariant()</span>
                            }
                        </div>

                        @if (work.HasProgress)
                        {
                            <a class="novel-resume-link" href="/Novels/Read/@work.CurrentChapterId">
                                @ui.Format("manga.card.continueChapter", ("chapter", work.CurrentChapterNumber))
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
        </div>
    }
</section>
