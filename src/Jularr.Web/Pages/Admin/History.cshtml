@page
@model Jularr.Web.Pages.Admin.HistoryModel
@using Jularr.Web.Features.Operations
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.history.title"];
    var plan = Model.Plan;
    var filter = plan.Filter;
    var returnUrl = HistoryModel.Href(filter);
    var pills = Enum.GetValues<AdminHistoryCategory>();
    static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
    static string Day(DateTime value) => value.ToString("yyyy-MM-dd");
    static string Clock(DateTime value) => value.ToString("HH:mm") + " UTC";
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-history.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.history.title"]</h1>
        <p>@ui["admin.history.subtitle"]</p>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<section class="admhist" aria-label="@ui["admin.history.title"]">
    <nav class="library-type-tabs admhist-tabs" aria-label="@ui["admin.history.tabsAria"]">
        @foreach (var pill in pills)
        {
            var active = pill == filter.Category;
            <a class="library-type-tab @(active ? "active" : "")"
               href="@HistoryModel.Href(filter with { Category = pill, Page = 1 })"
               aria-current="@(active ? "page" : null)">@ui["admin.history.cat." + AdminHistoryQuery.CategoryName(pill)] <span class="admhist-count">@plan.CategoryCounts[pill]</span></a>
        }
    </nav>

    <form method="get" action="@HistoryModel.PagePath" class="admhist-filters">
        @if (filter.Category != AdminHistoryCategory.All)
        {
            <input type="hidden" name="cat" value="@AdminHistoryQuery.CategoryName(filter.Category)" />
        }
        <input class="admhist-search" type="search" name="q" value="@filter.Search" maxlength="120"
               placeholder="@ui["admin.history.searchPlaceholder"]" aria-label="@ui["admin.history.searchPlaceholder"]" />
        <div class="admhist-controls">
            <label class="admhist-field">
                <span>@ui["admin.history.filter.from"]</span>
                <input type="date" name="from" value="@(filter.From is { } fromDay ? AdminHistoryQuery.FormatDay(fromDay) : "")" />
            </label>
            <label class="admhist-field">
                <span>@ui["admin.history.filter.to"]</span>
                <input type="date" name="to" value="@(filter.To is { } toDay ? AdminHistoryQuery.FormatDay(toDay) : "")" />
            </label>
            <label class="admhist-field">
                <span>@ui["admin.history.filter.result"]</span>
                <select name="result">
                    <option value="">@ui["admin.history.filter.allResults"]</option>
                    @foreach (var value in Enum.GetValues<AdminHistoryResult>())
                    {
                        var valueName = AdminHistoryQuery.ResultName(value);
                        <option value="@valueName" selected="@(filter.Result == value)">@ui["admin.history.result." + valueName]</option>
                    }
                </select>
            </label>
            <label class="admhist-field">
                <span>@ui["admin.history.filter.sort"]</span>
                <select name="sort">
                    <option value="">@ui["admin.history.sort.newest"]</option>
                    <option value="oldest" selected="@filter.OldestFirst">@ui["admin.history.sort.oldest"]</option>
                </select>
            </label>
            <button class="button" type="submit">@ui["admin.filter.apply"]</button>
            @if (filter.HasNarrowing || filter.OldestFirst)
            {
                <a class="text-link" href="@HistoryModel.Href(new AdminHistoryFilter(filter.Category))">@ui["admin.history.filter.reset"]</a>
            }
        </div>
    </form>

    @if (Model.Failed)
    {
        <div class="admhist-message" role="alert">
            <p>@ui["admin.history.loadFailed"]</p>
            <a class="button" href="@returnUrl">@ui["admin.history.retry"]</a>
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <p class="admhist-message muted" data-admin-history-empty>
            @(filter.HasNarrowing || filter.Category != AdminHistoryCategory.All ? ui["admin.history.noMatch"] : ui["admin.history.empty"])
        </p>
    }
    else
    {
        <div class="admhist-table-wrap">
            <table class="admhist-table" data-admin-history>
                <thead>
                    <tr>
                        <th scope="col">@ui["admin.history.col.time"]</th>
                        <th scope="col">@ui["admin.history.col.type"]</th>
                        <th scope="col">@ui["admin.history.col.details"]</th>
                        <th scope="col">@ui["admin.history.col.result"]</th>
                        <th scope="col">@ui["admin.history.col.performedBy"]</th>
                        <th scope="col"><span class="admhist-visually-hidden">@ui["admin.history.col.actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var operation in Model.Items)
                    {
                        var category = AdminHistoryQuery.CategoryName(AdminHistoryQuery.CategoryOf(operation.Kind, operation.Category));
                        var result = AdminHistoryQuery.ResultName(AdminHistoryQuery.ResultOf(operation.Status));
                        var finished = operation.FinishedAtUtc ?? operation.UpdatedAtUtc;
                        var actor = Model.ActorOf(operation);
                        var note = operation.Status == OperationStatus.Succeeded
                            ? operation.Message
                            : operation.Error ?? operation.Message;
                        <tr class="admhist-row">
                            <td class="admhist-cell-when">
                                <time datetime="@Iso(finished)">
                                    <span>@Day(finished)</span>
                                    <small>@Clock(finished)</small>
                                </time>
                            </td>
                            <td class="admhist-cell-type">
                                <span class="admhist-tag admhist-tag-@category">
                                    <partial name="_HistoryIcon" model="category" />
                                    @ui["admin.history.cat." + category]
                                </span>
                            </td>
                            <td class="admhist-cell-details">
                                <div class="admhist-copy">
                                    <strong class="admhist-title">@operation.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(operation.Subject))
                                    {
                                        <small>@operation.Subject</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(note))
                                    {
                                        <small class="admhist-note">@note</small>
                                    }
                                </div>
                            </td>
                            <td class="admhist-cell-result">
                                <span class="admhist-result admhist-result-@result">
                                    <partial name="_HistoryIcon" model="result" />
                                    @ui["admin.history.result." + result]
                                </span>
                            </td>
                            <td class="admhist-cell-actor">
                                <span class="admhist-actor">
                                    <partial name="_HistoryIcon" model="@(actor is null ? "system" : "user")" />
                                    <span class="admhist-actor-copy">
                                        <strong>@(actor ?? ui["admin.history.actor.system"])</strong>
                                        <small>@(actor is null ? ui["admin.history.actor.automatic"] : ui["admin.history.actor.manual"])</small>
                                    </span>
                                </span>
                            </td>
                            <td class="admhist-cell-actions">
                                <a class="button" asp-page="/Admin/Operation" asp-route-id="@operation.Id" asp-route-returnUrl="@returnUrl">@ui["admin.history.details"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admhist-footer">
            <span>@ui.Format("admin.history.showing", ("from", plan.Offset + 1), ("to", plan.Offset + Model.Items.Count), ("total", plan.Total))</span>
            @if (plan.PageCount > 1)
            {
                <nav class="admhist-pager" aria-label="@ui["admin.history.pagerAria"]">
                    @if (plan.HasPrevious)
                    {
                        <a class="admhist-page" href="@HistoryModel.Href(filter with { Page = plan.Page - 1 })" rel="prev">@ui["admin.history.page.previous"]</a>
                    }
                    @foreach (var number in AdminHistoryQuery.PageWindow(plan.Page, plan.PageCount))
                    {
                        if (number == 0)
                        {
                            <span class="admhist-gap" aria-hidden="true">&hellip;</span>
                        }
                        else if (number == plan.Page)
                        {
                            <span class="admhist-page admhist-page-current" aria-current="page">@number</span>
                        }
                        else
                        {
                            <a class="admhist-page" href="@HistoryModel.Href(filter with { Page = number })" aria-label="@ui.Format("admin.history.page.n", ("page", number))">@number</a>
                        }
                    }
                    @if (plan.HasNext)
                    {
                        <a class="admhist-page" href="@HistoryModel.Href(filter with { Page = plan.Page + 1 })" rel="next">@ui["admin.history.page.next"]</a>
                    }
                </nav>
            }
        </div>
    }
</section>
