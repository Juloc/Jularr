@page
@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.MediaCore
@using Jularr.Web.Pages.Admin.Capabilities
@model Jularr.Web.Pages.Admin.Capabilities.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.capabilities.title"];
}

<header class="page-header">
    <div>
        <h1>@ui["admin.capabilities.title"]</h1>
        <p>@ui["admin.capabilities.subtitle"]</p>
    </div>
    <div class="request-actions">
        <a class="button" href="/Admin/Capabilities/Manual">@ui["admin.requests.policiesHeading"]</a>
        <a class="button" asp-page="/Admin/Users">@ui["admin.user.backToUsers"]</a>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<p class="muted">@ui["admin.capabilities.ownerNote"]</p>

@if (Model.MediaTypes.Count == 0)
{
    <section class="panel">
        <div class="empty-state">
            <strong>@ui["admin.capabilities.noMediaModules"]</strong>
        </div>
    </section>
}
else
{
<section class="panel">
    <div class="panel-heading"><h2>@ui["admin.capabilities.roleDefaults"]</h2></div>
    <p class="muted">@ui["admin.capabilities.roleDefaultsHint"]</p>

    <form method="post" asp-page-handler="Roles" class="form-stack">
        <div class="capability-matrix-scroll">
            <table>
            <thead>
                <tr>
                    <th>@ui["admin.capabilities.mediaTypeColumn"]</th>
                    @foreach (var role in Model.Roles)
                    {
                        <th>@ui[AccountRoles.LabelKey(role)]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var mediaType in Model.MediaTypes)
                {
                    <tr>
                        <td>@ui[IndexModel.MediaTypeLabelKey(mediaType)]</td>
                        @foreach (var role in Model.Roles)
                        {
                            var current = Model.RoleDefaultFor(role, mediaType);
                            <td>
                                <select name="@IndexModel.RoleField(role, mediaType)" aria-label="@ui[AccountRoles.LabelKey(role)] · @ui[IndexModel.MediaTypeLabelKey(mediaType)]">
                                    @foreach (var level in Model.Levels)
                                    {
                                        <option value="@MediaCapabilityNames.ToStorage(level)" selected="@(current == level)">@ui[IndexModel.LevelLabelKey(level)]</option>
                                    }
                                </select>
                            </td>
                        }
                    </tr>
                }
            </tbody>
            </table>
        </div>
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
    </form>
</section>

<section class="panel">
    <div class="panel-heading"><h2>@ui["admin.capabilities.userOverrides"]</h2></div>
    <p class="muted">@ui["admin.capabilities.userOverridesHint"]</p>

    @if (Model.Users.Count == 0)
    {
        <p class="muted">@ui["admin.capabilities.noUsers"]</p>
    }

    <div class="user-admin-list">
        @foreach (var user in Model.Users)
        {
            <article class="user-admin-card" id="user-@user.Id">
                <div class="user-admin-header">
                    <div>
                        <strong>@user.UserName</strong>
                        <small>@ui[AccountRoles.LabelKey(user.Role)]</small>
                    </div>
                    <form method="post" asp-page-handler="ResetUser" class="inline-actions">
                        <input type="hidden" name="profileId" value="@user.Id" />
                        <button class="button" type="submit">@ui["admin.capabilities.resetToRole"]</button>
                    </form>
                </div>

                <form method="post" asp-page-handler="User" class="form-stack">
                    <input type="hidden" name="profileId" value="@user.Id" />
                    <div class="capability-matrix-scroll">
                        <table>
                        <thead>
                            <tr>
                                <th>@ui["admin.capabilities.mediaTypeColumn"]</th>
                                <th>@ui["admin.capabilities.overrideColumn"]</th>
                                <th>@ui["admin.capabilities.effectiveColumn"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mediaType in Model.MediaTypes)
                            {
                                var over = Model.UserOverrideFor(user.Id, mediaType);
                                <tr>
                                    <td>@ui[IndexModel.MediaTypeLabelKey(mediaType)]</td>
                                    <td>
                                        <select name="@IndexModel.UserField(mediaType)" aria-label="@user.UserName · @ui[IndexModel.MediaTypeLabelKey(mediaType)]">
                                            <option value="" selected="@(over is null)">@ui["admin.capabilities.inherit"]</option>
                                            @foreach (var level in Model.Levels)
                                            {
                                                <option value="@MediaCapabilityNames.ToStorage(level)" selected="@(over == level)">@ui[IndexModel.LevelLabelKey(level)]</option>
                                            }
                                        </select>
                                    </td>
                                    <td>@ui[IndexModel.LevelLabelKey(Model.EffectiveFor(user, mediaType))]</td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                    <button class="button button-primary" type="submit">@ui["common.save"]</button>
                </form>
            </article>
        }
    </div>
</section>
}
