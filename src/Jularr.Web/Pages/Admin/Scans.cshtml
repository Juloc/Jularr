@page
@model Jularr.Web.Pages.Admin.ScansModel
@using Jularr.Web.Features.Operations
@{
    var ui = Model.Ui;
    var dash = "—";
    ViewData["Title"] = ui["admin.scans.title"];

    string OperationStatusLabel(OperationStatus status) => status switch
    {
        OperationStatus.Queued => ui["admin.operations.status.queued"],
        OperationStatus.Running => ui["admin.operations.status.running"],
        OperationStatus.Succeeded => ui["admin.operations.status.succeeded"],
        OperationStatus.Failed => ui["admin.operations.status.failed"],
        OperationStatus.Cancelled => ui["admin.operations.status.cancelled"],
        OperationStatus.Interrupted => ui["admin.operations.status.interrupted"],
        _ => status.ToString()
    };
}

<header class="page-header">
    <div>
        <h1>@ui["admin.scans.title"]</h1>
        <p>@ui["admin.scans.subtitle"]</p>
    </div>
    <a class="button" asp-page="/Admin/System">@ui["admin.scans.mediaRoots"]</a>
</header>

<partial name="_AdminSectionLinks" />

<form method="get" class="operation-filter">
    <select name="rootId" aria-label="@ui["admin.scans.rootAria"]">
        <option value="">@ui["admin.scans.allRoots"]</option>
        @foreach (var root in Model.Roots)
        {
            <option value="@root.Id" selected="@(Model.RootId == root.Id)">@root.Name</option>
        }
    </select>
    <button class="button" type="submit">@ui["admin.filter.apply"]</button>
</form>

<section class="panel" data-scan-history>
    @if (Model.Scans.Count == 0)
    {
        <p class="muted">@ui["admin.scans.empty"]</p>
    }
    else
    {
        <div class="operation-list">
            @foreach (var row in Model.Scans)
            {
                var operation = row.Operation;
                <div class="operation-row operation-row-detailed" data-scan-active="@(operation.IsActive ? "true" : null)">
                    <div class="operation-copy">
                        <div class="operation-title-line">
                            <strong>@row.RootName</strong>
                            <span class="status-pill">@row.Scope</span>
                        </div>
                        <span>
                            @row.Trigger · @ui.Format("admin.scans.started", ("time", operation.StartedAtUtc?.ToLocalTime().ToString("g") ?? dash))
                            · @ui.Format("admin.scans.finished", ("time", operation.FinishedAtUtc?.ToLocalTime().ToString("g") ?? dash))
                            · @row.Phase
                            @if (row.FileProgress is { } files)
                            {
                                <text> · @files</text>
                            }
                        </span>
                        @if (row.Counters is { } counters)
                        {
                            <small>
                                @ui.Format("admin.scans.counters.media", ("count", counters.MediaFiles)) ·
                                @ui.Format("admin.scans.counters.added", ("count", counters.Discovered)) ·
                                @ui.Format("admin.scans.counters.changed", ("count", counters.Updated)) ·
                                @ui.Format("admin.scans.counters.removed", ("count", counters.Removed)) ·
                                @ui.Format("admin.scans.counters.skipped", ("count", counters.Skipped)) ·
                                @ui.Format("admin.scans.counters.subtitles", ("count", counters.Subtitles)) ·
                                @ui.Format("admin.scans.counters.artwork", ("count", counters.Artwork)) ·
                                @ui.Format("admin.scans.counters.nfoIgnored", ("count", counters.Metadata)) ·
                                @ui.Format("admin.scans.counters.analysed", ("count", counters.MediaAnalyzed)) ·
                                @ui.Format("admin.scans.counters.analysisFailed", ("count", counters.MediaAnalysisFailed)) ·
                                @ui.Format("admin.scans.counters.errors", ("count", counters.Errors)) ·
                                @ui.Format("admin.scans.counters.warnings", ("count", row.Warnings))
                            </small>
                        }
                        else if (!string.IsNullOrWhiteSpace(operation.Message))
                        {
                            <small>@operation.Message</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(operation.Error))
                        {
                            <div class="operation-error">@operation.Error</div>
                        }
                        @if (operation.IsActive && operation.ProgressPercent is { } progress)
                        {
                            <div class="operation-progress" aria-label="@ui.Format("admin.operation.progressComplete", ("percent", progress))">
                                <span style="width:@progress%"></span>
                            </div>
                        }
                    </div>
                    <div class="operation-row-meta">
                        <span class="status-pill operation-status-@operation.Status.ToString().ToLowerInvariant()">
                            @OperationStatusLabel(operation.Status)
                        </span>
                        <div class="inline-actions">
                            <a class="button" asp-page="/Admin/Operation" asp-route-id="@operation.Id">@ui["admin.nav.logs"]</a>
                            @if (row.CanRunAgain)
                            {
                                <form method="post" asp-page-handler="RunAgain" asp-route-rootId="@Model.RootId">
                                    <input type="hidden" name="operationId" value="@operation.Id" />
                                    <button class="button" type="submit">@ui["admin.scans.runAgain"]</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/library-scans.js" asp-append-version="true"></script>
}
