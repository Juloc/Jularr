@page
@model Jularr.Web.Pages.Admin.OperationsModel
@using Jularr.Web.Features.Operations
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.activity.title"];
    var plan = Model.Plan;
    var filter = plan.Filter;
    var returnUrl = OperationsModel.Href(filter);
    var tabs = new (AdminActivityTab Tab, string Label)[]
    {
        (AdminActivityTab.Todo, ui["admin.activity.tab.todo"]),
        (AdminActivityTab.Running, ui["admin.activity.tab.running"]),
        (AdminActivityTab.Failed, ui["admin.activity.tab.failed"])
    };
    var tabStatuses = AdminActivityQuery.StatusesOf(filter.Tab);
    static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
    static string Stamp(DateTime value) => value.ToString("yyyy-MM-dd HH:mm") + " UTC";

    string StatusLabel(OperationStatus status) => ui["admin.operations.status." + AdminActivityQuery.StatusName(status)];

    string PriorityLabel(OperationPriority priority) => ui["admin.operations.priority." + OperationPriorities.Name(priority)];

    string StatusIcon(OperationStatus status) => status switch
    {
        OperationStatus.Succeeded => "success",
        OperationStatus.Failed => "failed",
        OperationStatus.Interrupted => "warning",
        OperationStatus.Cancelled => "cancelled",
        OperationStatus.Running => "running",
        _ => "queued"
    };

    string EmptyText() =>
        !Model.AnyOperations ? ui["admin.activity.empty"]
        : filter.HasNarrowing ? ui["admin.activity.noMatch"]
        : ui["admin.activity.nothingHere"];
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-activity.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.activity.title"]</h1>
        <p>@ui["admin.activity.subtitle"]</p>
    </div>
    <div class="inline-actions">
        <a class="button" href="@returnUrl">@ui["admin.activity.refresh"]</a>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<section class="admact" aria-label="@ui["admin.activity.title"]">
    <nav class="library-type-tabs admact-tabs" aria-label="@ui["admin.activity.tabsAria"]">
        @foreach (var (tab, label) in tabs)
        {
            var active = tab == filter.Tab;
            <a class="library-type-tab @(active ? "active" : "")"
               href="@OperationsModel.Href(filter with { Tab = tab, Status = null, Page = 1 })"
               aria-current="@(active ? "page" : null)">@label <span class="admact-count">@plan.TabCounts[tab]</span></a>
        }
        <a class="library-type-tab" href="/Admin/History">@ui["admin.activity.tab.history"]</a>
        <a class="library-type-tab @(filter.Tab == AdminActivityTab.All ? "active" : "")"
           href="@OperationsModel.Href(filter with { Tab = AdminActivityTab.All, Status = null, Page = 1 })"
           aria-current="@(filter.Tab == AdminActivityTab.All ? "page" : null)">@ui["admin.activity.tab.all"] <span class="admact-count">@plan.TabCounts[AdminActivityTab.All]</span></a>
    </nav>

    <form method="get" action="@OperationsModel.PagePath" class="admact-filters">
        @if (filter.Tab != AdminActivityTab.Todo)
        {
            <input type="hidden" name="tab" value="@AdminActivityQuery.TabName(filter.Tab)" />
        }
        <div class="admact-search">
            <input type="search" name="q" value="@filter.Search" maxlength="120"
                   placeholder="@ui["admin.activity.searchPlaceholder"]" aria-label="@ui["admin.activity.searchPlaceholder"]" />
            <button class="button" type="submit">@ui["common.search"]</button>
        </div>
        <div class="admact-selects">
            <select name="type" aria-label="@ui["admin.activity.filter.type"]">
                <option value="">@ui["admin.activity.filter.type"]</option>
                @foreach (var category in Enum.GetValues<AdminHistoryCategory>().Where(category => category != AdminHistoryCategory.All))
                {
                    var categoryName = AdminHistoryQuery.CategoryName(category);
                    <option value="@categoryName" selected="@(filter.Category == category)">@ui["admin.history.cat." + categoryName]</option>
                }
            </select>
            @if (tabStatuses.Count > 1)
            {
                <select name="status" aria-label="@ui["admin.activity.filter.status"]">
                    <option value="">@ui["admin.activity.filter.status"]</option>
                    @foreach (var status in tabStatuses)
                    {
                        <option value="@AdminActivityQuery.StatusName(status)" selected="@(filter.Status == status)">@StatusLabel(status)</option>
                    }
                </select>
            }
            <select name="priority" aria-label="@ui["admin.activity.filter.priority"]">
                <option value="">@ui["admin.activity.filter.priority"]</option>
                @foreach (var level in Enum.GetValues<OperationPriority>())
                {
                    <option value="@OperationPriorities.Name(level)" selected="@(filter.Priority == level)">@PriorityLabel(level)</option>
                }
            </select>
            @if (filter.HasNarrowing)
            {
                <a class="text-link" href="@OperationsModel.Href(new AdminActivityFilter(filter.Tab))">@ui["admin.activity.filter.reset"]</a>
            }
        </div>
    </form>

    @if (Model.Failed)
    {
        <div class="admact-message" role="alert">
            <p>@ui["admin.activity.loadFailed"]</p>
            <a class="button" href="@returnUrl">@ui["admin.activity.tryAgain"]</a>
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <p class="admact-message muted" data-admin-activity-empty>@EmptyText()</p>
    }
    else
    {
        <div class="admact-table-wrap">
            <table class="admact-table" data-admin-activity>
                <thead>
                    <tr>
                        <th scope="col">@ui["admin.activity.col.type"]</th>
                        <th scope="col">@ui["admin.activity.col.title"]</th>
                        <th scope="col">@ui["admin.activity.col.step"]</th>
                        <th scope="col">@ui["admin.activity.col.progress"]</th>
                        <th scope="col">@ui["admin.activity.col.status"]</th>
                        <th scope="col">@ui["admin.activity.col.priority"]</th>
                        <th scope="col"><span class="admact-visually-hidden">@ui["admin.activity.col.actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var operation in Model.Items)
                    {
                        var category = AdminHistoryQuery.CategoryName(AdminHistoryQuery.CategoryOf(operation.Kind, operation.Category));
                        var status = AdminActivityQuery.StatusName(operation.Status);
                        var note = AdminActivityQuery.NoteOf(operation);
                        var ended = operation.Status is OperationStatus.Succeeded or OperationStatus.Failed or OperationStatus.Cancelled or OperationStatus.Interrupted;
                        var when = operation.FinishedAtUtc ?? operation.UpdatedAtUtc;
                        <tr class="admact-row" data-operation-status="@status">
                            <td class="admact-cell-type">
                                <span class="admact-tag admact-tag-@category">
                                    <partial name="_HistoryIcon" model="category" />
                                    @ui["admin.history.cat." + category]
                                </span>
                            </td>
                            <td class="admact-cell-title">
                                <div class="admact-copy">
                                    <strong class="admact-title">@operation.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(operation.Subject))
                                    {
                                        @if (Model.MediaLinks.TryGetValue(operation.Id, out var mediaLink))
                                        {
                                            <small><a class="text-link" href="@mediaLink">@operation.Subject</a></small>
                                        }
                                        else
                                        {
                                            <small>@operation.Subject</small>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="admact-cell-step">
                                @if (note is not null || operation.Attempt > 1)
                                {
                                    <div class="admact-copy">
                                        @if (note is not null)
                                        {
                                            <span class="admact-note @(operation.Status == OperationStatus.Failed ? "admact-note-error" : "")">@note</span>
                                        }
                                        @if (operation.Attempt > 1)
                                        {
                                            <small>@ui.Format("admin.operations.attemptInline", ("attempt", operation.Attempt))</small>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="admact-cell-progress">
                                @if (operation.ProgressPercent is { } progress)
                                {
                                    <div class="admact-progress">
                                        <div class="operation-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress"
                                             aria-label="@ui.Format("admin.operation.progressComplete", ("percent", progress))">
                                            <span style="width:@progress%"></span>
                                        </div>
                                        <small>@progress%</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="muted" aria-hidden="true">&mdash;</span>
                                }
                            </td>
                            <td class="admact-cell-status">
                                <span class="admact-state admact-state-@status">
                                    <partial name="_HistoryIcon" model="@StatusIcon(operation.Status)" />
                                    @StatusLabel(operation.Status)
                                </span>
                                @if (ended)
                                {
                                    <time class="admact-when" datetime="@Iso(when)">@Stamp(when)</time>
                                }
                            </td>
                            <td class="admact-cell-priority">
                                @if (Model.CanChangePriority(operation))
                                {
                                    <form method="post" asp-page-handler="Priority" class="admact-priority-form">
                                        <input type="hidden" name="id" value="@operation.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <select name="priority" aria-label="@ui["admin.activity.priority.change"]">
                                            @foreach (var level in Enum.GetValues<OperationPriority>())
                                            {
                                                <option value="@OperationPriorities.Name(level)" selected="@(operation.Priority == level)">@PriorityLabel(level)</option>
                                            }
                                        </select>
                                        <button class="button" type="submit">@ui["admin.activity.priority.apply"]</button>
                                    </form>
                                }
                                else if (operation.Status is OperationStatus.Succeeded or OperationStatus.Cancelled)
                                {
                                    <span class="muted" aria-hidden="true">&mdash;</span>
                                }
                                else
                                {
                                    <span class="admact-priority admact-priority-@OperationPriorities.Name(operation.Priority)">@PriorityLabel(operation.Priority)</span>
                                }
                            </td>
                            <td class="admact-cell-actions">
                                <div class="admact-actions">
                                    <a class="button" asp-page="/Admin/Operation" asp-route-id="@operation.Id" asp-route-returnUrl="@returnUrl">@ui["admin.history.details"]</a>
                                    @if (Model.CanRetry(operation))
                                    {
                                        <form method="post" asp-page-handler="Retry">
                                            <input type="hidden" name="id" value="@operation.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button" type="submit">@ui["admin.operation.retry"]</button>
                                        </form>
                                    }
                                    @if (Model.CanCancel(operation))
                                    {
                                        <form method="post" asp-page-handler="Cancel">
                                            <input type="hidden" name="id" value="@operation.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button" type="submit">@ui["common.cancel"]</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admact-footer">
            <span>@ui.Format("admin.activity.showing", ("from", plan.Offset + 1), ("to", plan.Offset + Model.Items.Count), ("total", plan.Total))</span>
            @if (plan.PageCount > 1)
            {
                <nav class="admact-pager" aria-label="@ui["admin.activity.pagerAria"]">
                    @if (plan.HasPrevious)
                    {
                        <a class="admact-page" href="@OperationsModel.Href(filter with { Page = plan.Page - 1 })" rel="prev">@ui["admin.activity.page.previous"]</a>
                    }
                    @foreach (var number in AdminHistoryQuery.PageWindow(plan.Page, plan.PageCount))
                    {
                        if (number == 0)
                        {
                            <span class="admact-gap" aria-hidden="true">&hellip;</span>
                        }
                        else if (number == plan.Page)
                        {
                            <span class="admact-page admact-page-current" aria-current="page">@number</span>
                        }
                        else
                        {
                            <a class="admact-page" href="@OperationsModel.Href(filter with { Page = number })" aria-label="@ui.Format("admin.activity.page.n", ("page", number))">@number</a>
                        }
                    }
                    @if (plan.HasNext)
                    {
                        <a class="admact-page" href="@OperationsModel.Href(filter with { Page = plan.Page + 1 })" rel="next">@ui["admin.activity.page.next"]</a>
                    }
                </nav>
            }
        </div>
    }
</section>
