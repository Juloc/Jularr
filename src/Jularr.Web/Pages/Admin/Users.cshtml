@page
@using Jularr.Web.Features.Auth
@model Jularr.Web.Pages.Admin.UsersModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.nav.users"];
}

<header class="page-header">
    <div>
        <h1>@ui["admin.nav.users"]</h1>
        <p>@ui["admin.users.subtitle"]</p>
    </div>
    <div class="inline-actions">
        <a class="button" asp-page="/Admin/Roles">@ui["admin.roles.title"]</a>
        <a class="button" asp-page="/Admin/Capabilities/Index">@ui["admin.capabilities.title"]</a>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<div class="settings-grid admin-users-layout" data-admin-users>
    <section class="panel admin-users-directory">
        <div class="panel-heading">
            <h2>@ui["admin.users.accounts"]</h2>
            <span>@Model.Users.Count</span>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="empty-state admin-users-empty">
                <strong>@ui["admin.users.noAccounts"]</strong>
                <span>@ui["admin.users.noAccountsHint"]</span>
            </div>
        }
        else
        {
            <div class="user-directory-list">
                @foreach (var account in Model.Users)
                {
                    var roleLabel = ui[AccountRoles.LabelKey(account.Role)];
                    <article class="user-directory-row" data-admin-user="@account.Id">
                        <div class="user-directory-main">
                            <div class="user-directory-heading">
                                <strong>@account.UserName</strong>
                                <div class="user-directory-badges">
                                    <span class="status-pill">@roleLabel</span>
                                    <span class="status-pill @(account.IsEnabled ? "status-ok" : "status-warn")">
                                        @(account.IsEnabled ? ui["admin.user.enabledLabel"] : ui["admin.user.disabledPendingLabel"])
                                    </span>
                                </div>
                            </div>

                            <div class="user-directory-meta">
                                <span>@ui.Format("admin.users.createdAt", ("time", account.CreatedAt.ToString("yyyy-MM-dd")))</span>
                            </div>
                        </div>

                        <div class="inline-actions user-directory-actions">
                            @if (account.Role != AccountRole.Owner)
                            {
                                @if (account.IsEnabled)
                                {
                                    <form method="post" asp-page-handler="Disable">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button class="button" type="submit">@ui["admin.users.disable"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Approve">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button class="button button-primary" type="submit">@ui["admin.user.approveEnable"]</button>
                                    </form>
                                }
                            }

                            <a class="button"
                               asp-page="/Admin/User"
                               asp-route-id="@account.Id">@ui["admin.users.manage"]</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel admin-users-create">
        <div class="panel-heading">
            <h2>@ui["admin.users.createUser"]</h2>
        </div>

        <form method="post" asp-page-handler="Create" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label>
                <span>@ui["admin.user.userNameLabel"]</span>
                <input asp-for="UserName" autocomplete="username" />
                <span asp-validation-for="UserName" class="validation"></span>
            </label>
            <label>
                <span>@ui["admin.users.initialPassword"]</span>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </label>
            <button class="button button-primary" type="submit">@ui["admin.users.createUser"]</button>
        </form>
    </section>
</div>
