@page
@model Jularr.Web.Pages.Admin.AiModel
@using Jularr.Web.Features.Ai
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.system.ai"];
    var capabilities = Model.Diagnostics.Capabilities;
    var usagePanel = new AiUsagePanel(ui, Model.Usage, true, "/Admin/Ai", Model.ProfileNames);
}
@section Head {
    <link rel="stylesheet" href="~/css/ai.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.system.ai"]</h1>
        <p>@ui["admin.ai.subtitle"]</p>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@Model.Provider.DisplayName</h2>
            @if (Model.Provider.IsAuthenticated)
            {
                <span class="status-pill status-ok">@ui["admin.subtitles.connected"]</span>
            }
            else if (Model.Provider.IsAvailable)
            {
                <span class="status-pill">@ui["admin.ai.notConnected"]</span>
            }
            else
            {
                <span class="status-pill status-error">@ui["admin.ai.unavailable"]</span>
            }
        </div>

        <div class="status-list">
            <div>
                <span>@ui["admin.ai.cli"]</span>
                <strong>@(Model.Provider.IsAvailable ? ui["admin.ai.installed"] : ui["admin.ai.missing"])</strong>
            </div>
            <div>
                <span>@ui["admin.ai.version"]</span>
                <strong>@(Model.Provider.Version ?? "—")</strong>
            </div>
            <div>
                <span>@ui["admin.ai.authentication"]</span>
                <strong>@(Model.Provider.AuthenticationMethod ?? "—")</strong>
            </div>
            <div>
                <span>@ui["admin.ai.transport"]</span>
                <strong>@AiViewFormat.Transport(ui, capabilities.Transport)</strong>
            </div>
            <div>
                <span>@ui["admin.ai.credentialStorage"]</span>
                <strong>/data/codex</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Provider.Error))
        {
            <p class="validation">@Model.Provider.Error</p>
        }

        @if (Model.Provider.IsAuthenticated)
        {
            <form method="post" asp-page-handler="Logout">
                <button class="button" type="submit">@ui["admin.ai.disconnect"]</button>
            </form>
        }
        else if (Model.Provider.IsAvailable && !Model.Login.IsActive)
        {
            <form method="post" asp-page-handler="Connect">
                <button class="button button-primary" type="submit">@ui["admin.ai.connectWithChatGpt"]</button>
            </form>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.ai.deviceLogin"]</h2></div>

        @if (Model.Login.State == DeviceLoginState.WaitingForUser)
        {
            <div class="device-login">
                <p>@ui["admin.ai.step1"]</p>
                <a class="button button-primary" href="@Model.Login.VerificationUrl" target="_blank" rel="noopener noreferrer">
                    @ui["admin.ai.openLoginPage"]
                </a>

                <p>@ui["admin.ai.step2"]</p>
                <code class="device-code">@Model.Login.UserCode</code>

                <p class="muted">@ui["admin.ai.codeExpires"]</p>

                <div class="inline-actions">
                    <a class="button" asp-page="/Admin/Ai">@ui["admin.ai.checkConnection"]</a>
                    <form method="post" asp-page-handler="Cancel">
                        <button class="button" type="submit">@ui["common.cancel"]</button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Login.State == DeviceLoginState.Starting)
        {
            <p class="muted">@ui["admin.ai.waitingForDeviceCode"]</p>
            <div class="inline-actions">
                <a class="button" asp-page="/Admin/Ai">@ui["admin.ai.refresh"]</a>
                <form method="post" asp-page-handler="Cancel">
                    <button class="button" type="submit">@ui["common.cancel"]</button>
                </form>
            </div>
        }
        else if (Model.Login.State is DeviceLoginState.Failed or DeviceLoginState.Cancelled)
        {
            <p class="validation">@(Model.Login.Message ?? ui["admin.ai.loginIncomplete"])</p>
            @if (Model.Provider.IsAvailable && !Model.Provider.IsAuthenticated)
            {
                <form method="post" asp-page-handler="Connect">
                    <button class="button" type="submit">@ui["admin.ai.tryAgain"]</button>
                </form>
            }
        }
        else
        {
            <p class="muted">
                @ui["admin.ai.headlessDescription"]
            </p>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.ai.appServerLogin"]</h2></div>

        @if (Model.AppServerLogin.State == DeviceLoginState.WaitingForUser)
        {
            <div class="device-login">
                <p>@ui["admin.ai.step1"]</p>
                <a class="button button-primary" href="@Model.AppServerLogin.VerificationUrl" target="_blank" rel="noopener noreferrer">
                    @ui["admin.ai.openLoginPage"]
                </a>

                <p>@ui["admin.ai.step2"]</p>
                <code class="device-code">@Model.AppServerLogin.UserCode</code>

                <p class="muted">@ui["admin.ai.codeExpires"]</p>

                <div class="inline-actions">
                    <a class="button" asp-page="/Admin/Ai">@ui["admin.ai.checkConnection"]</a>
                    <form method="post" asp-page-handler="CancelAppServer">
                        <button class="button" type="submit">@ui["common.cancel"]</button>
                    </form>
                </div>
            </div>
        }
        else if (Model.AppServerLogin.State == DeviceLoginState.Starting)
        {
            <p class="muted">@ui["admin.ai.waitingForDeviceCode"]</p>
            <div class="inline-actions">
                <a class="button" asp-page="/Admin/Ai">@ui["admin.ai.refresh"]</a>
                <form method="post" asp-page-handler="CancelAppServer">
                    <button class="button" type="submit">@ui["common.cancel"]</button>
                </form>
            </div>
        }
        else if (Model.AppServerLogin.State is DeviceLoginState.Failed or DeviceLoginState.Cancelled)
        {
            <p class="validation">@(Model.AppServerLogin.Message ?? ui["admin.ai.loginIncomplete"])</p>
            @if (Model.AppServerLoginSupported && Model.Provider.IsAvailable && !Model.Provider.IsAuthenticated)
            {
                <form method="post" asp-page-handler="ConnectAppServer">
                    <button class="button" type="submit">@ui["admin.ai.tryAgain"]</button>
                </form>
            }
        }
        else if (!Model.AppServerLoginSupported)
        {
            <p class="muted">@ui["admin.ai.appServerLoginUnsupported"]</p>
        }
        else if (!Model.Provider.IsAuthenticated)
        {
            <form method="post" asp-page-handler="ConnectAppServer">
                <button class="button button-primary" type="submit">@ui["admin.ai.connectViaAppServer"]</button>
            </form>
        }
    </section>
</div>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.ai.recentUsage"]</h2></div>
        <partial name="_AiActivity" model="Model.Activity" />
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.ai.capabilities"]</h2></div>
        <div class="status-list">
            @foreach (var capability in Enum.GetValues<AiCapability>())
            {
                var state = capabilities[capability];
                <div>
                    <span>@AiViewFormat.Capability(ui, capability)</span>
                    <strong class="@(state == AiCapabilityState.Supported ? "status-pill status-ok" : state == AiCapabilityState.Unsupported ? "status-pill" : "muted")">
                        @AiViewFormat.CapabilityState(ui, state)
                    </strong>
                </div>
            }
        </div>
        @if (Model.Provider.IsAvailable && !string.IsNullOrWhiteSpace(Model.Diagnostics.Error))
        {
            <p class="validation">@Model.Diagnostics.Error</p>
        }
    </section>
</div>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.ai.usageTitle"]</h2></div>
        <partial name="_AiUsage" model="usagePanel" />
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["ai.quota.title"]</h2>
            <form method="post" asp-page-handler="RefreshQuota" asp-route-period="@Model.Period">
                <button class="button" type="submit">@ui["admin.ai.refresh"]</button>
            </form>
        </div>
        <partial name="_AiQuota" model="new AiQuotaPanel(ui, Model.Diagnostics.Quota, true)" />
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.ai.models"]</h2>
        <form method="post" asp-page-handler="RefreshModels" asp-route-period="@Model.Period">
            <button class="button" type="submit">@ui["ai.models.refresh"]</button>
        </form>
    </div>
    <p class="muted">@AiViewFormat.CatalogStatus(ui, Model.Catalog, Model.Now)</p>
    @if (Model.Catalog.HasModels)
    {
        <ul class="ai-model-list">
            @foreach (var entry in Model.Catalog.Models)
            {
                <li>
                    <div>
                        <strong>@entry.DisplayName</strong>
                        <code>@entry.Id</code>
                        @if (entry.IsDefault)
                        {
                            <span class="status-pill status-ok">@ui["admin.ai.defaultModel"]</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(entry.Description))
                    {
                        <p class="muted">@entry.Description</p>
                    }
                    @if (entry.ReasoningEfforts.Count > 0)
                    {
                        <p>@ui["ai.settings.reasoning"]: @string.Join(", ", entry.ReasoningEfforts.Select(x => x.Effort == entry.DefaultReasoningEffort ? x.Effort + " *" : x.Effort))</p>
                    }
                    @if (entry.ServiceTiers.Count > 0)
                    {
                        <p>@ui["ai.settings.serviceTier"]: @string.Join(", ", entry.ServiceTiers.Select(x => x.Name))</p>
                    }
                </li>
            }
        </ul>
    }
</section>

@section Scripts {
    <script src="~/js/ai-activity.js" asp-append-version="true"></script>
}
