@page
@model Jularr.Web.Pages.Admin.WantedModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Acquisition.Wanted
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.wanted.title"];
    var list = Model.List;
    var filter = list.Filter;
    var returnUrl = WantedModel.Href(filter);
    var tabs = new (AdminWantedTab Tab, string Label)[]
    {
        (AdminWantedTab.All, ui["admin.wanted.tab.all"]),
        (AdminWantedTab.Requested, ui["admin.wanted.status.requested"]),
        (AdminWantedTab.Missing, ui["admin.wanted.status.missing"]),
        (AdminWantedTab.Searching, ui["admin.wanted.status.searching"]),
        (AdminWantedTab.Failed, ui["admin.wanted.status.failed"])
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-wanted.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.wanted.title"]</h1>
        <p>@ui["admin.wanted.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<section class="admwant" aria-label="@ui["admin.wanted.title"]">
    <nav class="library-type-tabs admwant-tabs" aria-label="@ui["admin.wanted.tabsAria"]">
        @foreach (var (tab, label) in tabs)
        {
            var active = tab == filter.Tab;
            <a class="library-type-tab @(active ? "active" : "")"
               href="@WantedModel.Href(filter with { Tab = tab, Page = 1 })"
               aria-current="@(active ? "page" : null)">@label <span class="admwant-count">@list.TabCounts[tab]</span></a>
        }
    </nav>

    <form method="get" action="@WantedModel.PagePath" class="admwant-filters">
        @if (filter.Tab != AdminWantedTab.All)
        {
            <input type="hidden" name="tab" value="@AdminWantedQuery.TabName(filter.Tab)" />
        }
        <input class="admwant-search" type="search" name="q" value="@filter.Search" maxlength="120"
               placeholder="@ui["admin.wanted.searchPlaceholder"]" aria-label="@ui["admin.wanted.searchPlaceholder"]" />
        <div class="admwant-controls">
            <label class="admwant-field">
                <span>@ui["admin.requests.filter.type"]</span>
                <select name="type">
                    <option value="">@ui["admin.wanted.filter.any"]</option>
                    @foreach (var kind in list.Kinds)
                    {
                        <option value="@AcquisitionAccessNames.Kind(kind)" selected="@(filter.Kind == kind)">@ui[MediaKindLabelKeys.Name(kind)]</option>
                    }
                </select>
            </label>
            @if (list.Languages.Count > 0)
            {
                <label class="admwant-field">
                    <span>@ui["admin.requests.filter.language"]</span>
                    <select name="lang">
                        <option value="">@ui["admin.wanted.filter.any"]</option>
                        @foreach (var tag in list.Languages)
                        {
                            <option value="@tag" selected="@(filter.Language == tag)">@RequestLanguages.Name(tag)</option>
                        }
                    </select>
                </label>
            }
            @if (list.Profiles.Count > 0)
            {
                <label class="admwant-field">
                    <span>@ui["admin.wanted.filter.profile"]</span>
                    <select name="profile">
                        <option value="">@ui["admin.wanted.filter.any"]</option>
                        @foreach (var (profileId, profileName) in list.Profiles)
                        {
                            <option value="@profileId" selected="@string.Equals(filter.ProfileId, profileId, StringComparison.OrdinalIgnoreCase)">@profileName</option>
                        }
                    </select>
                </label>
            }
            <label class="admwant-field">
                <span>@ui["admin.wanted.filter.sort"]</span>
                <select name="sort">
                    <option value="">@ui["admin.wanted.sort.search"]</option>
                    <option value="title" selected="@(filter.Sort == AdminWantedSort.Title)">@ui["admin.wanted.sort.title"]</option>
                    <option value="waiting" selected="@(filter.Sort == AdminWantedSort.Waiting)">@ui["admin.wanted.sort.waiting"]</option>
                </select>
            </label>
            <button class="button" type="submit">@ui["admin.filter.apply"]</button>
            @if (filter.HasNarrowing || filter.Sort != AdminWantedSort.LastSearch)
            {
                <a class="text-link" href="@WantedModel.Href(new AdminWantedFilter(filter.Tab))">@ui["admin.requests.filter.reset"]</a>
            }
        </div>
    </form>

    @if (Model.Failed)
    {
        <div class="admwant-message" role="alert">
            <p>@ui["admin.wanted.loadFailed"]</p>
            <a class="button" href="@returnUrl">@ui["admin.requests.retry"]</a>
        </div>
    }
    else if (list.Items.Count == 0)
    {
        <p class="admwant-message muted" data-admin-wanted-empty>
            @(filter.HasNarrowing || filter.Tab != AdminWantedTab.All ? ui["admin.wanted.noMatch"] : ui["admin.wanted.empty"])
        </p>
    }
    else
    {
        <div class="admwant-table-wrap">
            <table class="admwant-table" data-admin-wanted>
                <thead>
                    <tr>
                        <th scope="col">@ui["admin.wanted.col.title"]</th>
                        <th scope="col">@ui["admin.wanted.col.type"]</th>
                        <th scope="col">@ui["admin.wanted.col.desired"]</th>
                        <th scope="col">@ui["admin.wanted.col.status"]</th>
                        <th scope="col">@ui["admin.wanted.col.lastSearch"]</th>
                        <th scope="col"><span class="admwant-visually-hidden">@ui["admin.wanted.col.actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in list.Items)
                    {
                        var kindName = AcquisitionAccessNames.Kind(item.Kind);
                        var statusName = AdminWantedQuery.StatusName(item.Status);
                        var unit = Model.UnitLabel(item);
                        var result = Model.ResultLabel(item);
                        var languages = item.Languages.Select(RequestLanguages.Name).ToArray();
                        <tr class="admwant-row">
                            <td class="admwant-cell-title">
                                <div class="admwant-title-wrap">
                                    <span class="admwant-cover">
                                        @if (!string.IsNullOrWhiteSpace(item.CoverUrl))
                                        {
                                            <img src="@item.CoverUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                        }
                                    </span>
                                    <span class="admwant-copy">
                                        <strong class="admwant-title">@item.Title</strong>
                                        @if (unit is not null)
                                        {
                                            <small>@unit</small>
                                        }
                                        @if (item.IsUpgrade)
                                        {
                                            <small>@ui["acquisition.reason.upgradeWanted"]</small>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="admwant-cell-type">
                                <span class="admwant-tag admwant-tag-@kindName">@ui[MediaKindLabelKeys.Operation(item.Kind)]</span>
                            </td>
                            <td class="admwant-cell-desired">
                                @if (languages.Length == 0 && item.ProfileName is null)
                                {
                                    <span class="admwant-none" aria-hidden="true">&mdash;</span>
                                }
                                else
                                {
                                    <div class="admwant-stack">
                                        @if (languages.Length > 0)
                                        {
                                            <span>@string.Join(", ", languages)</span>
                                        }
                                        @if (item.ProfileName is not null)
                                        {
                                            <small>@item.ProfileName</small>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="admwant-cell-status">
                                <span class="admwant-state admwant-state-@statusName">
                                    <partial name="_WantedIcon" model="@statusName" />
                                    @ui["admin.wanted.status." + statusName]
                                </span>
                            </td>
                            <td class="admwant-cell-last">
                                <div class="admwant-stack">
                                    @if (item.LastSearchUtc is { } lastSearch)
                                    {
                                        <time datetime="@WantedModel.Iso(lastSearch)" title="@WantedModel.Stamp(lastSearch)">@Model.AgeLabel(lastSearch)</time>
                                    }
                                    else
                                    {
                                        <span class="admwant-none">@ui["admin.wanted.never"]</span>
                                    }
                                    @if (result is not null)
                                    {
                                        <small class="admwant-note">@result</small>
                                    }
                                    @if (item.NextSearchUtc is { } nextSearch && nextSearch > Model.NowUtc && item.Status is WantedStatus.Missing or WantedStatus.Failed)
                                    {
                                        <small>@ui.Format("admin.wanted.nextSearch", ("time", WantedModel.Stamp(nextSearch)))</small>
                                    }
                                </div>
                            </td>
                            <td class="admwant-cell-actions">
                                <div class="admwant-actions">
                                    @if (item.CanSearch && item.Source == WantedSource.Request)
                                    {
                                        <form method="post" asp-page-handler="SearchRequest" asp-route-id="@item.RequestId">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button button-primary" type="submit">@(item.Status == WantedStatus.Failed ? ui["admin.requests.retry"] : ui["admin.requests.searchNow"])</button>
                                        </form>
                                    }
                                    @if (item.CanSearch && item.Source == WantedSource.Request && item.Kind == MediaAcquisitionKind.Book)
                                    {
                                        <a class="button"
                                           asp-page="/Admin/BookManualSearch"
                                           asp-route-id="@item.RequestId">@ui["admin.wanted.manualSearch"]</a>
                                    }
                                    @if (item.CanSearch && item.Source == WantedSource.Monitored)
                                    {
                                        <form method="post" asp-page-handler="SearchAnime">
                                            <input type="hidden" name="animeKey" value="@item.AnimeKey" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button button-primary" type="submit">@ui["admin.requests.searchNow"]</button>
                                        </form>
                                    }
                                    @if (item.CanSearch && item.Source == WantedSource.Request && item.Kind is MediaAcquisitionKind.Movie or MediaAcquisitionKind.Tv)
                                    {
                                        <a class="button"
                                           asp-page="/Admin/ManualSearch"
                                           asp-route-id="@item.RequestId"
                                           asp-route-unit="@item.UnitId">@ui["admin.wanted.manualSearch"]</a>
                                    }
                                    @if (item.Source == WantedSource.Monitored && item.CanSearch && item.Season is not null && item.Episode is not null)
                                    {
                                        <a class="button"
                                           asp-page="/Acquisition/Index"
                                           asp-route-search="@item.AnimeKey"
                                           asp-route-season="@item.Season"
                                           asp-route-episode="@item.Episode"
                                           asp-route-mode="Episode"
                                           asp-fragment="search-results">@ui["admin.wanted.manualSearch"]</a>
                                    }
                                    @if (item.Source == WantedSource.Monitored && item.AnimeId is { } managedId)
                                    {
                                        <a class="button" href="/Admin/Media/@managedId">@ui["admin.media.manage"]</a>
                                    }
                                    @if (item.WorkId is { } workId)
                                    {
                                        <a class="button" href="@VideoWorkLinks.AdminPath(item.Kind, workId)">@ui["admin.media.manage"]</a>
                                    }
                                    @if (item.DetailUrl is { } detailUrl)
                                    {
                                        <a class="button" href="@detailUrl">@ui["admin.requests.viewMedia"]</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admwant-footer">
            <span>@ui.Format("admin.wanted.showing", ("from", list.Offset + 1), ("to", list.Offset + list.Items.Count), ("total", list.Total))</span>
            @if (list.PageCount > 1)
            {
                <nav class="admwant-pager" aria-label="@ui["admin.wanted.pagerAria"]">
                    @if (list.HasPrevious)
                    {
                        <a class="admwant-page" href="@WantedModel.Href(filter with { Page = list.Page - 1 })" rel="prev">@ui["admin.wanted.page.previous"]</a>
                    }
                    @foreach (var number in Jularr.Web.Features.Operations.AdminHistoryQuery.PageWindow(list.Page, list.PageCount))
                    {
                        if (number == 0)
                        {
                            <span class="admwant-gap" aria-hidden="true">&hellip;</span>
                        }
                        else if (number == list.Page)
                        {
                            <span class="admwant-page admwant-page-current" aria-current="page">@number</span>
                        }
                        else
                        {
                            <a class="admwant-page" href="@WantedModel.Href(filter with { Page = number })" aria-label="@ui.Format("admin.wanted.page.n", ("page", number))">@number</a>
                        }
                    }
                    @if (list.HasNext)
                    {
                        <a class="admwant-page" href="@WantedModel.Href(filter with { Page = list.Page + 1 })" rel="next">@ui["admin.wanted.page.next"]</a>
                    }
                </nav>
            }
        </div>
    }
</section>
