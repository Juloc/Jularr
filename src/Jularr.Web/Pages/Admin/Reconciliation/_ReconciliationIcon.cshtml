@model string
@* One 16px outline icon family for the whole reconciliation wizard; meaning always sits next to it as text or an accessible name. *@
<svg class="admrec-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "chevron":
            <path d="m6 3.5 4.5 4.5L6 12.5" />
            break;
        case "folder":
            <path d="M2 4.75A1.25 1.25 0 0 1 3.25 3.5h2.9l1.4 1.5h5.2A1.25 1.25 0 0 1 14 6.25v5.5a1.25 1.25 0 0 1-1.25 1.25h-9.5A1.25 1.25 0 0 1 2 11.75z" />
            break;
        case "file":
            <path d="M4 2.5h5l3 3v8H4z" />
            <path d="M9 2.5v3h3" />
            break;
        case "recognized":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.5 8.25 1.75 1.75 3.25-3.5" />
            break;
        case "partial":
        case "unclear":
            <circle cx="8" cy="8" r="5.75" />
            <path d="M8 4.9v3.5M8 10.9v.01" />
            break;
        case "error":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.9 5.9 4.2 4.2M10.1 5.9l-4.2 4.2" />
            break;
        case "ignored":
            <circle cx="8" cy="8" r="5.75" />
            <path d="M5.5 8h5" />
            break;
        case "arrow-left":
            <path d="M13 8H3M7 4 3 8l4 4" />
            break;
        case "arrow-right":
            <path d="M3 8h10M9 4l4 4-4 4" />
            break;
        case "split":
            <path d="M8 13V8M8 8 4 3.5M8 8l4-4.5" />
            break;
        case "chevron-down":
            <path d="m3.75 6 4.25 4.25L12.25 6" />
            break;
        default:
            <circle cx="8" cy="8" r="5.75" />
            <path d="M8 7.25v3.5M8 5.1v.01" />
            break;
    }
</svg>
