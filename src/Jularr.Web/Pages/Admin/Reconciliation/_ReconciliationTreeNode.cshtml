@model Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender
@using Jularr.Web.Features.Storage.Reconciliation
@{
    var node = Model.Node;
    var isSelected = Model.SelectedPath == node.Item.RelativePath;
    var selectedClass = isSelected ? " selected" : "";
    var state = Model.Present(node.Item.State);
    var expandsForSelection = Model.SelectedPath?.StartsWith(node.Item.RelativePath + "/", StringComparison.Ordinal) == true;
    var shouldExpand = node.Item.State != LibraryReconciliationItemState.Recognized || expandsForSelection || isSelected;
    var name = node.Item.RelativePath.Split('/').Last();
    var resolvedCount = node.Item.FileCount - node.Item.UnresolvedCount;
}
<li>
    @if (node.Children.Count > 0)
    {
        <details open="@shouldExpand">
            <summary>
                <a class="admrec-tree-entry@(selectedClass)" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@Model.PlanId" asp-route-selected="@node.Item.RelativePath" asp-route-step="2">@name</a>
                <span class="admrec-state @state.CssClass">@state.Text <span class="admrec-tree-count">@resolvedCount/@node.Item.FileCount</span></span>
            </summary>
            <ul>
                @foreach (var child in node.Children)
                {
                    <partial name="_ReconciliationTreeNode" model="new Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender(child, Model.PlanId, Model.SelectedPath, Model.Present)" />
                }
            </ul>
        </details>
    }
    else
    {
        <a class="admrec-tree-entry@(selectedClass)" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@Model.PlanId" asp-route-selected="@node.Item.RelativePath" asp-route-step="2">@name</a>
        <span class="admrec-state @state.CssClass">@state.Text</span>
    }
</li>
