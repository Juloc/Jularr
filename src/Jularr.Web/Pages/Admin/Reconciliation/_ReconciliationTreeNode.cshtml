@model Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender
@using Jularr.Web.Features.Storage.Reconciliation
@{
    var node = Model.Node;
    var item = node.Item;
    var isSelected = Model.SelectedPath == item.RelativePath;
    var state = Model.Present(item.State);
    var expandsForSelection = Model.SelectedPath?.StartsWith(item.RelativePath + "/", StringComparison.Ordinal) == true;
    var shouldExpand = item.State != LibraryReconciliationItemState.Recognized || expandsForSelection || isSelected;
    var name = item.RelativePath.Split('/').Last();
    var resolvedCount = item.FileCount - item.UnresolvedCount;
    var badgeCount = item.State is LibraryReconciliationItemState.Recognized or LibraryReconciliationItemState.Partial ? $"{resolvedCount}/{item.FileCount}" : item.UnresolvedCount.ToString();
    var iconName = item.IsDirectory ? "folder" : "file";
}
<li>
    @if (node.Children.Count > 0)
    {
        <details open="@shouldExpand">
            <summary>
                <span class="admrec-twisty"><partial name="_ReconciliationIcon" model='"chevron"' /></span>
                <a class="admrec-node admrec-tone-@state.CssClass @(isSelected ? "selected" : "")" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@Model.PlanId" asp-route-selected="@item.RelativePath" asp-route-step="2" aria-current="@(isSelected ? "true" : null)">
                    <partial name="_ReconciliationIcon" model="iconName" />
                    <span class="admrec-node-name">@name</span>
                    <span class="admrec-badge"><partial name="_ReconciliationIcon" model="state.CssClass" />@state.Text <span class="admrec-badge-count">(@badgeCount)</span></span>
                </a>
            </summary>
            <ul>
                @foreach (var child in node.Children)
                {
                    <partial name="_ReconciliationTreeNode" model="new Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender(child, Model.PlanId, Model.SelectedPath, Model.Present)" />
                }
            </ul>
        </details>
    }
    else
    {
        <div class="admrec-leaf">
            <a class="admrec-node admrec-tone-@state.CssClass @(isSelected ? "selected" : "")" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@Model.PlanId" asp-route-selected="@item.RelativePath" asp-route-step="2" aria-current="@(isSelected ? "true" : null)">
                <partial name="_ReconciliationIcon" model="iconName" />
                <span class="admrec-node-name">@name</span>
                @if (item.IsDirectory)
                {
                    <span class="admrec-badge"><partial name="_ReconciliationIcon" model="state.CssClass" />@state.Text <span class="admrec-badge-count">(@badgeCount)</span></span>
                }
                else
                {
                    <span class="admrec-visually-hidden">@state.Text</span>
                }
            </a>
        </div>
    }
</li>
