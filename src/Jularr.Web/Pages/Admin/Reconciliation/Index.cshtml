@page "/Admin/LibraryReconciliation/{planId:guid?}"
@model Jularr.Web.Pages.Admin.Reconciliation.IndexModel
@using Jularr.Web.Features.Storage.FolderBrowse
@using Jularr.Web.Features.Storage.Reconciliation
@functions {
    private string UnitText(LibraryReconciliationPlanItem item)
    {
        var unitId = item.AssignedWorkEpisodeId ?? item.AssignedWorkVolumeId ?? item.AssignedWorkChapterId;
        if (unitId is not { } id)
        {
            return string.Empty;
        }

        return Model.UnitLabels.TryGetValue(id, out var label) ? label : Model.Ui["admin.reconciliation.unitAssigned"];
    }
}
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.reconciliation.title"];
    var steps = new[]
    {
        ui["admin.reconciliation.step.scan"],
        ui["admin.reconciliation.step.structure"],
        ui["admin.reconciliation.step.mapping"],
        ui["admin.reconciliation.step.organize"],
        ui["admin.reconciliation.step.preview"]
    };
    var activeStep = Model.CurrentStep - 1;
    var plan = Model.Plan;
    var isReady = plan?.Status == LibraryReconciliationPlanStatus.Ready;
    var selectedPath = Model.SelectedItem?.RelativePath;
    var startFolderPathField = new PathFieldModel(
        "reconciliation-start-folder",
        "StartFolder",
        ui["admin.reconciliation.startFolder"],
        Model.StartFolder,
        ui)
    {
        Placeholder = ui["admin.reconciliation.startFolderHint"]
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-reconciliation.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.reconciliation.title"]</h1>
        <p>@ui["admin.reconciliation.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<main class="admrec" data-current-step="@Model.CurrentStep" aria-label="@ui["admin.reconciliation.title"]">
    <ol class="admrec-steps" aria-label="@ui["admin.reconciliation.title"]">
        @for (var index = 0; index < steps.Length; index++)
        {
            <li class="@(index == activeStep ? "active" : "")" aria-current="@(index == activeStep ? "step" : null)">
                @if (plan is not null && index != activeStep)
                {
                    <a asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@selectedPath" asp-route-step="@(index + 1)"><span>@(index + 1)</span>@steps[index]</a>
                }
                else
                {
                    <span class="admrec-step-label"><span>@(index + 1)</span>@steps[index]</span>
                }
            </li>
        }
    </ol>
    <p class="admrec-message admrec-desktop-hint">@ui["admin.reconciliation.desktopHint"]</p>

    @if (plan is null)
    {
        @if (Model.Roots.Count == 0)
        {
            <p class="admrec-message">@ui["admin.reconciliation.rootEmpty"]</p>
        }
        else
        {
            <section class="admrec-panel" aria-label="@ui["admin.reconciliation.step.scan"]">
                <form method="post" asp-page-handler="Create" class="admrec-form">
                    <label>
                        <span>@ui["admin.reconciliation.root"]</span>
                        <select asp-for="LibraryRootId" required>
                            @foreach (var root in Model.Roots)
                            {
                                <option value="@root.Id">@root.Name</option>
                            }
                        </select>
                    </label>
                    <partial name="_PathField" model="startFolderPathField" />
                    <fieldset>
                        <label><input asp-for="IncludeSubfolders" /> @ui["admin.reconciliation.includeSubfolders"]</label>
                        <label><input asp-for="SkipConfidentAssignments" /> @ui["admin.reconciliation.skipConfident"]</label>
                        <label><input asp-for="OnlyUnclearItems" /> @ui["admin.reconciliation.onlyUnclear"]</label>
                        <label><input asp-for="AnalyzeFilenameEvidence" /> @ui["admin.reconciliation.analyzeFilenameEvidence"]</label>
                    </fieldset>
                    <div asp-validation-summary="ModelOnly" class="admrec-errors" role="alert"></div>
                    <div class="admrec-actions"><button class="button button-primary" type="submit">@ui["admin.reconciliation.create"]</button></div>
                </form>
            </section>
        }
    }
    else if (plan.Status == LibraryReconciliationPlanStatus.Executing)
    {
        <p class="admrec-message" role="status">@ui["admin.reconciliation.executionRunning"]</p>
        @if (plan.ExecutionOperationId is { } runningOperationId)
        {
            <p><a class="button" asp-page="/Admin/Operation" asp-route-id="@runningOperationId">@ui["admin.reconciliation.openOperation"]</a></p>
        }
    }
    else
    {
        @if (Model.CurrentStep == 1)
        {
            <section class="admrec-panel" aria-label="@ui["admin.reconciliation.step.scan"]">
                <div class="admrec-panel-heading">
                    <p><strong>@plan.RootName</strong><span aria-hidden="true"> · </span><code>@plan.ScopeLabel</code></p>
                    <div class="admrec-actions">
                        @if (plan.Status is LibraryReconciliationPlanStatus.Draft or LibraryReconciliationPlanStatus.Failed)
                        {
                            <form method="post" asp-page-handler="Scan" asp-route-planId="@plan.Id">
                                <button class="button button-primary" type="submit">@(plan.Status == LibraryReconciliationPlanStatus.Failed ? ui["admin.reconciliation.scanAgain"] : ui["admin.reconciliation.scan"])</button>
                            </form>
                        }
                        <a class="button" asp-page="/Admin/Reconciliation/Index">@ui["admin.reconciliation.newReview"]</a>
                    </div>
                </div>

                @if (plan.Status == LibraryReconciliationPlanStatus.Draft)
                {
                    <p class="admrec-message">@ui["admin.reconciliation.inventoryPending"]</p>
                }
                else if (plan.Status == LibraryReconciliationPlanStatus.Scanning)
                {
                    <p class="admrec-message" role="status">@ui["admin.reconciliation.scanRunning"]</p>
                }
                else if (plan.Status == LibraryReconciliationPlanStatus.Failed)
                {
                    <p class="admrec-message admrec-error" role="alert">@plan.Failure</p>
                }
                else if (plan.Status == LibraryReconciliationPlanStatus.Stale)
                {
                    <p class="admrec-message admrec-error" role="alert">@ui["admin.reconciliation.staleScan"]</p>
                }
                else if (Model.Items.Count == 0)
                {
                    <p class="admrec-message">@ui["admin.reconciliation.noItems"]</p>
                }
                else
                {
                    <dl class="admrec-counts">
                        <div><dt>@ui["admin.reconciliation.files"]</dt><dd>@Model.FileCount</dd></div>
                        <div class="recognized"><dt>@ui["admin.reconciliation.recognized"]</dt><dd>@Model.RecognizedCount <small>(@Model.Percent(Model.RecognizedCount)%)</small></dd></div>
                        <div class="unclear"><dt>@ui["admin.reconciliation.unresolved"]</dt><dd>@Model.UnclearCount <small>(@Model.Percent(Model.UnclearCount)%)</small></dd></div>
                        <div class="error"><dt>@ui["admin.reconciliation.hardErrors"]</dt><dd>@Model.HardErrorCount <small>(@Model.Percent(Model.HardErrorCount)%)</small></dd></div>
                    </dl>
                    @if (Model.ProblemFolders.Count == 0)
                    {
                        <p class="admrec-message">@ui["admin.reconciliation.noUnclearItems"]</p>
                    }
                    else
                    {
                        <div class="admrec-table-wrap">
                            <table class="admrec-table admrec-stack-table">
                                <thead><tr><th>@ui["admin.reconciliation.path"]</th><th>@ui["admin.reconciliation.unresolved"]</th><th>@ui["admin.reconciliation.state"]</th></tr></thead>
                                <tbody>
                                    @foreach (var folder in Model.ProblemFolders)
                                    {
                                        var state = Model.GetStatePresentation(folder.State);
                                        <tr>
                                            <td data-label="@ui["admin.reconciliation.path"]"><a asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@folder.RelativePath" asp-route-step="2"><code>@folder.RelativePath</code></a></td>
                                            <td data-label="@ui["admin.reconciliation.unresolved"]">@folder.UnresolvedCount / @folder.FileCount</td>
                                            <td data-label="@ui["admin.reconciliation.state"]"><span class="admrec-state @state.CssClass">@state.Text</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </section>
            @if (isReady && Model.Items.Count > 0)
            {
                <div class="admrec-footer">
                    <span></span>
                    <a class="button button-primary" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-step="2">@ui["admin.reconciliation.next"]</a>
                </div>
            }
        }
        else if (!isReady)
        {
            <p class="admrec-message @(plan.Status == LibraryReconciliationPlanStatus.Stale ? "admrec-error" : "")">@(plan.Status == LibraryReconciliationPlanStatus.Stale ? ui["admin.reconciliation.staleScan"] : ui["admin.reconciliation.inventoryPending"])</p>
            <div class="admrec-footer">
                <a class="button" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-step="1">@ui["common.back"]</a>
                <span></span>
            </div>
        }
        else if (Model.CurrentStep == 2)
        {
            <section class="admrec-structure-grid" aria-label="@ui["admin.reconciliation.step.structure"]">
                <nav class="admrec-tree" aria-label="@ui["admin.reconciliation.step.structure"]">
                    <div class="admrec-tree-tools">
                        <button class="button" type="button" data-tree-toggle="open">@ui["admin.reconciliation.expandAll"]</button>
                        <button class="button" type="button" data-tree-toggle="close">@ui["admin.reconciliation.collapseAll"]</button>
                    </div>
                    <ul>
                        @foreach (var node in Model.Tree)
                        {
                            <partial name="_ReconciliationTreeNode" model="new Jularr.Web.Pages.Admin.Reconciliation.IndexModel.ReconciliationTreeNodeRender(node, plan.Id, selectedPath, Model.GetStatePresentation)" />
                        }
                    </ul>
                </nav>
                <aside class="admrec-detail" aria-live="polite">
                    @if (Model.SelectedItem is { } selected)
                    {
                        var selectedState = Model.GetStatePresentation(selected.State);
                        <h3><code>@selected.RelativePath</code> <span class="admrec-state @selectedState.CssClass">@selectedState.Text</span></h3>
                        <dl>
                            @if (Model.SelectedWork is { } assignedWork)
                            {
                                <div>
                                    <dt>@ui["admin.reconciliation.mappedWork"]</dt>
                                    <dd>@assignedWork.Title@(assignedWork.Year is { } year ? $" ({year})" : string.Empty)@if (assignedWork.IsInherited) { <small> · @ui.Format("admin.reconciliation.inheritedWork", ("path", assignedWork.SourcePath))</small> }</dd>
                                </div>
                            }
                            <div><dt>@ui["admin.reconciliation.confidence"]</dt><dd><meter min="0" max="100" value="@selected.Confidence" aria-label="@ui["admin.reconciliation.confidence"]"></meter> @selected.Confidence%</dd></div>
                            <div><dt>@ui["admin.reconciliation.evidence"]</dt><dd>@selected.DetectionSummary</dd></div>
                            @if (selected.IsDirectory)
                            {
                                <div><dt>@ui["admin.reconciliation.filesInFolder"]</dt><dd>@selected.FileCount</dd></div>
                                <div><dt>@ui["admin.reconciliation.unresolvedInFolder"]</dt><dd>@selected.UnresolvedCount</dd></div>
                            }
                        </dl>
                        @if (selected.IsDirectory)
                        {
                            @if (Model.SelectedFolderFiles.Count > 0)
                            {
                                <div class="admrec-table-wrap">
                                    <table class="admrec-table admrec-stack-table">
                                        <thead><tr><th>@ui["admin.reconciliation.file"]</th><th>@ui["admin.reconciliation.confidence"]</th><th>@ui["admin.reconciliation.state"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var file in Model.SelectedFolderFiles)
                                            {
                                                var fileState = Model.GetStatePresentation(file.State);
                                                <tr>
                                                    <td data-label="@ui["admin.reconciliation.file"]"><code>@file.RelativePath.Split('/').Last()</code></td>
                                                    <td data-label="@ui["admin.reconciliation.confidence"]">@(file.Confidence > 0 ? file.Confidence + "%" : "—")</td>
                                                    <td data-label="@ui["admin.reconciliation.state"]"><span class="admrec-state @fileState.CssClass">@fileState.Text</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (Model.LogicalGroups.Count > 0)
                            {
                                <ul class="admrec-group-list">
                                    @foreach (var group in Model.LogicalGroups)
                                    {
                                        <li>@group.Name <span>@group.FileCount @ui["admin.reconciliation.files"]</span></li>
                                    }
                                </ul>
                            }
                        }
                        <div class="admrec-actions">
                            <a class="button button-primary" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" asp-route-step="3">@ui["admin.reconciliation.step.mapping"]</a>
                        </div>
                    }
                    else
                    {
                        <p>@ui["admin.reconciliation.selectFolder"]</p>
                    }
                </aside>
            </section>
            <div class="admrec-footer">
                <a class="button" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-step="1">@ui["common.back"]</a>
                <a class="button button-primary" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@selectedPath" asp-route-step="@(selectedPath is null ? 4 : 3)">@ui["admin.reconciliation.next"]</a>
            </div>
        }
        else if (Model.CurrentStep == 3)
        {
            @if (Model.SelectedItem is not { } selected || Model.ScopeItem is not { } scope)
            {
                <p class="admrec-message">@ui["admin.reconciliation.selectFolder"]</p>
            }
            else
            {
                var scopeState = Model.GetStatePresentation(scope.State);
                var inherited = selected.IsDirectory ? Model.ResolvedReleaseMetadata : null;
                <section class="admrec-panel" aria-label="@ui["admin.reconciliation.step.mapping"]">
                    <div class="admrec-panel-heading">
                        <h2><code>@scope.RelativePath</code> <span class="admrec-state @scopeState.CssClass">@scopeState.Text</span></h2>
                        @if (!selected.IsDirectory)
                        {
                            <a class="button" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@scope.RelativePath" asp-route-step="3">@ui["admin.reconciliation.folderDefaults"]</a>
                        }
                    </div>

                    @if (selected.IsDirectory && selected.State != LibraryReconciliationItemState.Ignored)
                    {
                        <div class="admrec-defaults">
                            <div class="admrec-defaults-work">
                                @if (Model.SelectedWork is { } folderWork)
                                {
                                    <p><strong>@ui["admin.reconciliation.mappedWork"]</strong><span aria-hidden="true"> · </span>@folderWork.Title@(folderWork.Year is { } folderYear ? $" ({folderYear})" : string.Empty)</p>
                                    @if (folderWork.IsInherited)
                                    {
                                        <p class="admrec-hint">@ui.Format("admin.reconciliation.inheritedWork", ("path", folderWork.SourcePath))</p>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="ResetWork" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath">
                                            <input type="hidden" name="itemId" value="@selected.Id" />
                                            <button class="button" type="submit">@ui["admin.reconciliation.resetWork"]</button>
                                        </form>
                                    }
                                }
                                <form method="get" class="admrec-inline-form">
                                    <input type="hidden" name="planId" value="@plan.Id" />
                                    <input type="hidden" name="selected" value="@selected.RelativePath" />
                                    <input type="hidden" name="step" value="3" />
                                    <label>
                                        <span>@ui["admin.reconciliation.workSearch"]</span>
                                        <input asp-for="WorkQuery" maxlength="300" autocomplete="off" />
                                    </label>
                                    <button class="button" type="submit">@ui["admin.reconciliation.search"]</button>
                                </form>
                                @if (!string.IsNullOrWhiteSpace(Model.WorkQuery) && Model.WorkCandidates.Count == 0)
                                {
                                    <p class="admrec-hint">@ui["admin.reconciliation.noWorks"]</p>
                                }
                                @if (Model.WorkCandidates.Count > 0)
                                {
                                    <form method="post" asp-page-handler="AssignWork" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" class="admrec-inline-form">
                                        <input type="hidden" name="itemIds" value="@selected.Id" />
                                        <label>
                                            <span>@ui["admin.reconciliation.selectWork"]</span>
                                            <select name="workId" required>
                                                @foreach (var candidate in Model.WorkCandidates)
                                                {
                                                    <option value="@candidate.Id">@candidate.Title@(candidate.Year is { } candidateYear ? $" ({candidateYear})" : string.Empty)</option>
                                                }
                                            </select>
                                        </label>
                                        <button class="button button-primary" type="submit">@ui["admin.reconciliation.chooseWork"]</button>
                                    </form>
                                }
                            </div>
                            @if (Model.SelectedWork is not null)
                            {
                                <form method="post" asp-page-handler="AssignReleaseMetadata" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" class="admrec-defaults-release">
                                    <input type="hidden" name="itemId" value="@selected.Id" />
                                    <label>
                                        <span>@ui["admin.reconciliation.edition"]</span>
                                        <select name="editionId"><option value="">@ui["admin.reconciliation.unassigned"]</option>@foreach (var edition in Model.EditionCandidates) { <option value="@edition.Id" selected="@edition.IsAssigned">@edition.EditionKey · @edition.Language@(string.IsNullOrWhiteSpace(edition.Format) ? string.Empty : " · " + edition.Format)</option> }</select>
                                    </label>
                                    <label>
                                        <span>@ui["admin.reconciliation.version"]</span>
                                        <select name="versionId"><option value="">@ui["admin.reconciliation.unassigned"]</option>@foreach (var version in Model.VersionCandidates) { <option value="@version.Id" selected="@version.IsAssigned">@version.VersionKey@(string.IsNullOrWhiteSpace(version.UnitKey) ? string.Empty : " · " + version.UnitKey)</option> }</select>
                                    </label>
                                    <label><span>@ui["admin.reconciliation.language"]</span><input name="language" maxlength="32" value="@selected.Language" placeholder="@inherited?.Language" /></label>
                                    <label><span>@ui["admin.reconciliation.audioLanguage"]</span><input name="audioLanguage" maxlength="32" value="@selected.AudioLanguage" placeholder="@inherited?.AudioLanguage" /></label>
                                    <label><span>@ui["admin.reconciliation.subtitleLanguage"]</span><input name="subtitleLanguage" maxlength="32" value="@selected.SubtitleLanguage" placeholder="@inherited?.SubtitleLanguage" /></label>
                                    <label><span>@ui["admin.reconciliation.qualitySource"]</span><input name="qualitySource" maxlength="240" value="@selected.QualitySource" placeholder="@inherited?.QualitySource" /></label>
                                    <div class="admrec-actions"><button class="button button-primary" type="submit">@ui["admin.reconciliation.saveReleaseMetadata"]</button></div>
                                </form>
                                @if (inherited is not null && new[] { inherited.EditionSourcePath, inherited.VersionSourcePath, inherited.LanguageSourcePath, inherited.AudioLanguageSourcePath, inherited.SubtitleLanguageSourcePath, inherited.QualitySourcePath }.Any(x => !string.IsNullOrWhiteSpace(x) && x != selected.RelativePath))
                                {
                                    <ul class="admrec-group-list admrec-inherited-list">
                                        @if (inherited.EditionSourcePath is { } editionSource && editionSource != selected.RelativePath) { <li>@ui["admin.reconciliation.edition"] <code>@editionSource</code></li> }
                                        @if (inherited.VersionSourcePath is { } versionSource && versionSource != selected.RelativePath) { <li>@ui["admin.reconciliation.version"] <code>@versionSource</code></li> }
                                        @if (inherited.LanguageSourcePath is { } languageSource && languageSource != selected.RelativePath) { <li>@ui["admin.reconciliation.language"] <code>@languageSource</code></li> }
                                        @if (inherited.AudioLanguageSourcePath is { } audioSource && audioSource != selected.RelativePath) { <li>@ui["admin.reconciliation.audioLanguage"] <code>@audioSource</code></li> }
                                        @if (inherited.SubtitleLanguageSourcePath is { } subtitleSource && subtitleSource != selected.RelativePath) { <li>@ui["admin.reconciliation.subtitleLanguage"] <code>@subtitleSource</code></li> }
                                        @if (inherited.QualitySourcePath is { } qualitySource && qualitySource != selected.RelativePath) { <li>@ui["admin.reconciliation.qualitySource"] <code>@qualitySource</code></li> }
                                    </ul>
                                }
                            }
                        </div>
                    }

                    @if (Model.ScopeFiles.Count == 0)
                    {
                        <p class="admrec-message">@ui["admin.reconciliation.noItems"]</p>
                    }
                    else
                    {
                        <form method="post" asp-route-planId="@plan.Id" class="admrec-files-form">
                            <input type="hidden" name="planId" value="@plan.Id" />
                            <input type="hidden" name="selected" value="@selected.RelativePath" />
                            <div class="admrec-batch">
                                <label><span>@ui["admin.reconciliation.language"]</span><input name="language" maxlength="32" /></label>
                                <label><span>@ui["admin.reconciliation.audioLanguage"]</span><input name="audioLanguage" maxlength="32" /></label>
                                <label><span>@ui["admin.reconciliation.subtitleLanguage"]</span><input name="subtitleLanguage" maxlength="32" /></label>
                                <label><span>@ui["admin.reconciliation.qualitySource"]</span><input name="qualitySource" maxlength="240" /></label>
                                <button class="button" type="submit" asp-page-handler="AssignBatchReleaseMetadata">@ui["admin.reconciliation.applyReleaseDefaults"]</button>
                            </div>
                            @if (Model.EpisodeCandidates.Count > 0)
                            {
                                <div class="admrec-batch">
                                    <label>
                                        <span>@ui["admin.reconciliation.sequenceStartEpisode"]</span>
                                        <select name="startEpisodeId">
                                            @foreach (var episode in Model.EpisodeCandidates)
                                            {
                                                <option value="@episode.Id">S@episode.SeasonNumber.ToString("D2") E@episode.EpisodeNumber.ToString("D2")@(episode.IsSpecial ? " · Special" : string.Empty)@(string.IsNullOrWhiteSpace(episode.Title) ? string.Empty : " · " + episode.Title)</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        <span>@ui["admin.reconciliation.sequenceEndEpisode"]</span>
                                        <select name="endEpisodeId">
                                            <option value="">@ui["admin.reconciliation.sequenceEndEpisodeAutomatic"]</option>
                                            @foreach (var episode in Model.EpisodeCandidates)
                                            {
                                                <option value="@episode.Id">S@episode.SeasonNumber.ToString("D2") E@episode.EpisodeNumber.ToString("D2")@(episode.IsSpecial ? " · Special" : string.Empty)@(string.IsNullOrWhiteSpace(episode.Title) ? string.Empty : " · " + episode.Title)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="button" type="submit" asp-page-handler="AssignEpisodeSequence">@ui["admin.reconciliation.assignEpisodeSequence"]</button>
                                </div>
                                <p class="admrec-hint">@ui["admin.reconciliation.episodeSequenceHint"]</p>
                            }
                            @if (Model.WorkCandidates.Count > 0)
                            {
                                <div class="admrec-batch">
                                    <label>
                                        <span>@ui["admin.reconciliation.selectWork"]</span>
                                        <select name="workId">
                                            @foreach (var candidate in Model.WorkCandidates)
                                            {
                                                <option value="@candidate.Id">@candidate.Title@(candidate.Year is { } candidateYear ? $" ({candidateYear})" : string.Empty)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="button" type="submit" asp-page-handler="AssignWork">@ui["admin.reconciliation.mapSelected"]</button>
                                </div>
                            }
                            <div class="admrec-batch">
                                <label><span>@ui["admin.reconciliation.groupName"]</span><input name="groupName" maxlength="160" /></label>
                                <button class="button" type="submit" asp-page-handler="CreateLogicalGroup">@ui["admin.reconciliation.createGroup"]</button>
                                <button class="button" type="submit" asp-page-handler="ClearLogicalGroup">@ui["admin.reconciliation.clearGroup"]</button>
                                <button class="button" type="submit" asp-page-handler="SetIgnored" name="isIgnored" value="true">@ui["admin.reconciliation.skipFiles"]</button>
                                <button class="button" type="submit" asp-page-handler="SetIgnored" name="isIgnored" value="false">@ui["admin.reconciliation.restoreFile"]</button>
                                <button class="button" type="submit" asp-page-handler="ResetWorks">@ui["admin.reconciliation.resetSelected"]</button>
                            </div>
                            <div class="admrec-table-wrap">
                                <table class="admrec-table admrec-stack-table admrec-file-table">
                                    <thead>
                                        <tr>
                                            <th><span class="admrec-visually-hidden">@ui["admin.reconciliation.selectEntry"]</span></th>
                                            <th>@ui["admin.reconciliation.file"]</th>
                                            <th>@ui["admin.reconciliation.detected"]</th>
                                            <th>@ui["admin.reconciliation.unit"]</th>
                                            <th>@ui["admin.reconciliation.qualitySource"]</th>
                                            <th>@ui["admin.reconciliation.language"]</th>
                                            <th>@ui["admin.reconciliation.audioLanguage"]</th>
                                            <th>@ui["admin.reconciliation.subtitleLanguage"]</th>
                                            <th>@ui["admin.reconciliation.logicalGroup"]</th>
                                            <th>@ui["admin.reconciliation.state"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var file in Model.ScopeFiles)
                                        {
                                            var fileState = Model.GetStatePresentation(file.State);
                                            var unit = UnitText(file);
                                            var groupName = Model.LogicalGroups.SingleOrDefault(group => group.Id == file.LogicalGroupId)?.Name;
                                            <tr class="@(file.Id == selected.Id ? "selected" : "")">
                                                <td><input type="checkbox" name="itemIds" value="@file.Id" aria-label="@file.RelativePath" /></td>
                                                <td data-label="@ui["admin.reconciliation.file"]"><a asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@file.RelativePath" asp-route-step="3"><code>@file.RelativePath[(scope.RelativePath.Length == 0 ? 0 : scope.RelativePath.Length + 1)..]</code></a></td>
                                                <td data-label="@ui["admin.reconciliation.detected"]">@(file.Confidence > 0 ? file.Confidence + "%" : "—")</td>
                                                <td data-label="@ui["admin.reconciliation.unit"]">@(unit.Length > 0 ? unit : "—")</td>
                                                <td data-label="@ui["admin.reconciliation.qualitySource"]">@if (!string.IsNullOrWhiteSpace(file.QualitySource)) { @file.QualitySource } else if (!string.IsNullOrWhiteSpace(inherited?.QualitySource)) { <span class="admrec-inherited" title="@ui["admin.reconciliation.inherited"]">@inherited.QualitySource</span> } else { <text>—</text> }</td>
                                                <td data-label="@ui["admin.reconciliation.language"]">@if (!string.IsNullOrWhiteSpace(file.Language)) { @file.Language } else if (!string.IsNullOrWhiteSpace(inherited?.Language)) { <span class="admrec-inherited" title="@ui["admin.reconciliation.inherited"]">@inherited.Language</span> } else { <text>—</text> }</td>
                                                <td data-label="@ui["admin.reconciliation.audioLanguage"]">@if (!string.IsNullOrWhiteSpace(file.AudioLanguage)) { @file.AudioLanguage } else if (!string.IsNullOrWhiteSpace(inherited?.AudioLanguage)) { <span class="admrec-inherited" title="@ui["admin.reconciliation.inherited"]">@inherited.AudioLanguage</span> } else { <text>—</text> }</td>
                                                <td data-label="@ui["admin.reconciliation.subtitleLanguage"]">@if (!string.IsNullOrWhiteSpace(file.SubtitleLanguage)) { @file.SubtitleLanguage } else if (!string.IsNullOrWhiteSpace(inherited?.SubtitleLanguage)) { <span class="admrec-inherited" title="@ui["admin.reconciliation.inherited"]">@inherited.SubtitleLanguage</span> } else { <text>—</text> }</td>
                                                <td data-label="@ui["admin.reconciliation.logicalGroup"]">@(groupName ?? "—")</td>
                                                <td data-label="@ui["admin.reconciliation.state"]"><span class="admrec-state @fileState.CssClass">@fileState.Text</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    }

                    @if (!selected.IsDirectory && selected.State != LibraryReconciliationItemState.Ignored)
                    {
                        <div class="admrec-file-edit">
                            <p><code>@selected.RelativePath</code></p>
                            @if (Model.SelectedWork is null)
                            {
                                <p class="admrec-hint">@ui["admin.reconciliation.fileNeedsWork"]</p>
                            }
                            @if (Model.EpisodeCandidates.Count > 0)
                            {
                                <form method="post" asp-page-handler="AssignEpisode" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" class="admrec-inline-form">
                                    <input type="hidden" name="itemId" value="@selected.Id" />
                                    <label>
                                        <span>@ui["admin.reconciliation.episode"]</span>
                                        <select name="episodeId">
                                            <option value="">@ui["admin.reconciliation.unassigned"]</option>
                                            @foreach (var episode in Model.EpisodeCandidates)
                                            {
                                                <option value="@episode.Id" selected="@episode.IsAssigned">S@episode.SeasonNumber.ToString("D2") E@episode.EpisodeNumber.ToString("D2")@(episode.IsSpecial ? " · Special" : string.Empty)@(string.IsNullOrWhiteSpace(episode.Title) ? string.Empty : " · " + episode.Title)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="button" type="submit">@ui["admin.reconciliation.selectEpisode"]</button>
                                </form>
                            }
                            @if (Model.VolumeCandidates.Count > 0)
                            {
                                <form method="post" asp-page-handler="AssignVolume" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" class="admrec-inline-form">
                                    <input type="hidden" name="itemId" value="@selected.Id" />
                                    <label>
                                        <span>@ui["admin.reconciliation.volume"]</span>
                                        <select name="volumeId">
                                            <option value="">@ui["admin.reconciliation.unassigned"]</option>
                                            @foreach (var volume in Model.VolumeCandidates)
                                            {
                                                <option value="@volume.Id" selected="@volume.IsAssigned">V@volume.Number.ToString("D2")@(string.IsNullOrWhiteSpace(volume.Title) ? string.Empty : " · " + volume.Title)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="button" type="submit">@ui["admin.reconciliation.selectVolume"]</button>
                                </form>
                            }
                            @if (Model.ChapterCandidates.Count > 0)
                            {
                                <form method="post" asp-page-handler="AssignChapter" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" class="admrec-inline-form">
                                    <input type="hidden" name="itemId" value="@selected.Id" />
                                    <label>
                                        <span>@ui["admin.reconciliation.chapter"]</span>
                                        <select name="chapterId">
                                            <option value="">@ui["admin.reconciliation.unassigned"]</option>
                                            @foreach (var chapter in Model.ChapterCandidates)
                                            {
                                                <option value="@chapter.Id" selected="@chapter.IsAssigned">C@chapter.Number.ToString("0.##")@(string.IsNullOrWhiteSpace(chapter.Title) ? string.Empty : " · " + chapter.Title)</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="button" type="submit">@ui["admin.reconciliation.selectChapter"]</button>
                                </form>
                            }
                            @if (Model.SelectedWork is not null)
                            {
                                <form method="post" asp-page-handler="AssignReleaseMetadata" asp-route-planId="@plan.Id" asp-route-selected="@selected.RelativePath" class="admrec-defaults-release">
                                    <input type="hidden" name="itemId" value="@selected.Id" />
                                    <label>
                                        <span>@ui["admin.reconciliation.edition"]</span>
                                        <select name="editionId"><option value="">@ui["admin.reconciliation.unassigned"]</option>@foreach (var edition in Model.EditionCandidates) { <option value="@edition.Id" selected="@edition.IsAssigned">@edition.EditionKey · @edition.Language@(string.IsNullOrWhiteSpace(edition.Format) ? string.Empty : " · " + edition.Format)</option> }</select>
                                    </label>
                                    <label>
                                        <span>@ui["admin.reconciliation.version"]</span>
                                        <select name="versionId"><option value="">@ui["admin.reconciliation.unassigned"]</option>@foreach (var version in Model.VersionCandidates) { <option value="@version.Id" selected="@version.IsAssigned">@version.VersionKey@(string.IsNullOrWhiteSpace(version.UnitKey) ? string.Empty : " · " + version.UnitKey)</option> }</select>
                                    </label>
                                    <label><span>@ui["admin.reconciliation.language"]</span><input name="language" maxlength="32" value="@selected.Language" /></label>
                                    <label><span>@ui["admin.reconciliation.audioLanguage"]</span><input name="audioLanguage" maxlength="32" value="@selected.AudioLanguage" /></label>
                                    <label><span>@ui["admin.reconciliation.subtitleLanguage"]</span><input name="subtitleLanguage" maxlength="32" value="@selected.SubtitleLanguage" /></label>
                                    <label><span>@ui["admin.reconciliation.qualitySource"]</span><input name="qualitySource" maxlength="240" value="@selected.QualitySource" /></label>
                                    <div class="admrec-actions"><button class="button button-primary" type="submit">@ui["admin.reconciliation.saveReleaseMetadata"]</button></div>
                                </form>
                            }
                        </div>
                    }
                </section>
            }
            <div class="admrec-footer">
                <a class="button" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@selectedPath" asp-route-step="2">@ui["common.back"]</a>
                <a class="button button-primary" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-step="4">@ui["admin.reconciliation.next"]</a>
            </div>
        }
        else if (Model.CurrentStep == 4)
        {
            var exampleTarget = Model.OrganizationPreviewItem?.TargetRelativePath;
            var targetFolderSeparator = exampleTarget?.LastIndexOf('/') ?? -1;
            <form method="post" asp-page-handler="SetOrganizationMode" asp-route-planId="@plan.Id" class="admrec-organization">
                <fieldset class="admrec-modes">
                    <legend class="admrec-visually-hidden">@ui["admin.reconciliation.organization"]</legend>
                    @foreach (var mode in new[]
                    {
                        (LibraryReconciliationOrganizationMode.AssignOnly, "assignOnly"),
                        (LibraryReconciliationOrganizationMode.RenameFiles, "renameFiles"),
                        (LibraryReconciliationOrganizationMode.RenameFoldersAndFiles, "renameFoldersAndFiles"),
                        (LibraryReconciliationOrganizationMode.OrganizeCanonical, "organizeCanonical")
                    })
                    {
                        <label class="admrec-mode @(plan.OrganizationMode == mode.Item1 ? "selected" : "")">
                            <input type="radio" name="organizationMode" value="@mode.Item1" checked="@(plan.OrganizationMode == mode.Item1)" />
                            <span><strong>@ui["admin.reconciliation." + mode.Item2]</strong><small>@ui["admin.reconciliation." + mode.Item2 + "Hint"]</small></span>
                        </label>
                    }
                </fieldset>
                <div class="admrec-naming">
                    <dl>
                        @if (Model.OrganizationPreviewItem is { } organizationPreview)
                        {
                            <div><dt>@ui["admin.reconciliation.namingExample"]</dt><dd><code>@organizationPreview.RelativePath</code> → <code>@(exampleTarget ?? organizationPreview.RelativePath)</code></dd></div>
                            @if (exampleTarget is not null && targetFolderSeparator > 0)
                            {
                                <div><dt>@ui["admin.reconciliation.targetFolder"]</dt><dd><code>@exampleTarget[..(targetFolderSeparator + 1)]</code></dd></div>
                            }
                        }
                        else
                        {
                            <div><dd>@ui["admin.reconciliation.namingPreviewUnavailable"]</dd></div>
                        }
                    </dl>
                    <fieldset>
                        <label><input type="checkbox" name="removeEmptySourceFolders" value="true" checked="@plan.RemoveEmptySourceFolders" /> @ui["admin.reconciliation.removeEmptySourceFolders"]</label>
                        <label><input type="checkbox" checked disabled /> @ui["admin.reconciliation.verifyDestinationConflicts"]</label>
                        <label><input type="checkbox" checked disabled /> @ui["admin.reconciliation.reportDuplicateTargets"]</label>
                    </fieldset>
                    <div class="admrec-actions"><button class="button" type="submit">@ui["admin.reconciliation.saveOrganization"]</button></div>
                </div>
            </form>
            <div class="admrec-footer">
                <a class="button" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-selected="@selectedPath" asp-route-step="3">@ui["common.back"]</a>
                <a class="button button-primary" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-step="5">@ui["admin.reconciliation.next"]</a>
            </div>
        }
        else
        {
            @if (plan.Status == LibraryReconciliationPlanStatus.Completed)
            {
                <p class="admrec-message" role="status">@ui["admin.reconciliation.executionCompleted"]</p>
            }
            @if (plan.ExecutionOperationId is { } executionOperationId)
            {
                <p><a class="button" asp-page="/Admin/Operation" asp-route-id="@executionOperationId">@ui["admin.reconciliation.openOperation"]</a></p>
            }
            @if (Model.Preview is not { } preview || preview.Items.Count == 0)
            {
                <p class="admrec-message">@ui["admin.reconciliation.noItems"]</p>
            }
            else
            {
                <dl class="admrec-counts" aria-label="@ui["admin.reconciliation.previewSummary"]">
                    <div><dt>@ui["admin.reconciliation.previewAssign"]</dt><dd>@preview.AssignmentsOnly</dd></div>
                    <div><dt>@ui["admin.reconciliation.previewRename"]</dt><dd>@preview.Renames</dd></div>
                    <div><dt>@ui["admin.reconciliation.previewMove"]</dt><dd>@preview.Moves</dd></div>
                    <div><dt>@ui["admin.reconciliation.previewIgnored"]</dt><dd>@preview.Ignored</dd></div>
                    <div class="@(preview.Conflicts > 0 ? "error" : "")"><dt>@ui["admin.reconciliation.previewConflict"]</dt><dd>@preview.Conflicts</dd></div>
                    <div class="@(preview.Unresolved > 0 ? "unclear" : "")"><dt>@ui["admin.reconciliation.unresolved"]</dt><dd>@preview.Unresolved</dd></div>
                </dl>
                <div class="admrec-preview-grid">
                    <div class="admrec-table-wrap">
                        <table class="admrec-table admrec-stack-table">
                            <thead><tr><th>@ui["admin.reconciliation.previewOld"]</th><th>@ui["admin.reconciliation.previewNew"]</th><th>@ui["admin.reconciliation.previewAction"]</th><th>@ui["admin.reconciliation.state"]</th></tr></thead>
                            <tbody>
                                @foreach (var item in preview.Items)
                                {
                                    var action = Model.GetPreviewActionPresentation(item.Action);
                                    var isBlocked = item.Action is LibraryReconciliationPreviewAction.Blocked or LibraryReconciliationPreviewAction.Conflict;
                                    <tr>
                                        <td data-label="@ui["admin.reconciliation.previewOld"]"><code>@item.RelativePath</code></td>
                                        <td data-label="@ui["admin.reconciliation.previewNew"]"><code>@(item.TargetRelativePath ?? "—")</code></td>
                                        <td data-label="@ui["admin.reconciliation.previewAction"]"><span class="admrec-state @action.CssClass">@action.Text</span></td>
                                        <td data-label="@ui["admin.reconciliation.state"]">@(isBlocked ? item.Reason : ui["admin.reconciliation.ready"])</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="admrec-preview-side">
                        @if (preview.Conflicts > 0)
                        {
                            <section class="admrec-preview-notice admrec-error" aria-labelledby="admrec-conflicts-title">
                                <h3 id="admrec-conflicts-title">@ui.Format("admin.reconciliation.previewConflictsHeading", ("count", preview.Conflicts))</h3>
                                <ul>
                                    @foreach (var item in preview.Items.Where(x => x.Action == LibraryReconciliationPreviewAction.Conflict).Take(10))
                                    {
                                        <li><code>@item.RelativePath</code><span> · </span>@item.Reason</li>
                                    }
                                </ul>
                            </section>
                        }
                        @if (preview.Unresolved > 0)
                        {
                            <section class="admrec-preview-notice" aria-labelledby="admrec-hints-title">
                                <h3 id="admrec-hints-title">@ui.Format("admin.reconciliation.previewHintsHeading", ("count", preview.Unresolved))</h3>
                                <ul>
                                    @foreach (var item in preview.Items.Where(x => x.Action == LibraryReconciliationPreviewAction.Blocked).Take(10))
                                    {
                                        <li><code>@item.RelativePath</code><span> · </span>@item.Reason</li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                </div>
            }
            <div class="admrec-footer">
                <a class="button" asp-page="/Admin/Reconciliation/Index" asp-route-planId="@plan.Id" asp-route-step="4">@ui["common.back"]</a>
                @if (Model.Preview is { } executablePreview)
                {
                    <div class="admrec-actions">
                        @if (plan.OrganizationMode != LibraryReconciliationOrganizationMode.AssignOnly)
                        {
                            <form method="post" asp-page-handler="SetOrganizationMode" asp-route-planId="@plan.Id">
                                <input type="hidden" name="organizationMode" value="@LibraryReconciliationOrganizationMode.AssignOnly" />
                                <input type="hidden" name="removeEmptySourceFolders" value="false" />
                                <input type="hidden" name="returnStep" value="5" />
                                <button class="button" type="submit">@ui["admin.reconciliation.assignOnlyWithoutFiles"]</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Execute" asp-route-planId="@plan.Id">
                            <input type="hidden" name="previewFingerprint" value="@executablePreview.Fingerprint" />
                            <button class="button button-primary" type="submit" disabled="@(!executablePreview.CanExecute)">@ui["admin.reconciliation.execute"]</button>
                        </form>
                    </div>
                }
            </div>
        }
    }
</main>

<partial name="_FolderBrowser" model="ui" />

@section Scripts {
    <script src="~/js/folder-browser.js" asp-append-version="true" defer></script>
    <script src="~/js/admin-reconciliation.js" asp-append-version="true" defer></script>
}
