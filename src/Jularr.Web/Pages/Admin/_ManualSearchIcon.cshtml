@model string
@* Small decorative outline glyph of a Manual Search tag; the label always sits next to it. *@
<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "eligible":
            <path d="m3.5 8.5 3 3 6-7" />
            break;
        case "warning":
            <path d="M8 2.75 14 13H2L8 2.75ZM8 6.75v3M8 11.5v.01" />
            break;
        case "rejected":
            <path d="m4.5 4.5 7 7M11.5 4.5l-7 7" />
            break;
        case "seasonPack":
            <path d="m8 2.5 5.5 2.75L8 8 2.5 5.25 8 2.5ZM2.5 8 8 10.75 13.5 8M2.5 10.75 8 13.5l5.5-2.75" />
            break;
        case "movie":
            <rect x="2.5" y="3.5" width="11" height="9" rx="1.5" />
            <path d="M2.5 6.5h11M5.5 3.5l-1 3M9 3.5l-1 3" />
            break;
        default:
            <path d="M4.5 2.75h5l2.5 2.5v7.5a.5.5 0 0 1-.5.5h-7a.5.5 0 0 1-.5-.5v-9.5a.5.5 0 0 1 .5-.5ZM9.5 2.75v2.5H12" />
            break;
    }
</svg>
