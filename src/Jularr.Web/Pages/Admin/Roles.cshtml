@page
@using Jularr.Web.Features.Auth
@model Jularr.Web.Pages.Admin.RolesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.roles.title"];
}

<header class="page-header">
    <div>
        <h1>@ui["admin.roles.title"]</h1>
        <p>@ui["admin.roles.subtitle"]</p>
    </div>
    <div class="inline-actions">
        <a class="button" asp-page="/Admin/Users">@ui["admin.user.backToUsers"]</a>
        <a class="button" asp-page="/Admin/Capabilities/Index">@ui["admin.capabilities.title"]</a>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<section class="role-overview-grid" data-admin-roles>
    @foreach (var role in Model.Roles)
    {
        var isOwner = role.Role == AccountRole.Owner;
        <article class="panel role-overview-card">
            <div class="panel-heading">
                <div>
                    <h2>@ui[AccountRoles.LabelKey(role.Role)]</h2>
                    <span>@role.AccountCount · @ui["admin.users.accounts"]</span>
                </div>
                @if (isOwner)
                {
                    <span class="status-pill">@ui["admin.roles.fixed"]</span>
                }
            </div>

            <p class="muted">@ui[$"admin.roles.description.{role.Role}"]</p>

            <div class="role-policy-list">
                @if (role.Policies.Count == 0)
                {
                    <span class="muted">@ui["admin.roles.noAdminPolicies"]</span>
                }
                else
                {
                    @foreach (var policy in role.Policies)
                    {
                        <span class="status-pill">@ui[JularrPolicies.LabelKey(policy)]</span>
                    }
                }
            </div>

            @if (!isOwner)
            {
                <div class="inline-actions">
                    <a class="button"
                       asp-page="/Admin/Capabilities/Index">@ui["admin.roles.editMediaDefaults"]</a>
                </div>
            }
        </article>
    }
</section>

<section class="panel">
    <div class="panel-heading"><h2>@ui["admin.roles.assignment"]</h2></div>
    <p class="muted">@ui["admin.roles.assignmentHint"]</p>
    <a class="button button-primary" asp-page="/Admin/Users">@ui["admin.nav.users"]</a>
</section>
