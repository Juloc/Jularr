@page "{id}"
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Auth
@model Jularr.Web.Pages.Admin.UserModel
@{
    var ui = Model.Ui;
    var account = Model.Account;
    var roleLabel = ui[AccountRoles.LabelKey(account.Role)];
    ViewData["Title"] = ui.Format("admin.user.manageTitle", ("userName", account.UserName));
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-sessions.css" asp-append-version="true" />
}

<header class="page-header admin-user-header">
    <div>
        <h1>@account.UserName</h1>
        <div class="admin-user-heading-meta">
            <span class="status-pill">@roleLabel</span>
            <span class="status-pill @(account.IsEnabled ? "status-ok" : "status-warn")">
                @(account.IsEnabled ? ui["admin.user.enabledLabel"] : ui["admin.user.disabledPendingLabel"])
            </span>
        </div>
    </div>
    <a class="button" asp-page="/Admin/Users">@ui["admin.user.backToUsers"]</a>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div asp-validation-summary="ModelOnly" class="validation"></div>

<div class="settings-grid admin-user-detail-grid" data-admin-user-detail>
    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.user.account"]</h2></div>

        <div class="status-list">
            <div>
                <span>@ui["admin.user.role"]</span>
                <strong>@roleLabel</strong>
            </div>
            <div>
                <span>@ui["admin.operation.status"]</span>
                <strong>@(account.IsEnabled ? ui["admin.user.enabledLabel"] : ui["admin.user.disabledPendingLabel"])</strong>
            </div>
            <div>
                <span>@ui["admin.operation.created"]</span>
                <strong>@account.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</strong>
            </div>
        </div>

        <form method="post" asp-page-handler="Rename" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>@ui["admin.user.userNameLabel"]</span>
                <input name="userName"
                       value="@account.UserName"
                       maxlength="80"
                       autocomplete="username"
                       required />
            </label>
            <button class="button button-primary" type="submit">@ui["admin.user.renameUser"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.user.access"]</h2></div>

        @if (account.Role == AccountRole.Owner)
        {
            <p class="muted">@ui["admin.capabilities.ownerNote"]</p>
        }
        else
        {
            <form method="post" asp-page-handler="SetRole" class="form-stack">
                <input type="hidden" name="id" value="@account.Id" />
                <label>
                    <span>@ui["admin.user.role"]</span>
                    <select name="role">
                        @foreach (var role in new[] { AccountRole.User, AccountRole.MediaManager })
                        {
                            <option value="@role" selected="@(account.Role == role)">@ui[AccountRoles.LabelKey(role)]</option>
                        }
                    </select>
                </label>
                <button class="button" type="submit">@ui["admin.users.saveRole"]</button>
            </form>

            <div class="admin-user-access-actions">
                <form method="post" asp-page-handler="SetEnabled">
                    <input type="hidden" name="id" value="@account.Id" />
                    <input type="hidden" name="enabled" value="@(!account.IsEnabled)" />
                    <button class="button" type="submit">
                        @(account.IsEnabled ? ui["admin.user.disableUser"] : ui["admin.user.approveEnable"])
                    </button>
                </form>

                <a class="button"
                   asp-page="/Admin/Capabilities/Index"
                   asp-fragment="user-@account.Id">@ui["admin.capabilities.title"]</a>
            </div>
        }
    </section>

    <section class="panel admin-user-security">
        <div class="panel-heading"><h2>@ui["admin.user.security"]</h2></div>

        <form method="post" asp-page-handler="ResetPassword" class="form-stack">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>@ui["admin.user.newPassword"]</span>
                <input name="newPassword"
                       type="password"
                       minlength="12"
                       autocomplete="new-password"
                       required />
            </label>
            <button class="button" type="submit">@ui["admin.user.resetPassword"]</button>
        </form>

        <form method="post" asp-page-handler="InvalidateSessions" class="form-stack admin-user-session-action">
            <input type="hidden" name="id" value="@account.Id" />
            <p class="muted">@ui["admin.user.signOutAllDescription"]</p>
            <button class="button" type="submit">@ui["admin.user.signOutAllSessions"]</button>
        </form>
    </section>
</div>

@if (Model.ShowRequestPolicy)
{
    <section class="panel admin-user-request-policy" data-admin-user-request-policy>
        <div class="panel-heading">
            <div>
                <h2>@ui["admin.user.requestPolicy.title"]</h2>
                <span>@ui["admin.user.requestPolicy.subtitle"]</span>
            </div>
            <a class="button"
               asp-page="/Admin/Requests"
               asp-route-by="@account.Id"
               asp-fragment="auto-approval">@ui["admin.user.requestPolicy.manage"]</a>
        </div>

        @if (Model.RequestPolicyFailed)
        {
            <div class="empty-state" role="alert">
                <strong>@ui["admin.user.requestPolicy.unavailable"]</strong>
            </div>
        }
        else
        {
            <p class="muted">@ui["admin.user.requestPolicy.hint"]</p>

            <div class="capability-matrix-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>@ui["admin.capabilities.mediaTypeColumn"]</th>
                            <th>@ui["admin.user.requestPolicy.effective"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.RequestCapabilities)
                        {
                            var kindName = AcquisitionAccessNames.Kind(row.Kind);
                            <tr>
                                <td>@ui["admin.requests.kind." + kindName]</td>
                                <td>
                                    <span class="status-pill">
                                        @ui["admin.capabilities.level." + MediaCapabilityNames.ToStorage(row.Capability)]
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="admin-user-request-rules">
                <h3>@ui["admin.user.requestPolicy.autoApproval"]</h3>
                @if (Model.AutoApprovalRules.Count == 0)
                {
                    <p class="muted">@ui["admin.user.requestPolicy.noRules"]</p>
                }
                else
                {
                    <div class="user-admin-list">
                        @foreach (var rule in Model.AutoApprovalRules)
                        {
                            var media = rule.Kinds.Count == 0
                                ? ui["admin.requests.autoAllMedia"]
                                : string.Join(", ", rule.Kinds.Select(kind =>
                                    ui["admin.requests.kind." + AcquisitionAccessNames.Kind(kind)]));
                            var quota = rule.Quota is { } limit
                                ? ui.Format(
                                    "admin.requests.autoQuotaText",
                                    ("count", limit.MaxRequests),
                                    ("days", limit.PeriodDays))
                                : ui["admin.requests.autoNoLimit"];

                            <div class="user-admin-card admin-user-request-rule">
                                <div>
                                    <strong>@rule.Name</strong>
                                    <small>
                                        @(rule.AppliesToEveryone
                                            ? ui["admin.requests.autoEveryone"]
                                            : ui["admin.user.requestPolicy.thisUser"])
                                        · @media · @quota
                                    </small>
                                </div>
                                <span class="status-pill @(rule.Enabled ? "status-ok" : "status-warn")">
                                    @(rule.Enabled
                                        ? ui["admin.user.enabledLabel"]
                                        : ui["admin.requests.autoOff"])
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

<section class="panel admin-user-devices-sessions" data-admin-user-devices-sessions>
    <div class="panel-heading">
        <h2>@ui["admin.user.devicesSessions"]</h2>
    </div>

    <div class="admin-user-session-section">
        <h3>@ui["profile.devices.section.live"]</h3>
        @if (Model.Sessions.Count == 0)
        {
            <p class="muted">@ui["profile.devices.empty"]</p>
        }
        else
        {
            <div class="sessions-table-wrap">
                <table class="sessions-table">
                    <thead>
                        <tr>
                            <th>@ui["admin.sessions.column.title"]</th>
                            <th>@ui["admin.sessions.column.client"]</th>
                            <th>@ui["playback.diagnostics.mode"]</th>
                            <th>@ui["admin.sessions.column.started"]</th>
                            <th>@ui["admin.sessions.column.lastSeen"]</th>
                            <th>@ui["admin.sessions.column.actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.Sessions)
                        {
                            <tr class="@(session.IsTranscoding ? "session-row-transcoding" : "")">
                                <td data-label="@ui["admin.sessions.column.title"]">@session.Title</td>
                                <td data-label="@ui["admin.sessions.column.client"]">@session.ClientKind</td>
                                <td data-label="@ui["playback.diagnostics.mode"]">
                                    <span class="status-pill @(session.IsTranscoding ? "status-warn" : "status-ok")">@ui[session.PlaybackMethodKey]</span>
                                </td>
                                <td data-label="@ui["admin.sessions.column.started"]">@session.StartedAtUtc.ToLocalTime().ToString("g")</td>
                                <td data-label="@ui["admin.sessions.column.lastSeen"]">@session.LastSeenUtc.ToLocalTime().ToString("g")</td>
                                <td data-label="@ui["admin.sessions.column.actions"]">
                                    <form method="post" asp-page-handler="StopSession">
                                        <input type="hidden" name="id" value="@account.Id" />
                                        <input type="hidden" name="sessionId" value="@session.SessionId" />
                                        <button class="button" type="submit">@ui["profile.devices.stop"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="admin-user-session-section">
        <h3>@ui["profile.devices.section.known"]</h3>
        @if (Model.Devices.Count == 0)
        {
            <p class="muted">@ui["profile.devices.knownEmpty"]</p>
        }
        else
        {
            <div class="sessions-table-wrap">
                <table class="sessions-table">
                    <thead>
                        <tr>
                            <th>@ui["admin.devices.column.label"]</th>
                            <th>@ui["admin.devices.column.client"]</th>
                            <th>@ui["admin.devices.column.appVersion"]</th>
                            <th>@ui["admin.devices.column.status"]</th>
                            <th>@ui["admin.devices.column.lastSeen"]</th>
                            <th>@ui["admin.devices.column.actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in Model.Devices)
                        {
                            <tr>
                                <td data-label="@ui["admin.devices.column.label"]">@(device.Label ?? "—")</td>
                                <td data-label="@ui["admin.devices.column.client"]">@device.ClientKind</td>
                                <td data-label="@ui["admin.devices.column.appVersion"]">@(device.AppVersion ?? "—")</td>
                                <td data-label="@ui["admin.devices.column.status"]">
                                    <span class="status-pill @device.StatusPillClass">@ui[device.StatusLabelKey]</span>
                                </td>
                                <td data-label="@ui["admin.devices.column.lastSeen"]">@device.LastSeenUtc.ToLocalTime().ToString("g")</td>
                                <td data-label="@ui["admin.devices.column.actions"]">
                                    <form method="post" asp-page-handler="RevokeDevice">
                                        <input type="hidden" name="id" value="@account.Id" />
                                        <input type="hidden" name="deviceId" value="@device.Id" />
                                        <button class="button" type="submit">@ui["profile.devices.revoke"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@if (account.Role != AccountRole.Owner)
{
    <section class="panel admin-user-danger">
        <div class="panel-heading"><h2>@ui["admin.user.deleteUser"]</h2></div>
        <p class="muted">
            @ui["admin.user.deleteDescription1"]
            @ui.Format("admin.user.deleteDescription2", ("userName", account.UserName))
        </p>
        <form method="post" asp-page-handler="Delete" class="form-stack admin-user-delete-form">
            <input type="hidden" name="id" value="@account.Id" />
            <label>
                <span>@ui["admin.user.confirmationLabel"]</span>
                <input name="confirmation"
                       autocomplete="off"
                       placeholder="@account.UserName"
                       required />
            </label>
            <button class="button" type="submit">@ui["admin.user.deletePermanently"]</button>
        </form>
    </section>
}
