@page
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.MediaCore
@model Jularr.Web.Pages.Admin.MergeReview.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.mergeReview.title"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["admin.mergeReview.eyebrow"]</span>
        <h1>@ui["admin.mergeReview.title"]</h1>
        <p>@ui["admin.mergeReview.description"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Selected is { } work)
{
    <p><a asp-page="/Admin/MergeReview/Index">@ui["admin.mergeReview.back"]</a></p>

    <section class="panel">
        <div class="panel-heading">
            <h2>@work.CanonicalTitle</h2>
            <span>@WorkMediaTypes.ToStorage(work.MediaType)@(work.Year is { } y ? $" · {y}" : "")</span>
        </div>

        <h3>@ui["admin.mergeReview.work.identities"]</h3>
        <div class="status-list">
            @foreach (var identity in work.Identities)
            {
                <div>
                    <strong>@identity.Provider:@identity.ExternalId</strong>
                    <small>@WorkMediaTypes.ToStorage(identity.MediaType) · @identity.ReviewState@(identity.IsManualOverride ? " · " + ui["admin.mergeReview.work.manual"] : "")</small>
                    <form method="post" asp-page-handler="Split" class="inline-actions">
                        <input type="hidden" name="mediaType" value="@((int)identity.MediaType)" />
                        <input type="hidden" name="provider" value="@identity.Provider" />
                        <input type="hidden" name="externalId" value="@identity.ExternalId" />
                        <input type="hidden" name="workId" value="@work.Id" />
                        <label>@ui["admin.mergeReview.work.newTitle"]
                            <input type="text" name="newTitle" value="" />
                        </label>
                        <button class="button button-quiet" type="submit">@ui["admin.mergeReview.work.split"]</button>
                    </form>
                    <form method="post" asp-page-handler="Reassign" class="inline-actions">
                        <input type="hidden" name="mediaType" value="@((int)identity.MediaType)" />
                        <input type="hidden" name="provider" value="@identity.Provider" />
                        <input type="hidden" name="externalId" value="@identity.ExternalId" />
                        <input type="hidden" name="workId" value="@work.Id" />
                        <label>@ui["admin.mergeReview.work.targetWorkId"]
                            <input type="text" name="targetWorkId" value="" inputmode="text" />
                        </label>
                        <button class="button button-quiet" type="submit">@ui["admin.mergeReview.work.reassign"]</button>
                    </form>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.mergeReview.work.provenance"]</h2>
        </div>
        @if (Model.Provenance.Count == 0)
        {
            <p class="muted">—</p>
        }
        else
        {
            <div class="status-list">
                @foreach (var field in Model.Provenance)
                {
                    <div>
                        <strong>@field.FieldKey</strong>
                        <small>
                            @ui["admin.mergeReview.work.source"]: @field.Source
                            @if (field.IsManualOverride)
                            {
                                <text> · @ui["admin.mergeReview.work.manual"]</text>
                            }
                        </small>
                        @if (!field.IsManualOverride)
                        {
                            <form method="post" asp-page-handler="PinField">
                                <input type="hidden" name="workId" value="@work.Id" />
                                <input type="hidden" name="fieldKey" value="@field.FieldKey" />
                                <button class="button button-quiet" type="submit">@ui["admin.mergeReview.work.pin"]</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </section>
}
else
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.mergeReview.library.heading"]</h2>
            <form method="post" asp-page-handler="RunBackfill">
                <button class="button button-quiet" type="submit">@ui["admin.mergeReview.library.run"]</button>
            </form>
        </div>
        @if (Model.LibraryReview.Count == 0)
        {
            <p class="muted">@ui["admin.mergeReview.library.empty"]</p>
        }
        else
        {
            <div class="status-list">
                @foreach (var item in Model.LibraryReview)
                {
                    var reasonKey = item.Reason switch
                    {
                        LibraryWorkReviewReason.NoProviderIdentity => "admin.mergeReview.library.reason.noIdentity",
                        LibraryWorkReviewReason.ConflictingIdentities => "admin.mergeReview.library.reason.conflicting",
                        _ => "admin.mergeReview.library.reason.standsForAnother"
                    };
                    <div>
                        <strong>@item.Title</strong>
                        <small>@WorkMediaTypes.ToStorage(item.MediaType)@(string.IsNullOrWhiteSpace(item.Author) ? "" : " · " + item.Author)@(item.Identities.Count == 0 ? "" : " · " + string.Join(", ", item.Identities))</small>
                        <small>@ui[reasonKey]</small>
                        @foreach (var candidate in item.Candidates)
                        {
                            <div class="inline-actions">
                                <span>@candidate.Title · @candidate.Evidence</span>
                                <a class="button button-quiet" asp-page="/Admin/MergeReview/Index" asp-route-workId="@candidate.WorkId">@ui["admin.mergeReview.duplicates.open"]</a>
                                @if (item.Reason == LibraryWorkReviewReason.ConflictingIdentities && item.Candidates.Count == 2)
                                {
                                    <form method="post" asp-page-handler="Merge">
                                        <input type="hidden" name="keepWorkId" value="@candidate.WorkId" />
                                        <input type="hidden" name="mergeWorkId" value="@item.Candidates.Single(other => other.WorkId != candidate.WorkId).WorkId" />
                                        <button class="button button-primary" type="submit">@ui["admin.mergeReview.library.keepAndMerge"]</button>
                                    </form>
                                }
                            </div>
                        }
                        @if (item.Reason == LibraryWorkReviewReason.NoProviderIdentity)
                        {
                            <div class="inline-actions">
                                <form method="post" asp-page-handler="LinkEntry" class="inline-actions">
                                    <input type="hidden" name="entryId" value="@item.EntryId" />
                                    <label>@ui["admin.mergeReview.work.targetWorkId"]
                                        <input type="text" name="targetWorkId" value="" inputmode="text" />
                                    </label>
                                    <button class="button button-quiet" type="submit">@ui["admin.mergeReview.library.link"]</button>
                                </form>
                                <form method="post" asp-page-handler="CreateEntryWork">
                                    <input type="hidden" name="entryId" value="@item.EntryId" />
                                    <button class="button" type="submit">@ui["admin.mergeReview.library.create"]</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.mergeReview.duplicates.heading"]</h2>
        </div>
        @if (Model.Suggestions.Count == 0)
        {
            <p class="muted">@ui["admin.mergeReview.duplicates.empty"]</p>
        }
        else
        {
            <div class="status-list">
                @foreach (var suggestion in Model.Suggestions)
                {
                    <div>
                        <strong>@suggestion.KeepTitle ⇐ @suggestion.MergeTitle</strong>
                        <small>@WorkMediaTypes.ToStorage(suggestion.MediaType) · @ui.Format("admin.mergeReview.duplicates.score", ("score", suggestion.Score))</small>
                        <small>@string.Join(" · ", suggestion.Evidence)</small>
                        <div class="inline-actions">
                            <form method="post" asp-page-handler="Merge">
                                <input type="hidden" name="keepWorkId" value="@suggestion.KeepWorkId" />
                                <input type="hidden" name="mergeWorkId" value="@suggestion.MergeWorkId" />
                                <button class="button button-primary" type="submit">@ui["admin.mergeReview.duplicates.merge"]</button>
                            </form>
                            <a class="button button-quiet" asp-page="/Admin/MergeReview/Index" asp-route-workId="@suggestion.KeepWorkId">@ui["admin.mergeReview.duplicates.open"]</a>
                            <a class="button button-quiet" asp-page="/Admin/MergeReview/Index" asp-route-workId="@suggestion.MergeWorkId">@ui["admin.mergeReview.duplicates.open"]</a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.mergeReview.conflicts.heading"]</h2>
        </div>
        @if (Model.Conflicts.Count == 0)
        {
            <p class="muted">@ui["admin.mergeReview.conflicts.empty"]</p>
        }
        else
        {
            <div class="status-list">
                @foreach (var conflict in Model.Conflicts)
                {
                    <div>
                        <strong>@conflict.WorkTitle</strong>
                        <small>@conflict.Provider:@conflict.ExternalId · @WorkMediaTypes.ToStorage(conflict.MediaType)</small>
                        <div class="inline-actions">
                            <form method="post" asp-page-handler="ConfirmIdentity">
                                <input type="hidden" name="identityId" value="@conflict.IdentityId" />
                                <input type="hidden" name="workId" value="@conflict.WorkId" />
                                <button class="button" type="submit">@ui["admin.mergeReview.conflicts.confirm"]</button>
                            </form>
                            <a class="button button-quiet" asp-page="/Admin/MergeReview/Index" asp-route-workId="@conflict.WorkId">@ui["admin.mergeReview.duplicates.open"]</a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.mergeReview.history.heading"]</h2>
    </div>
    @if (Model.History.Count == 0)
    {
        <p class="muted">@ui["admin.mergeReview.history.empty"]</p>
    }
    else
    {
        <div class="status-list">
            @foreach (var entry in Model.History)
            {
                <div>
                    <span>@entry.CreatedAt.ToLocalTime().ToString("g") · @entry.ChangeType</span>
                    <strong>@entry.Summary</strong>
                    @if (!string.IsNullOrWhiteSpace(entry.Details))
                    {
                        <small>@entry.Details</small>
                    }
                </div>
            }
        </div>
    }
</section>
