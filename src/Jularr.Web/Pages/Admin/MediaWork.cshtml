@page "/Admin/Media/{kind}/{id:guid}"
@model Jularr.Web.Pages.Admin.MediaWorkModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Acquisition.Monitoring
@using Jularr.Web.Features.Library
@using Jularr.Web.Features.Storage
@using Jularr.Web.Features.Watchlist
@* Same layout as the Anime media page (docs/mockups/admin-media-detail/SPEC.md): a header with the medium-level controls, then seasons
   that expand into episodes (Series) or the versions of the Movie, each expanding into its real local files. Only what the backend can do
   is offered; the rest of the approved design is not drawn as a dead control. *@
@{
    var ui = Model.Ui;
    var detail = Model.Detail;
    ViewData["Title"] = detail?.Title ?? ui["admin.media.title"];

    string Bytes(long value) => StorageHealth.FormatBytes(value);
    string Languages(IEnumerable<string> codes) => string.Join(", ", codes.Select(code => code.ToUpperInvariant()));
    string StateLabel(AdminMediaState state) => state == AdminMediaState.Available
        ? ui["library.mediaCard.availability.available"]
        : ui["admin.wanted.status." + AdminMediaDetailView.StateName(state)];
    string MonitoringLabel(AdminMediaMonitoring monitoring) => monitoring switch
    {
        AdminMediaMonitoring.On => ui["admin.media.monitoring.on"],
        AdminMediaMonitoring.Partial => ui["admin.media.monitoring.partial"],
        _ => ui["admin.media.monitoring.off"]
    };
    string FileCount(int count) => count == 1 ? ui["admin.media.oneFile"] : ui.Format("admin.media.fileCount", ("count", count));
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-media-detail.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
    <script src="~/js/admin-media-work.js" asp-append-version="true" defer></script>
}

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Failed || detail is null)
{
    <div class="admmd-message" role="alert">
        <p>@ui["admin.media.loadFailed"]</p>
        <a class="button" href="@Model.Request.Path">@ui["admin.requests.retry"]</a>
    </div>
    return;
}

@{
    var isMovie = detail.Kind == MediaAcquisitionKind.Movie;
    var acquisition = detail.Acquisition;
    var monitoring = detail.Monitoring;
    var medium = detail.MediumMonitoring;
    var meta = string.Join(" · ", new[]
    {
        ui[MediaKindLabelKeys.Operation(detail.Kind)],
        detail.Year?.ToString(System.Globalization.CultureInfo.InvariantCulture)
    }.Where(part => !string.IsNullOrEmpty(part)));
    var audio = detail.AudioLanguages;
    var subtitles = detail.SubtitleLanguages;
    var episodes = detail.Episodes.ToList();
    var missing = isMovie ? 0 : episodes.Count(episode => episode.State != AdminMediaState.Available && !episode.IsUpcoming);
    var upcoming = ui["library.mediaCard.status.upcoming"];
    var detailHref = VideoWorkLinks.DetailPath(detail.Kind, detail.WorkId);
    var manualHref = acquisition.CanManualSearch ? Url.Page("/Admin/ManualSearch", new { id = acquisition.OpenRequest!.Id }) : null;
}

@if (Model.Notice is { } notice)
{
    <p class="admmd-notice" role="status">@notice</p>
}
@if (Model.Error is { } error)
{
    <p class="admmd-notice admmd-notice-error" role="alert">@error</p>
}

<section class="admmd-hero" aria-labelledby="admmd-title">
    <div class="admmd-poster" aria-hidden="true"><span>@WatchlistLabels.Initial(detail.Title)</span></div>
    <div class="admmd-hero-main">
        <div class="admmd-hero-top">
            <div class="admmd-titles">
                <h1 id="admmd-title">@detail.Title</h1>
                <p class="admmd-meta">@meta</p>
            </div>
            <div class="admmd-hero-actions">
                @if (acquisition.CanAcquire)
                {
                    @* A Partial or On Series posts Off; Off posts all episodes. The posted value is always the explicit target state. *@
                    var turnOn = medium == AdminMediaMonitoring.Off;
                    <form method="post" asp-page-handler="@(isMovie ? "MovieMonitor" : "SeriesScope")" class="admmd-monitor-form">
                        @if (isMovie)
                        {
                            <input type="hidden" name="monitored" value="@(turnOn ? "true" : "false")" />
                        }
                        else
                        {
                            <input type="hidden" name="scope" value="@(turnOn ? "all" : VideoMonitoringService.OffScope)" />
                        }
                        <button class="admmd-toggle @(medium == AdminMediaMonitoring.On ? "is-on" : medium == AdminMediaMonitoring.Partial ? "is-partial" : "")" type="submit" role="@(isMovie ? "switch" : "checkbox")"
                                aria-checked="@(medium == AdminMediaMonitoring.On ? "true" : medium == AdminMediaMonitoring.Partial ? "mixed" : "false")">
                            <span class="admin-switch" aria-hidden="true"></span>
                            @(medium == AdminMediaMonitoring.Off ? ui["admin.media.monitor"] : ui["admin.media.monitored"])
                        </button>
                    </form>
                }
                @if (acquisition.CanSearchNow)
                {
                    <form method="post" asp-page-handler="Search" class="admmd-desktop-only">
                        <button class="button button-primary" type="submit">@ui["admin.media.action.automatic"]</button>
                    </form>
                }
                @if (manualHref is not null)
                {
                    <a class="button admmd-desktop-only" href="@manualHref">@ui["admin.wanted.manualSearch"]</a>
                }
                <details class="admin-menu">
                    <summary class="admin-icon-button" aria-label="@ui["admin.media.more"]"><partial name="_AdminIcon" model='"more"' /><span class="admin-icon-label">@ui["admin.media.more"]</span></summary>
                    <div class="admin-menu-list">
                        <a class="admin-menu-item" href="@detailHref">@ui["admin.media.openLibrary"]</a>
                        @if (acquisition.CanAcquire && !isMovie)
                        {
                            <form method="post" asp-page-handler="SeriesScope">
                                <input type="hidden" name="scope" value="all" />
                                <button class="admin-menu-item" type="submit">@ui["admin.media.video.monitorAll"]</button>
                            </form>
                            <form method="post" asp-page-handler="SeriesScope">
                                <input type="hidden" name="scope" value="future" />
                                <button class="admin-menu-item" type="submit">@ui["admin.media.video.monitorFuture"]</button>
                            </form>
                        }
                    </div>
                </details>
            </div>
        </div>
        <dl class="admmd-stats">
            @if (isMovie)
            {
                <div class="admmd-stat"><dt>@ui["admin.media.stat.versions"]</dt><dd>@detail.Versions.Count<small>@FileCount(detail.Files.Count())</small></dd></div>
                <div class="admmd-stat"><dt>@ui["admin.media.col.status"]</dt><dd>@(detail.Available == 1 ? ui["library.mediaCard.availability.available"] : ui["admin.wanted.status.missing"])</dd></div>
            }
            else
            {
                <div class="admmd-stat"><dt>@ui["admin.media.stat.seasons"]</dt><dd>@detail.Seasons.Count<small>@(episodes.Count == 1 ? ui["library.anime.oneEpisode"] : ui.Format("library.index.episodeCount", ("count", episodes.Count)))</small></dd></div>
                <div class="admmd-stat"><dt>@ui["admin.media.stat.monitored"]</dt><dd>@MonitoringLabel(medium)<small>@ui.Format("admin.media.stat.monitoredOf", ("count", episodes.Count(episode => episode.Monitored)), ("total", episodes.Count))</small></dd></div>
                <div class="admmd-stat"><dt>@ui["admin.media.stat.available"]</dt><dd>@detail.Available / @detail.Total<small>@ui.Format("admin.media.group.missing", ("count", missing))</small></dd></div>
            }
            <div class="admmd-stat"><dt>@ui["admin.media.stat.storage"]</dt><dd>@Bytes(detail.SizeBytes)</dd></div>
            <div class="admmd-stat"><dt>@ui["library.acquisitionPanel.qualityProfile"]</dt><dd>@acquisition.ProfileName</dd></div>
            <div class="admmd-stat">
                <dt>@ui["admin.media.stat.languages"]</dt>
                <dd>@(audio.Count == 0 ? "—" : Languages(audio))@if (subtitles.Count > 0){<small>@ui.Format("admin.media.stat.subtitlesOf", ("languages", Languages(subtitles)))</small>}</dd>
            </div>
        </dl>
        @if (acquisition.OpenRequest is { } open)
        {
            <p class="admmd-note">@ui["requests.status." + AcquisitionAccessNames.Status(open.Status)]@(string.IsNullOrWhiteSpace(open.StatusMessage) ? "" : " · " + open.StatusMessage)</p>
        }
    </div>
</section>

@if (!acquisition.CanAcquire)
{
    <p class="admmd-note">@ui["admin.media.video.noAcquisition"]</p>
}

@if (isMovie)
{
    @if (detail.Versions.Count == 0)
    {
        <p class="admmd-message muted" data-admin-media-empty>@ui["admin.media.noFiles"]</p>
    }
    else
    {
        <div class="admmd-groups admmd-groups-versions" data-admin-media-versions>
            <div class="admmd-toolbar admmd-toolbar-inline">
                <h2>@ui["admin.media.stat.versions"]</h2>
                <partial name="_AdminMediaColumns" model="ui" />
            </div>
            <div class="admmd-cols" aria-hidden="true">
                <span>@ui["admin.media.col.version"]</span>
                <span data-col="status">@ui["admin.media.col.status"]</span>
                <span data-col="quality">@ui["admin.media.col.quality"]</span>
                <span data-col="audio">@ui["admin.media.col.audio"]</span>
                <span data-col="subtitles">@ui["admin.media.col.subtitles"]</span>
                <span data-col="files">@ui["admin.media.col.files"]</span>
                <span data-col="size">@ui["admin.media.col.size"]</span>
            </div>
            <ul class="admmd-episodes">
                @foreach (var version in detail.Versions)
                {
                    var versionName = version.Label ?? version.Quality ?? ui["admin.media.col.version"];
                    <li>
                        <details class="admmd-ep" id="v-@version.Id.ToString("N")">
                            <summary class="admmd-ep-row">
                                <span class="admmd-ep-title">
                                    <span class="admmd-ep-name">
                                        <span class="admmd-chevron"><partial name="_AdminMediaIcon" model='"chevron"' /></span>
                                        <strong>@versionName</strong>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(version.ReleaseGroup))
                                    {
                                        <small>@version.ReleaseGroup</small>
                                    }
                                </span>
                                <span class="admmd-ep-status" data-col="status">
                                    <span class="admin-tag admin-tag-success"><partial name="_AdminMediaIcon" model='"available"' />@StateLabel(AdminMediaState.Available)</span>
                                </span>
                                <span class="admmd-ep-quality" data-col="quality">@(version.Quality ?? "—")</span>
                                <span class="admmd-ep-langs" data-col="audio" title="@ui["admin.media.col.audio"]">
                                    @foreach (var language in version.Audio)
                                    {
                                        <span class="admmd-lang">@language.ToUpperInvariant()</span>
                                    }
                                </span>
                                <span class="admmd-ep-langs" data-col="subtitles" title="@ui["admin.media.col.subtitles"]">
                                    @foreach (var language in version.Subtitles)
                                    {
                                        <span class="admmd-lang admmd-lang-quiet">@language.ToUpperInvariant()</span>
                                    }
                                </span>
                                <span class="admmd-ep-files" data-col="files">@version.Files.Count</span>
                                <span class="admmd-ep-size" data-col="size">@Bytes(version.SizeBytes)</span>
                            </summary>
                            <div class="admmd-ep-body">
                                <partial name="_AdminVideoFiles" model='(version.Files, ui, "v-" + version.Id.ToString("N"))' />
                            </div>
                        </details>
                    </li>
                }
            </ul>
        </div>
    }
}
else
{
    @if (detail.Seasons.Count == 0)
    {
        <p class="admmd-message muted" data-admin-media-empty>@ui["admin.media.empty"]</p>
    }
    else
    {
        <div class="admmd-groups" data-admin-media-groups>
            <div class="admmd-toolbar admmd-toolbar-inline">
                <h2>@ui["admin.media.stat.seasons"]</h2>
                <partial name="_AdminMediaColumns" model="ui" />
            </div>
            <div class="admmd-cols" aria-hidden="true">
                <span></span>
                <span>@ui["admin.media.col.episode"]</span>
                <span data-col="status">@ui["admin.media.col.status"]</span>
                <span data-col="quality">@ui["admin.media.col.quality"]</span>
                <span data-col="audio">@ui["admin.media.col.audio"]</span>
                <span data-col="subtitles">@ui["admin.media.col.subtitles"]</span>
                <span data-col="files">@ui["admin.media.col.files"]</span>
                <span data-col="size">@ui["admin.media.col.size"]</span>
                <span>@ui["admin.media.col.monitor"]</span>
            </div>
            @foreach (var season in detail.Seasons)
            {
                var seasonName = Model.Name(season);
                var seasonMonitoring = season.Monitoring;
                var seasonMissing = season.Episodes.Count(episode => episode.State != AdminMediaState.Available && !episode.IsUpcoming);
                var firstMissing = season.Episodes.FirstOrDefault(episode => episode.State != AdminMediaState.Available && !episode.IsUpcoming);
                var seasonTurnOn = seasonMonitoring != AdminMediaMonitoring.On;
                <details class="admmd-group" id="s@(season.Number)" data-season-group open="@(detail.Seasons.Count == 1)">
                    <summary class="admmd-group-head">
                        <span class="admmd-chevron"><partial name="_AdminMediaIcon" model='"chevron"' /></span>
                        <span class="admmd-group-name">
                            <strong>@seasonName</strong>
                            <small>@(season.Episodes.Count == 1 ? ui["library.anime.oneEpisode"] : ui.Format("library.index.episodeCount", ("count", season.Episodes.Count))) · @Bytes(season.SizeBytes)</small>
                        </span>
                        <span class="admmd-group-state">
                            <span>@ui.Format("admin.media.group.available", ("available", season.Available), ("total", season.Episodes.Count))</span>
                            @if (seasonMissing > 0)
                            {
                                <small>@ui.Format("admin.media.group.missing", ("count", seasonMissing))</small>
                            }
                        </span>
                        <span class="admmd-group-langs" title="@ui["admin.media.col.audio"]">
                            @foreach (var (language, count) in season.AudioCoverage.Take(4))
                            {
                                <span class="admmd-lang @(count < season.Episodes.Count ? "is-partial" : "")">@language.ToUpperInvariant()</span>
                            }
                        </span>
                        <span class="admmd-group-monitor">
                            <span class="admin-tag @(seasonMonitoring == AdminMediaMonitoring.On ? "admin-tag-success" : seasonMonitoring == AdminMediaMonitoring.Partial ? "admin-tag-warning" : "")">@MonitoringLabel(seasonMonitoring)</span>
                            @if (firstMissing is not null && manualHref is not null)
                            {
                                <a class="admin-icon-button" asp-page="/Admin/ManualSearch" asp-route-id="@acquisition.OpenRequest!.Id" asp-route-unit="@firstMissing.Id"
                                   aria-label="@ui["admin.wanted.manualSearch"]: @seasonName"><partial name="_AdminIcon" model='"search"' /><span class="admin-icon-label">@ui["admin.wanted.manualSearch"]</span></a>
                            }
                            @if (acquisition.CanAcquire)
                            {
                                <form method="post" asp-page-handler="SeasonMonitor">
                                    <input type="hidden" name="season" value="@season.Number" />
                                    <input type="hidden" name="monitored" value="@(seasonTurnOn ? "true" : "false")" />
                                    <button class="admmd-toggle admmd-toggle-icon @(seasonMonitoring == AdminMediaMonitoring.On ? "is-on" : seasonMonitoring == AdminMediaMonitoring.Partial ? "is-partial" : "")"
                                            type="submit" role="checkbox"
                                            aria-checked="@(seasonMonitoring == AdminMediaMonitoring.On ? "true" : seasonMonitoring == AdminMediaMonitoring.Partial ? "mixed" : "false")"
                                            aria-label="@ui.Format("admin.media.monitorItem", ("name", seasonName))">
                                        <span class="admin-switch" aria-hidden="true"></span>
                                    </button>
                                </form>
                            }
                        </span>
                    </summary>
                    <ul class="admmd-episodes">
                        @foreach (var episode in season.Episodes)
                        {
                            var stateName = AdminMediaDetailView.StateName(episode.State);
                            var episodeName = string.IsNullOrWhiteSpace(episode.Title)
                                ? ui.Format("admin.media.episodeNumber", ("number", episode.Number))
                                : episode.Title;
                            var quality = episode.Files.Select(file => file.Quality).Aggregate((string?)null, AdminMediaDetailView.BestQuality);
                            <li>
                                <details class="admmd-ep" id="e@(episode.Season)x@(episode.Number)">
                                    <summary class="admmd-ep-row">
                                        <span class="admmd-ep-number">
                                            <span class="admmd-chevron"><partial name="_AdminMediaIcon" model='"chevron"' /></span>
                                            <span>@episode.Number</span>
                                        </span>
                                        <span class="admmd-ep-title">
                                            <strong>@episodeName</strong>
                                            @if (episode.AiredAt is { } airs)
                                            {
                                                <small>@(episode.IsUpcoming ? upcoming + " · " : "")<time datetime="@airs.ToString("yyyy-MM-dd")">@airs.ToString("yyyy-MM-dd")</time></small>
                                            }
                                        </span>
                                        <span class="admmd-ep-status" data-col="status">
                                            @if (episode.IsUpcoming && episode.State == AdminMediaState.Missing)
                                            {
                                                <span class="admmd-none">@upcoming</span>
                                            }
                                            else
                                            {
                                                <span class="admin-tag admin-tag-@AdminStatusTone.Of(episode.State)"><partial name="_AdminMediaIcon" model="stateName" />@StateLabel(episode.State)</span>
                                            }
                                        </span>
                                        <span class="admmd-ep-quality" data-col="quality">@(quality ?? "—")</span>
                                        <span class="admmd-ep-langs" data-col="audio" title="@ui["admin.media.col.audio"]">
                                            @foreach (var language in episode.Files.SelectMany(file => file.Audio).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                <span class="admmd-lang">@language.ToUpperInvariant()</span>
                                            }
                                        </span>
                                        <span class="admmd-ep-langs" data-col="subtitles" title="@ui["admin.media.col.subtitles"]">
                                            @foreach (var language in episode.Files.SelectMany(file => file.Subtitles).Distinct(StringComparer.OrdinalIgnoreCase))
                                            {
                                                <span class="admmd-lang admmd-lang-quiet">@language.ToUpperInvariant()</span>
                                            }
                                        </span>
                                        <span class="admmd-ep-files" data-col="files">@episode.Files.Count</span>
                                        <span class="admmd-ep-size" data-col="size">@(episode.Files.Count > 0 ? Bytes(episode.SizeBytes) : "—")</span>
                                        <span class="admmd-ep-monitor">
                                            @if (manualHref is not null && !episode.IsUpcoming && episode.State != AdminMediaState.Available)
                                            {
                                                <a class="admin-icon-button" asp-page="/Admin/ManualSearch" asp-route-id="@acquisition.OpenRequest!.Id" asp-route-unit="@episode.Id"
                                                   aria-label="@ui["admin.wanted.manualSearch"]: @episodeName"><partial name="_AdminIcon" model='"search"' /><span class="admin-icon-label">@ui["admin.wanted.manualSearch"]</span></a>
                                            }
                                            @if (acquisition.CanAcquire)
                                            {
                                                <form method="post" asp-page-handler="EpisodeMonitor">
                                                    <input type="hidden" name="episodeId" value="@episode.Id" />
                                                    <input type="hidden" name="monitored" value="@(episode.Monitored ? "false" : "true")" />
                                                    <input type="hidden" name="open" value="e@(episode.Season)x@(episode.Number)" />
                                                    <button class="admmd-toggle admmd-toggle-icon @(episode.Monitored ? "is-on" : "")" type="submit" role="switch" aria-checked="@(episode.Monitored ? "true" : "false")"
                                                            aria-label="@ui.Format("admin.media.monitorItem", ("name", episodeName))">
                                                        <span class="admin-switch" aria-hidden="true"></span>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="admin-tag @(episode.Monitored ? "admin-tag-success" : "")">@ui["admin.media.monitoring." + (episode.Monitored ? "on" : "off")]</span>
                                            }
                                        </span>
                                    </summary>
                                    <div class="admmd-ep-body">
                                        @if (episode.Files.Count == 0)
                                        {
                                            <p class="admmd-none">@ui["admin.media.noFiles"]</p>
                                        }
                                        else
                                        {
                                            <partial name="_AdminVideoFiles" model='(episode.Files, ui, "e" + episode.Season + "x" + episode.Number)' />
                                        }
                                    </div>
                                </details>
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>
    }
}

@if (acquisition.CanAcquire)
{
    <div class="admmd-panels">
        <section class="admmd-panel" aria-labelledby="admmd-profile-title">
            <h2 id="admmd-profile-title">@ui["library.acquisitionPanel.qualityProfile"]</h2>
            <form method="post" asp-page-handler="Profile" class="admmd-form">
                <label class="admmd-field">
                    <span>@ui["library.acquisitionPanel.qualityProfile"]</span>
                    <select name="profileId">
                        <option value="" selected="@(acquisition.AssignedProfileId is null)">@ui["admin.media.video.defaultProfile"]</option>
                        @foreach (var (profileId, profileName) in acquisition.Profiles)
                        {
                            <option value="@profileId" selected="@profileId.Equals(acquisition.AssignedProfileId, StringComparison.OrdinalIgnoreCase)">@profileName</option>
                        }
                    </select>
                </label>
                <button class="button" type="submit">@ui["common.save"]</button>
            </form>
        </section>
    </div>
}

@if (acquisition.CanSearchNow || manualHref is not null)
{
    <nav class="admmd-bar" aria-label="@ui["admin.media.acquisition.heading"]">
        @if (acquisition.CanSearchNow)
        {
            <form method="post" asp-page-handler="Search">
                <button class="button button-primary" type="submit">@ui["admin.media.action.automatic"]</button>
            </form>
        }
        @if (manualHref is not null)
        {
            <a class="button" href="@manualHref">@ui["admin.wanted.manualSearch"]</a>
        }
        <a class="button" href="@detailHref">@ui["admin.media.openLibrary"]</a>
    </nav>
}
