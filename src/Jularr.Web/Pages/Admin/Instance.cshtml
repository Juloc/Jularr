@page
@using Jularr.Web.Features.Instance
@model Jularr.Web.Pages.Admin.InstanceModel
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.instance.title"];
    var groups = new (string TitleKey, string DescriptionKey, IReadOnlyList<InstanceModule> Modules)[]
    {
        ("admin.instance.media", "admin.instance.mediaDescription", InstanceModel.ConfigurableMediaModules),
        ("admin.instance.features", "admin.instance.featuresDescription", InstanceModel.ConfigurableFeatureModules)
    };
}

<header class="page-header">
    <div>
        <h1>@ui["admin.instance.title"]</h1>
        <p>@ui["admin.instance.description"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="ui" />

<section class="admset-section" aria-labelledby="instance-preset">
    <div class="admset-head">
        <div>
            <h2 id="instance-preset">@ui["admin.instance.preset.title"]</h2>
            <p>@ui["admin.instance.preset.hint"]</p>
        </div>
        @if (Model.Preset == InstancePreset.Custom)
        {
            <span class="admin-tag admin-tag-text">@Model.PresetName(InstancePreset.Custom)</span>
        }
    </div>
    <div class="admin-module-grid">
        @foreach (var preset in new[] { InstancePreset.MediaManager, InstancePreset.Full })
        {
            <form method="post" asp-page-handler="Preset" class="admin-module-card">
                <input type="hidden" name="preset" value="@preset" />
                <div class="admin-module-head">
                    <strong>@Model.PresetName(preset)</strong>
                    @if (Model.Preset == preset)
                    {
                        <span class="admin-tag admin-tag-accent">@ui["admin.instance.preset.currentTag"]</span>
                    }
                </div>
                <p>@Model.PresetDescription(preset)</p>
                @if (Model.Preset != preset)
                {
                    <button class="button" type="submit">@ui["admin.instance.preset.apply"]</button>
                }
            </form>
        }
    </div>
</section>

<form method="post" class="admset-sections">
    @foreach (var group in groups)
    {
        var headingId = $"instance-{group.TitleKey}";
        <section class="admset-section" aria-labelledby="@headingId">
            <div class="admset-head">
                <div>
                    <h2 id="@headingId">@ui[group.TitleKey]</h2>
                    <p>@ui[group.DescriptionKey]</p>
                </div>
            </div>

            <div class="admin-module-grid">
                @foreach (var module in group.Modules)
                {
                    var fieldName = InstanceModel.FieldName(module);
                    var settingsPage = InstanceModel.SettingsPage(module);
                    <div class="admin-module-card">
                        <label class="admin-module-head" for="@fieldName">
                            <span class="admset-tile"><partial name="_AdminIcon" model="InstanceModel.Icon(module)" /></span>
                            <strong>@Model.Name(module)</strong>
                            <input id="@fieldName" type="checkbox" class="admin-switch" role="switch" name="@fieldName" value="true"
                                   checked="@Model.Settings.IsEnabled(module)" aria-describedby="@fieldName-description" />
                        </label>
                        <p id="@fieldName-description">@Model.Description(module)</p>
                        @if (settingsPage is not null)
                        {
                            <a class="button" asp-page="@settingsPage">@ui["admin.instance.openSettings"]</a>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <p class="admset-hint">@ui["admin.instance.retentionNote"]</p>

    <div class="admset-actions">
        <button class="button button-primary" type="submit">@ui["admin.instance.save"]</button>
    </div>
</form>
