@model Jularr.Web.Pages.Admin.ProfileTierRowView
@* One waiting step of an Acquisition Profile: after the wait, the ticked qualities are taken too. Renders stored steps and the clone template. *@
@{
    var ui = Model.Ui;
}
<li class="admprofiles-tier" data-tier-row>
    <input type="hidden" name="Tiers.Index" value="@Model.Index" />
    <label class="admset-field admprofiles-tier-wait">
        <span class="admset-label">@ui["admin.profiles.tier.after"]</span>
        <input type="number" min="1" inputmode="numeric" name="Tiers[@(Model.Index)].Minutes" value="@Model.Row.Minutes" />
    </label>
    <fieldset class="admprofiles-chips">
        <legend class="admset-label">@ui["admin.profiles.tier.qualities"]</legend>
        @foreach (var quality in Model.Qualities)
        {
            <label class="admprofiles-chip"><input type="checkbox" name="Tiers[@(Model.Index)].Qualities" value="@quality" checked="@Model.Row.Qualities.Contains(quality, StringComparer.OrdinalIgnoreCase)" /><span>@quality</span></label>
        }
    </fieldset>
    <button type="button" class="admin-icon-button" data-remove-row aria-label="@ui["admin.profiles.tier.remove"]"><partial name="_AdminIcon" model='"close"' /></button>
</li>
