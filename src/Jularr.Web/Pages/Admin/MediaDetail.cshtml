@page "/Admin/Media/{id:guid}"
@model Jularr.Web.Pages.Admin.MediaDetailModel
@using Jularr.Web.Features.Acquisition.History
@using Jularr.Web.Features.Acquisition.Import
@using Jularr.Web.Features.Acquisition.Ownership
@using Jularr.Web.Features.Library
@using Jularr.Web.Features.Operations
@using Jularr.Web.Features.Storage
@using Jularr.Web.Features.Metadata
@using Jularr.Web.Features.Watchlist
@* Layout follows docs/mockups/admin-media-detail/SPEC.md: a header with the medium-level controls, then seasons
   that expand into episodes and episodes that expand into their real local files. Only what the backend does
   today is offered; the rest of the approved design is left out rather than shown as a dead control. *@
@{
    var ui = Model.Ui;
    var detail = Model.Detail;
    ViewData["Title"] = detail?.Title ?? ui["admin.media.title"];

    string Bytes(long value) => StorageHealth.FormatBytes(value);
    string Languages(IEnumerable<string> codes) => string.Join(", ", codes.Select(code => code.ToUpperInvariant()));
    string StateLabel(AdminMediaState state) => state == AdminMediaState.Available
        ? ui["library.mediaCard.availability.available"]
        : ui["admin.wanted.status." + AdminMediaDetailView.StateName(state)];
    string MonitoringLabel(AdminMediaMonitoring monitoring) => monitoring switch
    {
        AdminMediaMonitoring.On => ui["admin.media.monitoring.on"],
        AdminMediaMonitoring.Partial => ui["admin.media.monitoring.partial"],
        _ => ui["admin.media.monitoring.off"]
    };
    string ModeLabel(AnimeManagementMode mode) => mode switch
    {
        AnimeManagementMode.ReadOnlyCoexistence => ui["admin.media.mode.readOnly"],
        AnimeManagementMode.ParallelAcquisition => ui["admin.media.mode.parallel"],
        _ => ui["admin.media.mode.managed"]
    };
    string EventLabel(AcquisitionHistoryEventKind kind) => kind switch
    {
        AcquisitionHistoryEventKind.Grabbed => ui["admin.media.event.grabbed"],
        AcquisitionHistoryEventKind.Delayed => ui["admin.media.event.delayed"],
        AcquisitionHistoryEventKind.Imported => ui["admin.media.event.imported"],
        AcquisitionHistoryEventKind.Upgraded => ui["admin.media.event.upgraded"],
        AcquisitionHistoryEventKind.ImportFailed => ui["admin.media.event.importFailed"],
        AcquisitionHistoryEventKind.Dismissed => ui["admin.media.event.dismissed"],
        _ => ui["admin.media.event.skipped"]
    };
    string ImportLabel(AnimeImportStatus status) => status switch
    {
        AnimeImportStatus.ManualRequired => ui["admin.media.import.manual"],
        AnimeImportStatus.Failed => ui["admin.media.import.failed"],
        _ => ui["admin.media.import.importing"]
    };
    string OperationStatusLabel(OperationStatus status) => ui["admin.operations.status." + AdminActivityQuery.StatusName(status)];
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-media-detail.css" asp-append-version="true" />
}

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Failed || detail is null)
{
    <div class="admmd-message" role="alert">
        <p>@ui["admin.media.loadFailed"]</p>
        <a class="button" href="@Model.Request.Path">@ui["admin.requests.retry"]</a>
    </div>
    return;
}

@{
    var id = detail.Id;
    var aniList = Model.AniListView;
    var acquisition = detail.Acquisition;
    var selfHref = MediaDetailModel.Href(id, aniList, Model.OpenGroup, Model.OpenEpisode);
    var metadata = detail.Metadata;
    var formatKey = WatchlistLabels.FormatKey(metadata?.Format);
    var meta = string.Join(" · ", new[]
    {
        formatKey is null ? null : ui[formatKey],
        metadata?.SeasonYear?.ToString(System.Globalization.CultureInfo.InvariantCulture),
        Model.ProviderStatus()
    }.Where(part => !string.IsNullOrEmpty(part)));
    var aniListId = string.Equals(metadata?.Provider, AniListMetadataProvider.ProviderKey, StringComparison.OrdinalIgnoreCase)
        && int.TryParse(metadata?.ExternalId, out var parsedAniListId)
            ? parsedAniListId
            : (int?)null;
    var audio = detail.AudioLanguages;
}

@if (Model.Notice is { } notice)
{
    <p class="admmd-notice" role="status">@notice</p>
}
@if (Model.Error is { } error)
{
    <p class="admmd-notice admmd-notice-error" role="alert">@error</p>
}

<section class="admmd-hero" aria-labelledby="admmd-title">
    <div class="admmd-poster" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(detail.PosterUrl))
        {
            <img src="@detail.PosterUrl" alt="" decoding="async" referrerpolicy="no-referrer" />
        }
        else
        {
            <span>@WatchlistLabels.Initial(detail.Title)</span>
        }
    </div>
    <div class="admmd-hero-main">
        <div class="admmd-hero-top">
            <div class="admmd-titles">
                <h1 id="admmd-title">@detail.Title</h1>
                @if (meta.Length > 0)
                {
                    <p class="admmd-meta">@meta</p>
                }
            </div>
            <div class="admmd-hero-actions">
                <form method="post" asp-page="/Acquisition/Index" asp-page-handler="AnimeSettings" class="admmd-monitor-form">
                    <input type="hidden" name="animeId" value="@id" />
                    <input type="hidden" name="returnUrl" value="@selfHref" />
                    <input type="hidden" name="monitored" value="@(acquisition.Monitored ? "false" : "true")" />
                    <input type="hidden" name="searchOnAdd" value="@(acquisition.SearchOnAdd ? "true" : "false")" />
                    <input type="hidden" name="profileId" value="@acquisition.ProfileId" />
                    <partial name="_AdminMediaSettingsFields" model="acquisition" />
                    <button class="admmd-toggle @(acquisition.Monitored ? "is-on" : "")" type="submit" aria-pressed="@(acquisition.Monitored ? "true" : "false")">
                        <span class="admin-switch" aria-hidden="true"></span>
                        @(acquisition.Monitored ? ui["admin.media.monitored"] : ui["admin.media.monitor"])
                    </button>
                </form>
                <a class="button" href="/Library/Anime/@id">@ui["admin.media.openLibrary"]</a>
                @if (aniListId is { } remoteId)
                {
                    <a class="button" href="https://anilist.co/anime/@remoteId" target="_blank" rel="noopener noreferrer">@ui["admin.media.openAniList"]</a>
                }
            </div>
        </div>
        <dl class="admmd-stats">
            <div class="admmd-stat"><dt>@ui["admin.media.stat.seasons"]</dt><dd>@detail.Seasons</dd></div>
            <div class="admmd-stat"><dt>@ui["admin.media.stat.available"]</dt><dd>@detail.Available / @detail.Episodes.Count</dd></div>
            <div class="admmd-stat"><dt>@ui["admin.media.stat.missing"]</dt><dd>@detail.Missing</dd></div>
            <div class="admmd-stat"><dt>@ui["admin.media.stat.storage"]</dt><dd>@Bytes(detail.SizeBytes)</dd></div>
            <div class="admmd-stat"><dt>@ui["library.acquisitionPanel.qualityProfile"]</dt><dd>@acquisition.ProfileName</dd></div>
            <div class="admmd-stat"><dt>@ui["admin.media.stat.audio"]</dt><dd>@(audio.Count == 0 ? "—" : Languages(audio))</dd></div>
        </dl>
    </div>
</section>

<div class="admmd-toolbar">
    <div class="admmd-view" role="group" aria-label="@ui["admin.media.view.aria"]">
        <a class="admmd-view-option @(aniList ? "" : "is-active")" href="@MediaDetailModel.Href(id, false)" aria-current="@(aniList ? null : "true")">@ui["admin.media.view.standard"]</a>
        <a class="admmd-view-option @(aniList ? "is-active" : "")" href="@MediaDetailModel.Href(id, true)" aria-current="@(aniList ? "true" : null)">@ui["admin.media.view.anilist"]</a>
    </div>
    <div class="admmd-actions">
        <form method="post" asp-page="/Acquisition/Index" asp-page-handler="SearchAnime">
            <input type="hidden" name="animeKey" value="@detail.Key" />
            <input type="hidden" name="returnUrl" value="@selfHref" />
            <button class="button button-primary" type="submit" disabled="@(!acquisition.Monitored || !acquisition.CanAcquire)">@ui["admin.media.action.searchWanted"]</button>
        </form>
        <a class="button"
           asp-page="/Acquisition/Index"
           asp-route-search="@detail.Key"
           asp-route-mode="Anime"
           asp-fragment="search-results">@ui["admin.wanted.manualSearch"]</a>
        <form method="post" asp-page="/Library/AnimeRepair" asp-page-handler="Rescan" asp-route-id="@id">
            <input type="hidden" name="returnUrl" value="@selfHref" />
            <button class="button" type="submit">@ui["admin.media.action.rescan"]</button>
        </form>
        <form method="post" asp-page="/Library/AnimeRepair" asp-page-handler="Reanalyze" asp-route-id="@id">
            <input type="hidden" name="returnUrl" value="@selfHref" />
            <button class="button" type="submit" disabled="@(detail.Available == 0)">@ui["admin.media.action.reanalyze"]</button>
        </form>
        <form method="post" asp-page="/Library/AnimeRepair" asp-page-handler="Optimize" asp-route-id="@id">
            <input type="hidden" name="returnUrl" value="@selfHref" />
            <button class="button" type="submit" disabled="@(detail.Available == 0)">@ui["admin.media.action.optimize"]</button>
        </form>
        <details class="admmd-more">
            <summary class="button">@ui["admin.media.more"]</summary>
            <div class="admmd-more-menu">
                @if (Model.CanRename)
                {
                    <a href="/Library/Rename/@id">@ui["library.anime.renameFiles"]</a>
                }
                <a href="/Library/AnimeRepair/@id">@ui["library.anime.repair"]</a>
                <a href="/Library/PresentationGroups/@id">@ui["library.presentation.manageLink"]</a>
            </div>
        </details>
    </div>
</div>

@if (!acquisition.CanAcquire)
{
    <p class="admmd-note">@ui["admin.media.readOnlyNote"]</p>
}

@if (Model.Groups.Count == 0)
{
    <p class="admmd-message muted" data-admin-media-empty>@ui["admin.media.empty"]</p>
}
else
{
    <div class="admmd-groups" data-admin-media-groups>
        <div class="admmd-cols" aria-hidden="true">
            <span>@ui["admin.media.col.episode"]</span>
            <span>@ui["admin.media.col.status"]</span>
            <span>@ui["admin.media.col.quality"]</span>
            <span>@ui["admin.media.col.audio"]</span>
            <span>@ui["admin.media.col.subtitles"]</span>
            <span>@ui["admin.media.col.files"]</span>
            <span>@ui["admin.media.col.size"]</span>
            <span>@ui["admin.media.col.monitor"]</span>
        </div>
        @foreach (var group in Model.Groups)
        {
            var groupName = Model.GroupName(group);
            var monitoring = group.Monitoring;
            var coverage = group.AudioCoverage;
            <details class="admmd-group" id="g-@group.Key" open="@Model.IsOpen(group)">
                <summary class="admmd-group-head">
                    <span class="admmd-chevron"><partial name="_AdminMediaIcon" model='"chevron"' /></span>
                    <span class="admmd-group-name">
                        <strong>@groupName</strong>
                        <small>@Model.EpisodeCount(group.Episodes.Count) · @Bytes(group.SizeBytes)</small>
                    </span>
                    <span class="admmd-group-state">
                        <span>@ui.Format("admin.media.group.available", ("available", group.Available), ("total", group.Episodes.Count))</span>
                        @if (group.Missing > 0)
                        {
                            <small>@ui.Format("admin.media.group.missing", ("count", group.Missing))</small>
                        }
                    </span>
                    <span class="admmd-group-langs" title="@ui["admin.media.col.audio"]">
                        @foreach (var (language, count) in coverage.Take(4))
                        {
                            <span class="admmd-lang @(count < group.Episodes.Count ? "is-partial" : "")">@language.ToUpperInvariant()</span>
                        }
                    </span>
                    <span class="admmd-group-monitor">
                        <span class="admmd-monitoring admmd-monitoring-@monitoring.ToString().ToLowerInvariant()">@MonitoringLabel(monitoring)</span>
                        @if (group.Season is { } seasonNumber)
                        {
                            var turnOn = monitoring != AdminMediaMonitoring.On;
                            <form method="post" asp-page-handler="SeasonMonitor" asp-route-id="@id">
                                <input type="hidden" name="season" value="@seasonNumber" />
                                <input type="hidden" name="monitored" value="@(turnOn ? "true" : "false")" />
                                <button class="admmd-toggle admmd-toggle-icon @(monitoring == AdminMediaMonitoring.On ? "is-on" : monitoring == AdminMediaMonitoring.Partial ? "is-partial" : "")"
                                        type="submit" role="switch"
                                        aria-checked="@(monitoring == AdminMediaMonitoring.On ? "true" : monitoring == AdminMediaMonitoring.Partial ? "mixed" : "false")"
                                        aria-label="@ui.Format(turnOn ? "admin.media.monitorItem" : "admin.media.unmonitorItem", ("name", groupName))"
                                        disabled="@(!acquisition.Monitored)"
                                        title="@(acquisition.Monitored ? null : ui["admin.media.monitorFirst"])">
                                    <span class="admin-switch" aria-hidden="true"></span>
                                </button>
                            </form>
                        }
                    </span>
                </summary>
                @if (group.Season is { } searchSeason)
                {
                    <div class="admmd-group-actions">
                        <a class="button"
                           asp-page="/Acquisition/Index"
                           asp-route-search="@detail.Key"
                           asp-route-season="@searchSeason"
                           asp-route-mode="Season"
                           asp-fragment="search-results">@ui["admin.wanted.manualSearch"]</a>
                    </div>
                }
                <ul class="admmd-episodes">
                    @foreach (var episode in group.Episodes)
                    {
                        var stateName = AdminMediaDetailView.StateName(episode.State);
                        var episodeOpen = Model.OpenEpisode == episode.Key && Model.IsOpen(group);
                        var episodeName = string.IsNullOrWhiteSpace(episode.Title)
                            ? ui.Format("admin.media.episodeNumber", ("number", episode.Number))
                            : episode.Title;
                        var rowHref = MediaDetailModel.Href(id, aniList, group.Key, episode.Key);
                        <li>
                            <details class="admmd-ep" id="e-@episode.Key" open="@episodeOpen">
                                <summary class="admmd-ep-row">
                                    <span class="admmd-ep-number">
                                        <span class="admmd-chevron"><partial name="_AdminMediaIcon" model='"chevron"' /></span>
                                        @if (aniList)
                                        {
                                            <span>@AnimeDetailView.EpisodeCode(episode.Season, episode.Number)</span>
                                        }
                                        else
                                        {
                                            <span>@episode.Number</span>
                                        }
                                    </span>
                                    <span class="admmd-ep-title">
                                        <strong>@episodeName</strong>
                                        @if (episode.UpgradeWanted)
                                        {
                                            <small>@ui["acquisition.reason.upgradeWanted"]</small>
                                        }
                                        @if (episode.State == AdminMediaState.Failed && episode.Failures > 0)
                                        {
                                            <small>@ui.Format("admin.wanted.attempt.failed", ("count", episode.Failures))</small>
                                        }
                                    </span>
                                    <span class="admmd-ep-status">
                                        <span class="admmd-state admmd-state-@stateName">
                                            <partial name="_AdminMediaIcon" model="stateName" />
                                            @StateLabel(episode.State)
                                        </span>
                                    </span>
                                    <span class="admmd-ep-quality">@(episode.Quality ?? "—")</span>
                                    <span class="admmd-ep-langs" title="@ui["admin.media.col.audio"]">
                                        @foreach (var language in episode.AudioLanguages)
                                        {
                                            <span class="admmd-lang">@language.ToUpperInvariant()</span>
                                        }
                                    </span>
                                    <span class="admmd-ep-langs" title="@ui["admin.media.col.subtitles"]">
                                        @foreach (var language in episode.SubtitleLanguages)
                                        {
                                            <span class="admmd-lang admmd-lang-quiet">@language.ToUpperInvariant()</span>
                                        }
                                    </span>
                                    <span class="admmd-ep-files">@episode.Files.Count</span>
                                    <span class="admmd-ep-size">@(episode.HasFiles ? Bytes(episode.SizeBytes) : "—")</span>
                                    <span class="admmd-ep-monitor">
                                        <form method="post" asp-page-handler="EpisodeMonitor" asp-route-id="@id">
                                            <input type="hidden" name="season" value="@episode.Season" />
                                            <input type="hidden" name="episode" value="@episode.Number" />
                                            <input type="hidden" name="monitored" value="@(episode.Monitored ? "false" : "true")" />
                                            <input type="hidden" name="open" value="@group.Key" />
                                            @if (aniList)
                                            {
                                                <input type="hidden" name="view" value="@AdminMediaDetailView.AniListView" />
                                            }
                                            <button class="admmd-toggle admmd-toggle-icon @(episode.Monitored ? "is-on" : "")"
                                                    type="submit" role="switch"
                                                    aria-checked="@(episode.Monitored ? "true" : "false")"
                                                    aria-label="@ui.Format(episode.Monitored ? "admin.media.unmonitorItem" : "admin.media.monitorItem", ("name", episodeName))"
                                                    disabled="@(!acquisition.Monitored)"
                                                    title="@(acquisition.Monitored ? null : ui["admin.media.monitorFirst"])">
                                                <span class="admin-switch" aria-hidden="true"></span>
                                            </button>
                                        </form>
                                    </span>
                                </summary>
                                <div class="admmd-ep-body">
                                    @if (!episode.HasFiles)
                                    {
                                        <p class="admmd-none">@ui["admin.media.noFiles"]</p>
                                    }
                                    else
                                    {
                                        <ul class="admmd-files">
                                            @foreach (var file in episode.Files)
                                            {
                                                <li class="admmd-file">
                                                    <div class="admmd-file-head">
                                                        <strong class="admmd-file-name">@file.Name</strong>
                                                        <span class="admmd-file-tags">
                                                            @if (file.Quality is not null)
                                                            {
                                                                <span class="admmd-tag">@file.Quality</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(file.VideoCodec))
                                                            {
                                                                <span class="admmd-tag">@AdminMediaDetailView.CodecLabel(file.VideoCodec)</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(file.Container))
                                                            {
                                                                <span class="admmd-tag">@file.Container</span>
                                                            }
                                                            <span class="admmd-tag">@Bytes(file.SizeBytes)</span>
                                                        </span>
                                                    </div>
                                                    <dl class="admmd-file-facts">
                                                        <div>
                                                            <dt>@ui["admin.media.col.audio"]</dt>
                                                            <dd>
                                                                @if (file.Audio.Count == 0)
                                                                {
                                                                    <span class="admmd-none">—</span>
                                                                }
                                                                @foreach (var track in file.Audio)
                                                                {
                                                                    <span class="admmd-track">@((track.Language ?? "?").ToUpperInvariant())@(AdminMediaDetailView.TrackLabel(track) is { Length: > 0 } label ? " " + label : "")</span>
                                                                }
                                                            </dd>
                                                        </div>
                                                        <div>
                                                            <dt>@ui["admin.media.col.subtitles"]</dt>
                                                            <dd>
                                                                @if (file.Subtitles.Count == 0)
                                                                {
                                                                    <span class="admmd-none">—</span>
                                                                }
                                                                @foreach (var track in file.Subtitles)
                                                                {
                                                                    <span class="admmd-track">@((track.Language ?? "?").ToUpperInvariant())@(string.IsNullOrEmpty(track.Codec) ? "" : " " + AdminMediaDetailView.CodecLabel(track.Codec))@(track.IsForced ? " · " + ui["admin.media.track.forced"] : "")</span>
                                                                }
                                                            </dd>
                                                        </div>
                                                        <div>
                                                            <dt>@ui["admin.media.file.location"]</dt>
                                                            <dd class="admmd-path">@(file.Location.Length == 0 ? "—" : file.Location)</dd>
                                                        </div>
                                                        <div>
                                                            <dt>@ui["admin.media.file.added"]</dt>
                                                            <dd><time datetime="@file.AddedUtc.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">@MediaDetailModel.Stamp(file.AddedUtc)</time></dd>
                                                        </div>
                                                    </dl>
                                                    @if (file.Analysis == MediaAnalysisStatus.Failed)
                                                    {
                                                        <p class="admmd-file-alert" role="alert">
                                                            @ui["admin.media.file.analysisFailed"]@(string.IsNullOrWhiteSpace(file.Diagnostic) ? "" : ": " + file.Diagnostic)
                                                        </p>
                                                    }
                                                    else if (file.Analysis != MediaAnalysisStatus.Succeeded)
                                                    {
                                                        <p class="admmd-file-pending">@ui["admin.media.file.notAnalysed"]</p>
                                                    }
                                                    <form method="post" asp-page-handler="ReanalyzeFile" asp-route-id="@id" class="admmd-file-actions">
                                                        <input type="hidden" name="fileId" value="@file.Id" />
                                                        <input type="hidden" name="open" value="@group.Key" />
                                                        <input type="hidden" name="ep" value="@episode.Key" />
                                                        @if (aniList)
                                                        {
                                                            <input type="hidden" name="view" value="@AdminMediaDetailView.AniListView" />
                                                        }
                                                        <button class="button" type="submit">@ui["admin.media.file.reanalyze"]</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @if (episode.Sidecars.Count > 0)
                                    {
                                        <p class="admmd-sidecars">
                                            <span>@ui["admin.media.sidecars"]</span>
                                            @foreach (var sidecar in episode.Sidecars)
                                            {
                                                <span class="admmd-track">@sidecar.Language.ToUpperInvariant() @sidecar.Format.ToUpperInvariant()@(sidecar.Forced ? " · " + ui["admin.media.track.forced"] : "")@(sidecar.Sdh ? " · SDH" : "")</span>
                                            }
                                        </p>
                                    }
                                </div>
                            </details>
                        </li>
                    }
                </ul>
            </details>
        }
    </div>
}

<div class="admmd-panels">
    <section class="admmd-panel" aria-labelledby="admmd-acquisition-title">
        <h2 id="admmd-acquisition-title">@ui["admin.media.acquisition.heading"]</h2>
        <p class="admmd-panel-facts">
            <span class="admmd-tag">@ModeLabel(acquisition.Mode)</span>
            <span>@(acquisition.Monitored ? ui.Format("admin.media.wantedCount", ("count", acquisition.WantedCount)) : ui["library.acquisitionPanel.notMonitored"])</span>
        </p>
        <form method="post" asp-page="/Acquisition/Index" asp-page-handler="AnimeSettings" class="admmd-form">
            <input type="hidden" name="animeId" value="@id" />
            <input type="hidden" name="returnUrl" value="@selfHref" />
            <input type="hidden" name="monitored" value="@(acquisition.Monitored ? "true" : "false")" />
            <partial name="_AdminMediaSettingsFields" model="acquisition" />
            <label class="admmd-field">
                <span>@ui["library.acquisitionPanel.qualityProfile"]</span>
                <select name="profileId">
                    @foreach (var (profileId, profileName) in acquisition.Profiles)
                    {
                        <option value="@profileId" selected="@profileId.Equals(acquisition.ProfileId, StringComparison.OrdinalIgnoreCase)">@profileName</option>
                    }
                </select>
            </label>
            <label class="admmd-check">
                <input type="checkbox" name="searchOnAdd" value="true" checked="@acquisition.SearchOnAdd" />
                <span>@ui["library.acquisitionPanel.searchWhenMonitoringStarts"]</span>
            </label>
            <button class="button" type="submit">@ui["common.save"]</button>
        </form>
        @if (detail.Imports.Count > 0)
        {
            <ul class="admmd-list" data-admin-media-imports>
                @foreach (var import in detail.Imports)
                {
                    <li>
                        <strong>@ImportLabel(import.Status)</strong>
                        @if (!string.IsNullOrWhiteSpace(import.Message))
                        {
                            <span>@import.Message</span>
                        }
                        <time datetime="@import.UpdatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">@MediaDetailModel.Stamp(import.UpdatedAtUtc)</time>
                    </li>
                }
            </ul>
            <a class="text-link" href="/Acquisition">@ui["admin.media.import.open"]</a>
        }
    </section>

    <section class="admmd-panel" aria-labelledby="admmd-mapping-title">
        <h2 id="admmd-mapping-title">@ui["admin.media.mapping.heading"]</h2>
        @if (detail.Mapping.Provider is null)
        {
            <p class="admmd-none">@ui["admin.media.mapping.none"]</p>
        }
        else
        {
            <p class="admmd-panel-facts">
                <strong>@detail.Mapping.Title</strong>
                <span>@detail.Mapping.Provider · ID @detail.Mapping.ExternalId</span>
            </p>
        }
        @if (detail.Mapping.RangesFailed)
        {
            <p class="admmd-notice admmd-notice-error" role="alert">@ui["admin.media.mapping.failed"]</p>
        }
        else if (detail.Mapping.Ranges.Count == 0)
        {
            <p class="admmd-none">@ui["library.anime.noExplicitRanges"]</p>
        }
        else
        {
            <ul class="admmd-list" data-admin-media-ranges>
                @foreach (var range in detail.Mapping.Ranges)
                {
                    var remoteEnd = range.RemoteEpisodeStart + (range.LocalEpisodeEnd - range.LocalEpisodeStart);
                    <li>
                        <strong>S@(range.SeasonNumber.ToString("00")) E@(range.LocalEpisodeStart.ToString("00"))–E@(range.LocalEpisodeEnd.ToString("00")) → @range.PreferredTitle</strong>
                        <span>@ui.Format("library.anime.aniListRange", ("start", range.RemoteEpisodeStart.ToString("00")), ("end", remoteEnd.ToString("00")))</span>
                    </li>
                }
            </ul>
        }
        <div class="admmd-panel-links">
            @if (Model.IsOwner)
            {
                <a class="button" href="/Library/Anime/@id#anime-manage">@ui["admin.media.mapping.edit"]</a>
            }
            <a class="text-link" href="/Library/AnimeRepair/@id">@ui["library.anime.repair"]</a>
        </div>
    </section>

    <section class="admmd-panel" aria-labelledby="admmd-activity-title">
        <h2 id="admmd-activity-title">@ui["admin.media.activity.heading"]</h2>
        @if (detail.ActivityFailed)
        {
            <p class="admmd-notice admmd-notice-error" role="alert">@ui["admin.media.activity.failed"]</p>
        }
        else if (detail.History.Count == 0 && detail.Operations.Count == 0)
        {
            <p class="admmd-none" data-admin-media-activity-empty>@ui["admin.media.activity.empty"]</p>
        }
        else
        {
            @if (detail.Operations.Count > 0)
            {
                <ul class="admmd-list" data-admin-media-operations>
                    @foreach (var operation in detail.Operations)
                    {
                        <li>
                            <a href="/Admin/Operation/@operation.Id">@operation.Title</a>
                            <span>@OperationStatusLabel(operation.Status)</span>
                            <time datetime="@operation.UpdatedAtUtc.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">@MediaDetailModel.Stamp(operation.UpdatedAtUtc)</time>
                        </li>
                    }
                </ul>
            }
            @if (detail.History.Count > 0)
            {
                <ul class="admmd-list" data-admin-media-history>
                    @foreach (var entry in detail.History)
                    {
                        <li>
                            <strong>@EventLabel(entry.EventKind)</strong>
                            <span>@AnimeDetailView.EpisodeCode(entry.SeasonNumber, entry.EpisodeNumber)@(string.IsNullOrWhiteSpace(entry.ReleaseTitle) ? "" : " · " + entry.ReleaseTitle)@(string.IsNullOrWhiteSpace(entry.QualityKey) ? "" : " · " + entry.QualityKey)</span>
                            @if (!string.IsNullOrWhiteSpace(entry.Reason))
                            {
                                <span class="admmd-reason">@entry.Reason</span>
                            }
                            <time datetime="@entry.OccurredAtUtc.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">@MediaDetailModel.Stamp(entry.OccurredAtUtc)</time>
                        </li>
                    }
                </ul>
            }
        }
    </section>
</div>
