@page "{id:guid}"
@model Jularr.Web.Pages.Admin.Music.ArtistModel
@using Jularr.Web.Features.Music
@{
    var ui = Model.Ui;
    var artist = Model.View!.Artist;
    ViewData["Title"] = artist.Name;
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-music.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
}

<header class="page-header">
    <div>
        <h1>@artist.Name</h1>
        <p><a class="text-link" asp-page="Index">@ui["admin.music.title"]</a></p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Notice is not null)
{
    <p class="metadata-notice" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<div class="admmusic">
    <section class="admmusic-panel" aria-label="@ui["admin.music.monitor.label"]">
        <div class="admmusic-toolbar">
            <form method="post" asp-page-handler="Monitor" asp-route-id="@artist.Id" class="admmusic-inline">
                <label for="monitor-mode">@ui["admin.music.monitor.label"]</label>
                <select id="monitor-mode" name="mode">
                    @foreach (var mode in new[] { MusicMonitorMode.All, MusicMonitorMode.Future, MusicMonitorMode.None })
                    {
                        <option value="@((int)mode)" selected="@(artist.Monitor == mode)">@Model.MonitorLabel(mode)</option>
                    }
                </select>
                <button class="button" type="submit">@ui["common.save"]</button>
            </form>
            <form method="post" asp-page-handler="Refresh" asp-route-id="@artist.Id" class="admmusic-inline">
                <button class="button" type="submit">@ui["admin.music.refresh"]</button>
            </form>
        </div>
    </section>

    <section class="admmusic-panel" aria-labelledby="admmusic-albums-heading">
        <h2 id="admmusic-albums-heading">@ui["admin.music.albums"]</h2>
        @if (Model.View.Albums.Count == 0)
        {
            <p class="admmusic-empty">@ui["admin.music.noAlbums"]</p>
        }
        else
        {
            <div class="admmusic-table-wrap">
                <table class="admmusic-table">
                    <thead>
                        <tr>
                            <th scope="col">@ui["admin.music.col.album"]</th>
                            <th scope="col">@ui["admin.music.col.type"]</th>
                            <th scope="col">@ui["admin.music.col.state"]</th>
                            <th scope="col" class="is-numeric">@ui["admin.music.col.tracks"]</th>
                            <th scope="col">@ui["admin.music.col.monitor"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var album in Model.View.Albums)
                        {
                            <tr id="album-@album.WorkId">
                                <td>
                                    <a class="admmusic-title" asp-page="Album" asp-route-workId="@album.WorkId">@album.Title</a>
                                    <span class="admmusic-sub">@(album.ReleaseDate is { } released ? released.ToString("yyyy-MM-dd") : album.Year?.ToString())</span>
                                </td>
                                <td>@Model.TypeLabel(album.Type)</td>
                                <td><span class="admin-tag admin-tag-@ArtistModel.StateTone(album.State)">@Model.StateLabel(album.State)</span></td>
                                <td class="is-numeric">@(album.Tracks == 0 ? "—" : $"{album.TracksWithFiles}/{album.Tracks}")</td>
                                <td>
                                    <form method="post" asp-page-handler="Album" asp-route-id="@artist.Id" class="admmusic-inline">
                                        <input type="hidden" name="workId" value="@album.WorkId" />
                                        <input type="hidden" name="monitored" value="@((!album.Monitored).ToString().ToLowerInvariant())" />
                                        <button class="button button-small button-quiet" type="submit" aria-pressed="@(album.Monitored ? "true" : "false")" aria-label="@ui["admin.music.monitorAlbum"]">@(album.Monitored ? ui["admin.music.monitored"] : ui["admin.music.unmonitored"])</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
