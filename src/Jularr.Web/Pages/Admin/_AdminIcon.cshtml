@model string
@* Decorative outline glyph of an Admin worklist action; the action's name is always next to it or in its accessible name. *@
<svg class="admin-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "refresh":
            <path d="M13.25 8a5.25 5.25 0 1 1-1.54-3.71M13.25 2.75v2.5h-2.5" />
            break;
        case "search":
            <circle cx="7" cy="7" r="4.25" />
            <path d="m10.25 10.25 3.5 3.5" />
            break;
        case "eye":
            <path d="M1.75 8s2.25-4.5 6.25-4.5S14.25 8 14.25 8 12 12.5 8 12.5 1.75 8 1.75 8Z" />
            <circle cx="8" cy="8" r="1.75" />
            break;
        case "check":
            <path d="m3.5 8.5 3 3 6-7" />
            break;
        case "more":
            <circle cx="3.5" cy="8" r=".6" />
            <circle cx="8" cy="8" r=".6" />
            <circle cx="12.5" cy="8" r=".6" />
            break;
    }
</svg>
