@model string
@* Decorative outline glyph of an Admin worklist action; the action's name is always next to it or in its accessible name. *@
<svg class="admin-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "refresh":
            <path d="M13.25 8a5.25 5.25 0 1 1-1.54-3.71M13.25 2.75v2.5h-2.5" />
            break;
        case "search":
            <circle cx="7" cy="7" r="4.25" />
            <path d="m10.25 10.25 3.5 3.5" />
            break;
        case "eye":
            <path d="M1.75 8s2.25-4.5 6.25-4.5S14.25 8 14.25 8 12 12.5 8 12.5 1.75 8 1.75 8Z" />
            <circle cx="8" cy="8" r="1.75" />
            break;
        case "check":
            <path d="m3.5 8.5 3 3 6-7" />
            break;
        case "more":
            <circle cx="3.5" cy="8" r=".6" />
            <circle cx="8" cy="8" r=".6" />
            <circle cx="12.5" cy="8" r=".6" />
            break;
        case "power":
            <path d="M8 1.75v5.5M4.6 4.2a5.25 5.25 0 1 0 6.8 0" />
            break;
        case "sessions":
            <rect x="1.75" y="2.75" width="12.5" height="8.5" rx="1.5" />
            <path d="M5.5 14h5M8 11.25V14" />
            break;
        case "folder":
            <path d="M1.75 4.25a1 1 0 0 1 1-1h3.1l1.4 1.6h5a1 1 0 0 1 1 1v6.4a1 1 0 0 1-1 1h-9.5a1 1 0 0 1-1-1Z" />
            break;
        case "chip":
            <rect x="4" y="4" width="8" height="8" rx="1.5" />
            <path d="M6.5 1.75v2.25M9.5 1.75v2.25M6.5 12v2.25M9.5 12v2.25M1.75 6.5H4M1.75 9.5H4M12 6.5h2.25M12 9.5h2.25" />
            break;
        case "play":
            <path d="M5 3.25v9.5l7.5-4.75Z" />
            break;
        case "stack":
            <path d="m8 2 6.25 3.25L8 8.5 1.75 5.25Z" />
            <path d="m1.75 8.25 6.25 3.25 6.25-3.25M1.75 11l6.25 3.25L14.25 11" />
            break;
        case "disk":
            <rect x="1.75" y="3.5" width="12.5" height="9" rx="2" />
            <path d="M1.75 9.25h12.5M11.5 11.25h.01" />
            break;
        case "globe":
            <circle cx="8" cy="8" r="6.25" />
            <path d="M1.75 8h12.5M8 1.75c1.8 1.9 2.7 4 2.7 6.25S9.8 12.35 8 14.25C6.2 12.35 5.3 10.25 5.3 8S6.2 3.65 8 1.75Z" />
            break;
        case "alert":
            <circle cx="8" cy="8" r="6.25" />
            <path d="M8 4.75V8.5M8 11h.01" />
            break;
        case "trash":
            <path d="M2.5 4.25h11M6.25 4.25V2.75h3.5v1.5M4 4.25l.6 8.5h6.8l.6-8.5M6.5 7v3.5M9.5 7v3.5" />
            break;
        case "wand":
            <path d="m2 14 7-7M9.5 2.25v2M8.5 3.25h2M13 6.5v2M12 7.5h2M12.25 2.5l-.01.01" />
            <path d="m8.5 6.5 1 1" />
            break;
        case "link":
            <path d="M6.75 9.25a2.75 2.75 0 0 0 3.9 0l2-2a2.75 2.75 0 0 0-3.9-3.9l-.6.6M9.25 6.75a2.75 2.75 0 0 0-3.9 0l-2 2a2.75 2.75 0 0 0 3.9 3.9l.6-.6" />
            break;
        case "edit":
            <path d="M2.5 13.5h2.7l7.4-7.4a1.4 1.4 0 0 0 0-2l-.7-.7a1.4 1.4 0 0 0-2 0L2.5 10.8Z" />
            break;
        case "columns":
            <rect x="2" y="2.5" width="12" height="11" rx="1.5" />
            <path d="M6 2.5v11M10 2.5v11" />
            break;
        case "screen-play":
            <rect x="1.75" y="2.75" width="12.5" height="9" rx="1.5" />
            <path d="M6.75 5.25v4l3.25-2ZM5.5 14h5" />
            break;
        case "film":
            <rect x="2" y="2.5" width="12" height="11" rx="1.5" />
            <path d="M5 2.5v11M11 2.5v11M2 6h3M2 10h3M11 6h3M11 10h3" />
            break;
        case "tv":
            <rect x="1.75" y="4" width="12.5" height="8.5" rx="1.5" />
            <path d="m5.5 1.75 2.5 2.25 2.5-2.25" />
            break;
        case "book":
            <path d="M8 3.75C6.9 2.9 5 2.5 2.25 2.75v9.5C5 12 6.9 12.4 8 13.25c1.1-.85 3-1.25 5.75-1v-9.5C11 2.5 9.1 2.9 8 3.75ZM8 3.75v9.5" />
            break;
        case "headphones":
            <path d="M2.5 9.5V8a5.5 5.5 0 0 1 11 0v1.5" />
            <rect x="2" y="9.25" width="3" height="4.5" rx="1" />
            <rect x="11" y="9.25" width="3" height="4.5" rx="1" />
            break;
        case "document":
            <path d="M4 1.75h5.5l3 3v9.5H4Z" />
            <path d="M9.25 1.75v3.25h3.25M6 8h4.5M6 10.5h4.5" />
            break;
        case "cap":
            <path d="m8 3 6.25 3L8 9 1.75 6Z" />
            <path d="M4 7.5v3c0 .8 1.8 1.75 4 1.75s4-.95 4-1.75v-3" />
            break;
        case "download":
            <path d="M8 2.75v7.5M4.75 7.5 8 10.75l3.25-3.25M3 13.25h10" />
            break;
        case "chart":
            <rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5" />
            <path d="m4.5 10.5 2.5-3 2 1.75 2.5-3.5" />
            break;
    }
    }
</svg>
