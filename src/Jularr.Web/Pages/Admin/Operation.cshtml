@page "{id:guid}"
@model Jularr.Web.Pages.Admin.OperationModel
@using Jularr.Web.Features.Operations
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Acquisition.DownloadClients
@using Jularr.Web.Features.Acquisition.Import
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.Operation.Title;
    var operation = Model.Operation;
    var dash = "—";

    string OperationStatusLabel(OperationStatus status) => status switch
    {
        OperationStatus.Queued => ui["admin.operations.status.queued"],
        OperationStatus.Running => ui["admin.operations.status.running"],
        OperationStatus.Succeeded => ui["admin.operations.status.succeeded"],
        OperationStatus.Failed => ui["admin.operations.status.failed"],
        OperationStatus.Cancelled => ui["admin.operations.status.cancelled"],
        OperationStatus.Interrupted => ui["admin.operations.status.interrupted"],
        _ => status.ToString()
    };

    string MediaLabel(MediaAcquisitionKind kind) => ui[MediaKindLabelKeys.Operation(kind)];

    string ImportStateLabel(DownloadImportState state) => state switch
    {
        DownloadImportState.Waiting => ui["admin.operation.importState.waiting"],
        DownloadImportState.Verifying => ui["admin.operation.importState.verifying"],
        DownloadImportState.Importing => ui["admin.operation.importState.importing"],
        DownloadImportState.MatchingMetadata => ui["admin.operation.importState.matchingMetadata"],
        DownloadImportState.Completed => ui["admin.operation.importState.completed"],
        DownloadImportState.Rejected => ui["admin.operation.importState.rejected"],
        DownloadImportState.GaveUp => ui["admin.operation.importState.gaveUp"],
        DownloadImportState.ManualReview => ui["admin.operation.importState.manualReview"],
        DownloadImportState.Failed => ui["admin.operation.importState.failed"],
        _ => state.ToString()
    };

    string ImportModeLabel(ImportMode? mode) => mode switch
    {
        null => ui["admin.operation.readInPlace"],
        ImportMode.Move => ui["settings.acquisition.importMode.move"],
        ImportMode.Copy => ui["settings.acquisition.importMode.copy"],
        ImportMode.Hardlink => ui["settings.acquisition.importMode.hardlink"],
        ImportMode.HardlinkOrCopy => ui["settings.acquisition.importMode.hardlinkOrCopy"],
        _ => mode.Value.ToString()
    };

    string LogLevelLabel(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Information => ui["admin.logs.level.information"],
        OperationLogLevel.Warning => ui["admin.logs.level.warning"],
        OperationLogLevel.Error => ui["admin.logs.level.error"],
        _ => level.ToString()
    };
}

<header class="page-header">
    <div>
        <h1>@operation.Title</h1>
        <p>@operation.Category · @operation.Kind</p>
    </div>
    @if (Model.BackToHistory is { } backToHistory)
    {
        <a class="button" href="@backToHistory">@ui["admin.operation.backToHistory"]</a>
    }
    else
    {
        <a class="button" href="@(Model.BackToActivity ?? "/Admin/Operations")">@ui["admin.operation.backToOperations"]</a>
    }
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.operation.status"]</h2>
            <span class="status-pill operation-status-@operation.Status.ToString().ToLowerInvariant()">
                @OperationStatusLabel(operation.Status)
            </span>
        </div>

        <div class="status-list">
            <div><span>@ui["admin.operation.lane"]</span><strong>@operation.Lane</strong></div>
            <div><span>@ui["admin.operation.attempt"]</span><strong>@operation.Attempt</strong></div>
            <div><span>@ui["admin.operation.created"]</span><strong>@operation.CreatedAtUtc.ToLocalTime().ToString("g")</strong></div>
            <div><span>@ui["admin.operation.started"]</span><strong>@(operation.StartedAtUtc?.ToLocalTime().ToString("g") ?? dash)</strong></div>
            <div><span>@ui["admin.operation.finished"]</span><strong>@(operation.FinishedAtUtc?.ToLocalTime().ToString("g") ?? dash)</strong></div>
            @if (!string.IsNullOrWhiteSpace(operation.ProfileId))
            {
                <div><span>@ui["admin.operation.user"]</span><strong>@operation.ProfileId</strong></div>
            }
            <div><span>@ui["admin.operation.performedBy"]</span><strong>@(Model.ActorName ?? ui["admin.history.actor.system"])</strong></div>
            @if (!string.IsNullOrWhiteSpace(operation.Subject))
            {
                <div><span>@ui["admin.operation.subject"]</span><strong>@operation.Subject</strong></div>
            }
        </div>

        @if (operation.ProgressPercent is { } progress)
        {
            <div class="operation-progress operation-progress-large">
                <span style="width:@progress%"></span>
            </div>
            <p class="muted">@ui.Format("admin.operation.progressComplete", ("percent", progress))</p>
        }

        @if (!string.IsNullOrWhiteSpace(operation.Message))
        {
            <p>@operation.Message</p>
        }

        @if (!string.IsNullOrWhiteSpace(operation.Error))
        {
            <div class="operation-error">@operation.Error</div>
        }

        <div class="inline-actions">
            @if (Model.CanCancel)
            {
                <form method="post" asp-page-handler="Cancel">
                    <input type="hidden" name="id" value="@operation.Id" />
                    <button class="button" type="submit">@ui["common.cancel"]</button>
                </form>
            }

            @if (operation.Retryable
                && operation.Status is OperationStatus.Failed
                    or OperationStatus.Interrupted)
            {
                <form method="post" asp-page-handler="Retry">
                    <input type="hidden" name="id" value="@operation.Id" />
                    <button class="button button-primary"
                            type="submit"
                            disabled="@(!Model.RuntimeAvailable)">@ui["admin.operation.retry"]</button>
                </form>
            }
        </div>

        @if (operation.Retryable
            && operation.Status is OperationStatus.Failed
                or OperationStatus.Interrupted
            && !Model.RuntimeAvailable)
        {
            <small class="muted">@ui["admin.operation.retryPayloadUnavailable"]</small>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.operation.download"]</h2></div>
        @if (!operation.IsDownload)
        {
            <p class="muted">@ui["admin.operation.notDownload"]</p>
        }
        else
        {
            <div class="status-list">
                <div><span>@ui["admin.operation.downloaded"]</span><strong>@ui.Format("admin.operation.bytesValue", ("bytes", operation.BytesCompleted?.ToString("N0") ?? dash))</strong></div>
                <div><span>@ui["admin.operation.total"]</span><strong>@(operation.BytesTotal?.ToString("N0") ?? ui["admin.operation.unknown"])</strong></div>
                <div><span>@ui["admin.operation.speed"]</span><strong>@(operation.BytesPerSecond is { } speed ? ui.Format("admin.operation.speedValue", ("speed", $"{speed / 1024d:N1}")) : dash)</strong></div>
                <div><span>@ui["admin.operation.eta"]</span><strong>@(operation.EtaUtc?.ToLocalTime().ToString("T") ?? dash)</strong></div>
                @if (Model.IsSabnzbdJob)
                {
                    <div><span>@ui["admin.operation.sabnzbdJob"]</span><strong>@operation.ExternalId</strong></div>
                }
                @if (Model.DownloadDetails is { } routing)
                {
                    <div><span>@ui["admin.operation.mediaType"]</span><strong>@MediaLabel(routing.MediaKind)</strong></div>
                    @if (Model.MediaLink is { } mediaLink)
                    {
                        <div><span>@ui["admin.operation.media"]</span><strong><a class="text-link" href="@mediaLink">@(string.IsNullOrWhiteSpace(operation.Subject) ? ui["admin.media.manage"] : operation.Subject)</a></strong></div>
                    }
                    <div><span>@ui["admin.operation.downloadCategory"]</span><strong>@(routing.Category ?? dash)</strong></div>
                }
            </div>
        }
    </section>

    @if (Model.DownloadDetails is { } download && (download.Import is not null || operation.Status == OperationStatus.Succeeded))
    {
        var import = download.Import;
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["admin.operation.import"]</h2>
                @if (import is not null)
                {
                    <span>@ImportStateLabel(import.State)</span>
                }
            </div>
            @if (import is null)
            {
                <p class="muted">@ui["admin.operation.notImportedYet"]</p>
            }
            else
            {
                <div class="status-list">
                    <div><span>@ui["admin.operation.reportedPath"]</span><strong>@(import.ReportedPath ?? dash)</strong></div>
                    <div><span>@ui["admin.operation.localPath"]</span><strong>@(import.LocalPath ?? dash)</strong></div>
                    <div><span>@ui["admin.operation.destination"]</span><strong>@(import.Destination ?? dash)</strong></div>
                    <div><span>@ui["admin.operation.importMode"]</span><strong>@(import.Destination is null ? dash : ImportModeLabel(import.Mode))</strong></div>
                    <div><span>@ui["admin.operation.importUpdated"]</span><strong>@import.UpdatedAtUtc.ToLocalTime().ToString("g")</strong></div>
                </div>
                <p>@import.Result</p>
            }
        </section>
    }

    @if (Model.Acquisition is { } acquisition && Model.AcquisitionAttempt is { } attempt)
    {
        <section class="panel">
            <div class="panel-heading"><h2>@ui["admin.operation.acquisition"]</h2></div>
            <div class="status-list">
                <div><span>@ui["admin.operation.anime"]</span><strong>@acquisition.AnimeTitle</strong></div>
                <div><span>@ui["admin.operation.episodes"]</span><strong>@Jularr.Web.Features.Acquisition.Sabnzbd.SabnzbdAcquisitionService.FormatEpisodes(acquisition.Episodes)</strong></div>
                <div><span>@ui["admin.operation.release"]</span><strong>@attempt.ReleaseTitle</strong></div>
                <div><span>@ui["admin.operation.attempt"]</span><strong>@ui.Format("admin.operation.attemptOf", ("attempt", attempt.Number), ("max", acquisition.MaxAttempts))</strong></div>
                <div><span>@ui["admin.operation.untriedCandidates"]</span><strong>@acquisition.PendingCandidates.Length</strong></div>
            </div>

            @if (acquisition.Attempts.Length > 1)
            {
                <h3>@ui["admin.operation.attempts"]</h3>
                <ul>
                    @foreach (var other in acquisition.Attempts.OrderBy(item => item.Number))
                    {
                        <li>
                            <a asp-page="/Admin/Operation" asp-route-id="@other.OperationId">#@other.Number</a>
                            @other.ReleaseTitle
                        </li>
                    }
                </ul>
            }

            @if (Model.AcquisitionBlocklist.Count > 0)
            {
                <h3>@ui["admin.operation.blocklistedReleases"]</h3>
                <ul>
                    @foreach (var blocked in Model.AcquisitionBlocklist)
                    {
                        <li><strong>@blocked.ReleaseTitle</strong> — @blocked.Reason</li>
                    }
                </ul>
            }
        </section>
    }
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.operation.log"]</h2>
        <div class="inline-actions">
            @if (operation.Kind == Jularr.Web.Features.Library.LibraryScanCoordinator.OperationKind)
            {
                <a class="button" asp-page="/Admin/Scans">@ui["admin.operation.scanHistory"]</a>
            }
            <a class="button" asp-page="/Admin/Logs" asp-route-operationId="@operation.Id">@ui["admin.operation.openInLogs"]</a>
        </div>
    </div>

    @if (Model.Logs.Count == 0)
    {
        <p class="muted">@ui["admin.operation.noLogEntries"]</p>
    }
    else
    {
        <div class="admin-log-list">
            @foreach (var entry in Model.Logs)
            {
                <div class="admin-log-row admin-log-@entry.Level.ToString().ToLowerInvariant()">
                    <time>@entry.CreatedAtUtc.ToLocalTime().ToString("G")</time>
                    <span>@LogLevelLabel(entry.Level)</span>
                    <strong>@entry.Module</strong>
                    <p>@entry.Message</p>
                </div>
            }
        </div>
    }
</section>
