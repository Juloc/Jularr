@model Jularr.Web.Features.Localization.UiTextBundle
@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.Instance
@using Jularr.Web.Features.Localization
@using Microsoft.Extensions.DependencyInjection
@* The Admin tab row of phones and tablets (the desktop sidebar lists the same pages). It renders from UiNavigationCatalog like the sidebar, so
   the two cannot disagree about which destinations exist, where they sit or which belong to Legacy. *@
@{
    var ui = Model;
    var moduleService = Context.RequestServices.GetService<IInstanceModuleService>();
    var instanceModules = moduleService is null
        ? InstanceModuleSettings.Default
        : await moduleService.GetAsync(Context.RequestAborted);
    var enabledModules = instanceModules.Modules.Where(pair => pair.Value).Select(pair => pair.Key).ToHashSet();
    var nav = UiShellNavigation.Build(Context.Request.Path, learningVisible: true, policy => JularrPolicies.Allows(User, policy), enabledInstanceModules: enabledModules);
    var groups = nav.Expanded?.Groups ?? [];
}
<nav class="admin-nav" aria-label="@ui["nav.admin"]">
    @foreach (var group in groups)
    {
        foreach (var item in group.Items)
        {
            <a class="admin-nav-item@(item.IsActive ? " active" : "")@(group.TitleKey == "nav.group.adminLegacy" ? " is-legacy" : "")"
               href="@item.Href"
               aria-current="@(item.IsCurrentPage ? "page" : null)"
               title="@(group.TitleKey == "nav.group.adminLegacy" ? ui["nav.group.adminLegacy"] : null)">@ui[item.LabelKey]</a>
        }
    }
</nav>
