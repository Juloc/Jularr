@model Jularr.Web.Features.Localization.UiTextBundle
@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.Instance
@using Microsoft.Extensions.DependencyInjection
@{
    var ui = Model;
    var path = Context.Request.Path;
    var moduleService = Context.RequestServices.GetService<IInstanceModuleService>();
    var instanceModules = moduleService is null
        ? InstanceModuleSettings.Default
        : await moduleService.GetAsync(Context.RequestAborted);
    var acquisitionEnabled = instanceModules.IsEnabled(InstanceModule.Acquisition);
    string[] systemPaths = ["/Admin/System", "/Admin/Transcoding", "/Admin/Subtitles", "/Admin/Sonarr", "/Admin/Ai"];
}
<nav class="admin-nav" aria-label="@ui["nav.admin"]">
    <a class="admin-nav-item @(path == "/Admin" ? "active" : "")" asp-page="/Admin/Index">@ui["admin.nav.overview"]</a>
    <a class="admin-nav-item @((path.StartsWithSegments("/Admin/Resources") || path.StartsWithSegments("/Admin/Database")) ? "active" : "")" asp-page="/Admin/Resources">@ui["admin.nav.resources"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Users") || path.StartsWithSegments("/Admin/User") || path.StartsWithSegments("/Admin/Roles") || path.StartsWithSegments("/Admin/Capabilities") ? "active" : "")" asp-page="/Admin/Users">@ui["admin.nav.users"]</a>
    @if (acquisitionEnabled)
    {
        <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Requests") ? "active" : "")" asp-page="/Admin/Requests">@ui["admin.nav.requests"]</a>
        <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Wanted") ? "active" : "")" asp-page="/Admin/Wanted">@ui["admin.nav.wanted"]</a>
        <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Usenet") || path.StartsWithSegments("/Settings/Indexers") || path.StartsWithSegments("/Settings/DownloadClients") ? "active" : "")" asp-page="/Admin/Usenet">@ui["admin.nav.usenet"]</a>
    }
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Operations") || path.StartsWithSegments("/Admin/Operation") ? "active" : "")" asp-page="/Admin/Operations">@ui["admin.nav.operations"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/History") ? "active" : "")" asp-page="/Admin/History">@ui["admin.nav.history"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Sessions") ? "active" : "")" asp-page="/Admin/Sessions">@ui["admin.nav.sessions"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Scans") ? "active" : "")" asp-page="/Admin/Scans">@ui["admin.nav.scans"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Logs") ? "active" : "")" asp-page="/Admin/Logs">@ui["admin.nav.logs"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Appearance") ? "active" : "")" asp-page="/Admin/Appearance">@ui["admin.nav.appearance"]</a>
    <a class="admin-nav-item @(path.StartsWithSegments("/Admin/Instance") ? "active" : "")" asp-page="/Admin/Instance">@ui["admin.nav.instance"]</a>
    <a class="admin-nav-item @(systemPaths.Any(system => path.StartsWithSegments(system)) ? "active" : "")" asp-page="/Admin/System">@ui["admin.nav.system"]</a>
</nav>
