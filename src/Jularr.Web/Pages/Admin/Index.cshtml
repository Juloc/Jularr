@page
@model Jularr.Web.Pages.Admin.IndexModel
@using System.Globalization
@using Jularr.Web.Features.Acquisition.Wanted
@using Jularr.Web.Features.Admin
@using Jularr.Web.Features.Health
@using Jularr.Web.Features.Operations
@using Jularr.Web.Features.Playback.Decision
@using Jularr.Web.Features.Storage
@section Head {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.dashboard.title"];
    var snapshot = Model.Snapshot;
    var now = snapshot.GeneratedAtUtc;
    var problems = snapshot.Problems;
    var refreshHref = "/Admin";

    string Age(DateTime thenUtc)
    {
        var (unit, count) = AdminWantedQuery.AgeOf(thenUtc, now);
        var number = count.ToString(CultureInfo.InvariantCulture);
        return unit switch
        {
            WantedAgeUnit.Minutes => ui.Format("admin.wanted.age.minutes", ("count", number)),
            WantedAgeUnit.Hours => ui.Format("admin.wanted.age.hours", ("count", number)),
            WantedAgeUnit.Days => ui.Format("admin.wanted.age.days", ("count", number)),
            _ => ui["admin.wanted.age.now"]
        };
    }

    static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture);
    static string Stamp(DateTime value) => value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
    string Percent(double value) => ui.Format("admin.dashboard.percent", ("value", Math.Round(value).ToString("0", CultureInfo.InvariantCulture)));
    string Bytes(long value) => StorageHealth.FormatBytes(value);
    string StatusLabel(OperationStatus status) => ui["admin.operations.status." + AdminActivityQuery.StatusName(status)];

    string ServiceName(DashboardServiceKind kind) => kind switch
    {
        DashboardServiceKind.Web => ui["admin.dashboard.service.web"],
        DashboardServiceKind.Database => ui["admin.dashboard.service.database"],
        DashboardServiceKind.Storage => ui["admin.dashboard.service.storage"],
        DashboardServiceKind.DownloadClients => ui["admin.dashboard.service.clients"],
        DashboardServiceKind.Indexers => ui["admin.dashboard.service.indexers"],
        DashboardServiceKind.Metadata => ui["admin.dashboard.service.metadata"],
        _ => ui["admin.dashboard.service.subtitles"]
    };

    string ServiceHref(DashboardServiceKind kind) => kind switch
    {
        DashboardServiceKind.Web or DashboardServiceKind.Database => "/Admin/Health",
        DashboardServiceKind.DownloadClients or DashboardServiceKind.Indexers => "/Admin/Usenet",
        DashboardServiceKind.Subtitles => "/Admin/Subtitles",
        _ => "/Admin/System"
    };

    string StateName(DashboardState state) => state switch
    {
        DashboardState.Online => "online",
        DashboardState.Warning => "warning",
        DashboardState.Error => "error",
        _ => "neutral"
    };

    string StateLabel(DashboardServiceTile tile) => tile.State switch
    {
        DashboardState.Online => ui["admin.dashboard.state.online"],
        DashboardState.Warning => ui["admin.dashboard.state.warning"],
        DashboardState.Error => ui["admin.dashboard.state.error"],
        _ => tile.Kind is DashboardServiceKind.Metadata or DashboardServiceKind.Subtitles
            ? ui["admin.dashboard.state.noActivity"]
            : ui["admin.dashboard.state.notConfigured"]
    };

    string RootStateLabel(StorageHealthState? health) => health switch
    {
        StorageHealthState.Online => ui["admin.system.health.online"],
        StorageHealthState.Starting => ui["admin.system.health.starting"],
        StorageHealthState.OfflineExpected => ui["admin.system.health.sleeping"],
        StorageHealthState.OfflineUnexpected => ui["admin.system.health.unavailable"],
        StorageHealthState.Error => ui["admin.system.health.error"],
        _ => ui["admin.dashboard.state.unchecked"]
    };

    string RootStateClass(StorageHealthState? health) => health switch
    {
        StorageHealthState.Online => "online",
        StorageHealthState.Starting or StorageHealthState.OfflineExpected => "warning",
        StorageHealthState.OfflineUnexpected or StorageHealthState.Error => "error",
        _ => "neutral"
    };

    string ProblemText(DashboardProblem problem) => ui.Format(
        "admin.dashboard.problem." + problem.Code,
        ("name", problem.Name),
        ("count", problem.Count),
        ("value", problem.Bytes is { } bytes ? Bytes(bytes) : null));

    string Summary(int running, int queued) => ui.Format("admin.dashboard.summary", ("running", running), ("queued", queued));

    var resources = snapshot.Resources;
    var currentResources = resources.Current;
    var resourcesAvailable = currentResources is { IsComplete: true };
    double[] jularrCpu = resources.History.Where(sample => sample.Jularr?.CpuPercent is not null).Select(sample => sample.Jularr!.CpuPercent!.Value).ToArray();
    double[] postgresCpu = resources.History.Where(sample => sample.PostgreSql?.CpuPercent is not null).Select(sample => sample.PostgreSql!.CpuPercent!.Value).ToArray();
    double[] jularrMemory = resources.History.Where(sample => sample.Jularr is not null).Select(sample => (double)sample.Jularr!.MemoryBytes).ToArray();
    double[] postgresMemory = resources.History.Where(sample => sample.PostgreSql is not null).Select(sample => (double)sample.PostgreSql!.MemoryBytes).ToArray();
    var cpuMaximum = Math.Max(100d, new[] { jularrCpu.DefaultIfEmpty(0).Max(), postgresCpu.DefaultIfEmpty(0).Max() }.Max());
    var memoryMaximum = Math.Max(1d, new[] { jularrMemory.DefaultIfEmpty(0).Max(), postgresMemory.DefaultIfEmpty(0).Max() }.Max());
    string ChartPoints(double[] values, double maximum)
    {
        if (values.Length < 2 || maximum <= 0)
        {
            return string.Empty;
        }

        return string.Join(" ", values.Select((value, index) => string.Create(CultureInfo.InvariantCulture, $"{50 + 560d * index / (values.Length - 1):0.##},{196 - Math.Clamp(value / maximum, 0, 1) * 176:0.##}")));
    }
    var storage = snapshot.Storage;
}

<header class="page-header">
    <div>
        <h1>@ui["admin.dashboard.title"]</h1>
    </div>
    <div class="inline-actions">
        <time class="admdash-updated" datetime="@Iso(snapshot.GeneratedAtUtc)">@ui.Format("admin.dashboard.updated", ("time", snapshot.GeneratedAtUtc.ToString("HH:mm:ss", CultureInfo.InvariantCulture) + " UTC"))</time>
        <a class="button" href="@refreshHref">@ui["admin.activity.refresh"]</a>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<div class="admdash">
    @* Problems first; when nothing is wrong the area shrinks to one calm line. *@
    @if (problems.Count > 0)
    {
        <section class="panel admdash-panel" aria-labelledby="admdash-problems">
            <div class="panel-heading">
                <h2 id="admdash-problems">@ui["admin.dashboard.problems.title"] <span class="admdash-count">@problems.Count</span></h2>
            </div>
            <ul class="admdash-problems">
                @foreach (var problem in problems)
                {
                    var severity = problem.Severity == DashboardSeverity.Error ? "error" : "warning";
                    <li>
                        <a class="admdash-problem" href="@problem.Href" data-problem="@problem.Code">
                            <span class="admdash-problem-icon admdash-tone-@severity"><partial name="_HistoryIcon" model="@(severity == "error" ? "failed" : "warning")" /></span>
                            <span class="admdash-problem-copy">
                                <span>@ProblemText(problem)</span>
                                @if (!string.IsNullOrWhiteSpace(problem.Detail))
                                {
                                    <small>@problem.Detail</small>
                                }
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
    else if (snapshot.HealthComplete)
    {
        <p class="admdash-calm" data-admin-dashboard-calm>
            <span class="admdash-tone-online"><partial name="_HistoryIcon" model="@("success")" /></span>
            @ui["admin.dashboard.calm"]
        </p>
    }

    @if (!snapshot.HealthComplete)
    {
        <div class="admdash-message" role="alert" data-admin-dashboard-partial>
            <p>@ui["admin.dashboard.partial"]</p>
            <a class="button" href="@refreshHref">@ui["admin.requests.retry"]</a>
        </div>
    }

    <section class="panel admdash-panel" aria-labelledby="admdash-services">
        <div class="panel-heading">
            <h2 id="admdash-services">@ui["admin.dashboard.services.title"]</h2>
        </div>
        <ul class="admdash-services">
            @foreach (var tile in snapshot.Services)
            {
                var tone = StateName(tile.State);
                <li>
                    <a class="admdash-service" href="@ServiceHref(tile.Kind)" data-service="@tile.Kind.ToString().ToLowerInvariant()">
                        <strong>@ServiceName(tile.Kind)</strong>
                        <span class="admdash-state admdash-tone-@tone"><span class="admdash-dot" aria-hidden="true"></span>@StateLabel(tile)</span>
                        @if (tile.Total > 0)
                        {
                            <small>@ui.Format("admin.dashboard.service.online", ("healthy", tile.Healthy), ("total", tile.Total))</small>
                        }
                        @if (tile.LatencyMs is { } latency)
                        {
                            <small>@ui.Format("admin.dashboard.service.latency", ("ms", Math.Round(latency).ToString("0", CultureInfo.InvariantCulture)))</small>
                        }
                        @if (tile.Version is not null)
                        {
                            <small>@ui.Format("admin.dashboard.service.version", ("version", tile.Version))</small>
                        }
                        @if (tile.Uptime is { } uptime)
                        {
                            <small>@ui.Format("admin.dashboard.service.uptime", ("time", AdminDashboardFormat.Duration(ui, uptime)))</small>
                        }
                        @if (tile.State is DashboardState.Warning or DashboardState.Error && !string.IsNullOrWhiteSpace(tile.Reason))
                        {
                            <small class="admdash-reason">@tile.Reason</small>
                        }
                    </a>
                </li>
            }
        </ul>
    </section>

    <div class="admdash-row admdash-row-resources">
        <section class="panel admdash-panel" aria-labelledby="admdash-resources">
            <div class="panel-heading">
                <h2 id="admdash-resources">@ui["admin.dashboard.resources.title"]</h2>
            </div>
            @if (!resourcesAvailable)
            {
                <p class="muted" data-stack-resources-unavailable>@ui["admin.dashboard.resources.unavailable"]</p>
            }
            else
            {
                var jularr = currentResources!.Jularr!;
                var postgres = currentResources.PostgreSql!;
                <div class="admdash-metrics admdash-stack-metrics" data-stack-resources>
                    <div class="admdash-metric admdash-stack-total" data-metric="stack-total">
                        <span class="admdash-metric-label">@ui["admin.dashboard.resources.total"]</span>
                        <strong class="admdash-metric-value">@(currentResources.TotalCpuPercent is { } totalCpu ? Percent(totalCpu) : "—")</strong>
                        <small>@ui.Format("admin.dashboard.resources.cpuMemory", ("memory", Bytes(currentResources.TotalMemoryBytes!.Value)))</small>
                    </div>
                    <div class="admdash-metric" data-metric="jularr">
                        <span class="admdash-metric-label">@ui["admin.dashboard.service.web"]</span>
                        <strong class="admdash-metric-value">@(jularr.CpuPercent is { } cpu ? Percent(cpu) : "—")</strong>
                        <small>@ui.Format("admin.dashboard.resources.cpuMemory", ("memory", Bytes(jularr.MemoryBytes)))</small>
                    </div>
                    <div class="admdash-metric" data-metric="postgresql">
                        <span class="admdash-metric-label">@ui["admin.dashboard.service.database"]</span>
                        <strong class="admdash-metric-value">@(postgres.CpuPercent is { } postgresCpuValue ? Percent(postgresCpuValue) : "—")</strong>
                        <small>@ui.Format("admin.dashboard.resources.cpuMemory", ("memory", Bytes(postgres.MemoryBytes)))</small>
                    </div>
                </div>
                <div class="admdash-stack-network" data-stack-network>
                    <span class="admdash-metric-label">@ui["admin.dashboard.network.title"] · @ui["admin.dashboard.service.web"]</span>
                    <span>@ui["admin.dashboard.network.download"] <strong>@(jularr.ReceiveBytesPerSecond is { } receive ? AdminDashboardFormat.Rate(ui, receive) : "—")</strong></span>
                    <span>@ui["admin.dashboard.network.upload"] <strong>@(jularr.SendBytesPerSecond is { } send ? AdminDashboardFormat.Rate(ui, send) : "—")</strong></span>
                </div>
                @if (jularrMemory.Length > 1 && postgresMemory.Length > 1)
                {
                    <div class="admdash-resource-chart-wrap">
                        <svg class="admdash-resource-chart" data-stack-resource-chart viewBox="0 0 640 240" role="img" aria-label="@ui["admin.dashboard.resources.chartAria"]">
                            <line class="admdash-chart-axis" x1="50" y1="196" x2="610" y2="196" />
                            <line class="admdash-chart-axis" x1="50" y1="20" x2="50" y2="196" />
                            <line class="admdash-chart-axis" x1="610" y1="20" x2="610" y2="196" />
                            <text x="2" y="26">@Percent(cpuMaximum)</text><text x="25" y="200">0%</text>
                            <text x="614" y="26">@Bytes((long)memoryMaximum)</text><text x="614" y="200">0</text>
                            @if (jularrCpu.Length > 1) { <polyline class="admdash-chart-line admdash-chart-jularr admdash-chart-cpu" points="@ChartPoints(jularrCpu, cpuMaximum)" /> }
                            @if (postgresCpu.Length > 1) { <polyline class="admdash-chart-line admdash-chart-postgres admdash-chart-cpu" points="@ChartPoints(postgresCpu, cpuMaximum)" /> }
                            <polyline class="admdash-chart-line admdash-chart-jularr admdash-chart-memory" points="@ChartPoints(jularrMemory, memoryMaximum)" />
                            <polyline class="admdash-chart-line admdash-chart-postgres admdash-chart-memory" points="@ChartPoints(postgresMemory, memoryMaximum)" />
                        </svg>
                        <div class="admdash-chart-legend" aria-hidden="true">
                            <span class="admdash-chart-jularr">@ui["admin.dashboard.service.web"]</span><span class="admdash-chart-postgres">@ui["admin.dashboard.service.database"]</span>
                            <span class="admdash-chart-cpu">@ui["admin.dashboard.resources.cpu"]</span><span class="admdash-chart-memory">@ui["admin.dashboard.resources.memory"]</span>
                        </div>
                    </div>
                }
            }
        </section>
    </div>

    @if (Model.CanManageSessions)
    {
        <section class="panel admdash-panel" aria-labelledby="admdash-streams">
            <div class="panel-heading">
                <h2 id="admdash-streams">@ui["admin.dashboard.streams.title"] <span class="admdash-count">@(snapshot.Sessions?.Count ?? 0)</span></h2>
                <a class="text-link" href="/Admin/Sessions">@ui["admin.index.viewAll"]</a>
            </div>
            @if (snapshot.Sessions is null)
            {
                <div class="admdash-message" role="alert" data-admin-dashboard-error="streams">
                    <p>@ui["admin.dashboard.loadFailed"]</p>
                    <a class="button" href="@refreshHref">@ui["admin.requests.retry"]</a>
                </div>
            }
            else if (snapshot.Sessions.Count == 0)
            {
                <p class="muted" data-admin-dashboard-empty="streams">@ui["admin.sessions.empty"]</p>
            }
            else
            {
                <div class="admdash-table-wrap">
                    <table class="admdash-table" data-admin-dashboard-streams>
                        <thead>
                            <tr>
                                <th scope="col">@ui["admin.sessions.column.title"]</th>
                                <th scope="col">@ui["admin.sessions.column.user"]</th>
                                <th scope="col">@ui["admin.sessions.column.client"]</th>
                                <th scope="col">@ui["playback.diagnostics.mode"]</th>
                                <th scope="col">@ui["admin.dashboard.streams.col.video"]</th>
                                <th scope="col">@ui["admin.dashboard.streams.col.bitrate"]</th>
                                <th scope="col"><span class="admdash-visually-hidden">@ui["admin.sessions.column.actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in snapshot.Sessions)
                            {
                                var mode = session.Plan.Mode switch
                                {
                                    PlaybackDeliveryMode.DirectPlay => "direct",
                                    PlaybackDeliveryMode.DirectStream => "stream",
                                    _ => "transcode"
                                };
                                var video = AdminDashboardFormat.Video(session.Plan);
                                var popoverId = "admdash-stream-" + session.SessionId.ToString("N");
                                var reason = session.TranscodeReason(ui);
                                <tr class="admdash-row-item">
                                    <td class="admdash-cell-title" data-label="@ui["admin.sessions.column.title"]"><strong>@session.Title</strong></td>
                                    <td data-label="@ui["admin.sessions.column.user"]">@session.ProfileName</td>
                                    <td data-label="@ui["admin.sessions.column.client"]">@session.ClientKind</td>
                                    <td data-label="@ui["playback.diagnostics.mode"]"><span class="admdash-tag admdash-mode-@mode">@ui[session.PlaybackMethodKey]</span></td>
                                    <td data-label="@ui["admin.dashboard.streams.col.video"]">@(video ?? "—")</td>
                                    <td data-label="@ui["admin.dashboard.streams.col.bitrate"]">@(session.Plan.Quality.DeliveredBitrateKbps is { } kbps and > 0 ? ui.Format("playback.quality.mbps", ("value", Math.Round(kbps / 1000d, 1).ToString("0.#", CultureInfo.InvariantCulture))) : "—")</td>
                                    <td class="admdash-cell-actions">
                                        <div class="admdash-actions">
                                            <form method="post" asp-page-handler="StopSession" asp-route-id="@session.SessionId"
                                                  onsubmit="return confirm('@ui["admin.dashboard.streams.stopConfirm"]');">
                                                <button class="button admdash-stop" type="submit" aria-label="@ui.Format("admin.dashboard.streams.stopAria", ("title", session.Title))">@ui["admin.sessions.stop"]</button>
                                            </form>
                                            <button class="button" type="button" popovertarget="@popoverId" aria-label="@ui.Format("admin.dashboard.streams.detailsAria", ("title", session.Title))">@ui["admin.history.details"]</button>
                                        </div>
                                        <div id="@popoverId" popover class="admdash-popover">
                                            <div class="admdash-popover-head">
                                                <strong>@session.Title</strong>
                                                <button class="button" type="button" popovertarget="@popoverId" popovertargetaction="hide">@ui["admin.dashboard.close"]</button>
                                            </div>
                                            <dl class="admdash-facts">
                                                <div><dt>@ui["admin.sessions.column.user"]</dt><dd>@session.ProfileName</dd></div>
                                                <div><dt>@ui["admin.sessions.column.client"]</dt><dd>@session.ClientKind</dd></div>
                                                <div><dt>@ui["playback.diagnostics.mode"]</dt><dd>@ui[session.PlaybackMethodKey]</dd></div>
                                                <div><dt>@ui["playback.diagnostics.source"]</dt><dd>@session.SourceSummary(ui)</dd></div>
                                                <div><dt>@ui["playback.diagnostics.delivered"]</dt><dd>@session.DeliveredSummary(ui)</dd></div>
                                                @if (reason is not null)
                                                {
                                                    <div><dt>@ui["admin.sessions.column.reason"]</dt><dd>@reason</dd></div>
                                                }
                                                <div><dt>@ui["admin.sessions.column.started"]</dt><dd><time datetime="@Iso(session.StartedAtUtc.UtcDateTime)">@Stamp(session.StartedAtUtc.UtcDateTime)</time></dd></div>
                                                <div><dt>@ui["admin.sessions.column.lastSeen"]</dt><dd><time datetime="@Iso(session.LastSeenUtc.UtcDateTime)">@Stamp(session.LastSeenUtc.UtcDateTime)</time></dd></div>
                                            </dl>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (snapshot.Work is { } work)
    {
        <div class="admdash-row admdash-row-work">
            <section class="panel admdash-panel" aria-labelledby="admdash-downloads">
                <div class="panel-heading">
                    <h2 id="admdash-downloads">@ui["admin.dashboard.downloads.title"] <span class="admdash-count">@Summary(work.DownloadsRunning, work.DownloadsQueued)</span></h2>
                    <a class="text-link" href="@AdminActivityQuery.Href("/Admin/Operations", new AdminActivityFilter(AdminActivityTab.All, AdminHistoryCategory.Acquisition))">@ui["admin.index.viewAll"]</a>
                </div>
                @if (work.Downloads.Count == 0)
                {
                    <p class="muted" data-admin-dashboard-empty="downloads">@ui["admin.dashboard.downloads.empty"]</p>
                }
                else
                {
                    <div class="admdash-table-wrap">
                        <table class="admdash-table" data-admin-dashboard-downloads>
                            <thead>
                                <tr>
                                    <th scope="col">@ui["admin.dashboard.downloads.col.release"]</th>
                                    <th scope="col">@ui["admin.dashboard.downloads.col.client"]</th>
                                    <th scope="col">@ui["admin.activity.col.progress"]</th>
                                    <th scope="col">@ui["admin.operation.speed"]</th>
                                    <th scope="col">@ui["admin.operation.eta"]</th>
                                    <th scope="col">@ui["admin.activity.col.status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var download in work.Downloads)
                                {
                                    var progress = AdminDashboardFormat.Progress(download);
                                    var eta = AdminDashboardFormat.Eta(ui, download, now);
                                    var client = AdminDashboardFormat.ClientName(download.ExternalProvider);
                                    var status = AdminActivityQuery.StatusName(download.Status);
                                    <tr class="admdash-row-item" data-operation-status="@status">
                                        <td class="admdash-cell-title" data-label="@ui["admin.dashboard.downloads.col.release"]">
                                            <a href="/Admin/Operation?id=@download.Id"><strong>@download.Title</strong></a>
                                            @if (!string.IsNullOrWhiteSpace(download.Subject))
                                            {
                                                <small>@download.Subject</small>
                                            }
                                        </td>
                                        <td data-label="@ui["admin.dashboard.downloads.col.client"]">@(client ?? "—")</td>
                                        <td data-label="@ui["admin.activity.col.progress"]">
                                            @if (progress is { } percent)
                                            {
                                                <div class="admdash-progress">
                                                    <div class="operation-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent"
                                                         aria-label="@ui.Format("admin.operation.progressComplete", ("percent", percent))"><span style="width:@percent%"></span></div>
                                                    <small>@percent%</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="muted" aria-hidden="true">&mdash;</span>
                                            }
                                        </td>
                                        <td data-label="@ui["admin.operation.speed"]">@(download.Status == OperationStatus.Running && download.BytesPerSecond is > 0 ? AdminDashboardFormat.Rate(ui, download.BytesPerSecond.Value) : "—")</td>
                                        <td data-label="@ui["admin.operation.eta"]">@(eta ?? "—")</td>
                                        <td data-label="@ui["admin.activity.col.status"]"><span class="admdash-tag admdash-status-@status">@StatusLabel(download.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="panel admdash-panel" aria-labelledby="admdash-tasks">
                <div class="panel-heading">
                    <h2 id="admdash-tasks">@ui["admin.dashboard.tasks.title"] <span class="admdash-count">@Summary(work.TasksRunning, work.TasksQueued)</span></h2>
                    <a class="text-link" href="/Admin/Operations">@ui["admin.index.viewAll"]</a>
                </div>
                @if (work.Tasks.Count == 0)
                {
                    <p class="muted" data-admin-dashboard-empty="tasks">@ui["admin.dashboard.tasks.empty"]</p>
                }
                else
                {
                    <div class="admdash-table-wrap">
                        <table class="admdash-table" data-admin-dashboard-tasks>
                            <thead>
                                <tr>
                                    <th scope="col">@ui["admin.activity.col.type"]</th>
                                    <th scope="col">@ui["admin.activity.col.title"]</th>
                                    <th scope="col">@ui["admin.activity.col.step"]</th>
                                    <th scope="col">@ui["admin.activity.col.progress"]</th>
                                    <th scope="col">@ui["admin.activity.col.status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in work.Tasks)
                                {
                                    var category = AdminHistoryQuery.CategoryName(AdminHistoryQuery.CategoryOf(task.Kind, task.Category));
                                    var progress = AdminDashboardFormat.Progress(task);
                                    var eta = AdminDashboardFormat.Eta(ui, task, now);
                                    var status = AdminActivityQuery.StatusName(task.Status);
                                    var note = AdminActivityQuery.NoteOf(task);
                                    <tr class="admdash-row-item" data-operation-status="@status">
                                        <td data-label="@ui["admin.activity.col.type"]">
                                            <span class="admdash-tag admdash-category"><partial name="_HistoryIcon" model="category" />@ui["admin.history.cat." + category]</span>
                                        </td>
                                        <td class="admdash-cell-title" data-label="@ui["admin.activity.col.title"]">
                                            <a href="/Admin/Operation?id=@task.Id"><strong>@task.Title</strong></a>
                                            @if (!string.IsNullOrWhiteSpace(task.Subject))
                                            {
                                                <small>@task.Subject</small>
                                            }
                                        </td>
                                        <td data-label="@ui["admin.activity.col.step"]"><span class="admdash-note">@(note ?? "—")</span></td>
                                        <td data-label="@ui["admin.activity.col.progress"]">
                                            @if (progress is { } percent)
                                            {
                                                <div class="admdash-progress">
                                                    <div class="operation-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent"
                                                         aria-label="@ui.Format("admin.operation.progressComplete", ("percent", percent))"><span style="width:@percent%"></span></div>
                                                    <small>@percent%</small>
                                                </div>
                                                @if (eta is not null)
                                                {
                                                    <small class="admdash-eta">@eta</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="muted" aria-hidden="true">&mdash;</span>
                                            }
                                        </td>
                                        <td data-label="@ui["admin.activity.col.status"]"><span class="admdash-tag admdash-status-@status">@StatusLabel(task.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
    else
    {
        <div class="admdash-message" role="alert" data-admin-dashboard-error="work">
            <p>@ui["admin.dashboard.loadFailed"]</p>
            <a class="button" href="@refreshHref">@ui["admin.requests.retry"]</a>
        </div>
    }

    @if (storage is not null)
    {
        <div class="admdash-row admdash-row-storage">
            <section class="panel admdash-panel" aria-labelledby="admdash-media-storage">
                <div class="panel-heading">
                    <h2 id="admdash-media-storage">@ui["admin.dashboard.storage.media"]</h2>
                    <a class="text-link" href="/Admin/System">@ui["admin.nav.system"]</a>
                </div>
                @if (storage.Roots.Count == 0)
                {
                    <p class="muted" data-admin-dashboard-empty="storage">@ui["admin.dashboard.storage.empty"]</p>
                }
                else
                {
                    <ul class="admdash-roots">
                        @foreach (var root in storage.Roots)
                        {
                            var rootTone = RootStateClass(root.Health);
                            <li class="admdash-root" data-root-state="@rootTone">
                                <div class="admdash-root-head">
                                    <strong>@root.Name</strong>
                                    <span class="admdash-state admdash-tone-@rootTone"><span class="admdash-dot" aria-hidden="true"></span>@RootStateLabel(root.Health)</span>
                                </div>
                                <code>@root.Path</code>
                                @if (root.FreeBytes is { } free && root.TotalBytes is { } total and > 0)
                                {
                                    var usedPercent = Math.Clamp((total - free) * 100d / total, 0, 100);
                                    <div class="operation-progress admdash-bar @(free <= SystemHealthService.WarningFreeBytes ? "admdash-bar-low" : "")" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                                         aria-valuenow="@Math.Round(usedPercent)" aria-label="@ui.Format("admin.dashboard.storage.freeOf", ("free", Bytes(free)), ("total", Bytes(total)))"><span style="width:@usedPercent.ToString("0.#", CultureInfo.InvariantCulture)%"></span></div>
                                    <small>@ui.Format("admin.dashboard.storage.freeOf", ("free", Bytes(free)), ("total", Bytes(total)))</small>
                                }
                                else if (root.FreeBytes is { } onlyFree)
                                {
                                    <small>@ui.Format("admin.dashboard.storage.free", ("free", Bytes(onlyFree)))</small>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="panel admdash-panel" aria-labelledby="admdash-system-storage">
                <div class="panel-heading">
                    <h2 id="admdash-system-storage">@ui["admin.dashboard.storage.system"]</h2>
                    <a class="text-link" href="/Admin/Storage">@ui["admin.index.storage.title"]</a>
                </div>
                <ul class="admdash-roots">
                    <li class="admdash-root">
                        <div class="admdash-root-head"><strong>@ui["admin.dashboard.storage.dataVolume"]</strong></div>
                        @if (storage.DataFreeBytes is { } dataFreeBytes && storage.DataTotalBytes is { } dataTotalBytes and > 0)
                        {
                            var dataUsed = Math.Clamp((dataTotalBytes - dataFreeBytes) * 100d / dataTotalBytes, 0, 100);
                            <div class="operation-progress admdash-bar @(dataFreeBytes <= SystemHealthService.WarningFreeBytes ? "admdash-bar-low" : "")" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                                 aria-valuenow="@Math.Round(dataUsed)" aria-label="@ui.Format("admin.dashboard.storage.freeOf", ("free", Bytes(dataFreeBytes)), ("total", Bytes(dataTotalBytes)))"><span style="width:@dataUsed.ToString("0.#", CultureInfo.InvariantCulture)%"></span></div>
                            <small>@ui.Format("admin.dashboard.storage.freeOf", ("free", Bytes(dataFreeBytes)), ("total", Bytes(dataTotalBytes)))</small>
                        }
                        else
                        {
                            <small>@ui["admin.overview.unknown"]</small>
                        }
                    </li>
                    @if (storage.DatabaseBytes is { } databaseBytes)
                    {
                        <li class="admdash-root">
                            <div class="admdash-root-head"><strong>@ui["admin.dashboard.storage.database"]</strong><span>@Bytes(databaseBytes)</span></div>
                        </li>
                    }
                </ul>
            </section>
        </div>
    }
    else
    {
        <div class="admdash-message" role="alert" data-admin-dashboard-error="storage">
            <p>@ui["admin.dashboard.loadFailed"]</p>
            <a class="button" href="@refreshHref">@ui["admin.requests.retry"]</a>
        </div>
    }

    <div class="admdash-row admdash-row-recent">
        <section class="panel admdash-panel" aria-labelledby="admdash-recent">
            <div class="panel-heading">
                <h2 id="admdash-recent">@ui["admin.dashboard.recent.title"]</h2>
                <a class="text-link" href="/Admin/History">@ui["admin.index.viewAll"]</a>
            </div>
            @if (snapshot.Recent is null)
            {
                <div class="admdash-message" role="alert" data-admin-dashboard-error="recent">
                    <p>@ui["admin.dashboard.loadFailed"]</p>
                    <a class="button" href="@refreshHref">@ui["admin.requests.retry"]</a>
                </div>
            }
            else if (snapshot.Recent.Count == 0)
            {
                <p class="muted" data-admin-dashboard-empty="recent">@ui["admin.history.empty"]</p>
            }
            else
            {
                <div class="admdash-table-wrap">
                    <table class="admdash-table" data-admin-dashboard-recent>
                        <thead>
                            <tr>
                                <th scope="col">@ui["admin.history.col.time"]</th>
                                <th scope="col">@ui["admin.history.col.type"]</th>
                                <th scope="col">@ui["admin.activity.col.title"]</th>
                                <th scope="col">@ui["admin.history.col.result"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in snapshot.Recent)
                            {
                                var when = entry.FinishedAtUtc ?? entry.UpdatedAtUtc;
                                var category = AdminHistoryQuery.CategoryName(AdminHistoryQuery.CategoryOf(entry.Kind, entry.Category));
                                var result = AdminHistoryQuery.ResultName(AdminHistoryQuery.ResultOf(entry.Status));
                                <tr class="admdash-row-item">
                                    <td data-label="@ui["admin.history.col.time"]"><time datetime="@Iso(when)" title="@Stamp(when)">@Age(when)</time></td>
                                    <td data-label="@ui["admin.history.col.type"]">
                                        <span class="admdash-tag admdash-category"><partial name="_HistoryIcon" model="category" />@ui["admin.history.cat." + category]</span>
                                    </td>
                                    <td class="admdash-cell-title" data-label="@ui["admin.activity.col.title"]">
                                        <a href="/Admin/Operation?id=@entry.Id"><strong>@entry.Title</strong></a>
                                        @if (!string.IsNullOrWhiteSpace(entry.Subject))
                                        {
                                            <small>@entry.Subject</small>
                                        }
                                    </td>
                                    <td data-label="@ui["admin.history.col.result"]"><span class="admdash-tag admdash-result-@result"><partial name="_HistoryIcon" model="@result" />@ui["admin.history.result." + result]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (snapshot.Waiting is { Any: true } waiting)
        {
            <section class="panel admdash-panel" aria-labelledby="admdash-waiting">
                <div class="panel-heading">
                    <h2 id="admdash-waiting">@ui["admin.dashboard.waiting.title"]</h2>
                </div>
                <ul class="admdash-waiting">
                    @if (waiting.PendingRequests > 0)
                    {
                        <li><a href="/Admin/Requests"><span>@ui["admin.dashboard.waiting.requests"]</span><strong>@waiting.PendingRequests.ToString("N0", CultureInfo.InvariantCulture)</strong></a></li>
                    }
                    @if (waiting.Wanted > 0)
                    {
                        <li><a href="/Admin/Wanted"><span>@ui["admin.wanted.title"]</span><strong>@waiting.Wanted.ToString("N0", CultureInfo.InvariantCulture)</strong></a></li>
                    }
                    @if (waiting.UnresolvedMappings > 0)
                    {
                        <li><a href="/Settings/MappingReview"><span>@ui["admin.overview.mapping.label"]</span><strong>@waiting.UnresolvedMappings.ToString("N0", CultureInfo.InvariantCulture)</strong></a></li>
                    }
                    @if (waiting.MissingLearningText > 0)
                    {
                        <li><a href="/Admin/Subtitles"><span>@ui["admin.overview.subtitles.label"]</span><strong>@waiting.MissingLearningText.ToString("N0", CultureInfo.InvariantCulture)</strong></a></li>
                    }
                </ul>
            </section>
        }
    </div>
</div>
