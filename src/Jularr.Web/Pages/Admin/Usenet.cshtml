@page
@model Jularr.Web.Pages.Admin.UsenetModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Acquisition.Search
@using Jularr.Web.Pages.Admin
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.usenet.title"];
    string StateClass(UsenetCheckState state) => state switch
    {
        UsenetCheckState.Ok => "is-ok",
        UsenetCheckState.Warning => "is-warn",
        UsenetCheckState.Missing => "is-missing",
        _ => "is-unknown"
    };
    string StateIcon(UsenetCheckState state) => state switch
    {
        UsenetCheckState.Ok => "✓",
        UsenetCheckState.Warning => "!",
        UsenetCheckState.Missing => "×",
        _ => "?"
    };
    string Size(long? bytes) => bytes switch
    {
        null => "",
        >= 1024L * 1024 * 1024 => $"{bytes.Value / (1024d * 1024 * 1024):0.0} GB",
        >= 1024L * 1024 => $"{bytes.Value / (1024d * 1024):0.0} MB",
        _ => $"{bytes.Value / 1024d:0} KB"
    };
    var picked = Model.TestResult?.Picked;
    string ClientCategoryLabel(MediaAcquisitionKind kind) => ui[MediaKindLabelKeys.ClientCategory(kind)];
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.usenet.title"]</h1>
        <p>@ui["admin.usenet.subtitle"]</p>
    </div>
    <form method="post" asp-page-handler="TestAll">
        <button class="button button-primary" type="submit">@ui["admin.usenet.testAll"]</button>
    </form>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Notice is not null)
{
    <p class="metadata-notice" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<section class="panel usenet-checklist" aria-labelledby="usenet-checklist-heading">
    <div class="panel-heading">
        <h2 id="usenet-checklist-heading">@ui["admin.usenet.checklistHeading"]</h2>
        <span>@ui.Format("admin.usenet.checklistProgress", ("done", Model.Checks.Count(check => check.State == UsenetCheckState.Ok)), ("total", Model.Checks.Count))</span>
    </div>
    <ol class="usenet-steps">
        @foreach (var check in Model.Checks)
        {
            <li class="usenet-step @StateClass(check.State)">
                <span class="usenet-step-icon" aria-hidden="true">@StateIcon(check.State)</span>
                <div class="usenet-step-copy">
                    <strong>@ui[$"admin.usenet.check.{check.Key}"]</strong>
                    @if (!string.IsNullOrWhiteSpace(check.Detail))
                    {
                        <span>@check.Detail</span>
                    }
                </div>
                @if (check.LinkPage is not null)
                {
                    <a class="button button-small" href="@check.LinkPage">@(check.State == UsenetCheckState.Missing ? ui["admin.usenet.setUp"] : ui["admin.usenet.open"])</a>
                }
            </li>
        }
    </ol>
</section>

<div class="usenet-columns">
    <section class="panel" aria-labelledby="usenet-indexers-heading">
        <div class="panel-heading">
            <h2 id="usenet-indexers-heading">@ui["admin.system.indexers"]</h2>
            <a class="button button-small" asp-page="/Legacy/Settings/Indexers/Edit">@ui["settings.indexers.add"]</a>
        </div>
        @if (Model.Indexers.Count == 0)
        {
            <p class="usenet-empty">@ui["settings.indexers.empty"]</p>
        }
        <ul class="usenet-cards">
            @foreach (var card in Model.Indexers)
            {
                var healthClass = card.Health is null ? "status-warn" : card.Health.IsHealthy ? "status-ok" : "status-error";
                var healthLabel = card.Health is null ? ui["settings.connectionTable.notChecked"] : card.Health.IsHealthy ? ui["settings.connectionTable.healthy"] : ui["settings.connectionTable.unhealthy"];
                <li class="usenet-card @(card.Entry.Enabled ? "" : "is-disabled")">
                    <div class="usenet-card-head">
                        <div>
                            <strong>@card.Entry.Name</strong>
                            <span class="muted">@card.Entry.Type · @ui.Format("admin.usenet.priority", ("priority", card.Entry.Priority))</span>
                        </div>
                        <span class="status-pill @healthClass">@healthLabel</span>
                    </div>
                    <dl class="usenet-facts">
                        <div><dt>@ui["admin.usenet.animeCategories"]</dt><dd>@string.Join(", ", SearchPlanner.Categories(MediaAcquisitionKind.Anime, card.Entry))</dd></div>
                        <div><dt>@ui["admin.usenet.bookCategories"]</dt><dd>@string.Join(", ", SearchPlanner.Categories(MediaAcquisitionKind.Book, card.Entry))</dd></div>
                        <div><dt>@ui["admin.usenet.mangaCategories"]</dt><dd>@string.Join(", ", SearchPlanner.Categories(MediaAcquisitionKind.Manga, card.Entry))</dd></div>
                        <div><dt>@ui["admin.usenet.lightNovelCategories"]</dt><dd>@string.Join(", ", SearchPlanner.Categories(MediaAcquisitionKind.LightNovel, card.Entry))</dd></div>
                        <div><dt>@ui["admin.usenet.capabilities"]</dt><dd>@(card.Entry.Settings.Capabilities?.Describe() ?? ui["admin.usenet.capabilitiesUnknown"])</dd></div>
                        <div><dt>@ui["admin.usenet.participation"]</dt><dd>@string.Join(" · ", new[] { card.Entry.Settings.AutomaticSearch ? ui["admin.usenet.participationAutomatic"] : null, card.Entry.Settings.InteractiveSearch ? ui["admin.usenet.participationManual"] : null }.OfType<string>())</dd></div>
                        @if (card.Health is not null)
                        {
                            <div><dt>@ui["admin.usenet.lastChecked"]</dt><dd>@card.Health.LastCheckedUtc.ToLocalTime().ToString("g")</dd></div>
                        }
                    </dl>
                    @if (card.Health is { IsHealthy: false, LastError: not null })
                    {
                        <p class="usenet-card-error">@card.Health.LastError</p>
                    }
                    <div class="usenet-card-actions">
                        <form method="post" asp-page-handler="TestIndexer" asp-route-id="@card.Entry.Id">
                            <button class="button button-small" type="submit">@ui["settings.connectionTable.test"]</button>
                        </form>
                        <a class="button button-small button-quiet" asp-page="/Legacy/Settings/Indexers/Edit" asp-route-id="@card.Entry.Id">@ui["settings.connectionTable.edit"]</a>
                        <form method="post" asp-page-handler="ToggleIndexer" asp-route-id="@card.Entry.Id">
                            <button class="button button-small button-quiet" type="submit">@(card.Entry.Enabled ? ui["admin.usenet.disable"] : ui["admin.usenet.enable"])</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteIndexer" asp-route-id="@card.Entry.Id" onsubmit="return confirm('@ui["admin.usenet.confirmRemove"]');">
                            <button class="button button-small button-danger" type="submit">@ui["common.remove"]</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    </section>

    <section class="panel" aria-labelledby="usenet-clients-heading">
        <div class="panel-heading">
            <h2 id="usenet-clients-heading">@ui["admin.system.downloadClients"]</h2>
            <a class="button button-small" asp-page="/Legacy/Settings/DownloadClients/Edit">@ui["settings.downloadClients.add"]</a>
        </div>
        @if (Model.Clients.Count == 0)
        {
            <p class="usenet-empty">@ui["admin.usenet.clientsEmpty"]</p>
        }
        <ul class="usenet-cards">
            @foreach (var card in Model.Clients)
            {
                var healthClass = card.Health is null ? "status-warn" : card.Health.IsHealthy ? "status-ok" : "status-error";
                var healthLabel = card.Health is null ? ui["settings.connectionTable.notChecked"] : card.Health.IsHealthy ? ui["settings.connectionTable.healthy"] : ui["settings.connectionTable.unhealthy"];
                <li class="usenet-card @(card.Entry.Enabled ? "" : "is-disabled")">
                    <div class="usenet-card-head">
                        <div>
                            <strong>@card.Entry.Name</strong>
                            <span class="muted">SABnzbd · @ui.Format("admin.usenet.priority", ("priority", card.Entry.Priority))</span>
                        </div>
                        <span class="status-pill @healthClass">@healthLabel</span>
                    </div>
                    <dl class="usenet-facts">
                        <div><dt>@ui["admin.usenet.address"]</dt><dd>@card.Entry.Settings.BaseUrl</dd></div>
                        @foreach (var kind in Model.ActiveKinds)
                        {
                            <div><dt>@ClientCategoryLabel(kind)</dt><dd>@(card.Entry.CategoryFor(kind) ?? ui["admin.usenet.defaultCategory"])</dd></div>
                        }
                    </dl>
                    @if (card.Health is { IsHealthy: false, LastError: not null })
                    {
                        <p class="usenet-card-error">@card.Health.LastError</p>
                    }
                    <div class="usenet-card-actions">
                        <form method="post" asp-page-handler="TestClient" asp-route-id="@card.Entry.Id">
                            <button class="button button-small" type="submit">@ui["settings.connectionTable.test"]</button>
                        </form>
                        <a class="button button-small button-quiet" asp-page="/Legacy/Settings/DownloadClients/Edit" asp-route-id="@card.Entry.Id">@ui["settings.connectionTable.edit"]</a>
                        <form method="post" asp-page-handler="ToggleClient" asp-route-id="@card.Entry.Id">
                            <button class="button button-small button-quiet" type="submit">@(card.Entry.Enabled ? ui["admin.usenet.disable"] : ui["admin.usenet.enable"])</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteClient" asp-route-id="@card.Entry.Id" onsubmit="return confirm('@ui["admin.usenet.confirmRemove"]');">
                            <button class="button button-small button-danger" type="submit">@ui["common.remove"]</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    </section>
</div>

<section class="panel usenet-booktest" id="book-test" aria-labelledby="usenet-booktest-heading">
    <div class="panel-heading">
        <h2 id="usenet-booktest-heading">@ui["admin.usenet.bookTestHeading"]</h2>
    </div>
    <p class="muted">@ui["admin.usenet.bookTestHelp"]</p>
    <form method="get" action="#book-test" class="usenet-booktest-form">
        <select name="TestKind" aria-label="@ui["admin.usenet.searchTestKind"]">
            @foreach (var kind in UsenetModel.TestKinds)
            {
                var value = AcquisitionAccessNames.Kind(kind);
                <option value="@value" selected="@(kind == Model.TestMediaKind)">@ui[$"admin.requests.kind.{value}"]</option>
            }
        </select>
        <input name="TestTitle" value="@Model.TestTitle" placeholder="@ui["admin.usenet.bookTestTitle"]" aria-label="@ui["admin.usenet.bookTestTitle"]" required />
        <input name="TestAuthor" value="@Model.TestAuthor" placeholder="@ui["admin.usenet.bookTestAuthor"]" aria-label="@ui["admin.usenet.bookTestAuthor"]" />
        <button class="button button-primary" type="submit">@ui["admin.usenet.bookTestRun"]</button>
    </form>
    @if (Model.TestResult is { } test)
    {
        <p class="usenet-booktest-summary">
            @ui.Format("admin.usenet.bookTestQueries", ("queries", string.Join(" · ", test.Queries)))
            @if (test.UsedCategoryFallback)
            {
                <span class="status-pill status-warn">@ui["admin.usenet.bookTestFallback"]</span>
            }
        </p>
        @foreach (var warning in test.Warnings)
        {
            <p class="usenet-card-error">@warning.IndexerName: @warning.Message</p>
        }
        @if (picked is not null)
        {
            <p class="metadata-notice">@ui.Format("admin.usenet.bookTestPicked", ("release", picked.Title))</p>
        }
        else
        {
            <p class="metadata-error">@test.FailureMessage</p>
        }
        @if (test.Ranked.Count > 0)
        {
            <ul class="usenet-releases">
                @foreach (var ranked in test.Ranked.Take(40))
                {
                    <li class="usenet-release @(ReferenceEquals(ranked.Release, picked) ? "is-picked" : "") @(ranked.Score == 0 ? "is-rejected" : "")">
                        <span class="usenet-release-score">@(ranked.Score == 0 ? "–" : ranked.Score.ToString())</span>
                        <div class="usenet-release-copy">
                            <strong>@ranked.Release.Title</strong>
                            <span>@ranked.Release.Indexer · @Size(ranked.Release.SizeBytes)@(ranked.Release.AgeDays is { } age ? $" · {age} d" : "")</span>
                        </div>
                        @if (ranked.RejectedBecause is not null)
                        {
                            <span class="status-pill status-error">@ranked.RejectedBecause</span>
                        }
                        else if (ReferenceEquals(ranked.Release, picked))
                        {
                            <span class="status-pill status-ok">@ui["admin.usenet.bookTestWouldPick"]</span>
                        }
                    </li>
                }
            </ul>
        }
    }
</section>

<section class="panel usenet-downloads" aria-labelledby="usenet-downloads-heading">
    <div class="panel-heading">
        <h2 id="usenet-downloads-heading">@ui["admin.usenet.downloadsHeading"]</h2>
        @if (Model.DownloadsClientName is not null)
        {
            <span>@Model.DownloadsClientName</span>
        }
    </div>
    <p class="muted">
        <a asp-page="/Settings/Acquisition">@ui["admin.usenet.pathMappingsLink"]</a>
        @if (Model.BooksInboxPath is not null)
        {
            <span>· @ui.Format("admin.usenet.booksInbox", ("path", Model.BooksInboxPath))</span>
        }
    </p>
    @if (Model.DownloadsError is not null)
    {
        <p class="metadata-error">@Model.DownloadsError</p>
    }
    else if (Model.DownloadsClientName is null)
    {
        <p class="usenet-empty">@ui["admin.usenet.clientsEmpty"]</p>
    }
    else if (Model.Downloads.Count == 0)
    {
        <p class="usenet-empty">@ui["admin.usenet.downloadsEmpty"]</p>
    }
    else
    {
        <ul class="usenet-downloads-list">
            @foreach (var row in Model.Downloads)
            {
                <li class="usenet-download @(row.IsActive ? "is-active" : "")">
                    <div class="usenet-download-copy">
                        <strong>@row.Name</strong>
                        <span>
                            @(row.Category ?? "*") · @row.Status
                            @if (row.SizeBytes is not null)
                            {
                                <text> · @Size(row.SizeBytes)</text>
                            }
                            @if (row.CompletedAt is { } completedAt)
                            {
                                <text> · @completedAt.ToLocalTime().ToString("g")</text>
                            }
                        </span>
                        @if (row.FailureMessage is not null)
                        {
                            <span class="usenet-card-error">@row.FailureMessage</span>
                        }
                        @if (row.LocalPathReadable == false)
                        {
                            <span class="usenet-card-error">@ui.Format("admin.usenet.pathUnreadable", ("path", row.LocalPath ?? row.StoragePath ?? ""))</span>
                        }
                    </div>
                    @if (row.IsActive && row.Percentage is { } percent)
                    {
                        <div class="usenet-download-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)percent)">
                            <span style="width: @((int)percent)%"></span>
                        </div>
                    }
                    else if (row.LocalPathReadable == true)
                    {
                        <span class="status-pill status-ok">@ui["admin.usenet.pathReadable"]</span>
                    }
                </li>
            }
        </ul>
    }
</section>
