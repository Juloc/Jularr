@page "/Admin/Resources"
@model Jularr.Web.Pages.Admin.ResourcesModel
@using System.Globalization
@using Jularr.Web.Features.Admin
@using Jularr.Web.Features.Storage
@section Head {
    <link rel="stylesheet" href="~/css/admin-resources.css" asp-append-version="true" />
}
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.resources.title"];
    var snapshot = Model.Snapshot;
    var resources = snapshot.Resources;
    var history = resources.History;
    var current = resources.Current;
    var available = current is { IsComplete: true };
    var storage = snapshot.Storage;

    string Bytes(long value) => StorageHealth.FormatBytes(value);
    string Rate(double? value) => value is { } rate ? AdminDashboardFormat.Rate(ui, rate) : "—";
    double? SumRate(double? first, double? second) => first is null && second is null ? null : (first ?? 0) + (second ?? 0);
    string Percent(double? value) => value is { } percent
        ? ui.Format("admin.dashboard.percent", ("value", Math.Round(percent).ToString("0", CultureInfo.InvariantCulture)))
        : "—";
    string Time(DateTimeOffset value) => value.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture);

    double?[] Series(Func<StackServiceResource?, double?> selector) => history.Select(sample => selector(sample.Jularr)).ToArray();
    double?[] PostgresSeries(Func<StackServiceResource?, double?> selector) => history.Select(sample => selector(sample.PostgreSql)).ToArray();
    double Max(params IEnumerable<double?>[] series) => Math.Max(1d, series.SelectMany(values => values).Where(value => value is not null).Select(value => value!.Value).DefaultIfEmpty(0).Max());
    string Points(IReadOnlyList<double?> values, double maximum)
    {
        if (values.Count < 2 || maximum <= 0 || values.Count(value => value is not null) < 2)
        {
            return string.Empty;
        }

        return string.Join(" ", values.Select((value, index) => value is null
            ? null
            : string.Create(CultureInfo.InvariantCulture, $"{44 + 552d * index / (values.Count - 1):0.##},{176 - Math.Clamp(value.Value / maximum, 0, 1) * 146:0.##}"))
            .Where(point => point is not null)!);
    }

    var jularrCpu = Series(service => service?.CpuPercent);
    var postgresCpu = PostgresSeries(service => service?.CpuPercent);
    var jularrMemory = Series(service => service is null ? null : service.MemoryBytes);
    var postgresMemory = PostgresSeries(service => service is null ? null : service.MemoryBytes);
    var receive = Series(service => service?.ReceiveBytesPerSecond);
    var send = Series(service => service?.SendBytesPerSecond);
    var jularrRead = Series(service => service?.ReadBytesPerSecond);
    var jularrWrite = Series(service => service?.WriteBytesPerSecond);
    var postgresRead = PostgresSeries(service => service?.ReadBytesPerSecond);
    var postgresWrite = PostgresSeries(service => service?.WriteBytesPerSecond);
    var cpuMaximum = Math.Max(100d, Max(jularrCpu, postgresCpu));
    var memoryMaximum = Max(jularrMemory, postgresMemory);
    var networkMaximum = Max(receive, send);
    var ioMaximum = Max(jularrRead, jularrWrite, postgresRead, postgresWrite);
    var hasCpuHistory = jularrCpu.Count(value => value is not null) > 1 || postgresCpu.Count(value => value is not null) > 1;
    var hasMemoryHistory = jularrMemory.Count(value => value is not null) > 1 || postgresMemory.Count(value => value is not null) > 1;
    var hasNetworkHistory = receive.Count(value => value is not null) > 1 || send.Count(value => value is not null) > 1;
    var hasIoHistory = jularrRead.Count(value => value is not null) > 1 || postgresRead.Count(value => value is not null) > 1 || jularrWrite.Count(value => value is not null) > 1 || postgresWrite.Count(value => value is not null) > 1;
}

<header class="page-header resources-header">
    <div>
        <p class="resources-eyebrow">@ui["admin.resources.breadcrumb"]</p>
        <h1>@ui["admin.resources.title"]</h1>
        <p>@ui["admin.resources.subtitle"]</p>
    </div>
    <div class="resources-header-actions">
        <span class="resources-period">@ui["admin.resources.lastFiveMinutes"]</span>
        <a class="button" href="/Admin/Resources">@ui["admin.activity.refresh"]</a>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@if (!available)
{
    <section class="panel resources-empty" data-stack-resources-unavailable>
        <h2>@ui["admin.resources.waiting.title"]</h2>
        <p>@ui["admin.dashboard.resources.unavailable"]</p>
        <p class="muted">@ui["admin.resources.waiting.detail"]</p>
    </section>
}
else
{
    var jularr = current!.Jularr!;
    var postgres = current.PostgreSql!;
    <div class="resources-page" data-stack-resources>
        <section class="panel resources-summary" aria-labelledby="resources-stack-title">
            <div class="resources-summary-head">
                <div>
                    <p class="resources-eyebrow">@ui["admin.resources.stack.label"]</p>
                    <h2 id="resources-stack-title">@ui["admin.dashboard.resources.total"]</h2>
                </div>
                <time datetime="@current.AtUtc.ToString("O", CultureInfo.InvariantCulture)">@ui.Format("admin.resources.sampled", ("time", Time(current.AtUtc)))</time>
            </div>
            <div class="resources-summary-metrics">
                <article data-resource-summary="cpu">
                    <span>@ui["admin.dashboard.resources.cpu"]</span>
                    <strong>@Percent(current.TotalCpuPercent)</strong>
                    <small>@ui["admin.resources.summary.combined"]</small>
                </article>
                <article data-resource-summary="memory">
                    <span>@ui["admin.dashboard.resources.memory"]</span>
                    <strong>@Bytes(current.TotalMemoryBytes!.Value)</strong>
                    <small>@ui["admin.resources.summary.combined"]</small>
                </article>
                <article data-resource-summary="network">
                    <span>@ui["admin.dashboard.network.title"]</span>
                    <strong>↓ @Rate(jularr.ReceiveBytesPerSecond)</strong>
                    <small>↑ @Rate(jularr.SendBytesPerSecond) · @ui["admin.dashboard.service.web"]</small>
                </article>
                <article data-resource-summary="io">
                    <span>@ui["admin.resources.io.title"]</span>
                    <strong>↓ @Rate(SumRate(jularr.ReadBytesPerSecond, postgres.ReadBytesPerSecond))</strong>
                    <small>↑ @Rate(SumRate(jularr.WriteBytesPerSecond, postgres.WriteBytesPerSecond))</small>
                </article>
            </div>
        </section>

        <section class="resources-service-grid" aria-label="@ui["admin.resources.services.aria"]">
            <article class="resources-service resources-service-jularr" data-resource-service="jularr">
                <div class="resources-service-head">
                    <div><span class="resources-service-icon">J</span><h2>@ui["admin.dashboard.service.web"]</h2></div>
                    <span class="status-pill status-ok">@ui["admin.resources.visible"]</span>
                </div>
                <dl>
                    <div><dt>@ui["admin.dashboard.resources.cpu"]</dt><dd>@Percent(jularr.CpuPercent)</dd></div>
                    <div><dt>@ui["admin.dashboard.resources.memory"]</dt><dd>@Bytes(jularr.MemoryBytes)</dd></div>
                    <div><dt>@ui["admin.dashboard.network.title"]</dt><dd>↓ @Rate(jularr.ReceiveBytesPerSecond) <span>↑ @Rate(jularr.SendBytesPerSecond)</span></dd></div>
                    <div><dt>@ui["admin.resources.io.title"]</dt><dd>↓ @Rate(jularr.ReadBytesPerSecond) <span>↑ @Rate(jularr.WriteBytesPerSecond)</span></dd></div>
                </dl>
            </article>
            <article class="resources-service resources-service-postgres" data-resource-service="postgresql">
                <div class="resources-service-head">
                    <div><span class="resources-service-icon">P</span><h2>@ui["admin.dashboard.service.database"]</h2></div>
                    <span class="status-pill status-ok">@ui["admin.resources.visible"]</span>
                </div>
                <dl>
                    <div><dt>@ui["admin.dashboard.resources.cpu"]</dt><dd>@Percent(postgres.CpuPercent)</dd></div>
                    <div><dt>@ui["admin.dashboard.resources.memory"]</dt><dd>@Bytes(postgres.MemoryBytes)</dd></div>
                    <div><dt>@ui["admin.dashboard.network.title"]</dt><dd>@ui["admin.resources.network.isolated"]</dd></div>
                    <div><dt>@ui["admin.resources.io.title"]</dt><dd>↓ @Rate(postgres.ReadBytesPerSecond) <span>↑ @Rate(postgres.WriteBytesPerSecond)</span></dd></div>
                </dl>
            </article>
        </section>

        <section class="panel resources-history" aria-labelledby="resources-history-title">
            <div class="panel-heading">
                <div><p class="resources-eyebrow">@ui["admin.resources.lastFiveMinutes"]</p><h2 id="resources-history-title">@ui["admin.resources.history.title"]</h2></div>
                <span class="muted">@ui["admin.resources.history.axes"]</span>
            </div>
            <div class="resources-charts">
                <figure data-resource-chart="cpu">
                    <figcaption><strong>@ui["admin.dashboard.resources.cpu"]</strong><span>@Percent(cpuMaximum)</span></figcaption>
                    @if (hasCpuHistory) { <svg viewBox="0 0 640 200" role="img" aria-label="@ui["admin.resources.chart.cpuAria"]"><partial name="_ResourceGrid" /><polyline class="resources-line jularr" points="@Points(jularrCpu, cpuMaximum)" /><polyline class="resources-line postgres" points="@Points(postgresCpu, cpuMaximum)" /></svg> } else { <p class="muted">@ui["admin.resources.history.collecting"]</p> }
                    <div class="resources-legend"><span class="jularr">@ui["admin.dashboard.service.web"]</span><span class="postgres">@ui["admin.dashboard.service.database"]</span></div>
                </figure>
                <figure data-resource-chart="memory">
                    <figcaption><strong>@ui["admin.dashboard.resources.memory"]</strong><span>@Bytes((long)memoryMaximum)</span></figcaption>
                    @if (hasMemoryHistory) { <svg viewBox="0 0 640 200" role="img" aria-label="@ui["admin.resources.chart.memoryAria"]"><partial name="_ResourceGrid" /><polyline class="resources-line jularr" points="@Points(jularrMemory, memoryMaximum)" /><polyline class="resources-line postgres" points="@Points(postgresMemory, memoryMaximum)" /></svg> } else { <p class="muted">@ui["admin.resources.history.collecting"]</p> }
                    <div class="resources-legend"><span class="jularr">@ui["admin.dashboard.service.web"]</span><span class="postgres">@ui["admin.dashboard.service.database"]</span></div>
                </figure>
                <figure data-resource-chart="network">
                    <figcaption><strong>@ui["admin.dashboard.network.title"]</strong><span>@Rate(networkMaximum)</span></figcaption>
                    @if (hasNetworkHistory) { <svg viewBox="0 0 640 200" role="img" aria-label="@ui["admin.resources.chart.networkAria"]"><partial name="_ResourceGrid" /><polyline class="resources-line download" points="@Points(receive, networkMaximum)" /><polyline class="resources-line upload" points="@Points(send, networkMaximum)" /></svg> } else { <p class="muted">@ui["admin.resources.history.collecting"]</p> }
                    <div class="resources-legend"><span class="download">↓ @ui["admin.dashboard.network.download"]</span><span class="upload">↑ @ui["admin.dashboard.network.upload"]</span></div>
                </figure>
                <figure data-resource-chart="io">
                    <figcaption><strong>@ui["admin.resources.io.title"]</strong><span>@Rate(ioMaximum)</span></figcaption>
                    @if (hasIoHistory) { <svg viewBox="0 0 640 200" role="img" aria-label="@ui["admin.resources.chart.ioAria"]"><partial name="_ResourceGrid" /><polyline class="resources-line jularr read" points="@Points(jularrRead, ioMaximum)" /><polyline class="resources-line postgres read" points="@Points(postgresRead, ioMaximum)" /><polyline class="resources-line jularr write" points="@Points(jularrWrite, ioMaximum)" /><polyline class="resources-line postgres write" points="@Points(postgresWrite, ioMaximum)" /></svg> } else { <p class="muted">@ui["admin.resources.history.collecting"]</p> }
                    <div class="resources-legend"><span class="jularr read">@ui["admin.dashboard.service.web"] ↓</span><span class="postgres read">@ui["admin.dashboard.service.database"] ↓</span><span class="jularr write">@ui["admin.dashboard.service.web"] ↑</span><span class="postgres write">@ui["admin.dashboard.service.database"] ↑</span></div>
                </figure>
            </div>
        </section>

        <section class="resources-storage-grid" aria-label="@ui["admin.resources.storage.aria"]">
            <article class="panel resources-mounts" data-resource-mounts>
                <div class="panel-heading"><div><p class="resources-eyebrow">@ui["admin.resources.storage.visibleOnly"]</p><h2>@ui["admin.resources.storage.title"]</h2></div><a class="text-link" href="/Admin/System">@ui["admin.resources.storage.manage"]</a></div>
                @if (storage?.Roots.Count > 0)
                {
                    <ul>
                    @foreach (var root in storage.Roots)
                    {
                        var used = root.TotalBytes is { } total && root.FreeBytes is { } free ? Math.Max(0, total - free) : 0;
                        var usedPercent = root.TotalBytes is { } capacity && capacity > 0 ? Math.Clamp(used * 100d / capacity, 0, 100) : 0;
                        var kind = root.FileSystemType?.Equals("cifs", StringComparison.OrdinalIgnoreCase) == true ? ui["admin.resources.mount.smb"] : ui["admin.resources.mount.volume"];
                        <li data-resource-mount="@root.FileSystemType">
                            <div><strong>@root.Name</strong><span>@kind</span></div>
                            <code>@root.Path</code>
                            @if (root.TotalBytes is { } rootTotal && root.FreeBytes is { } rootFree)
                            {
                                <div class="resources-capacity"><span><i style="width: @usedPercent.ToString("0.##", CultureInfo.InvariantCulture)%"></i></span><small>@Bytes(used) @ui["admin.resources.storage.usedOf"] @Bytes(rootTotal) · @Bytes(rootFree) @ui["admin.resources.storage.free"]</small></div>
                            }
                            else { <small class="muted">@ui["admin.resources.storage.capacityUnavailable"]</small> }
                        </li>
                    }
                    </ul>
                }
                else { <p class="muted">@ui["admin.resources.storage.none"]</p> }
            </article>
            <article class="panel resources-gpu" data-resource-gpu>
                <p class="resources-eyebrow">@ui["admin.resources.gpu.optional"]</p>
                <h2>@ui["admin.resources.gpu.title"]</h2>
                <p>@ui["admin.resources.gpu.unavailable"]</p>
                <p class="muted">@ui["admin.resources.gpu.detail"]</p>
            </article>
        </section>
    </div>
}

<div class="resources-page">
    <partial name="_ApplicationPerformance" model="Model.Performance" />
</div>
