@page
@model Jularr.Web.Pages.Admin.LogsModel
@using Jularr.Web.Features.Operations
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.nav.logs"];

    string LogLevelLabel(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Information => ui["admin.logs.level.information"],
        OperationLogLevel.Warning => ui["admin.logs.level.warning"],
        OperationLogLevel.Error => ui["admin.logs.level.error"],
        _ => level.ToString()
    };

    string LogLevelLabelForName(string level) =>
        Enum.TryParse<OperationLogLevel>(level, ignoreCase: true, out var parsed)
            ? LogLevelLabel(parsed)
            : level;
}

<header class="page-header">
    <div>
        <h1>@ui["admin.nav.logs"]</h1>
        <p>@ui["admin.logs.subtitle"]</p>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<form method="get" class="operation-filter">
    @if (Model.OperationId is { } operationId)
    {
        <input type="hidden" name="operationId" value="@operationId" />
    }
    <select name="level">
        <option value="">@ui["admin.logs.filter.allLevels"]</option>
        @foreach (var level in Enum.GetNames<OperationLogLevel>())
        {
            <option value="@level" selected="@(Model.Level == level)">@LogLevelLabelForName(level)</option>
        }
    </select>
    <input name="module" value="@Model.Module" placeholder="@ui["admin.logs.filter.modulePlaceholder"]" />
    <input name="search" value="@Model.Search" placeholder="@ui["admin.logs.filter.searchPlaceholder"]" />
    <button class="button" type="submit">@ui["admin.filter.apply"]</button>
</form>

<section class="panel">
    @if (Model.Logs.Count == 0)
    {
        <p class="muted">@ui["admin.logs.empty"]</p>
    }
    else
    {
        <div class="admin-log-list">
            @foreach (var entry in Model.Logs)
            {
                <a class="admin-log-row admin-log-@entry.Level.ToString().ToLowerInvariant()"
                   asp-page="/Admin/Operation"
                   asp-route-id="@entry.OperationId">
                    <time>@entry.CreatedAtUtc.ToLocalTime().ToString("G")</time>
                    <span>@LogLevelLabel(entry.Level)</span>
                    <strong>@entry.Module</strong>
                    <p>@entry.Message</p>
                </a>
            }
        </div>
    }
</section>
