@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Localization
@model MediaAcquisitionKind
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var name = AcquisitionAccessNames.Kind(Model);
    var icon = Model switch
    {
        MediaAcquisitionKind.Anime => "screen-play",
        MediaAcquisitionKind.Manga or MediaAcquisitionKind.LightNovel or MediaAcquisitionKind.Book => "book",
        MediaAcquisitionKind.Movie => "film",
        MediaAcquisitionKind.Tv => "tv",
        MediaAcquisitionKind.Audiobook => "headphones",
        MediaAcquisitionKind.Music => "music-note",
        _ => "stack"
    };
}
<partial name="_UiStatusTag" model='new UiStatusTagModel(ui["admin.requests.kind." + name], Icon: icon, CssClass: "admreq-type admreq-type-" + name)' />
