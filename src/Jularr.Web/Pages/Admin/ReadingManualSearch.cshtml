@page "{id:guid}"
@model Jularr.Web.Pages.Admin.ReadingManualSearchModel
@using Jularr.Web.Features.Acquisition.Selection
@{
    var ui = Model.Ui;
    var target = Model.Target!;
    ViewData["Title"] = target.Title;
    string ReasonText(SelectionReason reason) =>
        reason.Kind == SelectionReasonKind.Identity && ReadingManualSearchModel.IdentityKey(reason.Code) is { } key ? ui[key] : reason.Detail;
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-manage.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
}

<header class="page-header">
    <div>
        <h1>@target.Title</h1>
        @if (target.Author is not null)
        {
            <p>@target.Author</p>
        }
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Notice is not null)
{
    <p class="metadata-notice" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<div class="admmanage">
    <section class="admmanage-panel" aria-label="@ui["admin.manualSearch.profile"]">
        <dl class="admmanage-facts">
            <div><dt>@ui["admin.manualSearch.profile"]</dt><dd>@target.ProfileName</dd></div>
            <div><dt>@ui["admin.manualSearch.searches"]</dt><dd>@target.Searches</dd></div>
            @if (target.NextSearchUtc is { } next)
            {
                <div><dt>@ui["admin.manualSearch.nextSearch"]</dt><dd>@next.ToString("yyyy-MM-dd HH:mm") UTC</dd></div>
            }
        </dl>
        @if (target.StatusMessage is not null)
        {
            <p class="admmanage-summary">@target.StatusMessage</p>
        }
    </section>

    <section class="admmanage-panel" id="manual-search" aria-labelledby="admmanage-manual-heading">
        <h2 id="admmanage-manual-heading">@ui["admin.manualSearch.searchResults"]</h2>
        @if (!target.CanSearch)
        {
            <p class="admmanage-empty">@ui["admin.manualSearch.notSearchable"]</p>
        }
        else
        {
            <div class="admmanage-toolbar">
                <a class="button" asp-page="ReadingManualSearch" asp-route-id="@target.RequestId" asp-route-search="normal" asp-fragment="manual-search">@ui["admin.manualSearch.start"]</a>
                <a class="button button-quiet" asp-page="ReadingManualSearch" asp-route-id="@target.RequestId" asp-route-search="deep" asp-route-refresh="true" asp-fragment="manual-search">@ui["admin.manualSearch.deep"]</a>
                @if (Model.ManualDepth is not null)
                {
                    <a class="button button-quiet" asp-page="ReadingManualSearch" asp-route-id="@target.RequestId" asp-route-search="@Model.ManualDepth.ToString()!.ToLowerInvariant()" asp-route-refresh="true" asp-fragment="manual-search">@ui["admin.manualSearch.refresh"]</a>
                }
            </div>
        }
        @if (Model.Manual is { } manual)
        {
            <p class="admmanage-summary">@ui.Format("admin.manualSearch.summary", ("raw", manual.Summary.RawResults), ("distinct", manual.Summary.DistinctCandidates))</p>
            @foreach (var outcome in manual.Summary.Outcomes.Where(outcome => outcome.Message is not null))
            {
                <p class="admmanage-summary">@outcome.IndexerName: @outcome.Message</p>
            }
            @if (manual.WinnerReason is not null && manual.Candidates.Any(candidate => candidate.CanGrab))
            {
                <p class="admmanage-summary">@ui.Format("admin.manualSearch.winner", ("reason", manual.WinnerReason))</p>
            }
            @if (manual.Candidates.Count == 0)
            {
                <p class="admmanage-empty">@ui["admin.manualSearch.noCandidates"]</p>
            }
            else
            {
                <div class="admmanage-table-wrap">
                    <table class="admmanage-table">
                        <thead>
                            <tr>
                                <th scope="col">@ui["admin.manualSearch.col.release"]</th>
                                <th scope="col">@ui["admin.manualSearch.col.format"]</th>
                                <th scope="col">@ui["admin.manualSearch.col.language"]</th>
                                <th scope="col">@ui["admin.manualSearch.col.coverage"]</th>
                                <th scope="col" class="is-numeric">@ui["admin.manualSearch.col.score"]</th>
                                <th scope="col" class="is-numeric">@ui["admin.manualSearch.col.size"]</th>
                                <th scope="col" class="is-numeric">@ui["admin.manualSearch.col.age"]</th>
                                <th scope="col">@ui["admin.manualSearch.col.match"]</th>
                                <th scope="col"><span class="visually-hidden">@ui["admin.requests.col.actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in manual.Candidates)
                            {
                                var verdict = candidate.Verdict.ToString().ToLowerInvariant();
                                <tr>
                                    <td>
                                        <span class="admmanage-title">@candidate.Title</span>
                                        <span class="admmanage-sub">@string.Join(" · ", new[] { string.Join(", ", candidate.Sources), ReadingManualSearchModel.FoundVia(candidate) }.Where(part => part.Length > 0))</span>
                                        <ul class="admmanage-reasons">
                                            <li>@Model.ConfidenceLabel(candidate.IdentityConfidence)</li>
                                            @foreach (var reason in candidate.Reasons.Where(reason => reason.Kind != SelectionReasonKind.Identity))
                                            {
                                                <li>@ReasonText(reason)</li>
                                            }
                                            @if (candidate.RejectedBecause is not null && candidate.Verdict == Jularr.Web.Features.Acquisition.ManualSearch.ManualSearchVerdict.Rejected)
                                            {
                                                <li>@candidate.RejectedBecause</li>
                                            }
                                        </ul>
                                    </td>
                                    <td>@candidate.Format</td>
                                    <td>@(candidate.Language ?? "—")</td>
                                    <td>@Model.Coverage(candidate)</td>
                                    <td class="is-numeric">@(candidate.Score?.ToString() ?? "—")</td>
                                    <td class="is-numeric">@ReadingManualSearchModel.Size(candidate.SizeBytes)</td>
                                    <td class="is-numeric">@(candidate.AgeDays is { } days ? ui.Format("admin.manualSearch.ageDays", ("days", days)) : "—")</td>
                                    <td>
                                        <span class="admin-tag admin-tag-@ReadingManualSearchModel.VerdictTone(candidate.Verdict)">@ui["admin.manualSearch.state." + (candidate.IsTried ? "tried" : verdict)]</span>
                                    </td>
                                    <td class="is-actions">
                                        @if (candidate.CanGrab)
                                        {
                                            <form method="post" asp-page-handler="Grab" asp-route-id="@target.RequestId" class="admmanage-inline">
                                                <input type="hidden" name="releaseIdentity" value="@candidate.Identity" />
                                                <button class="button button-small" type="submit">@ui["admin.manualSearch.selectAndDownload"]</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>
