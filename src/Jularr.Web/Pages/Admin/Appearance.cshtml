@page
@model Jularr.Web.Pages.Admin.AppearanceModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.appearance.title"];
    var branding = Model.Branding;
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-branding.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-branding.js" asp-append-version="true" defer></script>
}

<header class="page-header">
    <div>
        <h1>@ui["admin.appearance.title"]</h1>
        <p>@ui["admin.appearance.description"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="ui" />

<form method="post" class="form-stack settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.appearance.defaultTheme"]</h2></div>
        <p class="muted">@ui["admin.appearance.defaultThemeHelp"]</p>
        <div class="theme-choice-grid" role="radiogroup" aria-label="@ui["admin.appearance.defaultTheme"]">
            @foreach (var theme in Model.Themes)
            {
                <label class="theme-choice @(theme.Id == Model.DefaultThemeId ? "selected" : "")">
                    <input type="radio" name="DefaultThemeId" value="@theme.Id" checked="@(theme.Id == Model.DefaultThemeId)" />
                    <img src="@theme.LogoPath" alt="" width="40" height="40" />
                    <span>
                        <strong>@ui[theme.NameKey]</strong>
                        <small>@ui[theme.DescriptionKey]</small>
                    </span>
                </label>
            }
        </div>
        <span asp-validation-for="DefaultThemeId" class="field-validation-error"></span>
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.appearance.profileOverrides"]</h2></div>
        <p class="muted">@ui["admin.appearance.profileOverridesHelp"]</p>
        <label class="checkbox-row">
            <input asp-for="AllowProfileThemeOverride" />
            <span>@ui["admin.appearance.allowThemeOverride"]</span>
        </label>
        <label class="checkbox-row">
            <input asp-for="AllowProfileAccentOverride" />
            <span>@ui["admin.appearance.allowAccentOverride"]</span>
        </label>
    </section>

    <div class="inline-actions">
        <button class="button button-primary" type="submit">@ui["admin.appearance.save"]</button>
    </div>
</form>

<section class="panel brand-panel" aria-labelledby="branding-title" data-instance-branding>
    <div class="panel-heading">
        <div>
            <h2 id="branding-title">@ui["admin.branding.title"]</h2>
            <p class="muted">@ui["admin.branding.description"]</p>
        </div>
        @if (branding.IsCustom || branding.HueBranding)
        {
            <form method="post" asp-page-handler="ResetBranding">
                <button class="button" type="submit">@ui["admin.branding.reset"]</button>
            </form>
        }
    </div>

    <form method="post" asp-page-handler="Branding" class="form-stack">
        <label>
            @ui["admin.branding.name"]
            <input asp-for="BrandName" maxlength="40" placeholder="@Jularr.Web.Features.Branding.InstanceBrandingSettings.ProductName" autocomplete="off" />
            <small class="muted">@ui["admin.branding.nameHelp"]</small>
        </label>
        <div class="inline-actions">
            <button class="button" type="submit">@ui["admin.branding.save"]</button>
        </div>
    </form>

    <form method="post" asp-page-handler="Logo" enctype="multipart/form-data" class="form-stack brand-logo-form">
        <div class="brand-logo-current">
            @if (branding.LogoUrl is { } logoUrl)
            {
                <img src="@logoUrl" alt="" width="56" height="56" class="brand-logo-preview" data-brand-logo />
            }
            else
            {
                <span class="brand-logo-none">@ui["admin.branding.logo.none"]</span>
            }
        </div>
        <label>
            @ui["admin.branding.logo"]
            <input type="file" name="logo" accept=".png,.jpg,.jpeg,.webp,.svg,image/png,image/jpeg,image/webp,image/svg+xml" />
            <small class="muted">@ui["admin.branding.logoHelp"]</small>
        </label>
        <div class="inline-actions">
            <button class="button" type="submit">@ui["admin.branding.logo.upload"]</button>
            @if (branding.HasLogo)
            {
                <button class="button" type="submit" asp-page-handler="RemoveLogo" formnovalidate>@ui["admin.branding.logo.remove"]</button>
            }
        </div>
    </form>

    <form method="post" asp-page-handler="Colour" class="form-stack brand-colour-form" data-brand-colour data-preview-url="@Url.Page("/Appearance/Accent", "Preview")">
        <label class="checkbox-row">
            <input asp-for="HueBranding" data-brand-colour-toggle />
            <span>
                @ui["admin.branding.hue"]
                <small class="muted">@ui["admin.branding.hueHelp"]</small>
            </span>
        </label>
        <div class="brand-colour-choice" data-brand-colour-choice>
            <input asp-for="Hue" type="hidden" data-brand-hue />
            <label class="brand-colour-picker">
                <span>@ui["admin.branding.hueValue"]</span>
                <input type="color" value="@Model.BrandColour" data-brand-colour-picker />
                <code data-brand-colour-hex>@Model.BrandColour</code>
            </label>
            @if (branding.HasLogo)
            {
                <button class="button" type="button" data-brand-colour-from-logo>@ui["admin.branding.colour.fromLogo"]</button>
            }
            @if (branding.LogoUrl is { } previewLogo)
            {
                <label class="checkbox-row">
                    <input asp-for="RecolourLogo" disabled="@(!branding.LogoRecolourable)" data-brand-recolour />
                    <span>
                        @ui["admin.branding.recolour"]
                        <small class="muted">@ui[branding.LogoRecolourable ? "admin.branding.recolourHelp" : "admin.branding.recolourImpossible"]</small>
                    </span>
                </label>
                <div class="brand-logo-preview-pair" aria-label="@ui["admin.branding.colour.preview"]">
                    <img src="@previewLogo" alt="" width="56" height="56" class="brand-logo-preview" data-brand-logo-original />
                    <span class="brand-logo-tint-preview" style="--brand-logo: url('@previewLogo')" data-brand-logo-tint hidden></span>
                </div>
            }
            <div class="brand-colour-preview" role="group" aria-label="@ui["admin.branding.colour.preview"]">
                <span class="button button-primary" aria-hidden="true">@ui["admin.branding.colour.sampleButton"]</span>
                <span class="admin-tag admin-tag-accent" aria-hidden="true">@ui["admin.branding.colour.sampleTag"]</span>
            </div>
            <small class="muted">@ui["admin.branding.colour.previewNote"]</small>
            <small class="muted" data-brand-colour-note hidden role="status">@ui["admin.branding.colour.noneInLogo"]</small>
        </div>
        <div class="inline-actions">
            <button class="button button-primary" type="submit">@ui["admin.branding.colour.save"]</button>
        </div>
    </form>
</section>
