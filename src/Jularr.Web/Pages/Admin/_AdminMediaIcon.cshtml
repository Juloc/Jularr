@model string
@* Small decorative glyph of an episode state or a disclosure arrow; its meaning always sits next to it as text. *@
<svg class="admmd-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "chevron":
            <path d="m6 3.5 4.5 4.5L6 12.5" />
            break;
        case "available":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.5 8.25 1.75 1.75 3.25-3.5" />
            break;
        case "searching":
            <circle cx="7" cy="7" r="4" />
            <path d="m10 10 3.5 3.5" />
            break;
        case "downloading":
        case "importing":
            <path d="M8 2.75v7.5M4.75 7.5 8 10.75l3.25-3.25M3 13.25h10" />
            break;
        case "failed":
            <circle cx="8" cy="8" r="5.75" />
            <path d="m5.75 5.75 4.5 4.5M10.25 5.75l-4.5 4.5" />
            break;
        default:
            <circle cx="8" cy="8" r="5.75" />
            <path d="M8 4.75v3.75M8 10.75v.01" />
            break;
    }
</svg>
