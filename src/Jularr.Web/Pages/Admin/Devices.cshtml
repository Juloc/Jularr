@page
@model Jularr.Web.Pages.Admin.DevicesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.devices.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-sessions.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["admin.devices.title"]</h1>
        <p>@ui["admin.devices.subtitle"]</p>
    </div>
</header>

<partial name="_AdminSectionLinks" />

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.devices.section.devices"]</h2>
    </div>

    @if (Model.Devices.Count == 0)
    {
        <p class="muted">@ui["admin.devices.empty"]</p>
    }
    else
    {
        <div class="sessions-table-wrap">
            <table class="sessions-table">
                <thead>
                    <tr>
                        <th>@ui["admin.devices.column.user"]</th>
                        <th>@ui["admin.devices.column.label"]</th>
                        <th>@ui["admin.devices.column.client"]</th>
                        <th>@ui["admin.devices.column.appVersion"]</th>
                        <th>@ui["admin.devices.column.status"]</th>
                        <th>@ui["admin.devices.column.firstSeen"]</th>
                        <th>@ui["admin.devices.column.lastSeen"]</th>
                        <th>@ui["admin.devices.column.actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in Model.Devices)
                    {
                        <tr>
                            <td data-label="@ui["admin.devices.column.user"]">@device.ProfileName</td>
                            <td data-label="@ui["admin.devices.column.label"]">@(device.Label ?? "—")</td>
                            <td data-label="@ui["admin.devices.column.client"]">@device.ClientKind</td>
                            <td data-label="@ui["admin.devices.column.appVersion"]">@(device.AppVersion ?? "—")</td>
                            <td data-label="@ui["admin.devices.column.status"]">
                                <span class="status-pill @device.StatusPillClass">@ui[device.StatusLabelKey]</span>
                            </td>
                            <td data-label="@ui["admin.devices.column.firstSeen"]">@device.FirstSeenUtc.ToLocalTime().ToString("g")</td>
                            <td data-label="@ui["admin.devices.column.lastSeen"]">@device.LastSeenUtc.ToLocalTime().ToString("g")</td>
                            <td data-label="@ui["admin.devices.column.actions"]">
                                <form method="post" asp-page-handler="Revoke" asp-route-id="@device.Id">
                                    <button class="button" type="submit">@ui["admin.devices.revoke"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.devices.section.events"]</h2>
    </div>

    @if (Model.RecentEvents.Count == 0)
    {
        <p class="muted">@ui["admin.devices.events.empty"]</p>
    }
    else
    {
        <div class="sessions-table-wrap">
            <table class="sessions-table">
                <thead>
                    <tr>
                        <th>@ui["admin.devices.events.column.when"]</th>
                        <th>@ui["admin.devices.events.column.user"]</th>
                        <th>@ui["admin.devices.events.column.event"]</th>
                        <th>@ui["admin.devices.events.column.address"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var securityEvent in Model.RecentEvents)
                    {
                        var succeeded = securityEvent.Kind == Jularr.Web.Features.Devices.SecurityEventKind.LoginSucceeded;
                        <tr>
                            <td data-label="@ui["admin.devices.events.column.when"]">@securityEvent.OccurredAtUtc.ToLocalTime().ToString("g")</td>
                            <td data-label="@ui["admin.devices.events.column.user"]">@securityEvent.UserName</td>
                            <td data-label="@ui["admin.devices.events.column.event"]">
                                <span class="status-pill @(succeeded ? "status-ok" : "status-error")">
                                    @(succeeded ? ui["admin.devices.events.loginSucceeded"] : ui["admin.devices.events.loginFailed"])
                                </span>
                            </td>
                            <td data-label="@ui["admin.devices.events.column.address"]">@(securityEvent.RemoteAddress ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
