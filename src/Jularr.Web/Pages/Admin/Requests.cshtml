@page
@model Jularr.Web.Pages.Admin.RequestsModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Auth
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.requests.title"];
    ViewData["AdminSectionRoot"] = "/Admin/Requests";
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-requests.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
    <script src="~/js/local-time.js" asp-append-version="true" defer></script>
    <script src="~/js/admin-requests.js" asp-append-version="true" defer></script>
}

@{
    var queue = Model.Queue;
    var filter = queue.Filter;
    var returnUrl = RequestsModel.Href(filter);
    var tabs = new (AdminRequestTab Tab, string Label)[]
    {
        (AdminRequestTab.All, ui["admin.requests.tab.all"]),
        (AdminRequestTab.Open, ui["admin.requests.tab.open"]),
        (AdminRequestTab.Approved, ui["admin.requests.tab.approved"]),
        (AdminRequestTab.InProgress, ui["admin.requests.tab.progress"]),
        (AdminRequestTab.Failed, ui["admin.requests.tab.failed"]),
        (AdminRequestTab.Rejected, ui["admin.requests.tab.rejected"]),
        (AdminRequestTab.Done, ui["admin.requests.tab.done"])
    };
    static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
    static string Day(DateTime value) => value.ToString("yyyy-MM-dd");
    static string Clock(DateTime value) => value.ToString("HH:mm");
}

<div class="admreq-navigation-row">
    <partial name="_AdminSectionLinks" />
    <nav class="library-type-tabs admreq-tabs" aria-label="@ui["admin.requests.tabsAria"]">
        @foreach (var (tab, label) in tabs)
        {
            var active = tab == filter.Tab;
            <a class="library-type-tab @(active ? "active" : "")" href="@RequestsModel.Href(filter with { Tab = tab, Page = 1 })" aria-current="@(active ? "page" : null)">@label <span class="admreq-count">@queue.TabCounts[tab]</span></a>
        }
    </nav>
</div>

@if (TempData["RequestActionResults"] is string resultJson)
{
    var results = System.Text.Json.JsonSerializer.Deserialize<RequestActionResult[]>(resultJson) ?? [];
    <section class="panel admreq-results" role="status">
        <h2>@ui["admin.requests.results"]</h2>
        @foreach (var group in results.GroupBy(result => result.Disposition))
        {
            <p>@ui["admin.requests.result." + group.Key.ToString().ToLowerInvariant()]: @group.Count()</p>
        }
        <details><summary>@ui["admin.requests.details"]</summary><ul>
        @foreach (var result in results)
        {
            <li>@result.Id · @ui["admin.requests.result." + result.Disposition.ToString().ToLowerInvariant()] · @ui["admin.requests.reason." + result.Reason]</li>
        }
        </ul></details>
    </section>
}

<section class="admreq" aria-label="@ui["admin.requests.title"]">
    <div class="admreq-control-surface">
        <form method="get" action="/Admin/Requests" class="admreq-filters" data-admreq-filters data-apply-label="@ui["common.apply"]" data-cancel-label="@ui["common.cancel"]">
            @if (filter.PageSize != AdminRequestQuery.DefaultPageSize)
            {
                <input type="hidden" name="size" value="@filter.PageSize" />
            }
            @if (filter.Tab != AdminRequestTab.All)
            {
                <input type="hidden" name="tab" value="@AdminRequestQuery.TabName(filter.Tab)" />
            }
            <div class="admreq-filter-row">
                <div class="admreq-search">
                    <input type="search" name="q" value="@filter.Search" maxlength="120" placeholder="@ui["admin.requests.searchPlaceholder"]" aria-label="@ui["admin.requests.searchPlaceholder"]" data-admreq-search />
                    <button class="admreq-search-submit" type="submit" aria-label="@ui["common.search"]"><partial name="_AdminIcon" model='"search"' /></button>
                </div>
                <button class="admreq-mobile-filter-trigger" type="button" data-admreq-open-filters aria-haspopup="dialog" aria-controls="admreq-filter-dialog" aria-expanded="false">
                    <partial name="_AdminIcon" model='"filter"' />
                    <span>@ui["admin.requests.filters.open"]</span>
                </button>
                <div class="admreq-selects">
                <div class="admreq-select-control">
                    <span class="admreq-filter-icon" aria-hidden="true"><partial name="_AdminIcon" model='"stack"' /></span>
                    <select name="type" multiple aria-label="@ui["admin.requests.filter.type"]" data-admreq-custom-select>
                    <option value="">@ui["admin.requests.filter.type"]</option>
                    @foreach (var kind in Model.EnabledKinds)
                    {
                        var kindName = AcquisitionAccessNames.Kind(kind);
                        <option value="@kindName" selected="@(filter.Kinds?.Contains(kind) == true)">@ui["admin.requests.kind." + kindName]</option>
                    }
                    </select>
                </div>
                <div class="admreq-select-control">
                <span class="admreq-filter-icon" aria-hidden="true"><partial name="_AdminIcon" model='"globe"' /></span>
                <select name="lang" multiple aria-label="@ui["admin.requests.filter.language"]" data-admreq-custom-select>
                    <option value="">@ui["admin.requests.filter.language"]</option>
                    @foreach (var tag in queue.Languages)
                    {
                        <option value="@tag" selected="@(filter.Languages?.Contains(tag) == true)">@RequestLanguages.Name(tag)</option>
                    }
                </select>
                </div>
                <div class="admreq-select-control">
                <span class="admreq-filter-icon" aria-hidden="true"><partial name="_AdminIcon" model='"alert"' /></span>
                <select name="status" multiple aria-label="@ui["admin.requests.filter.status"]" data-admreq-custom-select>
                    <option value="">@ui["admin.requests.filter.status"]</option>
                    @foreach (var value in Enum.GetValues<AcquisitionRequestStatus>())
                    {
                        var valueName = AcquisitionAccessNames.Status(value);
                        <option value="@valueName" selected="@(filter.Statuses?.Contains(value) == true)">@ui["requests.status." + valueName]</option>
                    }
                </select>
                </div>
                <div class="admreq-select-control">
                <span class="admreq-filter-icon" aria-hidden="true"><partial name="_AppIcon" model='"users"' /></span>
                <select name="by" multiple aria-label="@ui["admin.requests.filter.requester"]" data-admreq-custom-select>
                    <option value="">@ui["admin.requests.filter.requester"]</option>
                    @foreach (var (requesterId, requesterName) in Model.Requesters)
                    {
                        <option value="@requesterId" selected="@(filter.RequesterProfileIds?.Contains(requesterId) == true)">@requesterName</option>
                    }
                </select>
                </div>
                </div>
                <div class="admreq-select-control admreq-sort-control">
                    <span class="admreq-filter-icon" aria-hidden="true"><partial name="_AdminIcon" model='"arrow-down"' /></span>
                    <select name="sort" aria-label="@ui["admin.requests.sort"]" data-admreq-custom-select>
                        @foreach (var (value, labelKey) in new[]
                        {
                            ("newest", "admin.requests.sort.newest"),
                            ("oldest", "admin.requests.sort.oldest"),
                            ("modified", "admin.requests.sort.modified"),
                            ("title", "admin.requests.sort.title"),
                            ("requester", "admin.requests.sort.requester")
                        })
                        {
                            <option value="@value" selected="@(filter.Sort == value)">@ui[labelKey]</option>
                        }
                    </select>
                </div>
            </div>
            <div class="admreq-filter-apply" data-admreq-filter-apply hidden><button class="button button-primary" type="submit">@ui["admin.requests.filters.apply"]</button></div>
            @foreach (var kind in Model.EnabledKinds)
            {
                <template data-admreq-option-select="type" data-value="@AcquisitionAccessNames.Kind(kind)"><partial name="_RequestTypeTag" model="kind" /></template>
            }
            @foreach (var tag in queue.Languages)
            {
                <template data-admreq-option-select="lang" data-value="@tag"><partial name="_RequestLanguage" model="tag" /></template>
            }
            @foreach (var (id, name) in Model.Requesters)
            {
                <template data-admreq-option-select="by" data-value="@id"><partial name="_RequestRequester" model="name" /></template>
            }
            @foreach (var value in Enum.GetValues<AcquisitionRequestStatus>())
            {
                var name = AcquisitionAccessNames.Status(value);
                var approval = value is AcquisitionRequestStatus.Pending or AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Rejected;
                <template data-admreq-option-select="status" data-value="@name"><span class="admreq-badge @(approval ? "admreq-approval admreq-approval-" + name : "admreq-media admreq-media-" + name)"><partial name="_RequestStatusIcon" model='@(value == AcquisitionRequestStatus.Rejected || value == AcquisitionRequestStatus.Failed ? "rejected" : value == AcquisitionRequestStatus.Approved || value == AcquisitionRequestStatus.Completed ? "completed" : "pending")' />@ui["requests.status." + name]</span></template>
            }
            @foreach (var value in new[] { "newest", "oldest", "modified", "title", "requester" })
            {
                <template data-admreq-option-select="sort" data-value="@value"><span class="admreq-sort-option"><partial name="_AdminIcon" model='@(value is "newest" or "modified" ? "arrow-down" : "arrow-up")' /><span>@ui["admin.requests.sort." + value]</span></span></template>
            }
            @if (filter.HasNarrowing)
            {
                <div class="admreq-filter-summary"><span class="admreq-results-count">@ui.Format("admin.requests.matching", ("count", queue.Total))</span><a class="text-link" href="@RequestsModel.Href(new AdminRequestFilter(filter.Tab))">@ui["admin.requests.filter.reset"]</a></div>
            }
            <dialog class="admreq-filter-dialog" id="admreq-filter-dialog" data-admreq-filter-dialog aria-labelledby="admreq-filter-heading">
                <div class="admreq-filter-dialog-head">
                    <h2 id="admreq-filter-heading">@ui["admin.requests.filters.open"]</h2>
                    <button class="button admin-icon-button" type="button" data-admreq-close-filters aria-label="@ui["admin.requests.filters.close"]">
                        <partial name="_AdminIcon" model='"close"' />
                    </button>
                </div>
                <div data-admreq-filter-dialog-content></div>
                <div class="admreq-filter-dialog-foot">
                    @if (filter.HasNarrowing)
                    {
                        <a class="text-link" href="@RequestsModel.Href(new AdminRequestFilter(filter.Tab))">@ui["admin.requests.filter.reset"]</a>
                    }
                    <button class="button button-primary" type="submit">@ui["admin.requests.filters.apply"]</button>
                </div>
            </dialog>
        </form>
    </div>

    @if (Model.QueueFailed)
    {
        <div class="admreq-message" role="alert">
            <p>@ui["admin.requests.loadFailed"]</p>
            <a class="button" href="@returnUrl">@ui["admin.requests.retry"]</a>
        </div>
    }
    else if (queue.Items.Count == 0)
    {
        <p class="admreq-message muted" data-admin-requests-empty>
            @(Model.AnyRequests ? ui["admin.requests.noMatch"] : ui["admin.requests.empty"])
        </p>
    }
    else
    {
        <div class="admreq-table-wrap">
            <table class="admreq-table" data-admin-requests>
                <thead>
                    <tr>
                        <th class="admreq-cell-selection" scope="col">
                            <input type="checkbox" aria-label="@ui["admin.requests.title"]" data-admreq-select-all />
                        </th>
                        <th class="admreq-cell-title" scope="col">@ui["admin.requests.col.title"]</th>
                        <th class="admreq-cell-type" scope="col">@ui["admin.requests.col.type"]</th>
                        <th class="admreq-cell-who" scope="col">@ui["admin.requests.col.requester"]</th>
                        <th class="admreq-cell-requested" scope="col">@ui["admin.requests.col.requested"]</th>
                        <th class="admreq-cell-modified" scope="col">@ui["admin.requests.col.modified"]</th>
                        <th class="admreq-cell-profile" scope="col">@ui["admin.requests.col.profile"]</th>
                        <th class="admreq-cell-approval" scope="col">@ui["admin.requests.col.status"]</th>
                        <th class="admreq-cell-media" scope="col">@ui["admin.requests.col.mediaStatus"]</th>
                        <th class="admreq-cell-coverage" scope="col">@ui["admin.requests.col.coverage"]</th>
                        <th scope="col">@ui["admin.requests.col.actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in queue.Items)
                    {
                        var status = AcquisitionAccessNames.Status(request.Status);
                        var language = AdminRequestQuery.LanguageOf(request);
                        var requester = Model.ProfileNames.GetValueOrDefault(request.RequestedByProfileId) ?? request.RequestedByProfileId;
                        var isBookLike = request.Kind is MediaAcquisitionKind.Book or MediaAcquisitionKind.Manga or MediaAcquisitionKind.LightNovel;
                        var isVideo = request.Kind is MediaAcquisitionKind.Movie or MediaAcquisitionKind.Tv;
                        var titleId = $"request-title-{request.Id:N}";
                        var modifiedActor = request.WasAutoApproved
                            ? ui["requests.autoApproved"]
                            : Model.ProfileNames.GetValueOrDefault(request.DecidedByProfileId ?? string.Empty) ?? "—";
                        var profileName = Model.EffectiveProfileNames.GetValueOrDefault(request.Id) ?? "—";
                        var coverage = Model.CoverageOf(request);
                        var approvalStatus = request.Status switch
                        {
                            AcquisitionRequestStatus.Pending => "pending",
                            AcquisitionRequestStatus.Rejected => "rejected",
                            _ => "approved"
                        };
                        var mediaStatus = request.Status switch
                        {
                            AcquisitionRequestStatus.Searching => "searching",
                            AcquisitionRequestStatus.Downloading => "downloading",
                            AcquisitionRequestStatus.Importing => "importing",
                            AcquisitionRequestStatus.Completed => "completed",
                            AcquisitionRequestStatus.Failed => "failed",
                            _ => null
                        };
                        <tr class="admreq-row" data-admreq-row data-request-id="@request.Id" data-request-status="@AcquisitionAccessNames.Status(request.Status)" data-request-operation="@request.OperationId" tabindex="0">
                            <td class="admreq-cell-selection">
                                <input type="checkbox" value="@request.Id" aria-labelledby="@titleId" data-admreq-select />
                            </td>
                            <td class="admreq-cell-title">
                              <div class="admreq-title-wrap">
                                <span class="admreq-cover">
                                    @if (Model.Posters.TryGetValue(request.Id, out var poster))
                                    {
                                        <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                                    }
                                </span>
                                <span class="admreq-copy">
                                    @if (Model.ViewUrl(request) is { } resultUrl)
                                    {
                                        <a class="admreq-title" id="@titleId" href="@resultUrl" title="@request.Title">@request.Title</a>
                                    }
                                    else
                                    {
                                        <strong class="admreq-title" id="@titleId" title="@request.Title">@request.Title</strong>
                                    }
                                    <span class="admreq-copy-meta">
                                        @if (!string.IsNullOrWhiteSpace(request.Subtitle))
                                        {
                                            <small title="@request.Subtitle">@request.Subtitle</small>
                                        }
                                    </span>
                                    <small class="admreq-mobile-meta">
                                        @requester · <time datetime="@Iso(request.CreatedAt)" data-local-time="date"><span data-local-date>@Day(request.CreatedAt)</span></time>
                                    </small>
                                </span>
                              </div>
                            </td>
                            <td class="admreq-cell-type" data-label="@ui["admin.requests.col.type"]">
                                <partial name="_RequestTypeTag" model="request.Kind" />
                            </td>
                            <td class="admreq-cell-who" data-label="@ui["admin.requests.col.requester"]">
                                <partial name="_RequestRequester" model="requester" />
                            </td>
                            <td class="admreq-cell-when admreq-cell-requested" data-label="@ui["admin.requests.col.requested"]">
                                <time datetime="@Iso(request.CreatedAt)" data-local-time="parts">
                                    <span data-local-date>@Day(request.CreatedAt)</span>
                                    <small data-local-clock>@Clock(request.CreatedAt)</small>
                                </time>
                            </td>
                            <td class="admreq-cell-modified" data-label="@ui["admin.requests.col.modified"]">
                                <time datetime="@Iso(request.UpdatedAt)" data-local-time="date"><span data-local-date>@Day(request.UpdatedAt)</span><small>@modifiedActor</small></time>
                            </td>
                            <td class="admreq-cell-profile" data-label="@ui["admin.requests.col.profile"]">
                                <div class="admreq-stack"><span>@profileName</span><small>@(language is not null ? RequestLanguages.Name(language) : ui["requests.new.anyLanguage"])</small></div>
                            </td>
                            <td class="admreq-cell-approval" data-label="@ui["admin.requests.col.status"]">
                                <span class="admreq-badge admreq-approval admreq-approval-@approvalStatus" data-approval-status="@approvalStatus" title="@(request.WasAutoApproved ? ui["requests.autoApproved"] : null)">
                                    <partial name="_RequestStatusIcon" model="@(request.Status == AcquisitionRequestStatus.Pending ? "pending" : request.Status == AcquisitionRequestStatus.Rejected ? "rejected" : "completed")" />
                                    @(request.Status == AcquisitionRequestStatus.Pending ? ui["requests.status.pending"] : request.Status == AcquisitionRequestStatus.Rejected ? ui["requests.status.rejected"] : ui["requests.status.approved"])
                                </span>
                            </td>
                            <td class="admreq-cell-media" data-label="@ui["admin.requests.col.mediaStatus"]">
                                @if (mediaStatus is not null)
                                {
                                    <span class="admreq-badge admreq-media admreq-media-@mediaStatus" data-media-status="@status" title="@request.StatusMessage">
                                        <partial name="_RequestStatusIcon" model='@(mediaStatus == "failed" ? "rejected" : mediaStatus == "completed" ? "completed" : "pending")' />
                                        @ui["requests.status." + mediaStatus]
                                    </span>
                                }
                                else
                                {
                                    <span class="admreq-none" data-media-status="none">&mdash;</span>
                                }
                            </td>
                            <td class="admreq-cell-coverage" data-label="@ui["admin.requests.col.coverage"]">
                                @if (coverage.Count > 0)
                                {
                                    <span class="admreq-coverage-list">
                                        @foreach (var item in coverage)
                                        {
                                            <span class="admreq-coverage" title="@item">@item</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="admreq-none">&mdash;</span>
                                }
                            </td>
                            <td class="admreq-cell-actions" data-label="@ui["admin.requests.col.actions"]">
                                @{
                                    var waiting = request.Status is AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Failed;
                                    var viewUrl = request.Status != AcquisitionRequestStatus.Pending ? Model.ViewUrl(request) : null;
                                    var manualUrl = waiting && isVideo ? Url.Page("/Admin/ManualSearch", new { id = request.Id })
                                        : waiting && request.Kind == MediaAcquisitionKind.Book ? Url.Page("/Admin/BookManualSearch", new { id = request.Id })
                                        : waiting && request.Kind is MediaAcquisitionKind.Manga or MediaAcquisitionKind.LightNovel ? Url.Page("/Admin/ReadingManualSearch", new { id = request.Id })
                                        : null;
                                    var manageUrl = Model.VideoWorks.TryGetValue(request.Id, out var work) && request.Status != AcquisitionRequestStatus.Pending
                                        ? VideoWorkLinks.AdminPath(request.Kind, work.WorkId)
                                        : null;
                                    var inWanted = request.Status is AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Searching
                                        or AcquisitionRequestStatus.Downloading or AcquisitionRequestStatus.Importing
                                        && (request.Kind == MediaAcquisitionKind.Anime || isVideo);
                                    var searchNow = request.Status == AcquisitionRequestStatus.Approved && (isBookLike || isVideo);
                                    var viewIsPrimary = viewUrl is not null && !waiting && request.Status != AcquisitionRequestStatus.Rejected;
                                    var canChangeProfile = request.OperationId is null && request.Status is AcquisitionRequestStatus.Pending or AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Failed;
                                    var canDelete = request.Status is not (AcquisitionRequestStatus.Searching or AcquisitionRequestStatus.Downloading or AcquisitionRequestStatus.Importing);
                                }
                                <div class="admreq-actions">
                                    @if (request.Status is AcquisitionRequestStatus.Pending or AcquisitionRequestStatus.Failed)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button button-primary admreq-action" type="submit" data-admreq-action="@(request.Status == AcquisitionRequestStatus.Failed ? "retry" : "approve")"><span class="admreq-action-icon"><partial name="_AdminIcon" model='@(request.Status == AcquisitionRequestStatus.Failed ? "refresh" : "check")' /></span><span>@(request.Status == AcquisitionRequestStatus.Failed ? ui["admin.requests.retry"] : ui["admin.requests.approve"])</span></button>
                                        </form>
                                    }
                                    @if (request.Status == AcquisitionRequestStatus.Rejected)
                                    {
                                        <form method="post" asp-page-handler="Reopen" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button admreq-action" type="submit"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"refresh"' /></span><span>@ui["admin.requests.reopen"]</span></button>
                                        </form>
                                    }
                                    @if (viewIsPrimary)
                                    {
                                        <a class="button admreq-action" href="@viewUrl"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"eye"' /></span><span>@ui["admin.requests.viewMedia"]</span></a>
                                    }
                                    <button class="button admin-icon-button admreq-details-button" type="button" data-admreq-details
                                            data-title="@request.Title" data-requester="@requester" data-requested="@Iso(request.CreatedAt)"
                                            data-approval="@(request.Status == AcquisitionRequestStatus.Pending ? ui["requests.status.pending"] : request.Status == AcquisitionRequestStatus.Rejected ? ui["requests.status.rejected"] : ui["requests.status.approved"])"
                                            data-media="@(mediaStatus is null ? "—" : ui["requests.status." + mediaStatus])" data-message="@request.StatusMessage"
                                            aria-label="@ui["admin.requests.details"]" title="@ui["admin.requests.details"]"><partial name="_AdminIcon" model='"search"' /></button>
                                    @if (searchNow)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button admreq-action" type="submit" title="@ui["admin.requests.searchNow"]"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"refresh"' /></span><span>@ui["admin.requests.searchNow"]</span></button>
                                        </form>
                                    }
                                    <details class="admin-menu">
                                            <summary class="admin-icon-button" aria-label="@ui["admin.menu.more"]" title="@ui["admin.menu.more"]"><partial name="_AdminIcon" model='"more"' /></summary>
                                            <div class="admin-menu-list">
                                                <a class="admin-menu-item" href="@AcquisitionRequestService.StatusPath(request.Id)">@ui["admin.requests.details"]</a>
                                                @if (canChangeProfile)
                                                {
                                                    <button class="admin-menu-item" type="button" data-admreq-command="Profile">@ui["admin.requests.changeProfile"]</button>
                                                }
                                                @if (request.CanBeCancelled)
                                                {
                                                    <button class="admin-menu-item" type="button" data-admreq-command="Cancel">@ui["requests.cancel.confirm"]</button>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button class="admin-menu-item admreq-bulk-delete" type="button" data-admreq-command="Delete">@ui["admin.requests.delete"]</button>
                                                }
                                                @if (request.OperationId is { } operationId)
                                                {
                                                    <a class="admin-menu-item" href="/Admin/Operation/@operationId">@ui["admin.nav.operations"]</a>
                                                }
                                                @if (request.Status == AcquisitionRequestStatus.Pending)
                                                {
                                                    <form method="post" asp-page-handler="Reject" asp-route-id="@request.Id">
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button class="admin-menu-item" type="submit" data-admreq-command="Reject">@ui["admin.requests.reject"]</button>
                                                    </form>
                                                }
                                                @if (manualUrl is not null)
                                                {
                                                    <a class="admin-menu-item" href="@manualUrl">@ui["admin.wanted.manualSearch"]</a>
                                                }
                                                @if (viewUrl is not null && !viewIsPrimary)
                                                {
                                                    <a class="admin-menu-item" href="@viewUrl">@ui["admin.requests.viewMedia"]</a>
                                                }
                                                @if (inWanted)
                                                {
                                                    <a class="admin-menu-item" asp-page="/Admin/Wanted">@ui["admin.requests.wanted"]</a>
                                                }
                                                @if (manageUrl is not null)
                                                {
                                                    <a class="admin-menu-item" href="@manageUrl">@ui["admin.media.manage"]</a>
                                                }
                                                @if (waiting)
                                                {
                                                    <form method="post" asp-page-handler="Complete" asp-route-id="@request.Id">
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button class="admin-menu-item" type="submit">@ui["admin.requests.markDone"]</button>
                                                    </form>
                                                }
                                            </div>
                                        </details>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <aside class="admreq-bulk" data-admreq-bulk hidden aria-label="@ui["admin.requests.bulkActions"]">
            <span class="admreq-bulk-count"><strong data-admreq-selected-count>0</strong> @ui["admin.requests.selected"]</span>
            <button class="button admin-icon-button admreq-clear-selection" type="button" data-admreq-clear-selection aria-label="@ui["admin.requests.selectionClear"]" title="@ui["admin.requests.selectionClear"]"><partial name="_AdminIcon" model='"close"' /></button>
<div class="admreq-bulk-actions">
                <button class="button admreq-action button-primary" type="button" data-admreq-command="Approve"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"check"' /></span><span>@ui["admin.requests.approve"]</span></button>
                <button class="button admreq-action" type="button" data-admreq-command="Reject"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"close"' /></span><span>@ui["admin.requests.reject"]</span></button>
                <button class="button admreq-action" type="button" data-admreq-command="Retry"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"refresh"' /></span><span>@ui["admin.requests.retry"]</span></button>
                <button class="button admreq-action" type="button" data-admreq-command="Cancel"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"close"' /></span><span>@ui["admin.requests.cancel"]</span></button>
                <button class="button admreq-action" type="button" data-admreq-command="Complete"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"check"' /></span><span>@ui["admin.requests.markDone"]</span></button>
                <button class="button admreq-action" type="button" data-admreq-command="Profile"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"columns"' /></span><span>@ui["admin.requests.changeProfile"]</span></button>
                <button class="button admreq-action admreq-bulk-delete" type="button" data-admreq-command="Delete"><span class="admreq-action-icon"><partial name="_AdminIcon" model='"trash"' /></span><span>@ui["admin.requests.delete"]</span></button>
            </div>
        </aside>

        <div class="admreq-footer">
            <div class="admreq-footer-start">
                <form class="admreq-page-size" method="get" action="/Admin/Requests" data-admreq-page-size>
                    @if (filter.Tab != AdminRequestTab.All)
                    {
                        <input type="hidden" name="tab" value="@AdminRequestQuery.TabName(filter.Tab)" />
                    }
                    @foreach (var selectedKind in filter.Kinds ?? [])
                    {
                        <input type="hidden" name="type" value="@AcquisitionAccessNames.Kind(selectedKind)" />
                    }
                    @foreach (var selectedStatus in filter.Statuses ?? [])
                    {
                        <input type="hidden" name="status" value="@AcquisitionAccessNames.Status(selectedStatus)" />
                    }
                    @foreach (var language in filter.Languages ?? [])
                    {
                        <input type="hidden" name="lang" value="@language" />
                    }
                    @foreach (var requester in filter.RequesterProfileIds ?? [])
                    {
                        <input type="hidden" name="by" value="@requester" />
                    }
                    @if (filter.Search is not null)
                    {
                        <input type="hidden" name="q" value="@filter.Search" />
                    }
                    @if (filter.Sort != "newest")
                    {
                        <input type="hidden" name="sort" value="@filter.Sort" />
                    }
                    <label for="admreq-page-size">@ui["admin.requests.pageSize"]</label>
                    <span class="admreq-page-size-combobox">
                        <input id="admreq-page-size" type="number" name="size" value="@filter.PageSize" min="1" max="500" required inputmode="numeric" autocomplete="off" aria-controls="admreq-page-size-options" aria-label="@ui["admin.requests.pageSize"]" data-admreq-page-size-input />
                        <button class="admreq-page-size-trigger" type="button" aria-label="@ui["admin.requests.pageSize"]" aria-haspopup="listbox" aria-controls="admreq-page-size-options" aria-expanded="false" data-admreq-page-size-trigger><span class="admreq-select-chevron" aria-hidden="true"></span></button>
                    </span>
                    <div id="admreq-page-size-options" class="admreq-dropdown-panel" popover="auto" role="listbox" aria-label="@ui["admin.requests.pageSize"]" data-admreq-page-size-options>
                        @foreach (var size in AdminRequestQuery.StandardPageSizes)
                        {
                            <button type="button" class="admreq-dropdown-option @(filter.PageSize == size ? "is-selected" : "")" role="option" aria-selected="@(filter.PageSize == size ? "true" : "false")" data-admreq-page-size-option="@size">@size</button>
                        }
                    </div>
                </form>
                <span>@ui.Format("admin.requests.showing", ("from", (queue.Page - 1) * queue.PageSize + 1), ("to", (queue.Page - 1) * queue.PageSize + queue.Items.Count), ("total", queue.Total))</span>
            </div>
            @if (queue.PageCount > 1)
            {
                <nav class="admreq-pager" aria-label="@ui["admin.requests.title"]">
                    @if (queue.HasPrevious)
                    {
                        <a class="button admreq-page-button" href="@RequestsModel.Href(filter with { Page = queue.Page - 1 })" aria-label="@ui["requests.page.previous"]"><span aria-hidden="true">&lsaquo;</span></a>
                    }
                    @foreach (var pageNumber in Enumerable.Range(Math.Max(1, queue.Page - 2), Math.Min(queue.PageCount, queue.Page + 2) - Math.Max(1, queue.Page - 2) + 1))
                    {
                        <a class="button admreq-page-button @(pageNumber == queue.Page ? "active" : "")" href="@RequestsModel.Href(filter with { Page = pageNumber })" aria-current="@(pageNumber == queue.Page ? "page" : null)">@pageNumber</a>
                    }
                    @if (queue.HasNext)
                    {
                        <a class="button admreq-page-button" href="@RequestsModel.Href(filter with { Page = queue.Page + 1 })" aria-label="@ui["requests.page.next"]"><span aria-hidden="true">&rsaquo;</span></a>
                    }
                </nav>
            }
        </div>
    }
</section>

<dialog class="admreq-dialog" data-admreq-dialog aria-labelledby="admreq-dialog-title">
    <div class="admreq-dialog-head">
        <h2 id="admreq-dialog-title" data-admreq-dialog-title></h2>
        <button class="button admin-icon-button" type="button" data-admreq-dialog-close aria-label="@ui["common.close"]"><partial name="_AdminIcon" model='"close"' /></button>
    </div>
    <dl class="admreq-dialog-facts">
        <div><dt>@ui["admin.requests.detailsRequester"]</dt><dd data-admreq-dialog-requester></dd></div>
        <div><dt>@ui["admin.requests.detailsRequested"]</dt><dd data-admreq-dialog-requested></dd></div>
        <div><dt>@ui["admin.requests.detailsStatus"]</dt><dd data-admreq-dialog-approval></dd></div>
        <div><dt>@ui["admin.requests.detailsMediaStatus"]</dt><dd data-admreq-dialog-media></dd></div>
        <div class="admreq-dialog-message"><dt>@ui["admin.requests.detailsMessage"]</dt><dd data-admreq-dialog-message></dd></div>
    </dl>
</dialog>
<dialog class="admreq-dialog admreq-command-dialog" data-admreq-command-dialog aria-labelledby="admreq-command-title">
    <form method="post" asp-page-handler="Bulk" data-admreq-command-form>
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <input type="hidden" name="confirmed" value="true" />
        <input type="hidden" name="action" data-admreq-command-action />
        <div data-admreq-command-ids></div>
        <div class="admreq-dialog-head">
            <h2 id="admreq-command-title" data-admreq-command-title></h2>
            <button class="button admin-icon-button" type="button" data-admreq-command-close aria-label="@ui["common.close"]"><partial name="_AdminIcon" model='"close"' /></button>
        </div>
        <p>@ui["admin.requests.selected"] <strong data-admreq-command-count></strong></p>
        <p data-admreq-delete-warning hidden>@ui["admin.requests.deleteWarning"]</p>
        <label data-admreq-command-note hidden>
            <span>@ui["admin.requests.rejectReason"]</span>
            <textarea name="note" maxlength="2000" rows="3"></textarea>
        </label>
        <label data-admreq-command-profile hidden>
            <span>@ui["admin.requests.approveProfile"]</span>
            <span class="admreq-select-control">
                <span class="admreq-filter-icon" aria-hidden="true"><partial name="_AppIcon" model='"settings"' /></span>
                <select name="profileId" aria-label="@ui["admin.requests.approveProfile"]" data-admreq-custom-select>
                    <option value="">@ui["admin.requests.keepProfile"]</option>
                    @foreach (var profile in Model.QualityProfiles)
                    {
                        <option value="@profile.Id">@profile.Name</option>
                    }
                </select>
            </span>
        </label>
        <p class="muted">@ui["admin.requests.bulkLimit"]</p>
        <div class="admreq-command-footer">
            <button class="button" type="button" data-admreq-command-close>@ui["common.cancel"]</button>
            <button class="button button-primary admreq-action" type="submit" data-admreq-command-submit><span class="admreq-action-icon"><partial name="_AdminIcon" model='"check"' /></span><span data-admreq-command-label></span></button>
        </div>
    </form>
</dialog>
