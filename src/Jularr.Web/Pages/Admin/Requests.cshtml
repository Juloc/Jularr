@page
@model Jularr.Web.Pages.Admin.RequestsModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Auth
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.requests.title"];
    var settings = Model.RequestSettings;
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-requests.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
}

<header class="page-header">
    <div>
        <h1>@ui["admin.requests.title"]</h1>
        <p>@ui["admin.requests.subtitle"]</p>
    </div>
    @if (User.IsInRole(AccountRoles.Owner))
    {
        <div class="inline-actions">
            <a class="button" href="/Admin/Capabilities">@ui["admin.capabilities.title"]</a>
        </div>
    }
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@{
    var queue = Model.Queue;
    var filter = queue.Filter;
    var returnUrl = RequestsModel.Href(filter);
    var tabs = new (AdminRequestTab Tab, string Label)[]
    {
        (AdminRequestTab.All, ui["admin.requests.tab.all"]),
        (AdminRequestTab.Open, ui["admin.requests.tab.open"]),
        (AdminRequestTab.Approved, ui["admin.requests.tab.approved"]),
        (AdminRequestTab.InProgress, ui["admin.requests.tab.progress"]),
        (AdminRequestTab.Done, ui["admin.requests.tab.done"]),
        (AdminRequestTab.Rejected, ui["admin.requests.tab.rejected"])
    };
    static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
    static string Day(DateTime value) => value.ToString("yyyy-MM-dd");
    static string Clock(DateTime value) => value.ToString("HH:mm") + " UTC";
}

<section class="admreq" aria-label="@ui["admin.requests.title"]">
    <nav class="library-type-tabs admreq-tabs" aria-label="@ui["admin.requests.tabsAria"]">
        @foreach (var (tab, label) in tabs)
        {
            var active = tab == filter.Tab;
            <a class="library-type-tab @(active ? "active" : "")"
               href="@RequestsModel.Href(filter with { Tab = tab, Page = 1 })"
               aria-current="@(active ? "page" : null)">@label <span class="admreq-count">@queue.TabCounts[tab]</span></a>
        }
    </nav>

    <form method="get" action="/Admin/Requests" class="admreq-filters">
        @if (filter.Tab != AdminRequestTab.All)
        {
            <input type="hidden" name="tab" value="@AdminRequestQuery.TabName(filter.Tab)" />
        }
        <div class="admreq-search">
            <input type="search" name="q" value="@filter.Search" maxlength="120"
                   placeholder="@ui["admin.requests.searchPlaceholder"]" aria-label="@ui["admin.requests.searchPlaceholder"]" />
            <button class="button" type="submit">@ui["common.search"]</button>
        </div>
        <div class="admreq-selects">
            <select name="type" aria-label="@ui["admin.requests.filter.type"]">
                <option value="">@ui["admin.requests.filter.type"]</option>
                @foreach (var kind in Model.EnabledKinds)
                {
                    var kindName = AcquisitionAccessNames.Kind(kind);
                    <option value="@kindName" selected="@(filter.Kind == kind)">@ui["admin.requests.kind." + kindName]</option>
                }
            </select>
            <select name="lang" aria-label="@ui["admin.requests.filter.language"]">
                <option value="">@ui["admin.requests.filter.language"]</option>
                @foreach (var tag in queue.Languages)
                {
                    <option value="@tag" selected="@(filter.Language == tag)">@RequestLanguages.Name(tag)</option>
                }
            </select>
            <select name="status" aria-label="@ui["admin.requests.filter.status"]">
                <option value="">@ui["admin.requests.filter.status"]</option>
                @foreach (var value in Enum.GetValues<AcquisitionRequestStatus>())
                {
                    var valueName = AcquisitionAccessNames.Status(value);
                    <option value="@valueName" selected="@(filter.Status == value)">@ui["requests.status." + valueName]</option>
                }
            </select>
            <select name="by" aria-label="@ui["admin.requests.filter.requester"]">
                <option value="">@ui["admin.requests.filter.requester"]</option>
                @foreach (var (requesterId, requesterName) in Model.Requesters)
                {
                    <option value="@requesterId" selected="@(filter.RequesterProfileId == requesterId)">@requesterName</option>
                }
            </select>
            @if (filter.HasNarrowing)
            {
                <a class="text-link" href="@RequestsModel.Href(new AdminRequestFilter(filter.Tab))">@ui["admin.requests.filter.reset"]</a>
            }
        </div>
    </form>

    @if (Model.QueueFailed)
    {
        <div class="admreq-message" role="alert">
            <p>@ui["admin.requests.loadFailed"]</p>
            <a class="button" href="@returnUrl">@ui["admin.requests.retry"]</a>
        </div>
    }
    else if (queue.Items.Count == 0)
    {
        <p class="admreq-message muted" data-admin-requests-empty>
            @(Model.AnyRequests ? ui["admin.requests.noMatch"] : ui["admin.requests.empty"])
        </p>
    }
    else
    {
        <div class="admreq-table-wrap">
            <table class="admreq-table" data-admin-requests>
                <thead>
                    <tr>
                        <th scope="col">@ui["admin.requests.col.title"]</th>
                        <th scope="col">@ui["admin.requests.col.requester"]</th>
                        <th scope="col">@ui["admin.requests.col.language"]</th>
                        <th scope="col">@ui["admin.requests.col.requested"]</th>
                        <th scope="col">@ui["admin.requests.col.status"]</th>
                        <th scope="col">@ui["admin.requests.col.actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in queue.Items)
                    {
                        var status = AcquisitionAccessNames.Status(request.Status);
                        var options = Model.OptionsOf(request);
                        var language = AdminRequestQuery.LanguageOf(request);
                        var requester = Model.ProfileNames.GetValueOrDefault(request.RequestedByProfileId) ?? request.RequestedByProfileId;
                        var isBookLike = request.Kind is MediaAcquisitionKind.Book or MediaAcquisitionKind.Manga or MediaAcquisitionKind.LightNovel;
                        var isVideo = request.Kind is MediaAcquisitionKind.Movie or MediaAcquisitionKind.Tv;
                        <tr class="admreq-row">
                            <td class="admreq-cell-title">
                              <div class="admreq-title-wrap">
                                <span class="admreq-cover">
                                    @if (!string.IsNullOrWhiteSpace(request.CoverImageUrl))
                                    {
                                        <img src="@request.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                    }
                                </span>
                                <span class="admreq-copy">
                                    @if (Model.ViewUrl(request) is { } resultUrl)
                                    {
                                        <a class="admreq-title" href="@resultUrl">@request.Title</a>
                                    }
                                    else
                                    {
                                        <strong class="admreq-title">@request.Title</strong>
                                    }
                                    <span class="admin-tag admin-tag-text" data-kind="@AcquisitionAccessNames.Kind(request.Kind)">@ui["admin.requests.kind." + AcquisitionAccessNames.Kind(request.Kind)]</span>
                                    @if (!string.IsNullOrWhiteSpace(request.Subtitle))
                                    {
                                        <small>@request.Subtitle</small>
                                    }
                                    @if (request.WasAutoApproved)
                                    {
                                        <small>@ui["requests.autoApproved"]</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.StatusMessage))
                                    {
                                        <small>@request.StatusMessage</small>
                                    }
                                </span>
                              </div>
                            </td>
                            <td class="admreq-cell-who">@requester</td>
                            <td class="admreq-cell-lang">
                              <div class="admreq-stack">
                                @if (language is not null)
                                {
                                    <span>@RequestLanguages.Name(language)</span>
                                }
                                else if (request.Kind == MediaAcquisitionKind.Anime)
                                {
                                    <span>@ui["requests.new.anyLanguage"]</span>
                                }
                                else
                                {
                                    <span class="admreq-none" aria-hidden="true">&mdash;</span>
                                }
                                @if (options.Count > 0)
                                {
                                    <small>@string.Join(" · ", options)</small>
                                }
                              </div>
                            </td>
                            <td class="admreq-cell-when">
                                <time datetime="@Iso(request.CreatedAt)">
                                    <span>@Day(request.CreatedAt)</span>
                                    <small>@Clock(request.CreatedAt)</small>
                                </time>
                            </td>
                            <td class="admreq-cell-state">
                                <span class="admin-tag admin-tag-@AdminStatusTone.Of(request.Status)" data-status="@status">
                                    <partial name="_RequestStatusIcon" model="status" />
                                    @ui["requests.status." + status]
                                </span>
                            </td>
                            <td class="admreq-cell-actions">
                                @{
                                    var waiting = request.Status is AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Failed;
                                    var viewUrl = request.Status != AcquisitionRequestStatus.Pending ? Model.ViewUrl(request) : null;
                                    var manualUrl = waiting && isVideo ? Url.Page("/Admin/ManualSearch", new { id = request.Id })
                                        : waiting && request.Kind == MediaAcquisitionKind.Book ? Url.Page("/Admin/BookManualSearch", new { id = request.Id })
                                        : null;
                                    var manageUrl = Model.VideoWorks.TryGetValue(request.Id, out var work) && request.Status != AcquisitionRequestStatus.Pending
                                        ? VideoWorkLinks.AdminPath(request.Kind, work.WorkId)
                                        : null;
                                    var inWanted = request.Status is AcquisitionRequestStatus.Approved or AcquisitionRequestStatus.Searching
                                        or AcquisitionRequestStatus.Downloading or AcquisitionRequestStatus.Importing
                                        && (request.Kind == MediaAcquisitionKind.Anime || isVideo);
                                    var searchNow = request.Status == AcquisitionRequestStatus.Approved && (isBookLike || isVideo);
                                    var viewIsPrimary = viewUrl is not null && !waiting && request.Status != AcquisitionRequestStatus.Rejected;
                                    var hasMenu = inWanted || manageUrl is not null || waiting || (viewUrl is not null && !viewIsPrimary);
                                }
                                <div class="admreq-actions">
                                    @if (request.Status is AcquisitionRequestStatus.Pending or AcquisitionRequestStatus.Failed)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button button-primary" type="submit">@(request.Status == AcquisitionRequestStatus.Failed ? ui["admin.requests.retry"] : ui["admin.requests.approve"])</button>
                                        </form>
                                    }
                                    @if (request.Status == AcquisitionRequestStatus.Pending)
                                    {
                                        <form method="post" asp-page-handler="Reject" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button button-danger" type="submit">@ui["admin.requests.reject"]</button>
                                        </form>
                                    }
                                    @if (request.Status == AcquisitionRequestStatus.Rejected)
                                    {
                                        <form method="post" asp-page-handler="Reopen" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="button" type="submit">@ui["admin.requests.reopen"]</button>
                                        </form>
                                    }
                                    @if (viewIsPrimary)
                                    {
                                        <a class="admin-icon-button admin-icon-button-labelled" href="@viewUrl"><partial name="_AdminIcon" model='"eye"' /><span class="admin-icon-label">@ui["admin.requests.viewMedia"]</span></a>
                                    }
                                    @if (searchNow)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="admin-icon-button" type="submit" title="@ui["admin.requests.searchNow"]"><partial name="_AdminIcon" model='"refresh"' /><span class="admin-icon-label">@ui["admin.requests.searchNow"]</span></button>
                                        </form>
                                    }
                                    @if (manualUrl is not null)
                                    {
                                        <a class="admin-icon-button" href="@manualUrl" title="@ui["admin.wanted.manualSearch"]"><partial name="_AdminIcon" model='"search"' /><span class="admin-icon-label">@ui["admin.wanted.manualSearch"]</span></a>
                                    }
                                    @if (hasMenu)
                                    {
                                        <details class="admin-menu">
                                            <summary class="admin-icon-button" aria-label="@ui["admin.menu.more"]" title="@ui["admin.menu.more"]"><partial name="_AdminIcon" model='"more"' /></summary>
                                            <div class="admin-menu-list">
                                                @if (viewUrl is not null && !viewIsPrimary)
                                                {
                                                    <a class="admin-menu-item" href="@viewUrl">@ui["admin.requests.viewMedia"]</a>
                                                }
                                                @if (inWanted)
                                                {
                                                    <a class="admin-menu-item" asp-page="/Admin/Wanted">@ui["admin.requests.wanted"]</a>
                                                }
                                                @if (manageUrl is not null)
                                                {
                                                    <a class="admin-menu-item" href="@manageUrl">@ui["admin.media.manage"]</a>
                                                }
                                                @if (waiting)
                                                {
                                                    <form method="post" asp-page-handler="Complete" asp-route-id="@request.Id">
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button class="admin-menu-item" type="submit">@ui["admin.requests.markDone"]</button>
                                                    </form>
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admreq-footer">
            <span>@ui.Format("admin.requests.showing", ("from", (queue.Page - 1) * AdminRequestQuery.PageSize + 1), ("to", (queue.Page - 1) * AdminRequestQuery.PageSize + queue.Items.Count), ("total", queue.Total))</span>
            @if (queue.PageCount > 1)
            {
                <nav class="admreq-pager" aria-label="@ui["admin.requests.title"]">
                    @if (queue.HasPrevious)
                    {
                        <a class="button" href="@RequestsModel.Href(filter with { Page = queue.Page - 1 })">@ui["requests.page.previous"]</a>
                    }
                    <span>@ui.Format("requests.page.of", ("page", queue.Page), ("pages", queue.PageCount))</span>
                    @if (queue.HasNext)
                    {
                        <a class="button" href="@RequestsModel.Href(filter with { Page = queue.Page + 1 })">@ui["requests.page.next"]</a>
                    }
                </nav>
            }
        </div>
    }
</section>

<details class="admreq-settings" id="rules">
    <summary>@ui["admin.requests.settingsSummary"]</summary>

<section class="panel access-policies">
    <div class="panel-heading">
        <h2>@ui["admin.requests.policiesHeading"]</h2>
    </div>
    <p class="muted">@ui["admin.requests.policiesHelp"]</p>
    <form method="post" asp-page-handler="Policies">
        <table class="access-policy-table">
            <thead>
                <tr>
                    <th scope="col">@ui["admin.requests.column.media"]</th>
                    <th scope="col">@ui["admin.requests.column.manual"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var policy in Model.Policies)
                {
                    var name = AcquisitionAccessNames.Kind(policy.Kind);
                    <tr>
                        <th scope="row">@ui["admin.requests.kind." + name]</th>
                        <td>
                            <select name="manual.@name" aria-label="@ui["admin.requests.column.manual"]">
                                @foreach (var mode in Enum.GetValues<ManualAddMode>())
                                {
                                    var value = AcquisitionAccessNames.Manual(mode);
                                    <option value="@value" selected="@(mode == policy.Manual)">@ui["admin.requests.manual." + value]</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
    </form>
</section>

<section class="panel auto-approval" id="auto-approval">
    <div class="panel-heading">
        <h2>@ui["admin.requests.autoHeading"]</h2>
    </div>
    <p class="muted">@ui["admin.requests.autoHelp"]</p>

    @if (settings.AutoApprovalRules.Count == 0)
    {
        <p class="muted">@ui["admin.requests.autoEmpty"]</p>
    }
    else
    {
        <ul class="auto-rule-list">
            @foreach (var rule in settings.AutoApprovalRules)
            {
                var media = rule.Kinds.Count == 0
                    ? ui["admin.requests.autoAllMedia"]
                    : string.Join(", ", rule.Kinds.Select(kind => ui["admin.requests.kind." + AcquisitionAccessNames.Kind(kind)]));
                var requester = rule.ProfileIds.Count == 0
                    ? ui["admin.requests.autoEveryone"]
                    : string.Join(", ", rule.ProfileIds.Select(id => Model.ProfileNames.GetValueOrDefault(id) ?? id));
                var limit = rule.Quota is { } quota
                    ? ui.Format("admin.requests.autoQuotaText", ("count", quota.MaxRequests), ("days", quota.PeriodDays))
                    : ui["admin.requests.autoNoLimit"];
                <li class="auto-rule-row@(rule.Enabled ? "" : " is-off")">
                    <div class="auto-rule-copy">
                        <strong>@rule.Name</strong>
                        <span>@media · @requester · @limit</span>
                    </div>
                    @if (!rule.Enabled)
                    {
                        <span class="status-pill">@ui["admin.requests.autoOff"]</span>
                    }
                    @if (Model.CanEditSettings)
                    {
                        <div class="request-actions">
                            <form method="post" asp-page-handler="RuleEnabled">
                                <input type="hidden" name="id" value="@rule.Id" />
                                <input type="hidden" name="enabled" value="@(rule.Enabled ? "false" : "true")" />
                                <button class="button" type="submit">@(rule.Enabled ? ui["admin.requests.autoDisable"] : ui["admin.requests.autoEnable"])</button>
                            </form>
                            <form method="post" asp-page-handler="RemoveRule">
                                <input type="hidden" name="id" value="@rule.Id" />
                                <button class="button" type="submit">@ui["admin.requests.autoRemove"]</button>
                            </form>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.CanEditSettings)
    {
        <form method="post" asp-page-handler="AddRule" class="auto-rule-form">
            <label class="auto-rule-field">
                <span>@ui["admin.requests.autoName"]</span>
                <input type="text" name="name" maxlength="@AutoApprovalRule.MaxNameLength" required />
            </label>
            <fieldset class="auto-rule-field">
                <legend>@ui["admin.requests.column.media"]</legend>
                <div class="auto-rule-checks">
                    @foreach (var kind in Model.EnabledKinds)
                    {
                        var kindName = AcquisitionAccessNames.Kind(kind);
                        <label><input type="checkbox" name="kinds" value="@kindName" /> @ui["admin.requests.kind." + kindName]</label>
                    }
                </div>
            </fieldset>
            <label class="auto-rule-field">
                <span>@ui["admin.requests.autoRequester"]</span>
                <select name="profileId">
                    <option value="">@ui["admin.requests.autoEveryone"]</option>
                    @foreach (var (id, userName) in Model.ProfileNames.OrderBy(pair => pair.Value, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@id">@userName</option>
                    }
                </select>
            </label>
            <label class="auto-rule-field">
                <span>@ui["admin.requests.autoMax"]</span>
                <input type="number" name="maxRequests" min="1" max="@AutoApprovalQuota.MaxRequestsLimit" />
            </label>
            <label class="auto-rule-field">
                <span>@ui["admin.requests.autoDays"]</span>
                <input type="number" name="periodDays" min="1" max="@AutoApprovalQuota.PeriodDaysLimit" />
            </label>
            <button class="button button-primary" type="submit">@ui["admin.requests.autoAdd"]</button>
        </form>
    }

    @if (Model.QualityProfiles.Count > 0)
    {
        <h3 class="auto-approval-subheading">@ui["admin.requests.profilesHeading"]</h3>
        <p class="muted">@ui["admin.requests.profilesHelp"]</p>
        <form method="post" asp-page-handler="Profiles">
            <div class="auto-rule-checks">
                @foreach (var profile in Model.QualityProfiles)
                {
                    <label>
                        <input type="checkbox" name="profiles" value="@profile.Id"
                               checked="@settings.RequesterQualityProfileIds.Contains(profile.Id, StringComparer.Ordinal)"
                               disabled="@(!Model.CanEditSettings)" />
                        @profile.Name
                    </label>
                }
            </div>
            @if (Model.CanEditSettings)
            {
                <button class="button button-primary" type="submit">@ui["common.save"]</button>
            }
        </form>
    }
</section>

</details>
