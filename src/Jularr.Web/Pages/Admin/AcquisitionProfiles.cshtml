@page
@model Jularr.Web.Pages.Admin.AcquisitionProfilesModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Acquisition.Quality
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.profiles.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-profiles.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
    <script src="~/js/admin-profiles.js" asp-append-version="true" defer></script>
}

<header class="page-header">
    <div>
        <h1>@ui["admin.profiles.title"]</h1>
        <p>@ui["admin.profiles.intro"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Notice is not null)
{
    <p class="admset-notice" role="status">@Model.Notice</p>
}
@if (Model.Warning is not null)
{
    <p class="admset-notice" role="alert">@Model.Warning</p>
}

<div class="admprofiles">
    <aside class="admset-section admprofiles-list" aria-labelledby="admprofiles-list-heading">
        <div class="admset-head"><div><h2 id="admprofiles-list-heading">@ui["admin.profiles.list"]</h2></div></div>
        <ul class="admprofiles-items">
            @foreach (var row in Model.Rows)
            {
                var current = Model.Selected is not null && row.Profile.Id == Model.Selected.Profile.Id;
                <li>
                    <a class="admprofiles-item" asp-page="AcquisitionProfiles" asp-route-id="@row.Profile.Id" aria-current="@(current ? "page" : null)">
                        <strong>@row.Profile.Name</strong>
                        @if (row.DefaultKinds.Count > 0 || row.Titles > 0)
                        {
                            <span class="admprofiles-tags">
                                @if (row.DefaultKinds.Count > 0)
                                {
                                    <span class="admin-tag admin-tag-accent">@ui.Format("admin.profiles.defaultFor", ("kinds", string.Join(", ", row.DefaultKinds.Select(Model.KindLabel))))</span>
                                }
                                @if (row.Titles > 0)
                                {
                                    <span class="admin-tag admin-tag-text">@ui.Format("admin.profiles.usedBy", ("titles", row.Titles))</span>
                                }
                            </span>
                        }
                    </a>
                </li>
            }
        </ul>
        <form method="post" asp-page-handler="New" class="admset-actions admprofiles-new">
            <label class="admprofiles-new-kind">
                <span class="admset-label">@ui["admin.profiles.newLabel"]</span>
                <select class="admset-control" name="kind">
                    @foreach (var kind in Model.Kinds)
                    {
                        <option value="@kind">@Model.KindLabel(kind)</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">@ui["admin.profiles.new"]</button>
        </form>
    </aside>

    @if (Model.Selected is { } selected)
    {
        var profile = selected.Profile;
        var known = Model.KnownQualities(selected);
        var ranked = Model.Form.QualityOrder;
        var unranked = known.Where(quality => !ranked.Contains(quality, StringComparer.OrdinalIgnoreCase)).ToArray();
        var fields = Model.RuleFields(selected);
        var qualityTemplate = new ProfileQualityRowView("__quality__", true, false, ui);
        var ruleTemplate = new ProfileRuleRowView(new ScoreRuleRow { Effect = nameof(ReleaseRuleEffect.Prefer), Field = fields[0].ToString(), Match = nameof(ReleaseRuleMatch.Equals) }, "__index__", fields, ui);
        <div class="admprofiles-editor">
            <section class="admset-section" aria-labelledby="admprofiles-edit-heading">
                <div class="admset-head">
                    <div>
                        <h2 id="admprofiles-edit-heading">@profile.Name</h2>
                        <p>@Model.UsageText(selected)</p>
                    </div>
                    <div class="admset-actions admprofiles-profile-actions">
                        <form method="post" asp-page-handler="Duplicate" asp-route-id="@profile.Id"><button class="button" type="submit">@ui["admin.profiles.duplicate"]</button></form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@profile.Id"><button class="button button-danger" type="submit">@ui["admin.profiles.delete"]</button></form>
                    </div>
                </div>
                <form method="post" asp-page-handler="SetDefault" asp-route-id="@profile.Id" class="admset-actions">
                    <label class="admprofiles-new-kind">
                        <span class="admset-label">@ui["admin.profiles.setDefaultLabel"]</span>
                        <select class="admset-control" name="kind">
                            @foreach (var kind in Model.Kinds)
                            {
                                <option value="@kind">@Model.KindLabel(kind)</option>
                            }
                        </select>
                    </label>
                    <button class="button" type="submit">@ui["admin.profiles.setDefault"]</button>
                </form>
            </section>

            @if (Model.Errors.Count > 0)
            {
                <ul class="admset-notice admprofiles-errors" role="alert">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@Model.ErrorText(error)</li>
                    }
                </ul>
            }

            <form method="post" asp-page-handler="Save" class="admprofiles-form">
                <input type="hidden" name="Id" value="@profile.Id" />

                <section class="admset-section" aria-labelledby="admprofiles-general">
                    <div class="admset-head"><div><h2 id="admprofiles-general">@ui["admin.profiles.section.general"]</h2></div></div>
                    <div class="admset-fields">
                        <div class="admset-field"><label for="admprofiles-name">@ui["admin.profiles.field.name"]</label><input id="admprofiles-name" type="text" name="Name" value="@Model.Form.Name" required maxlength="80" /></div>
                    </div>
                    <label class="admset-switch-row">
                        <span class="admset-switch-copy"><strong>@ui["admin.profiles.field.allowAmbiguousIdentity"]</strong><span>@ui["admin.profiles.hint.allowAmbiguousIdentity"]</span></span>
                        <input type="checkbox" class="admin-switch" role="switch" name="AllowAmbiguousIdentity" value="true" checked="@Model.Form.AllowAmbiguousIdentity" />
                    </label>
                </section>

                <section class="admset-section" aria-labelledby="admprofiles-order">
                    <div class="admset-head"><div><h2 id="admprofiles-order">@ui["admin.profiles.section.order"]</h2><p>@ui["admin.profiles.order.hint"]</p></div></div>
                    <div class="admprofiles-order" data-quality-order>
                        <div class="admprofiles-order-head" aria-hidden="true">
                            <span>@ui["admin.profiles.order.col.quality"]</span>
                            <span>@ui["admin.profiles.order.col.takeNow"]</span>
                            <span>@ui["admin.profiles.order.col.final"]</span>
                        </div>
                        <ol class="admprofiles-quality-list" data-quality-list>
                            @foreach (var quality in ranked)
                            {
                                var taken = Model.Form.AllowedQualities.Contains(quality, StringComparer.OrdinalIgnoreCase);
                                var isFinal = string.Equals(Model.Form.UpgradeCutoffQuality, quality, StringComparison.OrdinalIgnoreCase);
                                <partial name="_AcquisitionProfileQualityRow" model="new ProfileQualityRowView(quality, taken, isFinal, ui)" />
                            }
                        </ol>
                        <label class="admprofiles-quality-none">
                            <input type="radio" name="UpgradeCutoffQuality" value="" checked="@string.IsNullOrWhiteSpace(Model.Form.UpgradeCutoffQuality)" />
                            <span>@ui["admin.profiles.order.noFinal"]</span>
                        </label>
                        <template data-quality-template>
                            <partial name="_AcquisitionProfileQualityRow" model="qualityTemplate" />
                        </template>
                        <div class="admprofiles-unranked" data-quality-unranked hidden="@(unranked.Length == 0)">
                            <h3 class="admset-label">@ui["admin.profiles.order.unranked"]</h3>
                            <ul class="admprofiles-chips">
                                @foreach (var quality in unranked)
                                {
                                    <li data-unranked="@quality"><button type="button" class="admprofiles-chip" data-rank-add="@quality"><partial name="_AdminIcon" model='"plus"' /><span>@quality</span></button></li>
                                }
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="admset-section" aria-labelledby="admprofiles-upgrades">
                    <div class="admset-head"><div><h2 id="admprofiles-upgrades">@ui["admin.profiles.section.upgrades"]</h2></div></div>
                    <label class="admset-switch-row">
                        <span class="admset-switch-copy"><strong>@ui["admin.profiles.field.upgradeAllowed"]</strong><span>@ui["admin.profiles.hint.upgradeAllowed"]</span></span>
                        <input type="checkbox" class="admin-switch" role="switch" name="UpgradeAllowed" value="true" checked="@Model.Form.UpgradeAllowed" />
                    </label>
                    <div class="admset-fields">
                        <div class="admset-field">
                            <label for="admprofiles-steps">@ui["admin.profiles.field.upgradeMinimumQualitySteps"]</label>
                            <input id="admprofiles-steps" type="number" min="1" inputmode="numeric" name="UpgradeMinimumQualitySteps" value="@Model.Form.UpgradeMinimumQualitySteps" />
                        </div>
                    </div>
                </section>

                <section class="admset-section" aria-labelledby="admprofiles-limits">
                    <div class="admset-head"><div><h2 id="admprofiles-limits">@ui["admin.profiles.section.limits"]</h2></div></div>
                    <div class="admset-fields">
                        <div class="admset-field">
                            <label for="admprofiles-minsize">@ui["admin.profiles.field.minimumSizeMegabytes"]</label>
                            <input id="admprofiles-minsize" type="number" min="0" inputmode="numeric" name="MinimumSizeMegabytes" value="@Model.Form.MinimumSizeMegabytes" />
                        </div>
                        <div class="admset-field">
                            <label for="admprofiles-maxsize">@ui["admin.profiles.field.maximumSizeMegabytes"]</label>
                            <input id="admprofiles-maxsize" type="number" min="0" inputmode="numeric" name="MaximumSizeMegabytes" value="@Model.Form.MaximumSizeMegabytes" />
                        </div>
                    </div>
                </section>

                <section class="admset-section" aria-labelledby="admprofiles-rules">
                    <div class="admset-head"><div><h2 id="admprofiles-rules">@ui["admin.profiles.section.rules"]</h2><p>@ui["admin.profiles.rules.hint"]</p></div></div>
                    <div class="admset-table-wrap" data-repeat="rules" data-next="@Model.Form.Rules.Count">
                        <table class="admset-table admprofiles-rules">
                            <thead>
                                <tr>
                                    <th scope="col">@ui["admin.profiles.rule.effect"]</th>
                                    <th scope="col">@ui["admin.profiles.rule.field"]</th>
                                    <th scope="col">@ui["admin.profiles.rule.match"]</th>
                                    <th scope="col">@ui["admin.profiles.rule.value"]</th>
                                    <th scope="col">@ui["admin.profiles.rule.name"]</th>
                                    <th scope="col"><span class="visually-hidden">@ui["admin.requests.col.actions"]</span></th>
                                </tr>
                            </thead>
                            <tbody data-repeat-list>
                                @for (var index = 0; index < Model.Form.Rules.Count; index++)
                                {
                                    <partial name="_AcquisitionProfileRuleRow" model="new ProfileRuleRowView(Model.Form.Rules[index], index.ToString(), fields, ui)" />
                                }
                            </tbody>
                        </table>
                        <template data-repeat-template>
                            <table><tbody><partial name="_AcquisitionProfileRuleRow" model="ruleTemplate" /></tbody></table>
                        </template>
                        <button type="button" class="button" data-repeat-add><partial name="_AdminIcon" model='"plus"' />@ui["admin.profiles.rule.add"]</button>
                    </div>

                    <div class="admset-fields">
                        <div class="admset-field">
                            <label for="admprofiles-must">@ui["admin.profiles.field.mustContain"]</label>
                            <textarea id="admprofiles-must" name="MustContain" rows="3" spellcheck="false">@Model.Form.MustContain</textarea>
                        </div>
                        <div class="admset-field">
                            <label for="admprofiles-mustnot">@ui["admin.profiles.field.mustNotContain"]</label>
                            <textarea id="admprofiles-mustnot" name="MustNotContain" rows="3" spellcheck="false">@Model.Form.MustNotContain</textarea>
                        </div>
                        <div class="admset-field">
                            <label for="admprofiles-regex">@ui["admin.profiles.field.requiredRegex"]</label>
                            <textarea id="admprofiles-regex" name="RequiredRegex" rows="2" spellcheck="false">@Model.Form.RequiredRegex</textarea>
                        </div>
                        <div class="admset-field">
                            <label for="admprofiles-regexnot">@ui["admin.profiles.field.rejectedRegex"]</label>
                            <textarea id="admprofiles-regexnot" name="RejectedRegex" rows="2" spellcheck="false">@Model.Form.RejectedRegex</textarea>
                        </div>
                    </div>
                    <p class="admset-hint">@ui["admin.profiles.hint.terms"]</p>
                </section>

                <section class="admset-section" aria-labelledby="admprofiles-sources">
                    <div class="admset-head"><div><h2 id="admprofiles-sources">@ui["admin.profiles.sources"]</h2></div></div>
                    <p class="admset-hint">@ui["admin.profiles.sources.hint"]</p>
                    @if (Model.Sources.Count == 0)
                    {
                        <p class="admset-hint">@ui["admin.profiles.sources.none"]</p>
                    }
                    else
                    {
                        <ul class="admprofiles-sources">
                            @foreach (var source in Model.Sources)
                            {
                                <li>
                                    <label class="admprofiles-chip"><input type="checkbox" name="AllowedSources" value="@source.Id" checked="@Model.Form.AllowedSources.Contains(source.Id)" /><span>@source.Name</span></label>
                                    <label class="admprofiles-chip"><input type="checkbox" name="PreferredSources" value="@source.Id" checked="@Model.Form.PreferredSources.Contains(source.Id)" /><span>@ui["admin.profiles.sources.prefer"]</span></label>
                                    <label class="admprofiles-chip"><input type="checkbox" name="FallbackOnlySources" value="@source.Id" checked="@Model.Form.FallbackOnlySources.Contains(source.Id)" /><span>@ui["admin.profiles.sources.fallbackOnly"]</span></label>
                                    @if (source.Missing)
                                    {
                                        <span class="admin-tag admin-tag-text">@ui["admin.profiles.sources.missing"]</span>
                                    }
                                    else if (!source.Enabled)
                                    {
                                        <span class="admin-tag admin-tag-text">@ui["admin.profiles.sources.disabled"]</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="admset-section" aria-labelledby="admprofiles-test">
                    <div class="admset-head"><div><h2 id="admprofiles-test">@ui["admin.profiles.test.heading"]</h2><p>@ui["admin.profiles.test.hint"]</p></div></div>
                    <div class="admset-grid">
                        <label class="admset-field"><span class="admset-label">@ui["admin.profiles.test.title"]</span><input class="admset-control" name="testTitle" value="@Model.TestInput.Title" spellcheck="false" /></label>
                        <label class="admset-field"><span class="admset-label">@ui["admin.profiles.test.size"]</span><input class="admset-control" type="number" min="0" name="testSizeMegabytes" value="@Model.TestInput.SizeMegabytes" /></label>
                        <label class="admset-field">
                            <span class="admset-label">@ui["admin.profiles.test.source"]</span>
                            <select class="admset-control" name="testSource">
                                <option value="">@ui["admin.profiles.test.sourceAny"]</option>
                                @foreach (var source in Model.Sources.Where(source => !source.Missing))
                                {
                                    <option value="@source.Id" selected="@(Model.TestInput.Source == source.Id)">@source.Name</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="admset-actions"><button class="button" type="submit" asp-page-handler="Test" formnovalidate>@ui["admin.profiles.test.run"]</button></div>
                    @if (Model.TestResult is { } test)
                    {
                        <div class="admset-notice" role="status" data-profile-test-result>
                            <p><strong>@Model.TestVerdict(test)</strong></p>
                            @if (test.QualityKey.Length > 0)
                            {
                                <p>@ui.Format("admin.profiles.test.quality", ("quality", test.QualityKey))</p>
                            }
                            @if (test.Reasons.Count > 0)
                            {
                                <ul>
                                    @foreach (var reason in test.Reasons)
                                    {
                                        <li>@reason</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </section>

                <div class="admset-actions">
                    <button class="button button-primary" type="submit">@ui["admin.profiles.save"]</button>
                </div>
            </form>
        </div>
    }
</div>
