@page
@model Jularr.Web.Pages.Admin.HealthModel
@using Jularr.Web.Features.Health
@using Jularr.Web.Features.Playback.Transcoding
@using Jularr.Web.Features.Storage
@section Head {
    <link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.nav.health"];
    var snapshot = Model.Snapshot;
    var update = Model.Update;
    var encoderName = Model.EncoderInUse.IsHardware ? PlaybackHardwareBackends.DisplayName(Model.EncoderInUse.Backend) : ui["admin.health.hardware.software"];

    string Pill(HealthState state) => state switch
    {
        HealthState.Ok => "status-ok",
        HealthState.Warning => "status-warning",
        _ => "status-error"
    };

    string ToolLabel(ExternalToolStatus tool) => tool.IsAvailable
        ? ui.Format("admin.health.tool.detected", ("tool", tool.Name), ("version", tool.Version ?? tool.Name))
        : ui.Format("admin.health.tool.notFound", ("tool", tool.Name));

    var aiPillClass = Model.AiStatus.IsAuthenticated
        ? "status-ok"
        : Model.AiStatus.IsAvailable ? "status-warning" : "status-error";
    var aiLabel = Model.AiStatus.IsAuthenticated
        ? ui["admin.subtitles.connected"]
        : Model.AiStatus.IsAvailable ? ui["admin.ai.notConnected"] : ui["admin.ai.unavailable"];

    var acquisitionPillClass = !snapshot.Acquisition.IsConfigured
        ? "status-warning"
        : Pill(snapshot.Acquisition.State);
    var acquisitionLabel = !snapshot.Acquisition.IsConfigured
        ? ui["admin.health.acquisition.notConfigured"]
        : snapshot.Acquisition.State == HealthState.Ok
            ? ui["settings.connectionTable.healthy"]
            : ui["settings.connectionTable.unhealthy"];
}

<header class="page-header">
    <div>
        <h1>@ui["admin.nav.health"]</h1>
        <p>@ui["admin.health.subtitle"]</p>
    </div>
</header>

<partial name="_AdminNavigation" model="Model.Ui" />

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.health.database.title"]</h2>
            <span class="status-pill @Pill(snapshot.Database.State)">
                @(snapshot.Database.Reachable ? ui["admin.health.database.reachable"] : ui["admin.health.database.unreachable"])
            </span>
        </div>

        <div class="status-list">
            <div>
                <span>@ui["admin.health.database.sizeLabel"]</span>
                <strong>@(snapshot.Database.FileSizeBytes is { } size ? StorageHealth.FormatBytes(size) : "—")</strong>
            </div>
            <div>
                <span>@ui["admin.health.database.backupLabel"]</span>
                <strong>—</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(snapshot.Database.Error))
        {
            <p class="validation">@snapshot.Database.Error</p>
        }
        <p class="muted">@ui["admin.health.database.lastBackupUnknown"]</p>

        <a class="button" asp-page="/Settings/Acquisition">@ui["admin.health.database.openBackup"]</a>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.health.storage.title"]</h2>
            <span class="status-pill @Pill(snapshot.DataVolume.State)">
                @(snapshot.DataVolume.State == HealthState.Ok ? ui["admin.overview.ok"] : ui["admin.health.storage.lowSpace"])
            </span>
        </div>

        <div class="status-list">
            <div>
                <span>@ui["admin.health.storage.dataVolumeLabel"]</span>
                <strong>
                    @(snapshot.DataVolume.FreeBytes is { } free && snapshot.DataVolume.TotalBytes is { } total
                        ? ui.Format("admin.health.storage.freeOfTotal", ("free", StorageHealth.FormatBytes(free)), ("total", StorageHealth.FormatBytes(total)))
                        : ui["admin.overview.unknown"])
                </strong>
            </div>
        </div>

        @if (snapshot.StorageRoots.Count > 0)
        {
            <div class="root-list">
                @foreach (var root in snapshot.StorageRoots)
                {
                    <div class="root-row">
                        <div>
                            <strong>@root.Name</strong>
                            <span class="status-pill @Pill(root.Online ? HealthState.Ok : HealthState.Error)">
                                @(root.Online ? ui["admin.system.health.online"] : ui["admin.system.health.unavailable"])
                            </span>
                            @if (root.Online)
                            {
                                <small>@(root.Writable ? ui["admin.health.storage.writable"] : ui["admin.health.storage.readOnly"])</small>
                            }
                            <code>@root.Path</code>
                        </div>
                    </div>
                }
            </div>
        }

        <a class="button" asp-page="/Admin/System">@ui["admin.health.storage.manageLink"]</a>
    </section>
</div>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["admin.health.services.title"]</h2></div>

        <div class="status-list">
            <div>
                <span>@ToolLabel(snapshot.Ffmpeg)</span>
                <strong class="status-pill @Pill(snapshot.Ffmpeg.State)">
                    @(snapshot.Ffmpeg.IsAvailable ? ui["settings.connectionTable.healthy"] : ui["settings.connectionTable.unhealthy"])
                </strong>
            </div>
            <div>
                <span>@ToolLabel(snapshot.Ffprobe)</span>
                <strong class="status-pill @Pill(snapshot.Ffprobe.State)">
                    @(snapshot.Ffprobe.IsAvailable ? ui["settings.connectionTable.healthy"] : ui["settings.connectionTable.unhealthy"])
                </strong>
            </div>
        </div>

        <div class="status-list admin-overview-list" aria-label="@ui["admin.health.services.title"]">
            <a asp-page="/Admin/Operations">
                <span>@ui.Format("admin.health.queue.summary", ("running", snapshot.JobQueue.Running), ("blocked", snapshot.JobQueue.Blocked))</span>
                <strong class="status-pill @Pill(snapshot.JobQueue.State)">
                    @(snapshot.JobQueue.Blocked > 0 ? ui["admin.health.queue.blocked"] : ui["admin.overview.ok"])
                </strong>
            </a>
            <a asp-page="/Admin/Ai">
                <span>@ui["admin.system.ai"]</span>
                <strong class="status-pill @aiPillClass">@aiLabel</strong>
            </a>
            <a asp-page="/Admin/Usenet">
                <span>
                    @ui.Format("admin.health.acquisition.summary",
                        ("healthyIndexers", snapshot.Acquisition.HealthyIndexers),
                        ("totalIndexers", snapshot.Acquisition.TotalIndexers),
                        ("healthyClients", snapshot.Acquisition.HealthyDownloadClients),
                        ("totalClients", snapshot.Acquisition.TotalDownloadClients))
                </span>
                <strong class="status-pill @acquisitionPillClass">@acquisitionLabel</strong>
            </a>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.health.update.title"]</h2>
            @if (update is { State: UpdateCheckState.UpToDate })
            {
                <span class="status-pill status-ok">@ui["admin.health.update.upToDate"]</span>
            }
            else if (update is { State: UpdateCheckState.UpdateAvailable })
            {
                <span class="status-pill status-warning">@ui.Format("admin.health.update.available", ("version", update.LatestVersion ?? "?"))</span>
            }
            else if (update is { State: UpdateCheckState.Unavailable })
            {
                <span class="status-pill">@ui["admin.health.update.unavailable"]</span>
            }
            else
            {
                <span class="status-pill">@ui["admin.health.update.notChecked"]</span>
            }
        </div>

        <div class="status-list">
            <div>
                <span>@ui["admin.health.update.runningLabel"]</span>
                <strong>@Model.RunningVersion</strong>
            </div>
            <div>
                <span>@ui["admin.health.update.latestLabel"]</span>
                <strong>
                    @if (update?.LatestVersion is { } latest && update.ReleaseUrl is { } releaseUrl)
                    {
                        <a href="@releaseUrl" target="_blank" rel="noopener">v@(latest) · @ui["admin.health.update.viewRelease"]</a>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </strong>
            </div>
        </div>

        @if (update?.CheckedAtUtc is { } checkedAt)
        {
            <p class="muted">@ui.Format("admin.health.update.lastChecked", ("when", checkedAt.ToLocalTime().ToString("g")))</p>
        }

        <form method="post" asp-page-handler="CheckUpdate">
            <button class="button" type="submit">@ui["admin.health.update.checkButton"]</button>
        </form>
    </section>
</div>

<div class="admset-sections">
<section class="admset-section" id="hardware" aria-labelledby="hardware-title">
    <div class="admset-head">
        <span class="admset-tile"><partial name="_AdminIcon" model='"chip"' /></span>
        <div>
            <h2 id="hardware-title">@ui["admin.health.hardware.title"]</h2>
            <p>@ui.Format("admin.health.hardware.inUse", ("encoder", encoderName))</p>
        </div>
    </div>

    @if (Model.HardwareCapabilities is not { } hardware)
    {
        <p class="admset-hint">@ui["admin.health.hardware.pending"]</p>
    }
    else
    {
        <div class="admset-table-wrap">
            <table class="admset-table">
                <thead>
                    <tr>
                        <th scope="col">@ui["admin.health.hardware.column.encoder"]</th>
                        <th scope="col">@ui["admin.health.hardware.column.state"]</th>
                        <th scope="col">@ui["admin.health.hardware.column.note"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var backend in PlaybackHardwareBackends.SelectionOrder)
                    {
                        var status = hardware.Status(backend);
                        var breaker = Model.Breakers.First(x => x.Backend == backend);
                        var stateKey = status?.State switch
                        {
                            PlaybackBackendState.Available => "available",
                            PlaybackBackendState.EncoderMissing => "encoderMissing",
                            PlaybackBackendState.NoDevice => "noDevice",
                            PlaybackBackendState.TestFailed => "testFailed",
                            _ => "ffmpegUnavailable"
                        };
                        var tone = status?.State switch
                        {
                            PlaybackBackendState.Available when !breaker.IsOpen => "success",
                            PlaybackBackendState.TestFailed or PlaybackBackendState.Available => "warning",
                            _ => ""
                        };
                        <tr>
                            <td>
                                <span class="admset-name">
                                    <strong>@PlaybackHardwareBackends.DisplayName(backend)</strong>
                                    @if (status?.Device is { } device)
                                    {
                                        <code>@device</code>
                                    }
                                </span>
                            </td>
                            <td><span class="admin-tag @(tone.Length == 0 ? "" : "admin-tag-" + tone)">@ui[$"admin.health.hardware.state.{stateKey}"]</span></td>
                            <td>
                                @if (status?.Detail is { } detail)
                                {
                                    <small>@detail</small>
                                }
                                @if (Model.DecodeDisabled.Contains(backend))
                                {
                                    <small>@ui["admin.health.hardware.decodeDisabled"]</small>
                                }
                                @if (breaker.ConsecutiveFailures > 0)
                                {
                                    <small>
                                        @(breaker.IsOpen
                                            ? ui.Format("admin.health.hardware.breakerOpen", ("until", breaker.OpenUntilUtc!.Value.ToLocalTime().ToString("t")))
                                            : ui.Format("admin.health.hardware.breakerFailures", ("count", breaker.ConsecutiveFailures)))
                                    </small>
                                    @if (breaker.LastFailureDetail is { } failureDetail)
                                    {
                                        <small>@failureDetail</small>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="admset-hint">@ui.Format("admin.health.hardware.detectedAt", ("when", hardware.DetectedAtUtc.ToLocalTime().ToString("g")))</p>
    }

    @if (Model.HardwareDetectionError is { } detectionError)
    {
        <p class="admset-notice" role="alert">@ui.Format("admin.health.hardware.detectionFailed", ("error", detectionError))</p>
    }

    <div class="admset-actions">
        <form method="post" asp-page-handler="Redetect">
            <button class="button" type="submit">@ui["admin.health.hardware.redetect"]</button>
        </form>
        <a class="button" asp-page="/Admin/Transcoding">@ui["admin.health.hardware.settingsLink"]</a>
    </div>
</section>
</div>
