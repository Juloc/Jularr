@model Jularr.Web.Pages.Admin.Manga.MangaUnitRow
@{
    var ui = Model.Ui;
    var chapter = Model.Chapter;
    var number = chapter.Number.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var name = string.IsNullOrWhiteSpace(chapter.Title) ? ui.Format("admin.manga.unit.chapter", ("number", number)) : chapter.Title;
}
<div class="admmd-ep-row">
    <span class="admmd-ep-number"><span>@number</span></span>
    <span class="admmd-ep-title"><strong>@name</strong></span>
    <span class="admmd-ep-status">
        <span class="admin-tag admin-tag-@(chapter.Installed ? "success" : "text")">@(chapter.Installed ? ui["admin.manga.state.installed"] : chapter.Wanted ? ui["admin.manga.state.wanted"] : ui["admin.manga.state.missing"])</span>
        @if (!chapter.Monitored)
        {
            <span class="admin-tag">@ui["admin.media.monitoring.off"]</span>
        }
    </span>
    <span class="admmd-ep-monitor">
        <partial name="_MangaUnitControls" model="@(new Jularr.Web.Pages.Admin.Manga.MangaUnitControls(Model.WorkId, "chapter", chapter.Id, chapter.Number, chapter.Monitored, chapter.Decision, name, Model.CanSearch, ui))" />
    </span>
</div>
