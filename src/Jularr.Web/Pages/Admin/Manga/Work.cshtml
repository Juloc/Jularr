@page "{workId:long}"
@model Jularr.Web.Pages.Admin.Manga.WorkModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.ReadingAcquisition
@using Jularr.Web.Pages.Admin.Manga
@{
    var ui = Model.Ui;
    var view = Model.View;
    var coverage = view.Coverage;
    var request = view.Request;
    ViewData["Title"] = view.Title;

    string Initial() => string.IsNullOrWhiteSpace(view.Title) ? "?" : view.Title.Trim()[..1].ToUpperInvariant();
    string StateTone(ReadingCoverageState state) => state switch { ReadingCoverageState.Installed => "success", ReadingCoverageState.Partial => "warning", _ => "text" };

    var openRequest = view.RequestIsOpen;
    var failed = view.RequestFailed;
    var waiting = view.RequestIsWaiting;
    var canSearch = view.CanSearch;
    var (volumesInstalled, volumesTotal) = view.VolumeCount;
    var (chaptersInstalled, chaptersTotal) = view.ChapterCount;
    var statusText = coverage.HasStructure
        ? volumesTotal > 0
            ? ui.Format("admin.manga.stat.volumesOf", ("installed", volumesInstalled), ("total", volumesTotal))
            : ui.Format("admin.manga.stat.chaptersOf", ("installed", chaptersInstalled), ("total", chaptersTotal))
        : coverage.LocalChapters > 0 ? ui["admin.manga.state.installed"] : ui["admin.manga.state.missing"];

    // The chapters of a title without volumes, and the library files, are paged: a long-running series has more than a page can carry.
    var loose = coverage.LooseChapters;
    var looseCount = loose.Count;
    var pages = Math.Max(1, (int)Math.Ceiling(Math.Max(looseCount, view.Files.Count) / (double)WorkModel.ChaptersPerPage));
    var page = Math.Min(Model.ChapterPage, pages);
    var shownLoose = loose.Skip((page - 1) * WorkModel.ChaptersPerPage).Take(WorkModel.ChaptersPerPage).ToList();
    var shownFiles = view.Files.Skip((page - 1) * WorkModel.ChaptersPerPage).Take(WorkModel.ChaptersPerPage).Select(file => (file, readable: WorkModel.Readable(file.SourcePath))).ToList();
    var unreadable = shownFiles.Where(item => !item.readable).Select(item => item.file.Name).ToList();
}
@section Head {
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-media-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-manga.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/admin-menu.js" asp-append-version="true" defer></script>
}

<partial name="_AdminNavigation" model="Model.Ui" />

@if (Model.Notice is not null)
{
    <p class="admmd-notice" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="admmd-notice admmd-notice-error" role="alert">@Model.Error</p>
}

<section class="admmd-hero" aria-labelledby="admmd-title" data-admin-manga-work="@view.WorkId">
    <div class="admmd-poster" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(view.CoverUrl))
        {
            <img src="@view.CoverUrl" alt="" decoding="async" referrerpolicy="no-referrer" data-initial="@Initial()" onerror="this.replaceWith(Object.assign(document.createElement('span'), { textContent: this.dataset.initial }))" />
        }
        else
        {
            <span>@Initial()</span>
        }
    </div>
    <div class="admmd-hero-main">
        <div class="admmd-hero-top">
            <div class="admmd-titles">
                <h1 id="admmd-title">@view.Title</h1>
                @if (!string.IsNullOrWhiteSpace(view.NativeTitle) || view.Aliases.Count > 0)
                {
                    <p class="admmd-meta">@string.Join(" · ", new[] { view.NativeTitle }.Concat(view.Aliases.Take(3)).Where(name => !string.IsNullOrWhiteSpace(name)))</p>
                }
                <p class="admmd-meta">
                    @string.Join(" · ", new[] { view.Status?.Replace("_", " ").ToLowerInvariant(), view.Year?.ToString(System.Globalization.CultureInfo.InvariantCulture) }.Where(part => !string.IsNullOrEmpty(part)))
                    @foreach (var identity in view.Identities.Take(1))
                    {
                        @if (view.Status is not null || view.Year is not null)
                        {
                            <span> · </span>
                        }

                        <a class="text-link" href="https://anilist.co/manga/@Uri.EscapeDataString(identity.ExternalId)" target="_blank" rel="noopener noreferrer">AniList @identity.ExternalId</a>
                    }
                </p>
            </div>
            <div class="admmd-hero-actions">
                <form method="post" asp-page-handler="Monitor" asp-route-workId="@view.WorkId" class="admmd-monitor-form">
                    <input type="hidden" name="scope" value="work" />
                    <input type="hidden" name="state" value="@(coverage.Monitored ? "false" : "true")" />
                    <button class="admmd-toggle @(coverage.Monitored ? "is-on" : "")" type="submit" role="switch" aria-checked="@(coverage.Monitored ? "true" : "false")">
                        <span class="admin-switch" aria-hidden="true"></span>
                        @(coverage.Monitored ? ui["admin.media.monitored"] : ui["admin.media.monitor"])
                    </button>
                </form>
                @if (canSearch)
                {
                    <form method="post" asp-page-handler="Search" asp-route-workId="@view.WorkId" class="admmd-desktop-only">
                        <button class="button button-primary" type="submit">@ui["admin.media.action.automatic"]</button>
                    </form>
                }
                @if ((waiting || failed) && request is not null)
                {
                    <a class="button admmd-desktop-only" asp-page="/Admin/ReadingManualSearch" asp-route-id="@request.Id">@ui["admin.wanted.manualSearch"]</a>
                }
                <details class="admin-menu">
                    <summary class="admin-icon-button" aria-label="@ui["admin.media.more"]"><partial name="_AdminIcon" model='"more"' /><span class="admin-icon-label">@ui["admin.media.more"]</span></summary>
                    <div class="admin-menu-list">
                        @if (view.SeriesId is { } seriesId)
                        {
                            <a class="admin-menu-item" href="/Manga/Series/@seriesId">@ui["admin.media.openLibrary"]</a>
                        }
                        @if (view.FirstChapterId is { } chapterId)
                        {
                            <a class="admin-menu-item" href="/Manga/Read/@chapterId">@ui["admin.books.read"]</a>
                        }
                        <form method="post" asp-page-handler="Refresh" asp-route-workId="@view.WorkId">
                            <button class="admin-menu-item" type="submit">@ui["admin.manga.refresh"]</button>
                        </form>
                    </div>
                </details>
            </div>
        </div>
        <dl class="admmd-stats">
            <div class="admmd-stat"><dt>@ui["admin.books.stat.status"]</dt><dd>@statusText</dd></div>
            @if (volumesTotal > 0 && chaptersTotal > 0)
            {
                <div class="admmd-stat"><dt>@ui["admin.manga.stat.chapters"]</dt><dd>@ui.Format("admin.manga.stat.of", ("installed", chaptersInstalled), ("total", chaptersTotal))</dd></div>
            }
            <div class="admmd-stat"><dt>@ui["admin.manga.stat.files"]</dt><dd>@view.Files.Count</dd></div>
            <div class="admmd-stat"><dt>@ui["admin.books.stat.formats"]</dt><dd>@(view.Formats.Count == 0 ? "—" : string.Join(", ", view.Formats))</dd></div>
            <div class="admmd-stat"><dt>@ui["library.acquisitionPanel.qualityProfile"]</dt><dd>@view.ProfileName</dd></div>
        </dl>
        @if (request is not null && openRequest)
        {
            <p class="admmd-note">
                @Model.RequestLabel(request.Status)@(string.IsNullOrWhiteSpace(request.StatusMessage) ? "" : " · " + request.StatusMessage)
                @if (request.OperationId is { } operationId)
                {
                    <a class="text-link" asp-page="/Admin/Operation" asp-route-id="@operationId">@ui["admin.media.downloadDetails"]</a>
                }
            </p>
        }
    </div>
</section>

@if (unreadable.Count > 0)
{
    <p class="admmd-notice admmd-notice-error" role="alert">@ui.Format("admin.books.storageOffline", ("files", string.Join(", ", unreadable.Take(5)) + (unreadable.Count > 5 ? " …" : "")))</p>
}
@if (failed)
{
    <p class="admmd-note" role="status">
        @ui.Format("admin.media.requestFailed", ("message", string.IsNullOrWhiteSpace(request!.StatusMessage) ? ui["requests.status.failed"] : request.StatusMessage))
        @if (request.OperationId is { } failedOperation)
        {
            <a class="text-link" asp-page="/Admin/Operation" asp-route-id="@failedOperation">@ui["admin.media.downloadDetails"]</a>
        }
    </p>
    <form method="post" asp-page-handler="Retry" asp-route-workId="@view.WorkId" class="admmd-note">
        <button class="button" type="submit">@ui["admin.requests.retry"]</button>
    </form>
}
@if (coverage.UntiedLocalChapters > 0 && coverage.HasStructure)
{
    <p class="admmd-note" role="status">@ui.Format("admin.manga.untied", ("count", coverage.UntiedLocalChapters))</p>
}

<section class="admmd-groups admman-units" aria-labelledby="admman-units-title" data-admin-manga-units>
    <div class="admmd-toolbar admmd-toolbar-inline">
        <h2 id="admman-units-title">@(coverage.Volumes.Count > 0 ? ui["admin.manga.volumes.heading"] : ui["admin.manga.chapters.heading"])</h2>
    </div>
    @if (!coverage.HasStructure)
    {
        <p class="admmd-message muted" data-admin-media-empty>@ui["admin.manga.structure.none"]</p>
    }
    else
    {
        <ul class="admmd-episodes">
            @foreach (var volume in coverage.Volumes)
            {
                var volumeName = string.IsNullOrWhiteSpace(volume.Title) ? ui.Format("admin.manga.unit.volume", ("number", volume.Number)) : volume.Title;
                <li data-manga-volume="@volume.Number" data-state="@volume.State.ToString().ToLowerInvariant()">
                    @if (volume.Chapters.Count > 0)
                    {
                        <details class="admmd-group">
                            <summary class="admmd-group-head">
                                <span class="admmd-chevron"><partial name="_AdminMediaIcon" model='"chevron"' /></span>
                                <span class="admmd-group-name">
                                    <strong>@volumeName</strong>
                                    <small>@ui.Format("admin.manga.unit.chapterCount", ("count", volume.Chapters.Count))</small>
                                </span>
                                <span class="admmd-group-state">
                                    <span>@ui.Format("admin.manga.stat.of", ("installed", volume.InstalledChapters), ("total", volume.Chapters.Count))</span>
                                </span>
                                <span class="admmd-group-langs"><span class="admin-tag admin-tag-@StateTone(volume.State)">@Model.StateLabel(volume.State, volume.Wanted)</span></span>
                                <span class="admmd-group-monitor" onclick="event.stopPropagation()">
                                    <partial name="_MangaUnitControls" model="@(new MangaUnitControls(view.WorkId, "volume", volume.Id, volume.Number, volume.Monitored, volume.Decision, volumeName, canSearch && volume.State != ReadingCoverageState.Installed, Model.Ui))" />
                                </span>
                            </summary>
                            <ul class="admmd-episodes">
                                @foreach (var chapter in volume.Chapters)
                                {
                                    <li data-manga-chapter="@chapter.Number.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-state="@(chapter.Installed ? "installed" : "missing")">
                                        <partial name="_MangaUnitRow" model="@(new MangaUnitRow(view.WorkId, chapter, Model.Ui, false))" />
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="admmd-ep-row">
                            <span class="admmd-ep-number"><span>@volume.Number</span></span>
                            <span class="admmd-ep-title"><strong>@volumeName</strong></span>
                            <span class="admmd-ep-status">
                                <span class="admin-tag admin-tag-@StateTone(volume.State)">@Model.StateLabel(volume.State, volume.Wanted)</span>
                                @if (!volume.Monitored)
                                {
                                    <span class="admin-tag">@ui["admin.media.monitoring.off"]</span>
                                }
                            </span>
                            <span class="admmd-ep-monitor">
                                <partial name="_MangaUnitControls" model="@(new MangaUnitControls(view.WorkId, "volume", volume.Id, volume.Number, volume.Monitored, volume.Decision, volumeName, canSearch && volume.State != ReadingCoverageState.Installed, Model.Ui))" />
                            </span>
                        </div>
                    }
                </li>
            }
            @foreach (var chapter in shownLoose)
            {
                <li data-manga-chapter="@chapter.Number.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-state="@(chapter.Installed ? "installed" : "missing")">
                    <partial name="_MangaUnitRow" model="@(new MangaUnitRow(view.WorkId, chapter, Model.Ui, canSearch && !chapter.Installed))" />
                </li>
            }
        </ul>
    }
</section>

<section class="admmd-groups" aria-labelledby="admman-files-title" data-admin-manga-files>
    <div class="admmd-toolbar admmd-toolbar-inline">
        <h2 id="admman-files-title">@ui["admin.manga.files.heading"]</h2>
    </div>
    @if (view.Files.Count == 0)
    {
        <p class="admmd-message muted" data-admin-media-empty>@ui["admin.manga.files.none"]</p>
    }
    else
    {
        <ul class="admmd-files">
            @foreach (var (file, readable) in shownFiles)
            {
                <li class="admmd-file">
                    <div class="admmd-file-head">
                        <strong class="admmd-file-name">@file.Name</strong>
                        <span class="admmd-file-tags">
                            <span class="admmd-lang">@file.Format</span>
                            @if (file.VolumeNumber is { } fileVolume)
                            {
                                <span class="admmd-lang admmd-lang-quiet">@ui.Format("admin.manga.unit.volume", ("number", fileVolume))</span>
                            }
                            <span class="admmd-lang admmd-lang-quiet">@ui.Format("admin.manga.file.pages", ("count", file.PageCount))</span>
                            <span class="admin-tag admin-tag-@(readable ? "success" : "danger")">@(readable ? ui["admin.books.file.available"] : ui["admin.books.file.missing"])</span>
                            <a class="text-link" href="/Manga/Read/@file.Id">@ui["admin.books.read"]</a>
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(file.SourcePath))
                    {
                        <p class="admmd-path">@file.SourcePath</p>
                    }
                </li>
            }
        </ul>
    }
    @if (pages > 1)
    {
        <nav class="admman-pager" aria-label="@ui["admin.manga.page.heading"]">
            @if (page > 1)
            {
                <a class="button" asp-page="Work" asp-route-workId="@view.WorkId" asp-route-pageNumber="@(page - 1)">@ui["admin.manga.page.previous"]</a>
            }
            <span>@ui.Format("admin.manga.page.of", ("page", page), ("pages", pages))</span>
            @if (page < pages)
            {
                <a class="button" asp-page="Work" asp-route-workId="@view.WorkId" asp-route-pageNumber="@(page + 1)">@ui["admin.manga.page.next"]</a>
            }
        </nav>
    }
</section>

<div class="admmd-panels">
    <section class="admmd-panel" aria-labelledby="admmd-profile-title">
        <h2 id="admmd-profile-title">@ui["library.acquisitionPanel.qualityProfile"]</h2>
        <form method="post" asp-page-handler="Profile" asp-route-workId="@view.WorkId" class="admmd-form">
            <label class="admmd-field">
                <span>@ui["library.acquisitionPanel.qualityProfile"]</span>
                <select name="profileId">
                    <option value="" selected="@(view.AssignedProfileId is null)">@ui["admin.media.video.defaultProfile"]</option>
                    @foreach (var (profileId, profileName) in view.Profiles)
                    {
                        <option value="@profileId" selected="@profileId.Equals(view.AssignedProfileId, StringComparison.OrdinalIgnoreCase)">@profileName</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">@ui["common.save"]</button>
        </form>
    </section>
    <section class="admmd-panel" aria-labelledby="admman-history-title" data-admin-manga-history>
        <h2 id="admman-history-title">@ui["admin.manga.history.heading"]</h2>
        @if (view.History.Count == 0)
        {
            <p class="admmd-note">@ui["admin.manga.history.none"]</p>
        }
        else
        {
            <ul class="admmd-list">
                @foreach (var entry in view.History)
                {
                    <li>
                        <strong>@Model.RequestLabel(entry.Status)</strong>
                        @if (!string.IsNullOrWhiteSpace(entry.StatusMessage))
                        {
                            <span class="admmd-reason">@entry.StatusMessage</span>
                        }
                        <time datetime="@entry.UpdatedAt.ToString("O")">@entry.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</time>
                        @if (entry.OperationId is { } entryOperation)
                        {
                            <a class="text-link" asp-page="/Admin/Operation" asp-route-id="@entryOperation">@ui["admin.media.downloadDetails"]</a>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@if (canSearch)
{
    <nav class="admmd-bar" aria-label="@ui["admin.media.acquisition.heading"]">
        <form method="post" asp-page-handler="Search" asp-route-workId="@view.WorkId">
            <button class="button button-primary" type="submit">@ui["admin.media.action.automatic"]</button>
        </form>
        @if ((waiting || failed) && request is not null)
        {
            <a class="button" asp-page="/Admin/ReadingManualSearch" asp-route-id="@request.Id">@ui["admin.wanted.manualSearch"]</a>
        }
        @if (view.SeriesId is { } barSeries)
        {
            <a class="button" href="/Manga/Series/@barSeries">@ui["admin.media.openLibrary"]</a>
        }
    </nav>
}
