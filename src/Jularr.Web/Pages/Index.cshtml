@page
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Discovery
@using Jularr.Web.Features.Home
@using Jularr.Web.Features.MediaCore
@using Jularr.Web.Features.Progress
@using Jularr.Web.Ui
@model IndexModel
@* Home and Discover are one surface (docs/mockups/home and docs/mockups/discover, binding): the media-type bar, then on the landing the hero,
   Continue and the discovery rows; typing or a filter turns the same page into results. The address is the only state; the titles are fetched
   from the Body handler after first paint so this GET stays local (#186). The Filter and the Search live in the shell header. *@
@{
    var ui = Model.Ui;
    var query = Model.Query;
    ViewData["Title"] = ui["discover.index.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-browse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-request.css" asp-append-version="true" />
}

<div class="dc-page"
     data-discover
     data-is-owner="@Model.IsOwner.ToString().ToLowerInvariant()"
     data-resolve-url="@Url.Page("/Index", "Resolve")"
     data-open-url="@Url.Page("/Index", "Open")"
     data-request-url="@Url.Page("/Index", "Request")"
     data-request-status-url="@Url.Page("/Index", "RequestStatus")"
     data-watchlist-url="@Url.Page("/Index", "Watchlist")"
     data-franchise-url="@Url.Page("/Index", "FollowFranchise")"
     data-text-action-failed="@ui["discover.card.actionFailed"]"
     data-text-retry="@ui["library.browse.error.retry"]"
     data-text-follow="@ui["discover.card.follow"]"
     data-text-followed="@ui["discover.card.followed"]"
     data-text-unfollow="@ui["discover.card.unfollow"]"
     data-text-franchise-followed="@ui["discover.card.franchiseFollowed"]"
     data-text-open="@ui["requests.open"]"
     data-text-source-for="@ui["discover.import.sourceFor"]"
     data-text-source-url="@ui["discover.import.sourceUrlHeading"]"
     data-status-pending="@ui[ConsumerAcquisitionLabels.StatusKey("pending")]"
     data-status-approved="@ui[ConsumerAcquisitionLabels.StatusKey("approved")]"
     data-status-searching="@ui[ConsumerAcquisitionLabels.StatusKey("searching")]"
     data-status-downloading="@ui[ConsumerAcquisitionLabels.StatusKey("downloading")]"
     data-status-importing="@ui[ConsumerAcquisitionLabels.StatusKey("importing")]"
     data-status-completed="@ui[ConsumerAcquisitionLabels.StatusKey("completed")]"
     data-status-failed="@ui[ConsumerAcquisitionLabels.StatusKey("failed")]"
     data-status-rejected="@ui[ConsumerAcquisitionLabels.StatusKey("rejected")]">
    @Html.AntiForgeryToken()

    <h1 class="sr-only">@ui["discover.index.title"]</h1>

    @* The fields of the header (search, filter) and the media type belong to this form. *@
    <form id="dc-form" method="get" action="/" data-dc-form>
        @if (query.Category != DiscoveryCategory.All)
        {
            <input type="hidden" name="category" value="@DiscoverBrowseQuery.CategoryName(query.Category)" />
        }
        @if (query.Mode != DiscoveryMode.Overview)
        {
            <input type="hidden" name="mode" value="@DiscoverBrowseQuery.ModeName(query.Mode)" />
        }
    </form>

    <nav class="dc-seg" aria-label="@ui["discover.categories.aria"]">
        @foreach (var (category, labelKey) in Model.VisibleTabs)
        {
            var selected = DiscoverScopes.IsActive(category, query.Category);
            <a class="dc-seg-item@(selected ? " is-active" : "")"
               href="@((query with { Category = category }).Href)"
               aria-current="@(selected ? "page" : null)"
               data-dc-tab>@ui[labelKey]</a>
        }
    </nav>

    @* The browse view of the selected type (never inside the filters), then the active filters as tokens that can be removed one by one. *@
    @if (query.Category != DiscoveryCategory.All && !query.IsSearch)
    {
        <nav class="dc-browse" aria-label="@ui["discover.browse.aria"]">
            @foreach (var mode in DiscoverBrowseModes.For(query.Category).Where(mode => mode != DiscoveryMode.MyList || Model.AniListConnected))
            {
                var current = query.Mode == mode;
                <a class="dc-browse-item@(current ? " is-active" : "")"
                   href="@((query with { Mode = mode }).Href)"
                   aria-current="@(current ? "page" : null)">@ui[DiscoverBrowseModes.LabelKey(mode)]</a>
            }
        </nav>
    }

    @if (query.ActiveFilterCount > 0)
    {
        <div class="dc-tokens" role="group" aria-label="@ui["library.browse.filters"]">
            @foreach (var (token, kind, value) in query.ActiveFilters)
            {
                var label = kind switch
                {
                    "genre" => ui[DiscoverGenres.Key(value)!],
                    "status" => ui[MediaBannerCardModel.StatusKey(Enum.Parse<MediaReleaseStatus>(value, true))],
                    "avail" => ui[value switch { "library" => "discover.filter.availabilityLibrary", "requested" => "discover.filter.availabilityRequested", _ => "discover.filter.availabilityNew" }],
                    "pref" => ui.Format("library.browse.filter.preferred", ("languages", string.Join(" · ", Model.Preference.Codes))),
                    _ => value
                };
                <a class="dc-token" href="@query.WithoutFilter(token).Href" aria-label="@ui.Format("discover.filter.removeAria", ("filter", label))">
                    <span>@label</span>
                    <partial name="_DiscoverIcon" model='"close"' />
                </a>
            }
            <a class="dc-token dc-token-clear" href="@query.WithoutFilters().Href">@ui["discover.filter.clearAll"]</a>
        </div>
    }

    @if (query.IsLanding)
    {
    <div data-dc-landing>
@if (Model.HomeLayout.Onboarding == HomeOnboardingState.Pending)
{
    <partial name="_HomeOnboardingOffer" model="Model.Ui" />
}
@if (Model.Hero.Count > 0)
{
    <section class="home-hero"
             aria-roledescription="carousel"
             aria-label="@Model.Ui["home.spotlight.aria"]"
             data-interval-ms="@IndexModel.HeroIntervalMs"
             data-home-hero>
        <div class="home-hero-track" aria-live="polite" data-home-hero-track>
            @for (var index = 0; index < Model.Hero.Count; index++)
            {
                var slide = Model.Hero[index];
                var hasImage = !string.IsNullOrWhiteSpace(slide.ImageUrl);
                var isPoster = hasImage && !slide.ImageIsBackdrop;
                <article class="home-hero-slide@(isPoster ? " home-hero-slide-poster" : "")@(hasImage ? "" : " home-hero-slide-plain")"
                         id="home-hero-@index"
                         role="group"
                         aria-roledescription="slide"
                         aria-label="@Model.Ui.Format("home.spotlight.slidePosition", ("index", index + 1), ("count", Model.Hero.Count))"
                         data-home-hero-slide>
                    @if (hasImage)
                    {
                        @* A poster is never stretched: it is blurred into the background and shown sharp beside the copy. *@
                        <img class="home-hero-art@(isPoster ? " home-hero-art-derived" : "")"
                             src="@slide.ImageUrl"
                             alt=""
                             draggable="false"
                             referrerpolicy="no-referrer" />
                    }
                    @if (isPoster)
                    {
                        <img class="home-hero-poster"
                             src="@slide.ImageUrl"
                             alt=""
                             draggable="false"
                             referrerpolicy="no-referrer" />
                    }
                    <div class="home-hero-copy">
                        <span class="home-hero-label">@slide.Label</span>
                        <h2>@slide.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(slide.Meta))
                        {
                            <p class="home-hero-meta">@slide.Meta</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                        {
                            <p class="home-hero-subtitle">@slide.Subtitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(slide.Description))
                        {
                            <p class="home-hero-description">@slide.Description</p>
                        }
                        <div class="home-hero-actions">
                            <a class="home-hero-primary" href="@slide.PrimaryHref">
                                @if (slide.PrimaryIsPlay)
                                {
                                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
                                }
                                <span>@slide.PrimaryLabel</span>
                            </a>
                            <a class="home-hero-secondary" href="@slide.SecondaryHref" aria-label="@slide.SecondaryLabel" title="@slide.SecondaryLabel">
                                @if (slide.SecondaryIcon == IndexModel.HomeHeroSecondary.Calendar)
                                {
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="4" y="5.5" width="16" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 11v5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="12" cy="7.9" r="1.15" fill="currentColor" /></svg>
                                }
                            </a>
                        </div>
                    </div>
                    @if (slide.ProgressPercent is int percent)
                    {
                        <div class="home-hero-progress">
                            <span class="home-hero-progress-track" aria-hidden="true"><span style="width:@percent%"></span></span>
                            @if (!string.IsNullOrWhiteSpace(slide.ProgressText))
                            {
                                <span>@slide.ProgressText</span>
                            }
                        </div>
                    }
                </article>
            }
        </div>
        @if (Model.Hero.Count > 1)
        {
            <button type="button" class="home-hero-arrow home-hero-prev" aria-label="@Model.Ui["home.spotlight.previous"]" data-home-hero-prev>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M14.5 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <button type="button" class="home-hero-arrow home-hero-next" aria-label="@Model.Ui["home.spotlight.next"]" data-home-hero-next>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            @* One segment per slide: the active one fills over data-interval-ms, then the hero advances.
               Each segment is also a button that jumps to its slide. *@
            <div class="home-hero-segments">
                @for (var index = 0; index < Model.Hero.Count; index++)
                {
                    <button type="button"
                            class="home-hero-segment"
                            aria-label="@Model.Ui.Format("home.spotlight.slideLabel", ("index", index + 1), ("count", Model.Hero.Count))"
                            aria-controls="home-hero-@index"
                            aria-current="@(index == 0 ? "true" : null)"
                            data-home-hero-segment><span class="home-hero-segment-track"><span class="home-hero-segment-fill"></span></span></button>
                }
                <button type="button"
                        class="home-hero-rotation"
                        aria-label="@Model.Ui["home.spotlight.pause"]"
                        data-label-pause="@Model.Ui["home.spotlight.pause"]"
                        data-label-play="@Model.Ui["home.spotlight.rotate"]"
                        hidden
                        data-home-hero-rotation>
                    <svg class="home-hero-rotation-pause" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
                    <svg class="home-hero-rotation-play" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
                </button>
            </div>
        }
    </section>
}


@if (Model.HomeLayout.PrioritizeContinue)
{
    <partial name="_HomeContinueRow" model="Model" />
}

    </div>
    }

    <p class="dc-notice" data-dc-offline hidden role="status">
        <partial name="_DiscoverIcon" model='"offline"' />
        <span>@ui["discover.offline"]</span>
    </p>

    <p class="dc-notice dc-notice-warning" data-dc-sync hidden role="status">
        <partial name="_DiscoverIcon" model='"warning"' />
        <span>@ui["discover.results.updateFailed"]</span>
        <button type="button" class="dc-link" data-dc-sync-retry>@ui["library.browse.error.retry"]</button>
    </p>

    <noscript><p class="dc-message">@ui["discover.noscript"]</p></noscript>

    <div class="dc-results" data-dc-body aria-busy="true">
        <p class="sr-only">@ui["discover.results.loading"]</p>
        <div class="dc-skeleton" aria-hidden="true">
            <span class="dc-skeleton-head"></span>
            <ul class="dc-track dc-ghosts">
                @for (var i = 0; i < DiscoverSectionView.TrackGhosts; i++)
                {
                    <li class="dc-track-item"><partial name="_DiscoverGhost" /></li>
                }
            </ul>
        </div>
    </div>

    @if (query.IsLanding && !Model.HomeLayout.PrioritizeContinue)
    {
        <div data-dc-landing>
            <partial name="_HomeContinueRow" model="Model" />
        </div>
    }

    <div class="dc-message" role="alert" data-dc-error hidden>
        <div>
            <p><strong>@ui["discover.results.unavailableTitle"]</strong></p>
            <p>@ui["discover.results.unavailableBody"]</p>
        </div>
        <button type="button" class="button" data-dc-retry>@ui["library.browse.error.retry"]</button>
    </div>

    @if (Model.IsOwner)
    {
        <details class="dc-import" data-dc-import hidden>
            <summary>@ui["discover.import.toggle"]</summary>
            <form method="post"
                  asp-page-handler="ImportSource"
                  class="dc-import-form"
                  data-dc-import-form>
                <div>
                    <strong data-import-title>@ui["discover.import.sourceUrlHeading"]</strong>
                    <span>@ui["discover.import.sourceHint"]</span>
                </div>
                <input type="hidden" name="metadataProvider" data-import-provider />
                <input type="hidden" name="metadataExternalId" data-import-external-id />
                <label>
                    <span>@ui["discover.import.sourceUrlHeading"]</span>
                    <input type="url"
                           name="sourceUrl"
                           required
                           inputmode="url"
                           autocomplete="url"
                           data-import-url
                           placeholder="https://ncode.syosetu.com/…" />
                </label>
                <div class="dc-import-actions">
                    <button class="button button-primary" type="submit">@ui["discover.import.submit"]</button>
                    <button class="button" type="button" data-import-clear>@ui["discover.import.clearMatch"]</button>
                </div>
            </form>
        </details>
    }

    @* The rich preview: a popover next to the hovered card on a pointer, a modal sheet on touch and from the
       preview button. Its content is cloned from the card's template when it opens. *@
    <div class="dc-hover" data-dc-hover role="dialog" hidden></div>
    <dialog class="dc-sheet" data-dc-sheet>
        <button type="button" class="dc-icon-btn dc-sheet-close" data-dc-sheet-close aria-label="@ui["library.browse.close"]">
            <partial name="_DiscoverIcon" model='"close"' />
        </button>
        <div class="dc-sheet-content" data-dc-sheet-content></div>
    </dialog>
    <partial name="_DiscoverRequestDialog" model="ui" />
</div>


@if (query.IsLanding)
{
@if (Model.PlaybackHistory.Count > 0)
{
    <details class="panel playback-history" data-playback-history data-dc-landing>
        <summary>
            <strong>@Model.Ui["home.history.title"]</strong>
            <span class="muted">@Model.PlaybackHistory.Count</span>
        </summary>
        <p class="muted">@Model.Ui.Format("home.history.description", ("count", Model.PlaybackHistoryLimit))</p>

        <ol class="playback-history-list">
            @foreach (var entry in Model.PlaybackHistory)
            {
                <li>
                    <a href="@entry.PlayHref">
                        @entry.Title.Title
                        @if (Model.EpisodeLabel(entry.SeasonNumber, entry.EpisodeNumber) is { } episodeLabel)
                        {
                            <text>· @episodeLabel</text>
                        }
                    </a>
                    <span>
                        <time datetime="@entry.LastPlayedAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">@entry.LastPlayedAt.ToString("yyyy-MM-dd HH:mm") UTC</time>
                        ·
                        @(entry.ReachedEnd
                            ? Model.Ui["home.history.finished"]
                            : Model.Ui.Format(
                                "home.history.stoppedAt",
                                ("time", EpisodeProgressService.FormatPosition(entry.PositionMs))))
                    </span>
                </li>
            }
        </ol>

        <form method="post" asp-page-handler="ClearHistory">
            <button class="button" type="submit">@Model.Ui["home.history.clear"]</button>
        </form>
    </details>
}


}

@section Scripts {
    <script src="~/js/home-spotlight.js" asp-append-version="true" defer></script>
    <script src="~/js/work-metadata.js" asp-append-version="true" defer></script>
    <script src="~/js/discover-staging.js" asp-append-version="true" defer></script>
    <script src="~/js/discover.js" asp-append-version="true" defer></script>
    <script src="~/js/discover-request.js" asp-append-version="true" defer></script>
}
