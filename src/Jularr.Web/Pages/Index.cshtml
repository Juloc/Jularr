@page
@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.Discovery
@using Jularr.Web.Features.MediaCore
@using Jularr.Web.Features.Progress
@model IndexModel
@{
    ViewData["Title"] = Model.Ui["nav.home"];
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-browse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-request.css" asp-append-version="true" />
}

@* Layout and hierarchy follow docs/mockups/home/SPEC.md (binding): hero → Continue → For you →
   recently discovered, then the Discover feed (trending and new titles of the providers, the same rows and cards as Discover
   with one shared body handler). No stat tiles and no filter chips; ?type= still narrows the rows server-side. *@

@if (Model.Hero.Count > 0)
{
    <section class="home-hero"
             aria-roledescription="carousel"
             aria-label="@Model.Ui["home.spotlight.aria"]"
             data-interval-ms="@IndexModel.HeroIntervalMs"
             data-home-hero>
        <div class="home-hero-track" aria-live="polite" data-home-hero-track>
            @for (var index = 0; index < Model.Hero.Count; index++)
            {
                var slide = Model.Hero[index];
                var hasImage = !string.IsNullOrWhiteSpace(slide.ImageUrl);
                var isPoster = hasImage && !slide.ImageIsBackdrop;
                <article class="home-hero-slide@(isPoster ? " home-hero-slide-poster" : "")@(hasImage ? "" : " home-hero-slide-plain")"
                         id="home-hero-@index"
                         role="group"
                         aria-roledescription="slide"
                         aria-label="@Model.Ui.Format("home.spotlight.slidePosition", ("index", index + 1), ("count", Model.Hero.Count))"
                         data-home-hero-slide>
                    @if (hasImage)
                    {
                        @* A poster is never stretched: it is blurred into the background and shown sharp beside the copy. *@
                        <img class="home-hero-art@(isPoster ? " home-hero-art-derived" : "")"
                             src="@slide.ImageUrl"
                             alt=""
                             draggable="false"
                             referrerpolicy="no-referrer" />
                    }
                    @if (isPoster)
                    {
                        <img class="home-hero-poster"
                             src="@slide.ImageUrl"
                             alt=""
                             draggable="false"
                             referrerpolicy="no-referrer" />
                    }
                    <div class="home-hero-copy">
                        <span class="home-hero-label">@slide.Label</span>
                        <h2>@slide.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(slide.Meta))
                        {
                            <p class="home-hero-meta">@slide.Meta</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                        {
                            <p class="home-hero-subtitle">@slide.Subtitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(slide.Description))
                        {
                            <p class="home-hero-description">@slide.Description</p>
                        }
                        <div class="home-hero-actions">
                            <a class="home-hero-primary" href="@slide.PrimaryHref">
                                @if (slide.PrimaryIsPlay)
                                {
                                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
                                }
                                <span>@slide.PrimaryLabel</span>
                            </a>
                            <a class="home-hero-secondary" href="@slide.SecondaryHref" aria-label="@slide.SecondaryLabel" title="@slide.SecondaryLabel">
                                @if (slide.SecondaryIcon == IndexModel.HomeHeroSecondary.Calendar)
                                {
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="4" y="5.5" width="16" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 11v5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="12" cy="7.9" r="1.15" fill="currentColor" /></svg>
                                }
                            </a>
                        </div>
                    </div>
                    @if (slide.ProgressPercent is int percent)
                    {
                        <div class="home-hero-progress">
                            <span class="home-hero-progress-track" aria-hidden="true"><span style="width:@percent%"></span></span>
                            @if (!string.IsNullOrWhiteSpace(slide.ProgressText))
                            {
                                <span>@slide.ProgressText</span>
                            }
                        </div>
                    }
                </article>
            }
        </div>
        @if (Model.Hero.Count > 1)
        {
            <button type="button" class="home-hero-arrow home-hero-prev" aria-label="@Model.Ui["home.spotlight.previous"]" data-home-hero-prev>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M14.5 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <button type="button" class="home-hero-arrow home-hero-next" aria-label="@Model.Ui["home.spotlight.next"]" data-home-hero-next>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            @* One segment per slide: the active one fills over data-interval-ms, then the hero advances.
               Each segment is also a button that jumps to its slide. *@
            <div class="home-hero-segments">
                @for (var index = 0; index < Model.Hero.Count; index++)
                {
                    <button type="button"
                            class="home-hero-segment"
                            aria-label="@Model.Ui.Format("home.spotlight.slideLabel", ("index", index + 1), ("count", Model.Hero.Count))"
                            aria-controls="home-hero-@index"
                            aria-current="@(index == 0 ? "true" : null)"
                            data-home-hero-segment><span class="home-hero-segment-track"><span class="home-hero-segment-fill"></span></span></button>
                }
                <button type="button"
                        class="home-hero-rotation"
                        aria-label="@Model.Ui["home.spotlight.pause"]"
                        data-label-pause="@Model.Ui["home.spotlight.pause"]"
                        data-label-play="@Model.Ui["home.spotlight.rotate"]"
                        hidden
                        data-home-hero-rotation>
                    <svg class="home-hero-rotation-pause" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
                    <svg class="home-hero-rotation-play" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
                </button>
            </div>
        }
    </section>
}

@if (Model.ContinueTiles.Count > 0)
{
    <section class="home-row" data-home-continue>
        <div class="home-row-heading">
            <h2><a href="@Model.ContinueDiscoverUrl">@Model.ContinueHeading</a></h2>
        </div>
        <div class="home-row-scroller" data-home-row>
            <div class="home-row-track home-continue-track" data-home-row-track>
                @foreach (var tile in Model.ContinueTiles)
                {
                    <partial name="_HomeContinueTile" model="tile" />
                }
            </div>
            <partial name="_HomeRowArrows" model="Model.Ui" />
        </div>
    </section>
}

@if (Model.ForYou.Count > 0)
{
    <section class="home-row" data-home-for-you>
        <div class="home-row-heading">
            <h2><a href="/Recommendations">@Model.Ui["recommendations.heading"]</a></h2>
        </div>
        <div class="home-row-scroller" data-home-row>
            <div class="home-row-track home-poster-track" data-home-row-track>
                @foreach (var poster in Model.ForYou)
                {
                    <a class="home-poster" href="@poster.Href" aria-label="@poster.Title" title="@poster.Title">
                        @if (!string.IsNullOrWhiteSpace(poster.ImageUrl))
                        {
                            <img src="@poster.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <span aria-hidden="true">@(poster.Title.Length > 0 ? poster.Title[..1].ToUpperInvariant() : "·")</span>
                        }
                    </a>
                }
            </div>
            <partial name="_HomeRowArrows" model="Model.Ui" />
        </div>
    </section>
}

@if (Model.RecentTitles.Count > 0)
{
    <section class="home-row home-row-secondary" data-home-recent>
        <div class="home-row-heading">
            <h2>@Model.Ui["home.library.recent"]</h2>
            <a class="text-link" href="/Library">@Model.Ui["home.library.view"]</a>
        </div>
        <div class="home-row-scroller" data-home-row>
            <div class="media-grid home-row-track home-media-track" data-home-row-track>
                @foreach (var recent in Model.RecentTitles)
                {
                    var coverageLabel = !Model.ShowContentMetrics || recent.Title.MediaType != WorkMediaType.Anime
                        ? null
                        : recent.TotalOccurrences == 0
                            ? Model.Ui["home.library.noLearningText"]
                            : Model.Ui.Format("home.library.prepared", ("percent", recent.PreparationPercent));
                    <partial name="_MediaCard" model='new MediaCardModel(
                        recent.Title.Title,
                        recent.Subtitle,
                        recent.Title.DetailHref,
                        coverageLabel is null ? null : recent.PreparationPercent,
                        coverageLabel,
                        recent.Title.PosterUrl,
                        coverageLabel)' />
                }
            </div>
            <partial name="_HomeRowArrows" model="Model.Ui" />
        </div>
    </section>
}

@if (Model.IsEmpty)
{
    <section class="empty-state" data-home-empty>
        <h3>@Model.Ui["home.empty.title"]</h3>
        <p>@Model.Ui["home.empty.body"]</p>
        <a class="button" href="/Discover">@Model.Ui["home.empty.discover"]</a>
        @if (Model.CanManageStorage)
        {
            <a class="button" href="/Admin/Storage">@Model.Ui["home.empty.storage"]</a>
        }
    </section>
}

<section class="home-discover">
    <div class="dc-page" data-discover @DiscoverFeedMarkup.Attributes(Url, Model.Ui, User.IsInRole(AccountRoles.Owner), "/Discover")>
        <partial name="~/Pages/Discover/_DiscoverFeed.cshtml" model="Model.Ui" />
    </div>
</section>

@if (Model.PlaybackHistory.Count > 0)
{
    <details class="panel playback-history" data-playback-history>
        <summary>
            <strong>@Model.Ui["home.history.title"]</strong>
            <span class="muted">@Model.PlaybackHistory.Count</span>
        </summary>
        <p class="muted">@Model.Ui.Format("home.history.description", ("count", Model.PlaybackHistoryLimit))</p>

        <ol class="playback-history-list">
            @foreach (var entry in Model.PlaybackHistory)
            {
                <li>
                    <a href="@entry.PlayHref">
                        @entry.Title.Title
                        @if (Model.EpisodeLabel(entry.SeasonNumber, entry.EpisodeNumber) is { } episodeLabel)
                        {
                            <text>· @episodeLabel</text>
                        }
                    </a>
                    <span>
                        <time datetime="@entry.LastPlayedAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">@entry.LastPlayedAt.ToString("yyyy-MM-dd HH:mm") UTC</time>
                        ·
                        @(entry.ReachedEnd
                            ? Model.Ui["home.history.finished"]
                            : Model.Ui.Format(
                                "home.history.stoppedAt",
                                ("time", EpisodeProgressService.FormatPosition(entry.PositionMs))))
                    </span>
                </li>
            }
        </ol>

        <form method="post" asp-page-handler="ClearHistory">
            <button class="button" type="submit">@Model.Ui["home.history.clear"]</button>
        </form>
    </details>
}

@section Scripts {
    <script src="~/js/home-spotlight.js" asp-append-version="true" defer></script>
    <script src="~/js/work-metadata.js" asp-append-version="true" defer></script>
    <script src="~/js/discover-staging.js" asp-append-version="true" defer></script>
    <script src="~/js/discover.js" asp-append-version="true" defer></script>
    <script src="~/js/discover-request.js" asp-append-version="true" defer></script>
}
