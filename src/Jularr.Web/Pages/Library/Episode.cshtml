@page "/Library/Episode/{id:guid}"
@using System.Text.Json
@using Jularr.Web.Features.Playback
@using Jularr.Web.Features.Playback.Decision
@using Jularr.Web.Features.ClientApi
@using Jularr.Web.Features.Storage
@using Jularr.Web.Features.Subtitles
@using Jularr.Web.Features.Learning
@using Jularr.Web.Features.Learning.LanguageAssistance
@using Jularr.Web.Features.Tracking
@using Jularr.Web.Ui
@using Microsoft.AspNetCore.Html
@model Jularr.Web.Pages.Library.EpisodeModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format("library.episode.pageTitle", ("anime", Model.AnimeTitle), ("episode", Model.EpisodeNumber));
    var isWatched = Model.LocalProgress?.IsCompleted == true;
    var resumeMs = Model.LocalProgress?.ResumePositionMs ?? 0;
    var resumeLabel = Jularr.Web.Features.Progress.EpisodeProgressService.FormatPosition(resumeMs);
    var episodeCode = $"S{Model.SeasonNumber:00} E{Model.EpisodeNumber:00}";
    var nativeTitle = Model.Metadata?.NativeTitle;
    var seekStep = PlayerDesign.SeekStepSeconds;
    var isAndroidClient = Request.Headers.UserAgent.ToString()
        .Contains("JularrAndroid/", StringComparison.OrdinalIgnoreCase);
}

@section Head {
    <link rel="stylesheet" href="~/css/player.css" asp-append-version="true" />
}

<div class="watch-layout">
<div class="watch-main">
@if (isAndroidClient && Model.Playback.Media is not null)
{
    <section class="preparation-panel">
        <div class="preparation-copy">
            <span class="eyebrow">@episodeCode</span>
            <strong>@Model.EpisodeTitle</strong>
            <span>@Model.AnimeTitle</span>
        </div>
        <a class="button button-primary"
           href="/Library/Episode/@Model.EpisodeId?native=1">@ui["player.play"]</a>
    </section>
}
else if (Model.Playback.Media is { } media)
{
    <section class="player-panel"
             data-episode-player
             data-episode-id="@Model.EpisodeId"
             data-duration-seconds="@(media.DurationSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
             data-playback-plan-url="@ClientApiRoutes.PlaybackPlan(Model.EpisodeId)"
             data-app-version="@Jularr.Web.Features.Appearance.AppBuildInfo.Version"
             data-stream-session-url-template="@ClientApiRoutes.StreamSession(Guid.Empty).Replace(Guid.Empty.ToString("D"), "__session__")"
             data-storage-state="@(media.Storage is { } storage ? ClientApiMappings.AvailabilityStateName(storage.State) : "unknown")"
             data-storage-availability-url="@ClientApiRoutes.MediaAvailability(media.MediaFileId)"
             data-player-bootstrap-url="@ClientApiRoutes.Player(Model.EpisodeId)"
             data-progress-url="@ClientApiRoutes.Progress(Model.EpisodeId)"
             data-completion-threshold="@Jularr.Web.Features.Progress.VideoProgressService.CompletionThreshold.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
             data-resume-seconds="@Model.ResumePositionSeconds.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
             data-next-url="@(Model.NextEpisodeUrl ?? "")"
             data-autoplay-next="@((Model.Flow?.AutoplayNext == true).ToString().ToLowerInvariant())"
             data-playback-preferences-url="@ClientApiRoutes.PlaybackPreferences"
             data-storage-health="@(media.Storage is { } health ? StorageHealth.Name(health.Health) : "")">
        @* The whole player lives in the stage: one timeline, one control bar and every setting in
           the player menu, so it behaves the same inline and in full screen. *@
        <div class="video-stage player-placeholder"
             data-video-stage
             data-player-chrome
             data-chrome-state="idle"
             tabindex="0"
             aria-label="@ui["library.watch.playerAria"]">
            <video preload="none" playsinline hidden data-playback-video></video>
            <div class="player-subtitle-stack">
                <div class="subtitle-overlay"
                     data-subtitle-overlay
                     lang="ja"
                     aria-live="polite"
                     hidden></div>
                <div class="playback-subtitle-overlay"
                     data-playback-subtitle
                     aria-live="polite"
                     hidden></div>
            </div>

            @* Double-tap seek feedback on the side that was tapped (player-chrome.js). *@
            <div class="player-seek-feedback" data-seek-feedback="back" aria-hidden="true" hidden>
                <partial name="_PlayerIcon" model="@("seekBack")" />
                <span data-seek-feedback-label></span>
            </div>
            <div class="player-seek-feedback" data-seek-feedback="forward" aria-hidden="true" hidden>
                <partial name="_PlayerIcon" model="@("seekForward")" />
                <span data-seek-feedback-label></span>
            </div>

            <div class="playback-preparation" data-playback-placeholder>
                <span class="eyebrow">@ui["library.episode.browserPlayback"]</span>
                <strong data-playback-status>@ui["library.episode.startingPlayback"]</strong>
                <div class="playback-preparation-actions" data-storage-actions hidden>
                    <button class="button" type="button" data-storage-retry>@ui["library.episode.tryAgain"]</button>
                    <button class="button button-primary" type="button" data-storage-wake hidden>@ui["player.play"]</button>
                </div>
            </div>

            <div class="player-chrome" data-player-controls>
                <div class="player-top">
                    <div class="player-heading">
                        <strong>@Model.AnimeTitle</strong>
                        <span>@episodeCode – @Model.EpisodeTitle</span>
                        @if (!string.IsNullOrWhiteSpace(nativeTitle))
                        {
                            <span lang="ja">@nativeTitle</span>
                        }
                    </div>
                </div>

                @* The one play/pause button. Tapping the video only shows or hides these controls. *@
                <div class="player-center">
                    <button class="player-round-button" type="button" data-player-action="seekBack10"
                            aria-label="@ui.Format("library.episode.seekBack", ("seconds", seekStep))">
                        <partial name="_PlayerIcon" model="@("seekBack")" />
                        <span>@seekStep</span>
                    </button>
                    <button class="player-round-button player-round-button-main" type="button" data-chrome-play
                            aria-label="@ui["library.watch.play"]"
                            data-label-play="@ui["library.watch.play"]" data-label-pause="@ui["library.watch.pause"]">
                        <partial name="_PlayerIcon" model="@("play")" />
                    </button>
                    <button class="player-round-button" type="button" data-player-action="seekForward10"
                            aria-label="@ui.Format("library.episode.seekForward", ("seconds", seekStep))">
                        <partial name="_PlayerIcon" model="@("seekForward")" />
                        <span>@seekStep</span>
                    </button>
                </div>

                <div class="player-bottom">
                    <div class="player-timeline-row" data-playback-timeline-row>
                        <input class="player-timeline"
                               type="range"
                               min="0"
                               max="0"
                               step="0.1"
                               value="0"
                               disabled
                               aria-label="@ui["library.episode.seekTimelineAria"]"
                               data-playback-timeline />
                    </div>
                    <div class="player-bar">
                        <div class="player-bar-group">
                            @if (Model.NextEpisodeUrl is { } playerNextUrl)
                            {
                                <a class="player-icon-button" href="@playerNextUrl" data-player-next
                                   aria-label="@ui["library.episode.nextEpisode"]" title="@ui["library.episode.nextEpisode"]">
                                    <partial name="_PlayerIcon" model="@("next")" />
                                </a>
                            }
                            <div class="player-volume">
                                <button class="player-icon-button" type="button" data-chrome-mute
                                        aria-label="@ui["library.watch.mute"]" title="@ui["library.watch.mute"]"
                                        data-label-mute="@ui["library.watch.mute"]" data-label-unmute="@ui["library.watch.unmute"]">
                                    <partial name="_PlayerIcon" model="@("volume")" />
                                </button>
                                <input class="player-volume-slider" type="range" min="0" max="1" step="0.05" value="1"
                                       aria-label="@ui["library.watch.volume"]" data-chrome-volume />
                            </div>
                            <span class="player-time">
                                <span data-playback-current>0:00</span>
                                <span aria-hidden="true">/</span>
                                <span data-playback-duration>--:--</span>
                            </span>
                        </div>
                        <div class="player-bar-group">
                            @if (Model.Controls is { HasLearningCues: true })
                            {
                                <button class="player-icon-button" type="button"
                                        data-player-action="repeatCurrentCue"
                                        data-repeat-line
                                        aria-label="@ui["library.episode.repeatCurrentLine"]"
                                        title="@ui["library.episode.repeatCurrentLine"]">
                                    <partial name="_PlayerIcon" model="@("replay")" />
                                </button>
                            }
                            <button class="player-icon-button" type="button" data-chrome-subtitles hidden
                                    aria-label="@ui["library.watch.subtitlesToggle"]" title="@ui["library.watch.subtitlesToggle"]" aria-pressed="false">
                                <partial name="_PlayerIcon" model="@("subtitles")" />
                            </button>
                            <button class="player-icon-button" type="button" data-chrome-settings-toggle
                                    aria-label="@ui["library.watch.settings"]" title="@ui["library.watch.settings"]" aria-expanded="false" aria-controls="player-settings">
                                <partial name="_PlayerIcon" model="@("settings")" />
                            </button>
                            <button class="player-icon-button" type="button" data-chrome-pip hidden
                                    aria-label="@ui["library.watch.pictureInPicture"]" title="@ui["library.watch.pictureInPicture"]">
                                <partial name="_PlayerIcon" model="@("pictureInPicture")" />
                            </button>
                            <button class="player-icon-button" type="button" data-chrome-fullscreen
                                    aria-label="@ui["library.watch.fullscreen"]" title="@ui["library.watch.fullscreen"]"
                                    data-label-enter="@ui["library.watch.fullscreen"]" data-label-exit="@ui["library.watch.exitFullscreen"]">
                                <partial name="_PlayerIcon" model="@("fullscreen")" />
                            </button>
                        </div>
                    </div>
                </div>

                <div class="player-settings" id="player-settings" data-chrome-settings role="dialog" aria-label="@ui["library.watch.settings"]" hidden>
                    <div class="player-settings-header">
                        <strong>@ui["library.watch.settings"]</strong>
                        <button class="player-icon-button" type="button" data-chrome-settings-close aria-label="@ui["library.watch.closeSettings"]">
                            <partial name="_PlayerIcon" model="@("close")" />
                        </button>
                    </div>
                    @if (Model.Controls is { } controls)
                    {
                        <label class="player-setting">
                            <span><partial name="_PlayerIcon" model="@("speed")" /> @ui["library.episode.speed"]</span>
                            <select data-playback-speed>
                                @foreach (var speed in controls.Speeds)
                                {
                                    <option value="@speed.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            selected="@(Math.Abs(speed - controls.InitialSpeed) < 0.0001)">@PlayerDesign.FormatSpeed(speed)</option>
                                }
                            </select>
                        </label>

                        <label class="player-setting">
                            <span><partial name="_PlayerIcon" model="@("subtitles")" /> @ui["library.episode.subtitles"]</span>
                            <select data-subtitle-track>
                                <option value="@PlayerControls.SubtitleOff"
                                        selected="@(controls.InitialSubtitle == PlayerControls.SubtitleOff)">@ui["library.episode.subtitlesOff"]</option>
                                @if (controls.HasLearningCues)
                                {
                                    <option value="@PlayerControls.SubtitleLearning"
                                            data-language="ja"
                                            selected="@(controls.InitialSubtitle == PlayerControls.SubtitleLearning)">@ui["library.episode.japaneseLearning"]</option>
                                }
                                @foreach (var track in controls.SubtitleTracks)
                                {
                                    @* Picture subtitles (PGS, VobSub) are burned into the video by the server;
                                       the menu says so up front instead of after a surprising restart. *@
                                    var note = !track.IsSelectable
                                        ? ui["library.episode.subtitleUnsupported"]
                                        : track.IsImage ? ui["library.episode.subtitleBurnedIn"] : null;
                                    <option value="@track.Id"
                                            data-language="@(track.Language ?? "")"
                                            data-learning-source="@(track.IsLearningSource ? "true" : "false")"
                                            data-image="@(track.IsImage ? "true" : "false")"
                                            data-format="@(track.Format ?? "")"
                                            disabled="@(!track.IsSelectable)"
                                            selected="@(track.Id == controls.InitialSubtitle)">@track.Label@(note is null ? "" : $" · {note}")</option>
                                }
                            </select>
                        </label>
                        <small class="player-setting-hint" data-subtitle-hint aria-live="polite"></small>

                        @if (controls.AudioTracks.Count > 1)
                        {
                            <label class="player-setting">
                                <span><partial name="_PlayerIcon" model="@("audioTrack")" /> @ui["library.episode.audio"]</span>
                                <select data-audio-track>
                                    @foreach (var track in controls.AudioTracks)
                                    {
                                        <option value="@track.Id"
                                                data-language="@(track.Language ?? "")"
                                                selected="@(track.Id == controls.InitialAudioTrackId)">@track.Label</option>
                                    }
                                </select>
                            </label>
                        }

                        <label class="player-setting">
                            <span><partial name="_PlayerIcon" model="@("quality")" /> @ui["library.episode.quality"]</span>
                            <select data-quality-cap>
                                <option value="auto">@ui["playback.quality.auto"]</option>
                                <option value="original">@ui["playback.quality.original"]</option>
                                @foreach (var step in PlaybackQualityPresets.Ladder)
                                {
                                    <option value="@step.Name">@ui.Format("playback.quality.mbps", ("value", step.BitrateKbps / 1000))</option>
                                }
                            </select>
                        </label>
                        <small class="player-setting-hint" data-quality-hint aria-live="polite"></small>
                    }

                    <label class="player-setting">
                        <span>@ui["library.episode.playbackLabel"]</span>
                        <select data-playback-mode>
                            <option value="auto">@ui["playback.preference.auto"]</option>
                            <option value="direct_only">@ui["playback.preference.direct_only"]</option>
                            <option value="always_transcode">@ui["playback.preference.always_transcode"]</option>
                        </select>
                    </label>
                    @* Compact status for everyone ("Direct Play · HEVC · 1080p · AAC"); the reasons only
                       appear when the original is not played untouched. *@
                    <div class="player-setting-status">
                        <span class="status-pill" data-playback-badge>@ui["library.episode.checking"]</span>
                        <small data-playback-summary>@ui["playback.status.checking"]</small>
                        <div class="player-playback-reasons" data-playback-reasons hidden>
                            <strong data-playback-reasons-heading>@ui["playback.status.whyNotDirectPlay"]</strong>
                            <ul data-playback-reason-list></ul>
                        </div>
                        @* Technical detail stays folded away inside the settings panel. *@
                        <details class="player-diagnostics" data-playback-diagnostics hidden>
                            <summary>@ui["playback.diagnostics.title"]</summary>
                            <dl data-playback-diagnostics-list></dl>
                        </details>
                    </div>

                    <label class="player-setting player-setting-toggle">
                        <span>@ui["library.episode.autoplayNextEpisode"]</span>
                        <input type="checkbox"
                               data-autoplay-toggle
                               checked="@(Model.Flow?.AutoplayNext == true)" />
                    </label>

                    <div class="player-settings-actions">
                        <button class="button"
                                type="button"
                                data-restart
                                hidden="@(Model.ResumePositionSeconds <= 0)">↺ @ui["library.episode.restartFromBeginning"]</button>
                        @if (Model.Controls is not null)
                        {
                            <button class="button"
                                    type="button"
                                    data-save-playback-defaults
                                    title="@ui["library.episode.saveDefaultsHint"]">@ui["library.episode.saveAsMyDefaults"]</button>
                        }
                    </div>
                </div>
            </div>

            @if (Model.ShowPlayerTools)
            {
            <aside class="player-learning-sheet"
                   data-word-inspector
                   aria-label="@ui["library.episode.subtitleLearningAria"]"
                   hidden>
                <div class="player-learning-sheet-header">
                    <div class="player-learning-copy">
                        <span class="player-learning-kicker" data-learning-kicker>@ui["library.episode.word"]</span>
                        <strong class="player-learning-word" data-word lang="ja"></strong>
                        <span class="player-learning-reading" data-reading lang="ja"></span>
                    </div>
                    <button class="player-icon-button"
                            type="button"
                            data-close-learning
                            data-player-action="closeOverlay"
                            aria-label="@ui["library.episode.closeLearningOverlay"]"><partial name="_PlayerIcon" model="@("close")" /></button>
                </div>
                <p class="player-learning-meaning" data-meaning></p>
                <div class="player-learning-actions">
                    <button class="button player-action-button"
                            type="button"
                            data-replay
                            data-player-action="repeatCurrentCue">↻ @ui["library.episode.repeatLine"]</button>
                    <span class="status-pill" data-state></span>
                </div>
            </aside>
            }

            <div class="post-play" data-post-play role="dialog" aria-label="@ui["library.episode.episodeFinished"]" hidden>
                <strong>@ui["library.episode.episodeFinished"]</strong>
                <span class="post-play-countdown" data-post-play-countdown aria-live="polite" hidden></span>
                <div class="post-play-actions">
                    <button class="button" type="button" data-post-play-replay>↻ @ui["library.episode.replay"]</button>
                    @if (Model.NextEpisodeUrl is { } postPlayNextUrl)
                    {
                        <a class="button button-primary" href="@postPlayNextUrl" data-post-play-next>@ui["library.episode.nextEpisode"]</a>
                    }
                    <a class="button" href="/Library/Anime/@Model.AnimeId" data-post-play-back>@ui["library.episode.backToEpisodes"]</a>
                    <button class="button" type="button" data-post-play-cancel hidden>@ui["library.episode.cancelAutoplay"]</button>
                </div>
            </div>

            <div class="player-error" data-player-error hidden></div>
        </div>
        <div class="reader-menu-offline" data-offline-media-item data-offline-media-kind="episode" data-offline-media-id="@Model.EpisodeId">
            <button class="button" type="button" data-offline-episode-save="@Model.EpisodeId">@ui["offlineLibrary.action.saveButton"]</button>
            <progress data-offline-media-progress max="100" value="0" hidden></progress>
            <small data-offline-media-status></small>
        </div>

        @if (Model.Controls is { } controlsData)
        {
            <script type="application/json" data-player-controls-data>@Html.Raw(JsonSerializer.Serialize(new
            {
                fileDefaultAudioTrackId = controlsData.FileDefaultAudioTrackId,
                initialAudioTrackId = controlsData.InitialAudioTrackId,
                sourceHeight = controlsData.SourceHeight,
                seekStepSeconds = seekStep,
                subtitleCuesUrlTemplate = ClientApiRoutes.SubtitleTrackCues(Model.EpisodeId, "__track__")
            }, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
        }
        <script type="application/json" data-player-icons>@Html.Raw(JsonSerializer.Serialize(new[] { "play", "pause", "volume", "volumeMuted", "fullscreen", "fullscreenExit" }.ToDictionary(name => name, name => new { viewBox = PlayerDesign.Icon(name).ViewBox, path = PlayerDesign.Icon(name).Path })))</script>
        <script type="application/json" data-cue-data>@Html.Raw(JsonSerializer.Serialize(Model.Controls is { HasLearningCues: true } ? Model.Playback.Cues : [], new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
        <script type="application/json" data-player-text>@Html.Raw(JsonSerializer.Serialize(ui.WithPrefix("playback.")))</script>
    </section>
    <partial name="_LanguageInspector" model='LanguageInspectorHost.ForAnimeEpisode(Model.AnimeId, Model.EpisodeId, "ja")' />
    <script src="~/js/player-design.js" asp-append-version="true"></script>
    <script src="~/js/playback-capabilities.js" asp-append-version="true"></script>
    <script src="~/js/episode-player.js" asp-append-version="true"></script>
    <script src="~/js/player-gestures.js" asp-append-version="true"></script>
    <script src="~/js/player-chrome.js" asp-append-version="true" defer></script>
    <partial name="_EpisodeMediaNavigation" model="new Jularr.Web.Features.MediaSegments.EpisodeMediaNavigationView(Model.EpisodeId, Model.Playback.Navigation, CanEdit: false, ui)" />
}
else
{
    <div class="empty-state">
        <h3>@ui["library.watch.noMediaTitle"]</h3>
        <p>@ui["library.watch.noMediaBody"]</p>
    </div>
}
@if (Model.ShowVocabularyTools
     || Model.ShowPreparationSuggestions
     || Model.ShowContentMetrics)
{
    @if (Model.Terms.Count == 0)
    {
        <div class="empty-state">
            <h3>@ui["library.episode.noVocabularyYet"]</h3>
            <p>@ui["library.episode.noVocabularyHint"]</p>
        </div>
    }
    else
    {
        @if (Model.ShowPreparationSuggestions || Model.ShowContentMetrics)
        {
            <section class="preparation-panel">
                <div class="preparation-copy">
                    <span class="eyebrow">@ui["library.episode.preparationEyebrow"]</span>
                    <strong>@ui.Format("library.episode.lexicalCoverage", ("percent", Model.Preparation.PreparedPercent))</strong>
                    <span>@ui.Format("library.episode.occurrencesKnownOrQueued", ("prepared", Model.Preparation.PreparedOccurrences), ("total", Model.Preparation.TotalOccurrences))</span>
                    <div class="progress-track"><span style="width:@Model.Preparation.PreparedPercent%"></span></div>
                    <small>@ui["library.episode.coverageHint"]</small>
                </div>

                @if (Model.ShowPreparationSuggestions)
                {
                    @if (Model.Preparation.RecommendedCount > 0)
                    {
                        <form method="post"
                              asp-page-handler="Prepare"
                              asp-route-id="@Model.EpisodeId">
                            <button class="button button-primary" type="submit">
                                @ui.Format("library.episode.prepareToTarget", ("target", Model.Preparation.TargetPercent), ("count", Model.Preparation.RecommendedCount))
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="status-pill status-ok">@ui.Format("library.episode.targetPrepared", ("percent", Model.Preparation.TargetPercent))</span>
                    }
                }
            </section>
        }

        @if (Model.ShowVocabularyTools)
        {
            <div class="term-table">
                <div class="term-table-head">
                    <span>@ui["library.episode.termColumn"]</span><span>@ui["library.episode.seenColumn"]</span><span>@ui["library.episode.statusColumn"]</span>
                </div>
                @foreach (var term in Model.Terms)
                {
                    <div class="term-row">
                        <div class="term-word">
                            <strong lang="ja">@term.Canonical</strong>
                            @if (!string.IsNullOrWhiteSpace(term.Reading))
                            {
                                <span>@term.Reading</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(term.Meaning))
                            {
                                <small>@term.Meaning</small>
                            }
                        </div>
                        <span class="occurrence">@term.EpisodeOccurrences×</span>
                        <div class="term-actions">
                            <form method="post"
                                  asp-page-handler="Learning"
                                  asp-route-id="@Model.EpisodeId" hidden="@(!Model.ShowLearnAction)">
                                <input type="hidden" name="termId" value="@term.TermId" />
                                <button class="chip @(term.State == UserTermState.Learning ? "selected" : "")"
                                        type="submit">@ui["library.episode.learn"]</button>
                            </form>
                            <form method="post"
                                  asp-page-handler="Known"
                                  asp-route-id="@Model.EpisodeId">
                                <input type="hidden" name="termId" value="@term.TermId" />
                                <button class="chip @(term.State == UserTermState.Known ? "selected" : "")"
                                        type="submit">@ui["library.episode.known"]</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    }
}
</div>

<aside class="watch-side" aria-label="@ui["library.watch.sideAria"]">
    <section class="watch-info">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img class="watch-cover" src="@Model.CoverImageUrl" alt="" loading="lazy" />
        }
        <div class="watch-info-copy">
            <a class="watch-title" href="/Library/Anime/@Model.AnimeId"><h1>@Model.AnimeTitle</h1></a>
            @if (!string.IsNullOrWhiteSpace(nativeTitle))
            {
                <span class="watch-native" lang="ja">@nativeTitle</span>
            }
            <div class="watch-facts">
                @if (!string.IsNullOrWhiteSpace(Model.Metadata?.Format))
                {
                    <span class="watch-fact watch-fact-accent">@Model.Metadata!.Format</span>
                }
                @if (Model.Metadata?.SeasonYear is { } year)
                {
                    <span class="watch-fact">@year</span>
                }
                @if ((Model.Metadata?.EpisodeCount ?? Model.Episodes.Count) is > 0 and var count)
                {
                    <span class="watch-fact">@ui.Format("library.watch.episodeCount", ("count", count))</span>
                }
            </div>
        </div>
    </section>

    <div class="watch-actions">
        <form method="post" asp-page-handler="Watched" asp-route-id="@Model.EpisodeId">
            <input type="hidden" name="watched" value="@(isWatched ? "false" : "true")" />
            <button class="button @(isWatched ? "" : "button-primary")" type="submit">@(isWatched ? ui["library.episode.markUnwatched"] : ui["library.episode.markWatched"])</button>
        </form>
        <span class="status-pill @(isWatched ? "status-ok" : "")" data-watched-state>
            @if (isWatched)
            {
                @ui["library.episode.watched"]
            }
            else if (resumeMs > 0)
            {
                @ui.Format("library.episode.resumeAt", ("position", resumeLabel), ("percent", Model.LocalProgress!.Percent))
            }
            else
            {
                @ui["library.episode.unwatched"]
            }
        </span>
        <a class="button"
           href="@Url.Page("/Settings/LearningScope", new {
               mediaType = LearningMediaType.Anime,
               scope = "content",
               workKey = Model.AnimeId.ToString(),
               contentKey = Model.EpisodeId.ToString(),
               label = $"{Model.AnimeTitle} · E{Model.EpisodeNumber}",
               returnUrl = $"/Library/Episode/{Model.EpisodeId}"
           })">@ui["library.languageToolsAndLearning"]</a>
        @if (Model.IsOwner)
        {
            Func<dynamic?, IHtmlContent> mappingGroup = @<div>
                    @if (Model.ExternalProgress is { } ownerProgress && !(ownerProgress.IsMatched && ownerProgress.ReviewReason is null))
                    {
                        var ownerPanel = new ExternalProgressPanel(
                            ownerProgress,
                            Url.Page(null, "ExternalProgress", new { id = Model.EpisodeId })!,
                            MatchUrl: $"/Library/Anime/{Model.AnimeId}#anime-manage",
                            MappingUrl: $"/Library/Anime/{Model.AnimeId}#anime-manage",
                            CanManageMapping: true,
                            Ui: ui);
                        <partial name="_ExternalProgressManage" model="ownerPanel" />
                    }
                    else
                    {
                        <a class="button" href="/Library/Anime/@Model.AnimeId#anime-manage">@ui["library.watch.manageAniListMatch"]</a>
                        <a class="button" href="/Library/Anime/@Model.AnimeId#anime-manage">@ui["library.watch.manageEpisodeMapping"]</a>
                    }
                </div>;

                Func<dynamic?, IHtmlContent> filesGroup = @<div>
                    @if (Model.NeedsLearningSource)
                    {
                        <partial name="_EpisodeSubtitleSources" model="Model" />
                    }
                    <div class="inline-actions">
                        <a class="button" href="@Url.Page("/Library/EpisodeSegments", new { id = Model.EpisodeId })">@ui["library.episodeSegments.editLink"]</a>
                    </div>
                </div>;

                var episodeNeedsReview = Model.ExternalProgress?.MappingBasis == ExternalMappingBasis.NeedsReview;
                var episodeManageSheet = new ManageSheetModel(
                    "episode-manage",
                    ui["library.watch.manageSources"],
                    ui.Format("library.episode.pageTitle", ("anime", Model.AnimeTitle), ("episode", Model.EpisodeNumber)),
                    [
                        new ManageSheetGroup(ui["manage.group.mapping"], mappingGroup(null)),
                        new ManageSheetGroup(ui["manage.group.files"], filesGroup(null))
                    ],
                    ui,
                    episodeNeedsReview ? new ManageSheetReviewBadge(ui["manage.needsReview"], "/Settings/MappingReview") : null,
                    OpenOnLoad: !string.IsNullOrWhiteSpace(Model.SubtitleNotice) || !string.IsNullOrWhiteSpace(Model.SubtitleError));
            <partial name="_ManageSheet" model="episodeManageSheet" />
        }
    </div>

    @if (Model.ShowContentMetrics)
    {
        <p class="watch-metrics">
            @ui.Format("library.episode.termSummary",
                ("distinct", Model.Preparation.DistinctTermCount),
                ("known", Model.Preparation.KnownTermCount),
                ("learning", Model.Preparation.LearningTermCount),
                ("new", Model.Preparation.NewTermCount),
                ("percent", Model.Preparation.PreparedPercent))
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Metadata?.Description))
    {
        <p class="watch-description">@Model.Metadata!.Description</p>
    }

    @* Users only see AniList sync once the anime is cleanly matched; unmatched or under-review
       mappings are an owner concern and live in the Sources & mapping dialog. *@
    @if (Model.ExternalProgress is { IsMatched: true, ReviewReason: null } externalProgress)
    {
        var externalPanel = new ExternalProgressPanel(
            externalProgress,
            Url.Page(null, "ExternalProgress", new { id = Model.EpisodeId })!,
            MatchUrl: $"/Library/Anime/{Model.AnimeId}#anilist-match",
            MappingUrl: $"/Library/Anime/{Model.AnimeId}#anilist-episode-mappings",
            CanManageMapping: false,
            Ui: ui);
        <partial name="_ExternalProgress" model="externalPanel" />
    }

    <section class="watch-episodes" data-watch-episodes>
        <div class="watch-episodes-header">
            <h2>@ui["library.watch.episodesHeading"]</h2>
            @if (Model.Seasons.Count > 1)
            {
                <select class="watch-season-select" data-watch-season aria-label="@ui["library.watch.seasonSelectAria"]">
                    @foreach (var season in Model.Seasons)
                    {
                        <option value="@season" selected="@(season == Model.SeasonNumber)">@ui.Format("library.watch.season", ("number", season))</option>
                    }
                </select>
            }
            else if (Model.Seasons.Count == 1)
            {
                <span class="muted">@ui.Format("library.watch.season", ("number", Model.Seasons[0]))</span>
            }
        </div>
        <ol class="watch-episode-list">
            @foreach (var episode in Model.Episodes)
            {
                <li data-season="@episode.SeasonNumber" hidden="@(episode.SeasonNumber != Model.SeasonNumber)">
                    <a class="watch-episode @(episode.IsCurrent ? "is-current" : "") @(episode.IsWatched ? "is-watched" : "")"
                       href="/Library/Episode/@episode.Id"
                       aria-current="@(episode.IsCurrent ? "page" : null)">
                        <span class="watch-episode-number">@episode.Number</span>
                        <span class="watch-episode-copy">
                            <strong>@episode.Title</strong>
                            @if (episode.ResumePercent is { } percent)
                            {
                                <span class="watch-episode-progress" aria-label="@ui.Format("library.watch.episodeProgressAria", ("percent", percent))"><span style="width: @percent%"></span></span>
                            }
                        </span>
                        @if (episode.IsCurrent)
                        {
                            <span class="watch-episode-state watch-episode-state-current" aria-hidden="true"><partial name="_PlayerIcon" model="@("play")" /></span>
                        }
                        else if (episode.IsWatched)
                        {
                            <span class="watch-episode-state" title="@ui["library.episode.watched"]">✓</span>
                        }
                    </a>
                </li>
            }
        </ol>
    </section>
</aside>
</div>
