@using Jularr.Web.Features.Library
@using Jularr.Web.Features.Localization
@model (LibraryCardView Card, UiTextBundle Ui)
@* One title of the Library (docs/mockups/library): dominant poster, title, one status line, a thin progress bar,
   the audio and subtitle languages with the preferred ones first, and a single availability marker only when
   the title is not complete. A title without a detail page yet is a plain card, not a link. The same markup is a poster
   card in the grid and a row in the list layout.
   Styles: wwwroot/css/library.css. *@
@{
    var card = Model.Card;
    var ui = Model.Ui;
}
<article class="lib-card@(card.Availability is { } marker ? " lib-card-" + marker.CssModifier : "")">
    @* The whole card opens the title through the stretched title link; the poster link is only for pointers. *@
    @if (card.Href is { } artHref)
    {
        <a class="lib-card-art" href="@artHref" tabindex="-1" aria-hidden="true">
            <partial name="_LibraryCardArt" model="card" />
        </a>
    }
    else
    {
        <span class="lib-card-art" aria-hidden="true">
            <partial name="_LibraryCardArt" model="card" />
        </span>
    }

    @if (card.Availability is { } availability)
    {
        <span class="lib-state lib-state-@availability.CssModifier">
            <partial name="_LibraryIcon" model="availability.CssModifier" />
            @availability.Label
        </span>
    }

    <div class="lib-card-body">
        <div class="lib-card-head">
            <h3 class="lib-card-title">
                @if (card.Href is { } titleHref)
                {
                    <a href="@titleHref">@card.Title</a>
                }
                else
                {
                    @card.Title
                }
            </h3>
            @if (card.Action is { } action)
            {
                <details class="lib-menu" data-lib-menu>
                    <summary class="lib-menu-button" aria-label="@ui["library.browse.card.actions"]">
                        <partial name="_LibraryIcon" model='"more"' />
                    </summary>
                    <div class="lib-menu-panel">
                        <a href="@action.Url">@action.Label</a>
                    </div>
                </details>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(card.StatusText))
        {
            <p class="lib-card-status">@card.StatusText</p>
        }

        @if (card.ProgressPercent is int percent)
        {
            <div class="lib-card-progress">
                <span class="lib-card-bar" role="progressbar" aria-label="@card.ProgressAria"
                      aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent"><span style="width:@percent%"></span></span>
                <span class="lib-card-percent" aria-hidden="true">@card.ProgressText</span>
            </div>
        }

        @if (card.HasLanguages)
        {
            <div class="lib-langs@(card.PreferredMissing ? " is-fallback" : "")"
                 title="@(card.PreferredMissing ? ui["library.browse.card.preferredMissing"] : null)">
                @foreach (var (label, icon, chips) in new[]
                {
                    (ui["library.mediaCard.audioLanguages"], "audio", card.Audio),
                    (ui["library.mediaCard.subtitleLanguages"], "subtitles", card.Subtitles)
                })
                {
                    if (chips.Any)
                    {
                        <span class="lib-lang-group" role="group" aria-label="@label">
                            <span class="lib-lang-icon" title="@label"><partial name="_LibraryIcon" model="icon" /></span>
                            @foreach (var chip in chips.Shown)
                            {
                                <span class="lib-lang@(chip.IsPreferred ? " is-preferred" : "")">@chip.Code</span>
                            }
                            @if (chips.More > 0)
                            {
                                <span class="lib-lang lib-lang-more" title="@ui.Format("library.anime.moreLanguages", ("count", chips.More))">+@chips.More</span>
                            }
                        </span>
                    }
                }
            </div>
        }
    </div>
</article>
