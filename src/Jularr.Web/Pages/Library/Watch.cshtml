@page "/Library/Watch/{workId:guid}/{episodeId:guid?}"
@model Jularr.Web.Pages.Library.WatchModel
@* The web player of a Movie or one episode of a Series. It renders the same player stage and scripts as every other
   video; only the canonical target and its routes differ (Features/Playback/VideoPlayerStageView). *@
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.EpisodeLine is { } line ? $"{Model.Title} · {line}" : Model.Title;
}

@section Head {
    <link rel="stylesheet" href="~/css/player.css" asp-append-version="true" />
}

<div class="watch-layout">
    <div class="watch-main">
        @if (Model.Stage is { } stage)
        {
            <partial name="_VideoPlayerStage" model="stage" />
            <partial name="_VideoPlayerScripts" />
        }
        else
        {
            <div class="empty-state">
                <h3>@ui["library.watch.noMediaTitle"]</h3>
                <p>@ui["library.video.noMediaBody"]</p>
            </div>
        }
    </div>

    <aside class="watch-side" aria-label="@ui["library.video.sideAria"]">
        <section class="watch-info">
            <div class="watch-info-copy">
                <h1 class="watch-title">@Model.Title</h1>
                @if (Model.EpisodeLine is { } episodeLine)
                {
                    <div class="watch-facts"><span class="watch-fact">@episodeLine</span></div>
                }
            </div>
        </section>
        <div class="watch-actions">
            <a class="button" href="@Model.BackUrl">@ui["library.video.backToDetails"]</a>
        </div>
    </aside>
</div>
