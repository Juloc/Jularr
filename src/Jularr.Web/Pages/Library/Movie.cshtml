@page "/Library/Movie/{workId:guid}"
@using System.Globalization
@using Jularr.Web.Features.Library
@model Jularr.Web.Pages.Library.MovieDetailModel
@* The canonical Movie detail (docs/mockups/movie-detail/SPEC.md, binding): one scrolling page, never tabs. The hero
   carries the title, the state-derived primary action and the facts strip; Versions & Languages stays a compact card.
   Trailer, Cast & Crew, Specials and More Like This need provider metadata Jularr does not persist yet; they are not
   rendered at all instead of empty blocks. *@
@{
    Layout = "_VideoDetailLayout";
    var ui = Model.Ui;
    var detail = Model.Detail;
    ViewData["Title"] = detail.Title;
    var audio = detail.Audio;
    var subtitles = detail.Subtitles;
    var audioChips = AnimeDetailView.Chips(audio, detail.Preference.Audio);
    var subtitleChips = AnimeDetailView.Chips(subtitles, detail.Preference.Subtitle);
    var hasLanguages = audio.Count > 0 || subtitles.Count > 0;
    var hasUltraHd = detail.Versions.Any(x => x.IsUltraHd);
    var hasHdr = detail.Versions.Any(x => x.IsHdr);
    var hasDolbyVision = detail.Versions.Any(x => x.IsDolbyVision);
    var preferredAvailable = detail.Preference.IsAvailableIn(audio, subtitles);
    string Codes(IEnumerable<string> languages) => string.Join(" · ", languages.Order(StringComparer.Ordinal).Select(x => x.ToUpperInvariant()));
    string VersionLabel(VideoDetailVersion version, int number)
    {
        var quality = version.IsUltraHd ? "4K" : version.Height is int height ? $"{height}p" : ui.Format("library.video.versionNumber", ("number", number));
        var range = version.IsDolbyVision ? "Dolby Vision" : version.IsHdr ? version.DynamicRange : null;
        var runtime = version.RuntimeMinutes is int minutes ? ui.Format("library.anime.durationMinutes", ("minutes", minutes)) : null;
        return string.Join(" · ", new[] { quality, range, runtime }.Where(x => !string.IsNullOrEmpty(x)));
    }
}

<partial name="_VideoDetailHero" model="Model" />

<div class="vd-body">
    <div class="vd-main">
        <partial name="_VideoDetailRelated" model="Model" />

        @if (detail.AlsoKnownAs.Count > 0)
        {
            <section class="vd-card" aria-labelledby="vd-about-title">
                <h2 id="vd-about-title">@ui["library.video.aboutHeading"]</h2>
                <dl class="vd-facts">
                    <div>
                        <dt>@ui["library.video.alsoKnownAs"]</dt>
                        <dd>@string.Join(" · ", detail.AlsoKnownAs)</dd>
                    </div>
                </dl>
            </section>
        }
    </div>

    @if (detail.Versions.Count > 0)
    {
        <aside class="vd-aside" aria-label="@ui["library.video.versionsHeading"]">
        <section class="vd-card" aria-labelledby="vd-versions-title">
            <h2 id="vd-versions-title">@ui["library.video.versionsHeading"]</h2>
            @if (hasLanguages)
            {
                <dl class="vd-langs">
                    @foreach (var (label, chips) in new[] { (ui["mediaFacts.audio"], audioChips), (ui["mediaFacts.subtitles"], subtitleChips) })
                    {
                        if (chips.Any)
                        {
                            <div>
                                <dt>@label</dt>
                                <dd>
                                    @foreach (var chip in chips.Shown)
                                    {
                                        <span class="ad-lang@(chip.IsPreferred ? " is-preferred" : "")" title="@(chip.IsPreferred ? ui["library.anime.preferredLanguage"] : null)">@chip.Code</span>
                                    }
                                    @if (chips.More > 0)
                                    {
                                        <span class="ad-lang ad-lang-more" title="@ui.Format("library.anime.moreLanguages", ("count", chips.More))">+@chips.More</span>
                                    }
                                </dd>
                            </div>
                        }
                    }
                </dl>
                @if (detail.Preference.IsSet)
                {
                    <p class="vd-language-state@(preferredAvailable ? "" : " is-other")">@ui[preferredAvailable ? "library.video.language.preferred" : "library.video.language.otherOnly"]</p>
                }
            }

            @if (hasUltraHd || hasHdr || hasDolbyVision)
            {
                <ul class="vd-badges" aria-label="@ui["library.video.capabilities"]">
                    @if (hasUltraHd)
                    {
                        <li>4K</li>
                    }
                    @if (hasHdr)
                    {
                        <li>HDR</li>
                    }
                    @if (hasDolbyVision)
                    {
                        <li>Dolby Vision</li>
                    }
                </ul>
            }

            <details class="vd-versions">
                <summary>@ui["library.video.viewAll"]</summary>
                <ol>
                    @foreach (var (version, index) in detail.Versions.Select((version, index) => (version, index + 1)))
                    {
                        <li>
                            <strong>@VersionLabel(version, index)</strong>
                            @if (version.Audio.Count > 0)
                            {
                                <span>@ui["mediaFacts.audio"]: @Codes(version.Audio)</span>
                            }
                            @if (version.Subtitles.Count > 0)
                            {
                                <span>@ui["mediaFacts.subtitles"]: @Codes(version.Subtitles)</span>
                            }
                        </li>
                    }
                </ol>
            </details>
        </section>
        </aside>
    }
</div>
