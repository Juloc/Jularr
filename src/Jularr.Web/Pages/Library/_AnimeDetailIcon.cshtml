@model string
@* Decorative stroke icons of the anime detail page. The text they sit beside always names them. *@
<svg class="ad-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "play":
            <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "more":
            <circle cx="12" cy="5.5" r="1.4" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
            <circle cx="12" cy="18.5" r="1.4" fill="currentColor" stroke="none" />
            break;
        case "star":
            <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            break;
        case "episodes":
            <rect x="3" y="6" width="18" height="12" rx="2" />
            <path d="M8 3.5h8M10.5 10.25v3.5l3-1.75z" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "audio":
            <path d="M4 15v-3a8 8 0 0 1 16 0v3" />
            <rect x="3.5" y="14" width="4" height="6" rx="1.5" />
            <rect x="16.5" y="14" width="4" height="6" rx="1.5" />
            break;
        case "subtitles":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M7 12h3M13 12h4M7 15.5h7M16.5 15.5h.5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m16 16 4 4" />
            break;
        case "cog":
            <circle cx="12" cy="12" r="3" />
            <path d="M12 3.5v2.5M12 18v2.5M3.5 12H6M18 12h2.5M6 6l1.8 1.8M16.2 16.2 18 18M18 6l-1.8 1.8M7.8 16.2 6 18" />
            break;
        case "alert":
            <path d="M12 4.5 21 19.5H3z" />
            <path d="M12 10v4.5M12 17.2v.01" />
            break;
        case "chevron":
            <path d="m9.5 6 6 6-6 6" />
            break;
        case "grid":
            <rect x="4" y="4" width="6.5" height="6.5" rx="1.2" />
            <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" />
            <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" />
            <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" />
            break;
        case "list":
            <path d="M8.5 6.5H20M8.5 12H20M8.5 17.5H20" />
            <circle cx="4.5" cy="6.5" r=".9" fill="currentColor" stroke="none" />
            <circle cx="4.5" cy="12" r=".9" fill="currentColor" stroke="none" />
            <circle cx="4.5" cy="17.5" r=".9" fill="currentColor" stroke="none" />
            break;
        case "available":
            <circle cx="12" cy="12" r="8.5" />
            <path d="m8.25 12.25 2.6 2.6 4.9-5.4" />
            break;
        case "language":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5v5.25M12 16.25v.01" />
            break;
        case "requested":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "downloading":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5v7M8.75 11.75 12 15l3.25-3.25" />
            break;
        case "importing":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M8 13.5h8M12 7.75v5M9.75 10.75 12 13" />
            break;
        default:
            <circle cx="12" cy="12" r="8.5" />
            <path d="m8.75 8.75 6.5 6.5" />
            break;
    }
</svg>
