@model string
@* Decorative stroke icons of the Library page. The text they sit beside always names them. *@
<svg class="lib-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "filter":
            <path d="M4 6h16M7 12h10M10.5 18h3" />
            break;
        case "sort":
            <path d="M8 5v14M4.5 15.5 8 19l3.5-3.5M16 19V5M12.5 8.5 16 5l3.5 3.5" />
            break;
        case "grid":
            <rect x="4" y="4" width="6.5" height="6.5" rx="1.2" />
            <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" />
            <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" />
            <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" />
            break;
        case "list":
            <path d="M8.5 6.5H20M8.5 12H20M8.5 17.5H20" />
            <circle cx="4.5" cy="6.5" r=".9" fill="currentColor" stroke="none" />
            <circle cx="4.5" cy="12" r=".9" fill="currentColor" stroke="none" />
            <circle cx="4.5" cy="17.5" r=".9" fill="currentColor" stroke="none" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m16 16 4 4" />
            break;
        case "close":
            <path d="m6 6 12 12M18 6 6 18" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "more":
            <circle cx="12" cy="5.5" r="1.4" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
            <circle cx="12" cy="18.5" r="1.4" fill="currentColor" stroke="none" />
            break;
        case "audio":
            <path d="M4 15v-3a8 8 0 0 1 16 0v3" />
            <rect x="3.5" y="14" width="4" height="6" rx="1.5" />
            <rect x="16.5" y="14" width="4" height="6" rx="1.5" />
            break;
        case "subtitles":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M7 12h3M13 12h4M7 15.5h7M16.5 15.5h.5" />
            break;
        case "partial":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none" />
            break;
        case "requested":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "missing":
            <circle cx="12" cy="12" r="8.5" />
            <path d="m8.75 8.75 6.5 6.5" />
            break;
        case "offline":
            <path d="M3.5 9.5a13 13 0 0 1 17 0M6.5 13a8.5 8.5 0 0 1 11 0M9.5 16.5a4 4 0 0 1 5 0M4 4l16 16" />
            break;
        case "warning":
            <path d="M12 4 3 19.5h18zM12 10v4.5M12 17.25v.01" />
            break;
        case "play":
            <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none" />
            break;
        case "star":
            <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="currentColor" stroke="none" />
            break;
    }
</svg>
