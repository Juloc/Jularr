@page "/Library/Anime/{id:guid}"
@using Jularr.Web.Features.Franchises
@using Jularr.Web.Features.Learning
@using Jularr.Web.Features.Library
@using Jularr.Web.Features.Tracking
@using Jularr.Web.Features.Watchlist
@using Jularr.Web.Ui
@using Microsoft.AspNetCore.Html
@model Jularr.Web.Pages.Library.AnimeModel
@* Layout and hierarchy follow docs/mockups/anime-series-detail/SPEC.md (binding): one backdrop hero with its
   facts inside it, then seasons | episodes | related works. Owner-only tools stay in the Manage sheet. *@
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.AnimeTitle;
    var next = Model.NextEpisode;
    var primaryActionKey = Model.PrimaryAction switch
    {
        AnimePrimaryAction.Continue => "library.mediaCard.continueWatching",
        AnimePrimaryAction.Start => "library.mediaCard.startWatching",
        _ => "library.mediaCard.watchAgain"
    };
    var backLink = new ContextBackLinkModel("/Library", $"← {ui["nav.library"]}", "back-link");
    var providerStatus = MediaBannerCardModel.MapStatus(Model.Metadata?.Status);
    var providerStatusLabel = providerStatus switch
    {
        MediaReleaseStatus.Ongoing => ui["library.mediaCard.status.ongoing"],
        MediaReleaseStatus.Finished => ui["library.mediaCard.status.finished"],
        MediaReleaseStatus.Upcoming => ui["library.mediaCard.status.upcoming"],
        MediaReleaseStatus.Hiatus => ui["library.mediaCard.status.hiatus"],
        MediaReleaseStatus.Cancelled => ui["library.mediaCard.status.cancelled"],
        _ => null
    };
    var providerRating = Model.Metadata?.AverageScore is int averageScore and > 0 and <= 100
        ? (averageScore / 10m).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)
        : null;

    // Without a wide backdrop the cover becomes a blurred background: never a second, sharp poster.
    var hasBackdrop = !string.IsNullOrWhiteSpace(Model.BannerImageUrl);
    var heroArt = hasBackdrop ? Model.BannerImageUrl : Model.CoverImageUrl;

    string SeasonName(AnimeStructureEntry entry) => entry.GroupName
        ?? (entry.IsSpecials
            ? ui["library.anime.specials"]
            : ui.Format("library.watch.season", ("number", entry.SeasonNumber)));
    string EpisodeCountText(int count) => count == 1
        ? ui["library.anime.oneEpisode"]
        : ui.Format("library.index.episodeCount", ("count", count));

    var regularSeasons = Model.Episodes.Where(x => x.SeasonNumber > 0).Select(x => x.SeasonNumber).Distinct().Count();
    var hasSpecials = Model.Episodes.Any(x => x.SeasonNumber == 0);
    var structureText = string.Join(" + ", new[]
    {
        regularSeasons > 1 ? ui.Format("mediaFacts.seasonCount", ("count", regularSeasons)) : null,
        hasSpecials ? ui["library.anime.specials"] : null
    }.Where(x => x is not null));
    var formatKey = Jularr.Web.Features.Watchlist.WatchlistLabels.FormatKey(Model.Metadata?.Format);
    var heroYear = Model.Metadata?.SeasonYear ?? Model.LocalMetadata?.Year;
    var heroDescription = !string.IsNullOrWhiteSpace(Model.Metadata?.Description)
        ? Model.Metadata!.Description
        : Model.LocalMetadata?.Plot;
    var episodeTotal = Model.Metadata?.EpisodeCount ?? (Model.Episodes.Count > 0 ? Model.Episodes.Count : (int?)null);
    var runtime = Model.Metadata?.EpisodeDurationMinutes;
    var watchedPercent = Model.Episodes.Count == 0 ? 0 : Model.WatchedEpisodeCount * 100 / Model.Episodes.Count;
    var hasStrip = providerRating is not null || episodeTotal is not null || runtime is not null
        || Model.Facts is { HasLanguages: true } || Model.WatchedEpisodeCount > 0;
    var hasUpcoming = false;
    var upcoming = await Component.InvokeAsync("UpcomingReleases", new { mediaType = Jularr.Web.Features.Calendar.ReleaseMediaType.Anime, mediaId = Model.AnimeId, ui });
    using (var upcomingText = new System.IO.StringWriter())
    {
        upcoming.WriteTo(upcomingText, System.Text.Encodings.Web.HtmlEncoder.Default);
        hasUpcoming = !string.IsNullOrWhiteSpace(upcomingText.ToString());
    }
    var hasSide = hasUpcoming || Model.Related.Count > 0 || Model.Franchises.Count > 0 || Model.ExternalProgress is not null;
    var sortOptions = new[]
    {
        (AnimeEpisodeSort.EpisodeAscending, ui["library.anime.sort.episodeAsc"]),
        (AnimeEpisodeSort.EpisodeDescending, ui["library.anime.sort.episodeDesc"]),
        (AnimeEpisodeSort.UnwatchedFirst, ui["library.anime.sort.unwatched"])
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/anime-detail.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/context-back-link.js" asp-append-version="true"></script>
    <script src="~/js/anime-detail.js" asp-append-version="true" defer></script>
}

<div class="ad-page">
<partial name="_ContextBackLink" model="backLink" />

<section class="ad-hero@(hasBackdrop ? "" : " ad-hero-derived")" aria-labelledby="ad-title">
    <div class="ad-hero-bg" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(heroArt))
        {
            <img class="ad-hero-art" src="@heroArt" alt="" loading="eager" referrerpolicy="no-referrer" />
        }
    </div>
    <div class="ad-hero-copy">
        <h1 id="ad-title">@Model.AnimeTitle</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Metadata?.NativeTitle) ||
             !string.Equals(Model.LocalAnimeTitle, Model.AnimeTitle, StringComparison.Ordinal))
        {
            <p class="ad-hero-alt">
                @if (!string.IsNullOrWhiteSpace(Model.Metadata?.NativeTitle))
                {
                    <span lang="ja">@Model.Metadata!.NativeTitle</span>
                }
                @if (!string.Equals(Model.LocalAnimeTitle, Model.AnimeTitle, StringComparison.Ordinal))
                {
                    <span>@Model.LocalAnimeTitle</span>
                }
            </p>
        }

        <ul class="ad-hero-meta">
            @if (heroYear is int year)
            {
                <li>@year</li>
            }
            @if (formatKey is not null)
            {
                <li>@ui[formatKey]</li>
            }
            @if (structureText.Length > 0)
            {
                <li>@structureText</li>
            }
            @if (providerStatus is { } status && providerStatusLabel is not null)
            {
                <li class="ad-status ad-status-@status.ToString().ToLowerInvariant()">@providerStatusLabel</li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(heroDescription))
        {
            <p class="ad-hero-description">@heroDescription</p>
        }
        else if (Model.Metadata is null)
        {
            <p class="ad-hero-description">@ui.Format("library.anime.episodesDiscovered", ("count", Model.Episodes.Count))</p>
        }

        <div class="ad-hero-actions">
            @if (next is not null && Model.PlaybackEnabled)
            {
                <a class="ad-primary" href="/Library/Episode/@next.Id">
                    <partial name="_AnimeDetailIcon" model='"play"' />
                    <span>@ui[primaryActionKey]</span>
                    <small>@AnimeDetailView.EpisodeCode(next.SeasonNumber, next.Number)</small>
                </a>
            }

            @if (Model.IsOnWatchlist is bool onList)
            {
                <partial name="_WatchlistAction" model='new WatchlistActionView(onList, new Dictionary<string, string> { ["id"] = Model.AnimeId.ToString() }, ui)' />
            }

            <details class="ad-menu" data-ad-menu>
                <summary class="ad-secondary ad-icon-button" aria-label="@ui["library.anime.moreActions"]">
                    <partial name="_AnimeDetailIcon" model='"more"' />
                </summary>
                <div class="ad-menu-panel">
                    <a href="@Url.Page("/Settings/LearningScope", new {
                        mediaType = LearningMediaType.Anime,
                        scope = "work",
                        workKey = Model.AnimeId.ToString(),
                        label = Model.AnimeTitle,
                        returnUrl = $"/Library/Anime/{Model.AnimeId}"
                    })">@ui["library.languageToolsAndLearning"]</a>
                    @if (Model.RequestHref is not null)
                    {
                        <a href="@Model.RequestHref">@ui["library.anime.requestMore"]</a>
                    }
                </div>
            </details>

            @if (Model.IsOwner)
            {
                    Func<dynamic?, IHtmlContent> metadataGroup = @<div>
                            <form method="get" class="metadata-search">
                                <input type="search"
                                       name="q"
                                       value="@Model.SearchQuery"
                                       aria-label="@ui["library.animeTitleAria"]"
                                       placeholder="@ui["library.searchAniListPlaceholder"]" />
                                <button class="button button-primary" type="submit">@ui["library.searchAniList"]</button>
                            </form>

                            @if (!string.IsNullOrWhiteSpace(Model.MetadataError))
                            {
                                <p class="metadata-error">@Model.MetadataError</p>
                            }

                            @if (Model.Metadata is { } currentMatch)
                            {
                                <p class="muted">@currentMatch.Provider · ID @currentMatch.ExternalId</p>
                            }

                            @if (Model.SearchResults.Count > 0)
                            {
                                <div class="metadata-results">
                                    @foreach (var candidate in Model.SearchResults)
                                    {
                                        <article class="metadata-result">
                                            <div class="metadata-result-poster">
                                                @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                                                {
                                                    <img src="@candidate.CoverImageUrl"
                                                         alt=""
                                                         loading="lazy"
                                                         referrerpolicy="no-referrer" />
                                                }
                                                else
                                                {
                                                    <span>@candidate.PreferredTitle[..1]</span>
                                                }
                                            </div>
                                            <div class="metadata-result-copy">
                                                <strong>@candidate.PreferredTitle</strong>
                                                @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                                                {
                                                    <span lang="ja">@candidate.NativeTitle</span>
                                                }
                                                <small>
                                                    @if (candidate.SeasonYear is int year)
                                                    {
                                                        <text>@year</text>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(candidate.Format))
                                                    {
                                                        <text> · @candidate.Format</text>
                                                    }
                                                    @if (candidate.EpisodeCount is int count)
                                                    {
                                                        <text> · @ui.Format("library.episodeCountAbbrev", ("count", count))</text>
                                                    }
                                                </small>
                                            </div>
                                            <div>
                                                <form method="post"
                                                      asp-page-handler="MatchMetadata"
                                                      asp-route-id="@Model.AnimeId">
                                                    <input type="hidden" name="provider" value="@candidate.Provider" />
                                                    <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                                    <button class="button" type="submit">
                                                        @(Model.Metadata?.Provider == candidate.Provider &&
                                                          Model.Metadata?.ExternalId == candidate.ExternalId
                                                            ? ui["library.matched"]
                                                            : ui["library.anime.useForDisplay"])
                                                    </button>
                                                </form>

                                                <details>
                                                    <summary>@ui["library.anime.mapLocalEpisodes"]</summary>
                                                    <form method="post"
                                                          asp-page-handler="MatchEpisodeRange"
                                                          asp-route-id="@Model.AnimeId">
                                                        <input type="hidden" name="provider" value="@candidate.Provider" />
                                                        <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                                        <label>
                                                            @ui["library.anime.localSeason"]
                                                            <input type="number"
                                                                   name="seasonNumber"
                                                                   min="0"
                                                                   value="@Model.SuggestedMappingSeason"
                                                                   required />
                                                        </label>
                                                        <label>
                                                            @ui["library.anime.localFrom"]
                                                            <input type="number"
                                                                   name="localEpisodeStart"
                                                                   min="1"
                                                                   value="@Model.SuggestedMappingEpisodeStart"
                                                                   required />
                                                        </label>
                                                        <label>
                                                            @ui["library.anime.localTo"]
                                                            <input type="number"
                                                                   name="localEpisodeEnd"
                                                                   min="1"
                                                                   placeholder="@ui["library.anime.autoPlaceholder"]" />
                                                        </label>
                                                        <label>
                                                            @ui["library.anime.aniListStartsAt"]
                                                            <input type="number"
                                                                   name="remoteEpisodeStart"
                                                                   min="1"
                                                                   value="1"
                                                                   required />
                                                        </label>
                                                        <small>@ui["library.anime.localToHint"]</small>
                                                        <button class="button button-primary" type="submit">@ui["library.anime.addMapping"]</button>
                                                    </form>
                                                </details>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }

                            @if (Model.Metadata is not null)
                            {
                                <div class="inline-actions">
                                    <form method="post" asp-page-handler="RefreshMetadata" asp-route-id="@Model.AnimeId">
                                        <button class="button" type="submit">@ui["library.anime.refreshMetadata"]</button>
                                    </form>
                                    <form method="post" asp-page-handler="RemoveMetadata" asp-route-id="@Model.AnimeId">
                                        <button class="button" type="submit">@ui["library.anime.removeMatch"]</button>
                                    </form>
                                </div>
                            }
                        </div>;

                        Func<dynamic?, IHtmlContent> mappingGroup = @<div>
                            @if (Model.ExternalProgress is { } mappingProgress)
                            {
                                var mappingPanel = new ExternalProgressPanel(
                                    mappingProgress,
                                    Url.Page(null, "ExternalProgress", new { id = Model.AnimeId })!,
                                    Model.Metadata is { } matchedForMapping &&
                                    matchedForMapping.ExternalId == mappingProgress.MatchedMediaId?.ToString()
                                        ? matchedForMapping.CoverImageUrl
                                        : null,
                                    // Change-match and edit-mappings live in the Metadata group of
                                    // this same sheet, so only the review link (an external
                                    // destination) is worth showing again here.
                                    MatchUrl: null,
                                    MappingUrl: null,
                                    CanManageMapping: true,
                                    Ui: ui);
                                <partial name="_ExternalProgressManage" model="mappingPanel" />
                            }

                            @if (Model.EpisodeMappings.Count == 0)
                            {
                                <p>@ui["library.anime.noExplicitRanges"]</p>
                            }
                            else
                            {
                                <div class="episode-list">
                                    @foreach (var mapping in Model.EpisodeMappings)
                                    {
                                        var remoteEnd = mapping.RemoteEpisodeStart
                                            + (mapping.LocalEpisodeEnd - mapping.LocalEpisodeStart);

                                        <div class="episode-row">
                                            <div class="episode-number">S@(mapping.SeasonNumber.ToString("00"))</div>
                                            <div class="episode-main">
                                                <strong>
                                                    E@(mapping.LocalEpisodeStart.ToString("00"))–E@(mapping.LocalEpisodeEnd.ToString("00"))
                                                    → @mapping.PreferredTitle
                                                </strong>
                                                <span>
                                                    @ui.Format("library.anime.aniListRange", ("start", mapping.RemoteEpisodeStart.ToString("00")), ("end", remoteEnd.ToString("00")))
                                                    · ID @mapping.ExternalId
                                                </span>
                                            </div>
                                            <form method="post"
                                                  asp-page-handler="RemoveEpisodeMapping"
                                                  asp-route-id="@Model.AnimeId">
                                                <input type="hidden" name="mappingId" value="@mapping.Id" />
                                                <button class="button" type="submit">@ui["common.remove"]</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>;

                        Func<dynamic?, IHtmlContent> filesGroup = @<div class="inline-actions">
                            <a class="button" href="/Admin/Media/@Model.AnimeId">@ui["admin.media.manageLink"]</a>
                            <a class="button" href="/Library/Rename/@Model.AnimeId">@ui["library.anime.renameFiles"]</a>
                            <a class="button" href="/Library/AnimeRepair/@Model.AnimeId">@ui["library.anime.repair"]</a>
                            <a class="button" href="/Library/PresentationGroups/@Model.AnimeId">@ui["library.presentation.manageLink"]</a>
                        </div>;

                        Func<dynamic?, IHtmlContent> acquisitionGroup = @<div>
                            <partial name="_AnimeAcquisitionPanel" model="(Model.AnimeId, ui)" />
                        </div>;

                        var needsReview = Model.ExternalProgress?.MappingBasis == ExternalMappingBasis.NeedsReview;
                        var manageSheet = new ManageSheetModel(
                            "anime-manage",
                            ui["manage.trigger"],
                            Model.AnimeTitle,
                            [
                                new ManageSheetGroup(ui["manage.group.metadata"], metadataGroup(null)),
                                new ManageSheetGroup(ui["manage.group.mapping"], mappingGroup(null)),
                                new ManageSheetGroup(ui["manage.group.files"], filesGroup(null)),
                                new ManageSheetGroup(ui["manage.group.acquisition"], acquisitionGroup(null))
                            ],
                            ui,
                            needsReview ? new ManageSheetReviewBadge(ui["manage.needsReview"], "/Settings/MappingReview") : null);
                    <partial name="_ManageSheet" model="manageSheet" />
            }
        </div>
    </div>

    @if (hasStrip)
    {
        <ul class="ad-hero-strip">
            @if (providerRating is not null)
            {
                <li title="@ui["library.mediaCard.rating"]">
                    <partial name="_AnimeDetailIcon" model='"star"' />
                    <span><span class="sr-only">@ui["library.mediaCard.rating"] </span>@providerRating</span>
                </li>
            }
            @if (episodeTotal is int total)
            {
                <li>
                    <partial name="_AnimeDetailIcon" model='"episodes"' />
                    <span>@ui.Format("mediaFacts.episodeCount", ("count", total))</span>
                </li>
            }
            @if (runtime is int minutesPerEpisode)
            {
                <li>
                    <partial name="_AnimeDetailIcon" model='"clock"' />
                    <span>@ui.Format("library.anime.durationMinutes", ("minutes", minutesPerEpisode))</span>
                </li>
            }
            @if (Model.Facts is { HasLanguages: true } facts)
            {
                @foreach (var group in facts.LanguageGroups.Where(x => x.Usage != Jularr.Web.Features.MediaFacts.MediaFactsLanguageUsage.Text))
                {
                    <li role="group" aria-label="@group.Label" title="@group.Label">
                        <partial name="_AnimeDetailIcon" model='group.Usage == Jularr.Web.Features.MediaFacts.MediaFactsLanguageUsage.Audio ? "audio" : "subtitles"' />
                        <span>
                            @foreach (var chip in group.Chips)
                            {
                                <span class="ad-strip-lang@(chip.IsPartial ? " is-partial" : "")" title="@chip.PartialLabel">@chip.Code</span>
                            }
                        </span>
                    </li>
                }
            }
            @if (Model.WatchedEpisodeCount > 0)
            {
                <li class="ad-strip-progress">
                    <span>@Model.WatchedEpisodeCount / @Model.Episodes.Count @ui["library.watch.episodesHeading"]</span>
                    <span class="progress-track" role="progressbar"
                          aria-label="@ui.Format("library.mediaCard.progressWatched", ("percent", watchedPercent))"
                          aria-valuemin="0" aria-valuemax="100" aria-valuenow="@watchedPercent"><span style="width:@watchedPercent%"></span></span>
                </li>
            }
        </ul>
    }
</section>

<div class="ad-main@(Model.Structure.Count == 0 ? " no-rail" : "")@(hasSide ? "" : " no-side")">
    @if (Model.Structure.Count > 0)
    {
        <nav class="ad-seasons" aria-labelledby="ad-seasons-title">
            <h2 id="ad-seasons-title">@ui["library.anime.seasonsHeading"]</h2>
            <ul>
                @foreach (var entry in Model.Structure)
                {
                    var isSelected = entry.Key == Model.Selected?.Key;
                    var art = Model.StructureArt.GetValueOrDefault(entry.Key);
                    <li>
                        <a class="ad-season@(isSelected ? " is-selected" : "")"
                           href="@Model.PageHref(entry.Key, Model.Sort, Model.Layout)"
                           aria-current="@(isSelected ? "true" : null)">
                            <span class="ad-season-art" aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(art))
                                {
                                    <img src="@art" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                                }
                                else
                                {
                                    <span>@(entry.SeasonNumber is int number ? (number == 0 ? "SP" : $"S{number}") : entry.Key.ToUpperInvariant())</span>
                                }
                            </span>
                            <span class="ad-season-copy">
                                <strong>@SeasonName(entry)</strong>
                                <small>@EpisodeCountText(entry.EpisodeCount)</small>
                            </span>
                            <partial name="_AnimeDetailIcon" model='"chevron"' />
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

    <section class="ad-episodes" id="episodes" aria-labelledby="ad-episodes-title">
        <header class="ad-episodes-head">
            <h2 id="ad-episodes-title">@ui["library.watch.episodesHeading"]</h2>
            @if (Model.Selected is { } selected)
            {
                <span class="ad-context">@ui.Format("library.anime.selectedSeasonContext", ("season", SeasonName(selected)), ("count", EpisodeCountText(selected.EpisodeCount)))</span>
            }
            @if (Model.SelectedEpisodes.Count > 0)
            {
                <div class="ad-tools">
                    <form method="get" action="/Library/Anime/@Model.AnimeId#episodes" class="ad-sort" data-ad-sort>
                        @if (Model.Selected is { } sortScope)
                        {
                            <input type="hidden" name="part" value="@sortScope.Key" />
                        }
                        @if (AnimeDetailView.LayoutName(Model.Layout) is { } layoutValue)
                        {
                            <input type="hidden" name="view" value="@layoutValue" />
                        }
                        <label>
                            <span>@ui["library.anime.sortLabel"]</span>
                            <select name="sort">
                                @foreach (var (value, label) in sortOptions)
                                {
                                    <option value="@AnimeDetailView.SortName(value)" selected="@(value == Model.Sort)">@label</option>
                                }
                            </select>
                        </label>
                        <noscript><button type="submit" class="button">@ui["common.search"]</button></noscript>
                    </form>
                    <div class="ad-view" role="group" aria-label="@ui["library.anime.viewAria"]">
                        @foreach (var (layout, icon, label) in new[]
                        {
                            (AnimeEpisodeLayout.Grid, "grid", ui["library.anime.view.grid"]),
                            (AnimeEpisodeLayout.List, "list", ui["library.anime.view.list"])
                        })
                        {
                            <a class="ad-view-button@(layout == Model.Layout ? " is-active" : "")"
                               href="@Model.PageHref(Model.Selected?.Key, Model.Sort, layout)"
                               aria-current="@(layout == Model.Layout ? "true" : null)"
                               aria-label="@label" title="@label">
                                <partial name="_AnimeDetailIcon" model="icon" />
                            </a>
                        }
                    </div>
                </div>
            }
        </header>

        @if (Model.SelectedEpisodes.Count == 0)
        {
            <div class="ad-empty">
                <p>@ui["library.anime.noEpisodes"]</p>
                @if (Model.OpenRequest is not null)
                {
                    var pending = AnimeDetailView.Availability(AnimeEpisodeMediaFacts.None, Model.OpenRequest, null, null);
                    <span class="ad-state ad-state-@AnimeDetailView.AvailabilityName(pending)">
                        <partial name="_AnimeDetailIcon" model="AnimeDetailView.AvailabilityName(pending)" />
                        @ui[AnimeDetailView.AvailabilityKey(pending)]
                    </span>
                }
            </div>
        }
        else
        {
            <ul class="ad-episode-list@(Model.Layout == AnimeEpisodeLayout.List ? " is-list" : " is-grid")">
                @foreach (var episode in Model.SelectedEpisodes)
                {
                    <li><partial name="_AnimeEpisodeCard" model="(Model, episode)" /></li>
                }
            </ul>
        }
    </section>

    @if (hasSide)
    {
    <aside class="ad-side">
        @if (Model.Related.Count > 0 || Model.Franchises.Count > 0)
        {
            <section class="ad-related" aria-labelledby="ad-related-title">
                <h2 id="ad-related-title">@ui["library.anime.relatedHeading"]</h2>
                @if (Model.Related.Count > 0)
                {
                    <ul>
                        @foreach (var related in Model.Related)
                        {
                            var kind = related.MediaType == WatchlistMediaType.Anime
                                ? (related.FormatKey is null ? null : ui[related.FormatKey])
                                : ui[$"watchlist.type.{WatchlistMediaTypeNames.ToCategory(related.MediaType)}"];
                            var detail = string.Join(" · ", new[] { ui[related.GroupKey], kind, related.Year?.ToString(System.Globalization.CultureInfo.InvariantCulture) }.Where(x => !string.IsNullOrEmpty(x)));
                            <li>
                                <a href="@related.Href">
                                    <span class="ad-related-art" aria-hidden="true">
                                        @if (!string.IsNullOrWhiteSpace(related.CoverImageUrl))
                                        {
                                            <img src="@related.CoverImageUrl" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                                        }
                                        else
                                        {
                                            <span>@WatchlistLabels.Initial(related.Title)</span>
                                        }
                                    </span>
                                    <span class="ad-related-copy">
                                        <strong>@related.Title</strong>
                                        <small>@detail</small>
                                    </span>
                                    <partial name="_AnimeDetailIcon" model='"chevron"' />
                                </a>
                            </li>
                        }
                    </ul>
                }
                @if (Model.Franchises.Count > 0)
                {
                    <div class="ad-franchises">
                        @if (Model.RelatedMore > 0)
                        {
                            <a href="/Franchises/@Model.Franchises[0].Id">@ui.Format("library.anime.relatedMore", ("count", Model.RelatedMore))</a>
                        }
                        @foreach (var franchise in Model.Franchises)
                        {
                            <a href="/Franchises/@franchise.Id">
                                <span>@FranchiseLabels.Title(ui, franchise.Title)</span>
                                <small>@ui.Format("franchise.memberCount", ("count", franchise.MemberCount))</small>
                            </a>
                        }
                    </div>
                }
            </section>
        }

        @upcoming

        @if (Model.ExternalProgress is { } externalProgress)
        {
            var externalPanel = new ExternalProgressPanel(
                externalProgress,
                Url.Page(null, "ExternalProgress", new { id = Model.AnimeId })!,
                // Range mappings can point at another AniList part; only reuse the
                // matched cover when the resolved entry is the metadata match itself.
                Model.Metadata is { } matchedMetadata &&
                matchedMetadata.ExternalId == externalProgress.MatchedMediaId?.ToString()
                    ? matchedMetadata.CoverImageUrl
                    : null,
                Ui: ui);
            <partial name="_ExternalProgress" model="externalPanel" />
        }
    </aside>
    }
</div>
</div>
