@page
@using Jularr.Web.Features.Collections
@using Jularr.Web.Features.Library
@using Jularr.Web.Features.MediaCore
@model Jularr.Web.Pages.Library.IndexModel
@* Layout and hierarchy follow docs/mockups/library (binding): a Library | Collections switch, the media-type
   tabs, one toolbar (count, Filters, Sort, layout) and a poster grid. The address is the only state. *@
@{
    var ui = Model.Ui;
    var query = Model.Query;
    ViewData["Title"] = ui["nav.library"];
    var state = Model.State;
    var facets = Model.Facets;
    var active = query.ActiveFilterCount;
    var hasTitles = !query.Collections && Model.Total > 0 && state != LibraryPageState.Error;

    string CountText(int count) => count == 1 ? ui["library.browse.countOne"] : ui.Format("library.browse.count", ("count", count));
    string LanguageName(string code) => Jularr.Web.Features.Acquisition.Access.RequestLanguages.Name(code);
    // The offered languages, plus a selected one the library no longer has so the choice stays visible.
    IEnumerable<string> LanguageOptions(IReadOnlyList<string> offered, string? selected) =>
        selected is null || offered.Contains(selected) ? offered : offered.Append(selected);
}

@section Head {
    <link rel="stylesheet" href="~/css/library.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/library-browse.js" asp-append-version="true" defer></script>
}

<div class="lib-page">
    <header class="lib-head">
        <div class="lib-head-main">
            <h1>@ui["nav.library"]</h1>
            <nav class="lib-switch" aria-label="@ui["library.browse.viewAria"]">
                <a class="lib-switch-item@(query.Collections ? "" : " is-active")" href="@LibraryBrowse.BasePath"
                   aria-current="@(query.Collections ? null : "page")" data-lib-nav>@ui["nav.library"]</a>
                <a class="lib-switch-item@(query.Collections ? " is-active" : "")"
                   href="@LibraryBrowse.Href(new LibraryBrowseQuery { Collections = true })"
                   aria-current="@(query.Collections ? "page" : null)" data-lib-nav>@ui["collections.nav.title"]</a>
            </nav>
        </div>
    </header>

    @if (!query.Collections)
    {
        <partial name="_LibraryScopeTabs" model="(Model.ScopeTabs, ui)" />
    }

    <p class="lib-notice" data-lib-offline hidden role="status">
        <partial name="_LibraryIcon" model='"offline"' />
        <span>@ui["library.browse.offline"]</span>
        <a href="/Settings/Offline">@ui["library.browse.offline.open"]</a>
    </p>

    @if (hasTitles)
    {
        var sortHref = new Func<LibrarySort, string>(sort => LibraryBrowse.Href(query with { Sort = sort }));
        <div class="lib-toolbar">
            <p class="lib-count" aria-live="polite">
                @(active > 0
                    ? ui.Format("library.browse.countFiltered", ("count", Model.Cards.Count), ("total", Model.Total))
                    : CountText(Model.Total))
            </p>

            <div class="lib-controls">
                <details class="lib-pop lib-filter" data-lib-pop>
                    <summary class="lib-btn@(active > 0 ? " is-active" : "")"
                             aria-label="@(active > 0 ? ui.Format("library.browse.filtersActiveAria", ("count", active)) : ui["library.browse.filters"])">
                        <partial name="_LibraryIcon" model='"filter"' />
                        <span>@ui["library.browse.filters"]</span>
                        @if (active > 0)
                        {
                            <span class="lib-badge">@active</span>
                        }
                    </summary>
                    <span class="lib-pop-backdrop" data-lib-close></span>
                    <div class="lib-pop-panel lib-filter-panel" role="dialog" aria-label="@ui["library.browse.filters"]">
                        <form method="get" action="@LibraryBrowse.BasePath" data-lib-filters>
                            @if (query.MediaType is { } scope)
                            {
                                <input type="hidden" name="type" value="@WorkMediaTypes.ToStorage(scope)" />
                            }
                            @if (query.Sort != LibrarySort.Recent)
                            {
                                <input type="hidden" name="sort" value="@LibraryBrowse.SortName(query.Sort)" />
                            }
                            @if (query.Layout == LibraryLayout.List)
                            {
                                <input type="hidden" name="view" value="list" />
                            }
                            <div class="lib-pop-head">
                                <h2>@ui["library.browse.filters"]</h2>
                                @if (active > 0)
                                {
                                    <a class="lib-reset" href="@LibraryBrowse.Href(query.WithoutFilters())" data-lib-nav>@ui["library.browse.filter.reset"]</a>
                                }
                                <button type="button" class="lib-icon-btn" data-lib-close aria-label="@ui["library.browse.close"]">
                                    <partial name="_LibraryIcon" model='"close"' />
                                </button>
                            </div>

                            <div class="lib-groups">
                                <fieldset class="lib-group">
                                    <legend>@ui["library.browse.filter.groupProgress"]</legend>
                                    @foreach (var option in LibraryBrowse.ProgressStates)
                                    {
                                        var count = facets.Progress.GetValueOrDefault(option);
                                        var selected = query.Progress.Contains(option);
                                        if (count > 0 || selected)
                                        {
                                            <label class="lib-check">
                                                <input type="checkbox" name="progress" value="@LibraryBrowse.ProgressName(option)" checked="@selected" />
                                                <span>@ui[LibraryBrowse.ProgressKey(option)]</span>
                                                <span class="lib-check-count">@count</span>
                                            </label>
                                        }
                                    }
                                </fieldset>

                                <fieldset class="lib-group">
                                    <legend>@ui["library.browse.filter.groupAvailability"]</legend>
                                    @foreach (var option in LibraryBrowse.AvailabilityStates)
                                    {
                                        var count = facets.Availability.GetValueOrDefault(option);
                                        var selected = query.Availability.Contains(option);
                                        if (count > 0 || selected)
                                        {
                                            <label class="lib-check">
                                                <input type="checkbox" name="avail" value="@LibraryBrowse.AvailabilityName(option)" checked="@selected" />
                                                <span>@ui[LibraryBrowse.AvailabilityKey(option)]</span>
                                                <span class="lib-check-count">@count</span>
                                            </label>
                                        }
                                    }
                                </fieldset>

                                @{
                                    var showPreferred = Model.Preference.IsSet && (facets.PreferredLanguage > 0 || query.PreferredLanguage);
                                    var showAudio = facets.AudioLanguages.Count > 0 || query.AudioLanguage is not null;
                                    var showSubtitle = facets.SubtitleLanguages.Count > 0 || query.SubtitleLanguage is not null;
                                }
                                @if (showPreferred || showAudio || showSubtitle)
                                {
                                    <fieldset class="lib-group">
                                        <legend>@ui["library.browse.filter.groupLanguage"]</legend>
                                        @if (showPreferred)
                                        {
                                            <label class="lib-check">
                                                <input type="checkbox" name="pref" value="1" checked="@query.PreferredLanguage" />
                                                <span>@ui.Format("library.browse.filter.preferred", ("languages", string.Join(" · ", Model.Preference.Codes)))</span>
                                                <span class="lib-check-count">@facets.PreferredLanguage</span>
                                            </label>
                                        }
                                        @if (showAudio)
                                        {
                                            <label class="lib-select">
                                                <span>@ui["library.browse.filter.audio"]</span>
                                                <select name="audio">
                                                    <option value="">@ui["library.browse.filter.any"]</option>
                                                    @foreach (var code in LanguageOptions(facets.AudioLanguages, query.AudioLanguage))
                                                    {
                                                        <option value="@code" selected="@(query.AudioLanguage == code)">@LanguageName(code)</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        @if (showSubtitle)
                                        {
                                            <label class="lib-select">
                                                <span>@ui["library.browse.filter.subtitle"]</span>
                                                <select name="sub">
                                                    <option value="">@ui["library.browse.filter.any"]</option>
                                                    @foreach (var code in LanguageOptions(facets.SubtitleLanguages, query.SubtitleLanguage))
                                                    {
                                                        <option value="@code" selected="@(query.SubtitleLanguage == code)">@LanguageName(code)</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                    </fieldset>
                                }

                                @if (facets.Years.Count > 0 || facets.Statuses.Count > 0 || facets.Formats.Count > 0)
                                {
                                    <fieldset class="lib-group">
                                        <legend>@ui["library.browse.filter.groupMetadata"]</legend>
                                        @if (facets.Years.Count > 0)
                                        {
                                            <label class="lib-select">
                                                <span>@ui["library.browse.filter.year"]</span>
                                                <select name="year">
                                                    <option value="">@ui["library.browse.filter.any"]</option>
                                                    @foreach (var year in facets.Years)
                                                    {
                                                        <option value="@year" selected="@(query.Year == year)">@year</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        @if (facets.Statuses.Count > 0)
                                        {
                                            <label class="lib-select">
                                                <span>@ui["library.browse.filter.status"]</span>
                                                <select name="status">
                                                    <option value="">@ui["library.browse.filter.any"]</option>
                                                    @foreach (var status in facets.Statuses)
                                                    {
                                                        <option value="@LibraryBrowse.StatusName(status)" selected="@(query.Status == status)">@ui[LibraryBrowse.StatusKey(status)]</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        @if (facets.Formats.Count > 0)
                                        {
                                            <label class="lib-select">
                                                <span>@ui["library.browse.filter.format"]</span>
                                                <select name="format">
                                                    <option value="">@ui["library.browse.filter.any"]</option>
                                                    @foreach (var format in facets.Formats)
                                                    {
                                                        <option value="@format" selected="@(query.Format == format)">@ui[Jularr.Web.Features.Watchlist.WatchlistLabels.FormatKey(format)!]</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                    </fieldset>
                                }
                            </div>

                            <div class="lib-pop-foot">
                                <button type="submit" class="button button-primary">@ui["library.browse.filter.apply"]</button>
                            </div>
                        </form>
                    </div>
                </details>

                <details class="lib-pop lib-sort" data-lib-pop>
                    <summary class="lib-btn">
                        <partial name="_LibraryIcon" model='"sort"' />
                        <span>@ui.Format("library.browse.sortCurrent", ("sort", ui[LibraryBrowse.SortKey(query.Sort)]))</span>
                    </summary>
                    <span class="lib-pop-backdrop" data-lib-close></span>
                    <div class="lib-pop-panel lib-sort-panel" role="dialog" aria-label="@ui["library.browse.sortMenuAria"]">
                        <div class="lib-pop-head lib-sort-head">
                            <h2>@ui["library.browse.sortMenuAria"]</h2>
                            <button type="button" class="lib-icon-btn" data-lib-close aria-label="@ui["library.browse.close"]">
                                <partial name="_LibraryIcon" model='"close"' />
                            </button>
                        </div>
                        <ul class="lib-sort-list">
                            @foreach (var sort in LibraryBrowse.Sorts)
                            {
                                var selected = sort == query.Sort;
                                <li>
                                    <a class="lib-sort-option@(selected ? " is-selected" : "")" href="@sortHref(sort)"
                                       aria-current="@(selected ? "true" : null)" data-lib-nav>
                                        <span class="lib-sort-mark" aria-hidden="true"></span>
                                        @ui[LibraryBrowse.SortKey(sort)]
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </details>

                <nav class="lib-layout" aria-label="@ui["library.browse.layoutAria"]">
                    @foreach (var (layout, icon, labelKey) in new[]
                    {
                        (LibraryLayout.Grid, "grid", "library.browse.layout.grid"),
                        (LibraryLayout.List, "list", "library.browse.layout.list")
                    })
                    {
                        var selected = layout == query.Layout;
                        <a class="lib-icon-btn@(selected ? " is-active" : "")" href="@LibraryBrowse.Href(query with { Layout = layout })"
                           aria-current="@(selected ? "true" : null)" aria-label="@ui[labelKey]" title="@ui[labelKey]" data-lib-nav>
                            <partial name="_LibraryIcon" model="icon" />
                        </a>
                    }
                </nav>
            </div>
        </div>
    }

    <div class="lib-results" data-lib-results aria-busy="false">
        @if (state == LibraryPageState.Error)
        {
            <div class="lib-message" role="alert">
                <p>@ui["library.browse.error.title"]</p>
                <a class="button" href="@Model.CurrentHref" data-lib-nav>@ui["library.browse.error.retry"]</a>
            </div>
        }
        else if (query.Collections)
        {
            <partial name="_LibraryCollections" model="(Model.Collections, ui)" />
        }
        else if (state == LibraryPageState.Empty && Model.LibraryTotal > 0)
        {
            <div class="lib-message">
                <p>@ui["library.browse.scopeEmpty"]</p>
            </div>
        }
        else if (state == LibraryPageState.Empty)
        {
            <div class="empty-state">
                <h3>@ui["library.index.emptyTitle"]</h3>
                <p>@ui["library.index.emptyHint"]</p>
                <a class="button" href="/Discover">@ui["library.index.emptyAction"]</a>
            </div>
        }
        else if (state == LibraryPageState.NoResults)
        {
            <div class="lib-message">
                <p>@ui["library.browse.noResults.title"]</p>
                <a class="button" href="@LibraryBrowse.Href(query.WithoutFilters())" data-lib-nav>@ui["library.browse.noResults.reset"]</a>
            </div>
        }
        else
        {
            @if (state == LibraryPageState.Degraded)
            {
                <p class="lib-notice lib-notice-warning" role="status">
                    <partial name="_LibraryIcon" model='"warning"' />
                    <span>@ui["library.browse.degraded"]</span>
                    <a href="@Model.CurrentHref" data-lib-nav>@ui["library.browse.error.retry"]</a>
                </p>
            }

            <ul class="lib-grid@(query.Layout == LibraryLayout.List ? " lib-list" : "")">
                @foreach (var card in Model.Cards)
                {
                    <li><partial name="_LibraryCard" model="(card, ui)" /></li>
                }
            </ul>
        }
    </div>
</div>
