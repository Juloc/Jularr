@model (Jularr.Web.Pages.Library.AnimeModel Page, Jularr.Web.Pages.Library.AnimeModel.EpisodeRow Episode)
@using Jularr.Web.Features.Library
@* One episode of the anime detail page (docs/mockups/anime-series-detail/SPEC.md): thumbnail with runtime and
   progress, code and title, compact audio/subtitle languages, availability and an overflow menu. Release
   and file details never appear here. The same markup is a card in the grid and a row in the list layout. *@
@{
    var vm = Model.Page;
    var ui = vm.Ui;
    var episode = Model.Episode;
    var code = AnimeDetailView.EpisodeCode(episode.SeasonNumber, episode.Number);
    var stateName = AnimeDetailView.AvailabilityName(episode.Availability);
    var stateIcon = episode.Availability == AnimeEpisodeAvailability.OtherLanguageOnly ? "language" : stateName;
    var art = vm.BannerImageUrl ?? vm.CoverImageUrl;
    var href = vm.PlaybackEnabled ? $"/Library/Episode/{episode.Id}" : null;
}
<article class="ad-ep ad-ep-@stateName@(episode.IsWatched ? " is-watched" : "")">
    <a class="ad-ep-thumb" href="@href" aria-label="@ui.Format("library.anime.openEpisodeAria", ("code", code), ("title", episode.Title))">
        @if (!string.IsNullOrWhiteSpace(art))
        {
            <img src="@art" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        }
        @if (href is not null)
        {
            <span class="ad-ep-play" aria-hidden="true"><partial name="_AnimeDetailIcon" model='"play"' /></span>
        }
        @if (episode.RuntimeMinutes is int minutes)
        {
            <span class="ad-ep-runtime">@ui.Format("library.anime.durationMinutes", ("minutes", minutes))</span>
        }
        @if (episode.IsWatched)
        {
            <span class="ad-ep-watched" title="@ui["library.episode.watched"]">
                <partial name="_AnimeDetailIcon" model='"check"' />
                <span class="sr-only">@ui["library.episode.watched"]</span>
            </span>
        }
        else if (episode.ResumePercent is int resume)
        {
            <span class="ad-ep-resume progress-track" role="progressbar"
                  aria-label="@ui.Format("library.mediaCard.progressWatched", ("percent", resume))"
                  aria-valuemin="0" aria-valuemax="100" aria-valuenow="@resume"><span style="width:@resume%"></span></span>
            <span class="ad-ep-resume-text" aria-hidden="true">@ui.Format("library.mediaCard.percent", ("percent", resume))</span>
        }
    </a>

    <div class="ad-ep-body">
        <div class="ad-ep-head">
            <div class="ad-ep-title">
                <p class="ad-ep-code">@code</p>
                <h3><a href="@href">@episode.Title</a></h3>
            </div>
            <details class="ad-menu" data-ad-menu>
                <summary class="ad-menu-button" aria-label="@ui["library.anime.episodeActions"]">
                    <partial name="_AnimeDetailIcon" model='"more"' />
                </summary>
                <div class="ad-menu-panel">
                    @if (href is not null)
                    {
                        <a href="@href">@ui["library.watch.play"]</a>
                    }
                    <form method="post" asp-page-handler="Watched" asp-route-id="@vm.AnimeId">
                        <input type="hidden" name="episodeId" value="@episode.Id" />
                        <input type="hidden" name="watched" value="@(episode.IsWatched ? "false" : "true")" />
                        <input type="hidden" name="part" value="@vm.Selected?.Key" />
                        <input type="hidden" name="sort" value="@AnimeDetailView.SortName(vm.Sort)" />
                        <input type="hidden" name="view" value="@AnimeDetailView.LayoutName(vm.Layout)" />
                        <button type="submit"
                                aria-label="@(episode.IsWatched ? ui.Format("library.anime.markUnwatchedAria", ("code", code)) : ui.Format("library.anime.markWatchedAria", ("code", code)))">
                            @(episode.IsWatched ? ui["library.episode.markUnwatched"] : ui["library.episode.markWatched"])
                        </button>
                    </form>
                </div>
            </details>
        </div>

        @if (vm.ShowContentMetrics)
        {
            <p class="ad-ep-learning">
                @if (episode.JapaneseSubtitleTracks == 0)
                {
                    @ui["library.anime.noJapaneseSubtitle"]
                }
                else
                {
                    @ui.Format("library.anime.vocabularyCandidates", ("count", episode.TotalTerms), ("percent", episode.PreparationPercent))
                }
            </p>
        }

        <div class="ad-ep-foot">
            <div class="ad-langs">
                @foreach (var (label, icon, chips) in new[]
                {
                    (ui["library.mediaCard.audioLanguages"], "audio", episode.Audio),
                    (ui["library.mediaCard.subtitleLanguages"], "subtitles", episode.Subtitles)
                })
                {
                    if (chips.Any)
                    {
                        <span class="ad-lang-group" role="group" aria-label="@label">
                            <span class="ad-lang-icon" title="@label"><partial name="_AnimeDetailIcon" model="icon" /></span>
                            @foreach (var chip in chips.Shown)
                            {
                                <span class="ad-lang@(chip.IsPreferred ? " is-preferred" : "")"
                                      title="@(chip.IsPreferred ? ui["library.anime.preferredLanguage"] : null)">@chip.Code</span>
                            }
                            @if (chips.More > 0)
                            {
                                <span class="ad-lang ad-lang-more" title="@ui.Format("library.anime.moreLanguages", ("count", chips.More))">+@chips.More</span>
                            }
                        </span>
                    }
                }
            </div>
            <span class="ad-state ad-state-@stateName">
                <partial name="_AnimeDetailIcon" model="stateIcon" />
                @ui[AnimeDetailView.AvailabilityKey(episode.Availability)]
            </span>
        </div>
    </div>
</article>
