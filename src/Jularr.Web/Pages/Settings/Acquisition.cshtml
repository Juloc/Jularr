@page
@model Jularr.Web.Pages.Settings.AcquisitionModel
@using Jularr.Web.Features.Acquisition.Import
@using Jularr.Web.Features.Media.Optimization
@using Jularr.Web.Features.Storage.FolderBrowse
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.acquisition.title"];

    // Remote side: a path of another system, never a folder of this container. Local side: a folder
    // of this container, chosen with the shared folder browser when the viewer may browse.
    var remoteField = new PathFieldModel("mapping-remote", "remotePrefix", ui["settings.acquisition.remotePrefixColumn"], null, ui)
    {
        Placeholder = "/downloads",
        Required = true,
        Browsable = false
    };
    var localField = new PathFieldModel("mapping-local", "localPrefix", ui["settings.acquisition.localPrefixColumn"], null, ui)
    {
        Placeholder = "/data/downloads",
        Required = true,
        Disabled = false,
        Browsable = Model.CanManageStorage
    };
    var pathTestLabels = ui.WithPrefix("settings.acquisition.pathTest.")
        .Concat(ui.WithPrefix("storage.problem."))
        .ToDictionary(pair => pair.Key, pair => pair.Value);
}

@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storage-paths.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <h1>@ui["settings.acquisition.heading"]</h1>
        <p>@ui["settings.acquisition.pageDescription"]</p>
    </div>
    <a class="button" asp-page="/Acquisition/Index">@ui["settings.acquisition.animeAcquisitionLink"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="admset-notice" role="alert">@Model.Error</p>
}

<div class="settings-grid acquisition-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.importModeHeading"]</h2></div>
        <p class="muted">
            @ui["settings.acquisition.importModeDescription"]
        </p>
        <form method="post" asp-page-handler="ImportMode" class="form-stack">
            <label>
                <span>@ui["settings.acquisition.defaultImportModeLabel"]</span>
                <select class="admset-control" name="defaultImportMode">
                            @foreach (var mode in Enum.GetValues<ImportMode>())
                    {
                        <option value="@mode" selected="@(Model.ImportSettings.DefaultImportMode == mode)">@Model.ImportModeLabel(mode)</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">@ui["settings.acquisition.saveDefault"]</button>
        </form>

        @if (Model.Roots.Count > 0)
        {
            <div class="admset-table-wrap"><table class="admset-table">
                <thead><tr><th>@ui["settings.acquisition.libraryRootColumn"]</th><th>@ui["admin.storage.destinations.column.placement"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var root in Model.Roots)
                    {
                        <tr>
                            <td>@root.Name</td>
                            <td>@Model.ImportPolicyLabel(root.PlacementPolicy)</td>
                            <td class="admset-cell-actions"><a class="admin-tag admin-tag-accent" asp-page="/Admin/Storage/Index" asp-fragment="destinations">@ui["settings.acquisition.placementInStorage"]</a></td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>

    <section class="panel" id="media-folders">
        <div class="panel-heading"><h2>@ui["settings.acquisition.mediaFoldersHeading"]</h2></div>
        <p class="muted">@ui["settings.acquisition.mediaFoldersDescription"]</p>
        @foreach (var kind in Model.MediaFolderKinds)
        {
            var folders = Model.FoldersFor(kind);
            var slug = Jularr.Web.Pages.Settings.AcquisitionModel.FolderName(kind);
            var inboxField = new PathFieldModel($"{slug}-inbox", "inboxRoot", ui["settings.acquisition.inboxFolderLabel"], folders.InboxRoot, ui)
            {
                Placeholder = $"/data/downloads/complete/{slug}",
                Disabled = !Model.CanManageStorage
            };
            <div class="acquisition-folder">
            <h3>@Model.MediaLabel(kind)</h3>
            <form method="post" asp-page-handler="MediaFolders" class="form-stack">
                <input type="hidden" name="kind" value="@kind" />
                @if (Model.Destinations.TryGetValue(kind, out var destination))
                {
                    <div class="acquisition-destination">
                        <span class="admset-label">@ui["settings.acquisition.destinationLabel"]</span>
                        <span class="admset-name">
                            <strong>@destination.Name</strong>
                            @if (Model.CanManageStorage)
                            {
                                <code>@destination.Path</code>
                            }
                        </span>
                        <span class="admin-tag">@Model.ImportPolicyLabel(destination.PlacementPolicy)</span>
                    </div>
                }
                else
                {
                    <p class="admset-hint">@ui["settings.acquisition.destinationMissing"]</p>
                }

                <a class="text-link" asp-page="/Admin/Storage/Index" asp-fragment="destinations">@ui["settings.acquisition.destinationChange"]</a>
                <partial name="_PathField" model="inboxField" />
                <div class="inline-actions">
                    @if (Model.CanManageStorage)
                    {
                        <button class="button" type="submit">@ui["common.save"]</button>
                    }
                    @if (!string.IsNullOrWhiteSpace(folders.InboxRoot))
                    {
                        <button class="button" type="submit" asp-page-handler="ScanInbox">@ui["settings.acquisition.scanInbox"]</button>
                    }
                </div>
            </form>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.playbackOptimizationHeading"]</h2></div>
        <p class="muted">@ui["settings.acquisition.playbackOptimizationDescription"]</p>
        <form method="post" asp-page-handler="PlaybackOptimization" class="form-stack">
            <label>
                <span>@ui["settings.acquisition.playbackOptimizationLabel"]</span>
                <select class="admset-control" name="playbackOptimization">
                    @foreach (var mode in Enum.GetValues<LosslessPlaybackOptimizationMode>())
                    {
                        <option value="@mode" selected="@(Model.ImportSettings.PlaybackOptimization == mode)">@Model.PlaybackOptimizationLabel(mode)</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">@ui["common.save"]</button>
        </form>
    </section>

    <section class="panel path-mapping-panel">
        <div class="panel-heading"><h2>@ui["settings.acquisition.remotePathMappingHeading"]</h2></div>
        <p class="muted">
            @ui["settings.acquisition.remotePathMappingDescription"]
        </p>
        @if (Model.ImportSettings.RemotePathMappingCount > 0)
        {
            <table class="path-mapping-table">
                <thead><tr><th>@ui["admin.requests.column.media"]</th><th>@ui["settings.acquisition.remotePrefixColumn"]</th><th>@ui["settings.acquisition.localPrefixColumn"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var kind in Model.PathMappingKinds)
                    {
                        foreach (var mapping in Model.ImportSettings.RemotePathMappingsFor(kind))
                        {
                            <tr>
                                <td data-label="@ui["admin.requests.column.media"]">@Model.KindLabel(kind)</td>
                                <td data-label="@ui["settings.acquisition.remotePrefixColumn"]">@mapping.RemotePrefix</td>
                                <td data-label="@ui["settings.acquisition.localPrefixColumn"]">@mapping.LocalPrefix</td>
                                <td>
                                    <form method="post" asp-page-handler="RemovePathMapping">
                                        <input type="hidden" name="kind" value="@kind" />
                                        <input type="hidden" name="remotePrefix" value="@mapping.RemotePrefix" />
                                        <button class="button" type="submit">@ui["settings.acquisition.remove"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        <form method="post" asp-page-handler="AddPathMapping" id="path-mapping-form" class="path-mapping-form">
            <label class="path-mapping-kind">
                <span>@ui["admin.operation.mediaType"]</span>
                <select name="kind">
                    @foreach (var kind in Model.PathMappingKinds)
                    {
                        <option value="@kind">@Model.KindLabel(kind)</option>
                    }
                </select>
            </label>
            <div class="path-mapping-pair">
                <partial name="_PathField" model="remoteField" />
                <span class="path-mapping-arrow" aria-hidden="true">→</span>
                <partial name="_PathField" model="localField" />
            </div>
            <button class="button" type="submit">@ui["settings.acquisition.addMapping"]</button>
        </form>
        <div class="path-test" data-path-test data-form="path-mapping-form" data-endpoint="@Url.Page(null, "PreviewPathMapping")">
            <script type="application/json" data-path-test-config>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { labels = pathTestLabels }))</script>
            <label for="path-test-sample"><span>@ui["settings.acquisition.pathTestLabel"]</span></label>
            <div class="path-field-row">
                <input id="path-test-sample" type="text" data-path-test-sample placeholder="/data/downloads/complete/test.mkv" autocomplete="off" spellcheck="false" />
                <button type="button" class="button" data-path-test-run>@ui["settings.acquisition.pathTestButton"]</button>
            </div>
            <dl class="path-test-result" data-path-test-result aria-live="polite" hidden></dl>
            <p class="muted" data-path-test-note hidden></p>
        </div>
    </section>

    @if (Model.ShowAnimeAutoMonitor)
    {
        <section class="panel">
            <div class="panel-heading"><h2>@ui["settings.acquisition.autoMonitorHeading"]</h2></div>
            <p class="muted">@ui["settings.acquisition.autoMonitorDescription"]</p>
            <form method="post" asp-page-handler="AniListAutoMonitor" class="acquisition-inline-form">
                <label class="acquisition-check">
                    <input type="checkbox" name="enabled" value="true" checked="@Model.AniListAutoMonitorEnabled" />
                    <span>@ui["settings.acquisition.autoMonitorCheckbox"]</span>
                </label>
                <button class="button" type="submit">@ui["common.save"]</button>
            </form>
        </section>
    }

    @if (Model.CanManageStorage)
    {
        <section class="panel">
            <div class="panel-heading"><h2>@ui["settings.acquisition.backupHeading"]</h2></div>
            <p class="muted">
                @ui["settings.acquisition.backupDescription"]
            </p>
            <form method="post" asp-page-handler="ExportBackup">
                <button class="button" type="submit">@ui["settings.acquisition.exportBackup"]</button>
            </form>

            <form method="post" asp-page-handler="PreviewRestore" enctype="multipart/form-data" class="acquisition-inline-form">
                <label><span>@ui["settings.acquisition.backupFileLabel"]</span><input type="file" name="backupFile" accept="application/json" required /></label>
                <button class="button" type="submit">@ui["settings.acquisition.previewRestore"]</button>
            </form>

            @if (Model.RestorePreview is { } preview)
            {
                <table>
                    <thead><tr><th>@ui["settings.acquisition.fileColumn"]</th><th>@ui["settings.acquisition.existsNowColumn"]</th><th>@ui["settings.acquisition.secretColumn"]</th><th>@ui["settings.acquisition.validJsonColumn"]</th><th>@ui["settings.acquisition.wouldChangeColumn"]</th></tr></thead>
                    <tbody>
                        @foreach (var file in preview.Files)
                        {
                            <tr>
                                <td>@file.FileName</td>
                                <td>@(file.ExistedBefore ? ui["settings.acquisition.yes"] : ui["settings.acquisition.noNew"])</td>
                                <td>@(file.ContainsEncryptedSecret ? ui["settings.acquisition.yes"] : "")</td>
                                <td>@(file.IsValidJson ? ui["settings.acquisition.yes"] : ui["settings.acquisition.invalid"])</td>
                                <td>@(file.WouldChange ? ui["settings.acquisition.yes"] : ui["settings.acquisition.no"])</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (preview.Errors.Count > 0)
                {
                    <ul>
                        @foreach (var error in preview.Errors)
                        {
                            <li class="metadata-error">@error</li>
                        }
                    </ul>
                }
                @if (preview.CanRestore)
                {
                    <form method="post" asp-page-handler="ApplyRestore">
                        <input type="hidden" name="pendingRestoreJson" value="@Model.PendingRestoreJson" />
                        <button class="button button-primary" type="submit">@ui["settings.acquisition.applyRestore"]</button>
                    </form>
                }
            }
        </section>
    }
</div>

@if (Model.CanManageStorage)
{
    <partial name="_FolderBrowser" model="ui" />
}

@section Scripts {
    @if (Model.CanManageStorage)
    {
        <script src="~/js/folder-browser.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/path-mapping-test.js" asp-append-version="true" defer></script>
}
