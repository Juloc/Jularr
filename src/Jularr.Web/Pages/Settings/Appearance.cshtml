@page
@using Jularr.Web.Features.Appearance
@model Jularr.Web.Pages.Settings.AppearanceModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.appearance.title"];
    ViewData["NeedsSakura"] = true;
    var mode = Model.Appearance.ThemeMode;
    var accent = Model.EffectiveAccent;
    var isCustom = Model.Presets.All(preset => preset.Seed != accent);
}
@section Head {
    <link rel="stylesheet" href="~/css/appearance-settings.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">← @ui["settings.title"]</a>
        <h1>@ui["settings.appearance.title"]</h1>
        <p>@ui["settings.appearance.description"]</p>
    </div>
</header>

<div class="appearance-layout"
     data-appearance-settings
     data-preview-url="@Url.Page("/Appearance/Accent", "Preview")"
     data-default-seed="@AppAccent.DefaultSeed"
     data-text-saving="@ui["settings.appearance.saving"]"
     data-text-saved="@ui["settings.appearance.saved"]"
     data-text-failed="@ui["settings.appearance.saveFailed"]"
     data-text-invalid="@ui["settings.appearance.invalidHex"]">

    <div class="appearance-controls">
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.appearance.catalogHeading"]</h2>
            </div>
            @if (Model.InstanceAppearance.AllowProfileThemeOverride)
            {
                <p class="muted appearance-help">@ui["settings.appearance.catalogHelp"]</p>
                <form method="post" asp-page="/Appearance/Theme" asp-page-handler="Select" class="form-stack">
                    <div class="theme-choice-grid" role="radiogroup" aria-label="@ui["settings.appearance.catalogHeading"]">
                        <label class="theme-choice @(string.IsNullOrEmpty(Model.SelectedThemeId) ? "selected" : "")">
                            <input type="radio" name="themeId" value="" checked="@string.IsNullOrEmpty(Model.SelectedThemeId)" />
                            <img src="@Model.Themes.Single(theme => theme.Id == Model.InstanceAppearance.DefaultThemeId).LogoPath" alt="" width="40" height="40" />
                            <span>
                                <strong>@ui["settings.appearance.followInstance"]</strong>
                                <small>@ui.Format("settings.appearance.followInstanceHelp", ("theme", ui[Model.Themes.Single(theme => theme.Id == Model.InstanceAppearance.DefaultThemeId).NameKey]))</small>
                            </span>
                        </label>
                        @foreach (var theme in Model.Themes)
                        {
                            <label class="theme-choice @(theme.Id == Model.SelectedThemeId ? "selected" : "")">
                                <input type="radio" name="themeId" value="@theme.Id" checked="@(theme.Id == Model.SelectedThemeId)" />
                                <img src="@theme.LogoPath" alt="" width="40" height="40" />
                                <span>
                                    <strong>@ui[theme.NameKey]</strong>
                                    <small>@ui[theme.DescriptionKey]</small>
                                </span>
                            </label>
                        }
                    </div>
                    <div class="inline-actions"><button type="submit" class="button">@ui["settings.appearance.applyTheme"]</button></div>
                </form>
            }
            else
            {
                <p class="muted">@ui.Format("settings.appearance.instanceThemeLocked", ("theme", ui[Model.Themes.Single(theme => theme.Id == Model.InstanceAppearance.DefaultThemeId).NameKey]))</p>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.appearance.modeHeading"]</h2>
            </div>
            <form method="post" asp-page="/Appearance/Theme" class="appearance-mode" data-appearance-mode-form>
                @foreach (var option in new[] { AppTheme.System, AppTheme.Light, AppTheme.Dark })
                {
                    <label class="appearance-mode-option">
                        <input type="radio" name="theme" value="@option" checked="@(option == mode)" data-appearance-mode />
                        <span class="appearance-mode-swatch appearance-mode-swatch-@option" aria-hidden="true"><i></i><i></i></span>
                        <span>@ui["theme." + option]</span>
                    </label>
                }
            </form>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.appearance.accentHeading"]</h2>
                <span class="appearance-status" role="status" aria-live="polite" data-appearance-status></span>
            </div>
            <p class="muted appearance-help">@ui["settings.appearance.accentHelp"]</p>

            <form method="post" asp-page="/Appearance/Accent" data-appearance-accent-form>
                <input type="hidden" name="accent" value="@Model.Appearance.AccentColor" data-appearance-accent-value />

                <div class="accent-swatches" role="radiogroup" aria-label="@ui["settings.appearance.accentHeading"]">
                    @foreach (var preset in Model.Presets)
                    {
                        var selected = preset.Seed == accent;
                        <button type="button"
                                class="accent-swatch @(selected ? "selected" : "")"
                                role="radio"
                                aria-checked="@(selected ? "true" : "false")"
                                data-accent-preset="@preset.Seed"
                                style="--swatch: @preset.Seed">
                            <span class="accent-swatch-dot" aria-hidden="true"></span>
                            <span class="accent-swatch-label">@ui["settings.appearance.preset." + preset.Key]</span>
                        </button>
                    }
                </div>

                <div class="accent-custom @(isCustom ? "selected" : "")" data-accent-custom>
                    <label class="accent-picker">
                        <input type="color" value="@accent" data-accent-picker aria-label="@ui["settings.appearance.customLabel"]" />
                        <span>@ui["settings.appearance.customLabel"]</span>
                    </label>
                    <label class="accent-hex">
                        <span>@ui["settings.appearance.hexLabel"]</span>
                        <input type="text" value="@accent" maxlength="7" spellcheck="false" autocomplete="off"
                               pattern="#?[0-9a-fA-F]{6}" data-accent-hex />
                    </label>
                    <button type="button" class="button" data-accent-reset>@ui["settings.appearance.reset"]</button>
                </div>
                <p class="appearance-note muted" data-accent-mono-note hidden>@ui["settings.appearance.monochromeNote"]</p>
            </form>
        </section>

        @if (Model.CanUseAdmin)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>@ui["settings.appearance.adminShortcutHeading"]</h2>
                </div>
                <form method="post" asp-page-handler="AdminShortcut" class="appearance-mode">
                    <label class="appearance-mode-option">
                        <input type="checkbox" name="show" value="true" checked="@Model.Appearance.ShowAdminShortcut" onchange="this.form.submit()" />
                        <span>@ui["settings.appearance.adminShortcutLabel"]</span>
                    </label>
                    <input type="hidden" name="show" value="false" />
                    <p class="muted">@ui["settings.appearance.adminShortcutHelp"]</p>
                </form>
            </section>
        }

        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.appearance.sakuraHeading"]</h2>
            </div>
            <form method="post" asp-page="/Appearance/Sakura" class="appearance-mode" data-appearance-sakura-form>
                @foreach (var option in new[] { AppSakura.Off, AppSakura.Subtle, AppSakura.Full })
                {
                    <label class="appearance-mode-option">
                        <input type="radio" name="sakura" value="@option" checked="@(option == Model.Appearance.SakuraMode)" data-appearance-sakura />
                        <span>@ui["settings.appearance.sakura." + option]</span>
                    </label>
                }
            </form>
        </section>
    </div>

    <section class="panel appearance-preview" aria-labelledby="appearance-preview-heading">
        <div class="panel-heading">
            <h2 id="appearance-preview-heading">@ui["settings.appearance.previewHeading"]</h2>
        </div>

        <div class="preview-shell" aria-hidden="true">
            <div class="preview-sidebar">
                <div class="preview-brand"><partial name="_AppBrandMark" /></div>
                <span class="preview-nav active"><i></i>@ui["nav.home"]</span>
                <span class="preview-nav"><i></i>@ui["nav.library"]</span>
                <span class="preview-nav"><i></i>@ui["nav.settings"]</span>
            </div>
            <div class="preview-main">
                <div class="preview-banner art-tint ink-night"></div>
                <div class="preview-chips">
                    <span class="chip selected">@ui["settings.appearance.preview.all"]</span>
                    <span class="chip">@ui["settings.appearance.preview.anime"]</span>
                    <span class="chip">@ui["settings.appearance.preview.manga"]</span>
                </div>
                <div class="preview-card">
                    <div class="preview-poster art-tint"><span class="media-badge">@ui["settings.appearance.preview.badge"]</span></div>
                    <div class="preview-card-copy">
                        <strong>@ui["settings.appearance.preview.cardTitle"]</strong>
                        <span class="muted">@ui["settings.appearance.preview.cardMeta"]</span>
                        <div class="progress-track"><span style="width: 62%"></span></div>
                        <span class="preview-link">@ui["settings.appearance.preview.link"]</span>
                    </div>
                </div>
                <div class="inline-actions">
                    <span class="button button-primary">@ui["settings.appearance.preview.primary"]</span>
                    <span class="button">@ui["settings.appearance.preview.secondary"]</span>
                    <span class="status-pill status-ok">@ui["settings.appearance.preview.statusOk"]</span>
                </div>
            </div>
        </div>

        <h3 class="appearance-subheading">@ui["settings.appearance.contrastHeading"]</h3>
        <dl class="contrast-list">
            <div data-contrast-pair="--on-accent|--accent"><dt>@ui["settings.appearance.contrast.buttonText"]</dt><dd data-contrast-value></dd></div>
            <div data-contrast-pair="--accent-text|--surface"><dt>@ui["settings.appearance.contrast.accentText"]</dt><dd data-contrast-value></dd></div>
            <div data-contrast-pair="--muted|--surface"><dt>@ui["settings.appearance.contrast.mutedText"]</dt><dd data-contrast-value></dd></div>
            <div data-contrast-pair="--text|--bg"><dt>@ui["settings.appearance.contrast.bodyText"]</dt><dd data-contrast-value></dd></div>
        </dl>

        <h3 class="appearance-subheading">@ui["settings.appearance.paletteHeading"]</h3>
        <div class="palette-strip" aria-hidden="true">
            @foreach (var token in new[] { "--accent-soft", "--accent-border", "--accent", "--accent-hover", "--accent-text", "--bg", "--surface-2", "--border", "--muted", "--text" })
            {
                <span style="background: var(@token)" title="@token"></span>
            }
        </div>
        <div class="palette-strip palette-strip-data" aria-hidden="true">
            @for (var index = 1; index <= 6; index++)
            {
                <span style="background: var(--data-@index)" title="--data-@index"></span>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/appearance-settings.js" asp-append-version="true" defer></script>
}
