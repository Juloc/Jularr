@page
@using Jularr.Web.Features.Acquisition.Ownership
@model Jularr.Web.Pages.Settings.SonarrMigrationModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.sonarrMigration.title"];
    var statusClass = Model.Sonarr.Status switch
    {
        SonarrObservationStatus.Observed => "status-pill status-ok",
        SonarrObservationStatus.Unavailable => "status-pill status-error",
        _ => "status-pill"
    };
    var statusText = Model.Sonarr.Status switch
    {
        SonarrObservationStatus.Observed => ui.Format("settings.sonarrMigration.status.observed", ("time", Model.Sonarr.ObservedAtUtc?.ToString("u"))),
        SonarrObservationStatus.Unavailable => ui["settings.sonarrMigration.status.unavailable"],
        _ => ui["settings.sonarrMigration.status.notConfigured"]
    };
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Settings">@ui["common.backToSettings"]</a>
        <h1>@ui["settings.sonarrMigration.title"]</h1>
        <p>
            @ui["settings.sonarrMigration.pageDescription1"]
            @ui["settings.sonarrMigration.pageDescription2"]
        </p>
    </div>
    <span class="@statusClass">@statusText</span>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="metadata-error" style="color:inherit">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error">@Model.Error</p>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.sonarrMigration.observationHeading"]</h2>
            <span>@ui.Format("settings.sonarrMigration.seriesQueueSummary", ("series", Model.Sonarr.Series.Count), ("queued", Model.Sonarr.Queue.Count))</span>
        </div>
        @if (Model.Sonarr.Status == SonarrObservationStatus.NotConfigured)
        {
            <p class="muted">
                @ui["settings.sonarrMigration.observation.notConfiguredBody"]
                <a href="/Admin/Sonarr">@ui["settings.sonarrMigration.observation.openAdminSonarr"]</a>
            </p>
        }
        else if (Model.Sonarr.Status == SonarrObservationStatus.Unavailable)
        {
            <p class="metadata-error">
                @Model.Sonarr.StatusDetail
                @ui["settings.sonarrMigration.observation.unavailableSuffix"]
            </p>
        }
        else
        {
            <p class="muted">
                @ui["settings.sonarrMigration.observation.observedBody"]
            </p>
        }
        <div class="inline-actions">
            <a class="button" href="?refresh=true@(string.IsNullOrWhiteSpace(Model.Q) ? "" : "&q=" + Uri.EscapeDataString(Model.Q))">@ui["settings.sonarrMigration.refresh"]</a>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.sonarrMigration.conflictsHeading"]</h2>
            <span class="@(Model.Conflicts.Count == 0 ? "status-pill status-ok" : "status-pill status-warning")">@Model.Conflicts.Count</span>
        </div>
        @if (Model.Conflicts.Count == 0)
        {
            <p class="muted">@ui["settings.sonarrMigration.conflicts.none"]</p>
        }
        else
        {
            <ul>
                @foreach (var conflict in Model.Conflicts)
                {
                    <li><strong>@conflict.AnimeKey</strong> (@conflict.Kind, @conflict.Value): @conflict.Reason</li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.sonarrMigration.safeRolloutHeading"]</h2>
            <span>@ui["settings.sonarrMigration.titleByTitle"]</span>
        </div>
        <ol class="muted">
            <li><strong>@ui["settings.sonarrMigration.rollout.keepSonarr.term"]</strong> @ui["settings.sonarrMigration.rollout.keepSonarr.description"]</li>
            <li><strong>@ui["settings.sonarrMigration.rollout.parallel.term"]</strong> @ui["settings.sonarrMigration.rollout.parallel.description"]</li>
            <li><strong>@ui["settings.sonarrMigration.rollout.handOver.term"]</strong> @ui["settings.sonarrMigration.rollout.handOver.description"]</li>
            <li><strong>@ui["settings.sonarrMigration.rollout.revert.term"]</strong> @ui["settings.sonarrMigration.rollout.revert.description"]</li>
        </ol>
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["settings.sonarrMigration.animeHeading"]</h2>
        <form method="get" class="inline-actions">
            <input name="q" value="@Model.Q" placeholder="@ui["settings.sonarrMigration.filterPlaceholder"]" />
            <button class="button" type="submit">@ui["settings.sonarrMigration.filter"]</button>
        </form>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <p class="muted">@ui["settings.sonarrMigration.noAnimeFound"]</p>
    }

    @foreach (var row in Model.Rows)
    {
        <article class="panel">
            <div class="panel-heading">
                <div>
                    <h3>@row.Title</h3>
                    <span class="muted">@row.AnimeKey</span>
                </div>
                <span class="@(row.Mode == AnimeManagementMode.JularrManaged ? "status-pill status-ok" : row.Mode == AnimeManagementMode.ParallelAcquisition ? "status-pill status-warning" : "status-pill")">
                    @(row.HasExplicitDecision ? Model.DescribeMode(row.Mode) : ui.Format("settings.sonarrMigration.modeWithDefault", ("mode", Model.DescribeMode(row.Mode))))
                </span>
            </div>

            <p class="muted">
                @if (row.SeriesId is null)
                {
                    <span>@ui["settings.sonarrMigration.notFoundInSonarr"]</span>
                }
                else
                {
                    <span>
                        @ui["settings.sonarrMigration.seriesLabel"] <strong>@(row.SeriesTitle ?? $"#{row.SeriesId}")</strong>@(row.SeriesSuggested ? " " + ui["settings.sonarrMigration.suggestedMatch"] : "")
                        &middot; @(row.Series is null ? ui["settings.sonarrMigration.notObserved"] : row.Series.Monitored ? ui["settings.sonarrMigration.monitoredInSonarr"] : ui["settings.sonarrMigration.unmonitoredInSonarr"])
                        &middot; @ui.Format("settings.sonarrMigration.activeDownloads", ("count", row.ActiveSonarrDownloads))
                        @if (row.SonarrUnmonitoredByJularr)
                        {
                            <span>&middot; @ui["settings.sonarrMigration.unmonitoredByJularr"]</span>
                        }
                    </span>
                }
            </p>

            @foreach (var conflict in row.Conflicts)
            {
                <p class="metadata-error">@conflict.Reason</p>
            }

            <form method="post" asp-page-handler="Apply" asp-route-q="@Model.Q" class="inline-actions">
                <input type="hidden" name="animeKey" value="@row.AnimeKey" />
                <input type="hidden" name="sonarrSeriesId" value="@row.SeriesId" />
                @if (row.SeriesId is not null)
                {
                    <label class="checkbox-row">
                        <input type="checkbox" name="applySonarrMonitoring" value="true" />
                        <span>@ui["settings.sonarrMigration.alsoUpdateMonitoring"]</span>
                    </label>
                }
                <button class="button" type="submit" name="migrationAction" value="@AnimeMigrationAction.KeepSonarr">@ui["settings.sonarrMigration.rollout.keepSonarr.term"]</button>
                <button class="button" type="submit" name="migrationAction" value="@AnimeMigrationAction.StartParallel">@ui["settings.sonarrMigration.rollout.parallel.term"]</button>
                <button class="button button-primary" type="submit" name="migrationAction" value="@AnimeMigrationAction.HandOverToJularr">@ui["settings.sonarrMigration.handOverToJularrButton"]</button>
                <button class="button" type="submit" name="migrationAction" value="@AnimeMigrationAction.Revert">@ui["settings.sonarrMigration.rollout.revert.term"]</button>
            </form>
        </article>
    }
</section>

@if (Model.RecentEvents.Count > 0)
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.sonarrMigration.migrationLogHeading"]</h2>
            <span>@ui.Format("settings.sonarrMigration.latestCount", ("count", Model.RecentEvents.Count))</span>
        </div>
        <ul>
            @foreach (var entry in Model.RecentEvents)
            {
                <li>@entry.AtUtc.ToString("u") &middot; <strong>@entry.AnimeKey</strong> &middot; @entry.Action: @entry.Detail</li>
            }
        </ul>
    </section>
}
