@page "/Search"
@model Jularr.Web.Pages.Search.IndexModel
@using Jularr.Web.Features.Search
@{
    var ui = Model.Ui;
    var results = Model.Results;
    ViewData["Title"] = ui["search.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<div class="search-page">
    <header class="search-header">
        <h1>@ui["search.title"]</h1>
    </header>

    <form class="search-form" method="get" action="/Search" role="search">
        <div class="search-field">
            <partial name="_AppIcon" model='"search"' />
            <input type="search" name="q" value="@Model.Query" autocomplete="off" spellcheck="false"
                   enterkeyhint="search" aria-label="@ui["nav.search"]" placeholder="@ui["search.placeholder"]" />
            <button class="button button-primary" type="submit">@ui["common.search"]</button>
        </div>

        <fieldset class="search-types">
            <legend class="search-sr-only">@ui["search.typesAria"]</legend>
            @foreach (var type in Model.VisibleTypes)
            {
                <label class="search-type">
                    <input type="checkbox" name="type" value="@MediaSearchTypes.ToStorage(type)"
                           checked="@Model.SelectedTypes.Contains(type)" />
                    <span>@Model.TypeLabel(type)</span>
                </label>
            }
        </fieldset>

        <details class="search-filters" open="@Model.HasFilters">
            <summary>@ui["search.filters.toggle"]</summary>
            <div class="search-filter-grid">
                <label class="search-filter">
                    <span>@ui["search.filter.availability"]</span>
                    <select name="availability">
                        <option value="">@ui["search.option.any"]</option>
                        <option value="@IndexModel.AvailableOption" selected="@(Model.Availability == IndexModel.AvailableOption)">@ui["library.mediaCard.availability.available"]</option>
                        <option value="@IndexModel.LibraryOption" selected="@(Model.Availability == IndexModel.LibraryOption)">@ui["library.mediaCard.availability.local"]</option>
                    </select>
                </label>

                <label class="search-filter">
                    <span>@ui["search.filter.monitoring"]</span>
                    <select name="monitoring">
                        <option value="">@ui["search.option.any"]</option>
                        <option value="@IndexModel.YesOption" selected="@(Model.Monitoring == IndexModel.YesOption)">@ui["search.option.monitored"]</option>
                        <option value="@IndexModel.NoOption" selected="@(Model.Monitoring == IndexModel.NoOption)">@ui["search.option.notMonitored"]</option>
                    </select>
                </label>

                <label class="search-filter">
                    <span>@ui["search.filter.wanted"]</span>
                    <select name="wanted">
                        <option value="">@ui["search.option.any"]</option>
                        <option value="@IndexModel.YesOption" selected="@(Model.Wanted == IndexModel.YesOption)">@ui["search.option.wanted"]</option>
                        <option value="@IndexModel.NoOption" selected="@(Model.Wanted == IndexModel.NoOption)">@ui["search.option.notWanted"]</option>
                    </select>
                </label>

                @* Language and genre only offer what the current results carry, so no option leads to nothing. *@
                @{
                    var languages = results.Facets.Languages.ToList();
                    if (Model.Language is { } chosenLanguage && !languages.Contains(chosenLanguage, StringComparer.Ordinal))
                    {
                        languages.Insert(0, chosenLanguage);
                    }
                }
                @if (languages.Count > 0)
                {
                    <label class="search-filter">
                        <span>@ui["search.filter.language"]</span>
                        <select name="language">
                            <option value="">@ui["search.option.any"]</option>
                            @foreach (var language in languages)
                            {
                                <option value="@language" selected="@string.Equals(Model.Language, language, StringComparison.Ordinal)">@IndexModel.LanguageLabel(language)</option>
                            }
                        </select>
                    </label>
                }

                @{
                    var genres = results.Facets.Genres.ToList();
                    if (Model.Genre is { } chosenGenre && !genres.Contains(chosenGenre, StringComparer.OrdinalIgnoreCase))
                    {
                        genres.Insert(0, chosenGenre);
                    }
                }
                @if (genres.Count > 0)
                {
                    <label class="search-filter">
                        <span>@ui["search.filter.genre"]</span>
                        <select name="genre">
                            <option value="">@ui["search.option.any"]</option>
                            @foreach (var genre in genres)
                            {
                                <option value="@genre" selected="@string.Equals(Model.Genre, genre, StringComparison.OrdinalIgnoreCase)">@genre</option>
                            }
                        </select>
                    </label>
                }

                <label class="search-filter">
                    <span>@ui["search.filter.yearFrom"]</span>
                    <input type="number" name="yearFrom" inputmode="numeric" min="1" max="9999"
                           value="@Model.YearFrom" placeholder="@results.Facets.MinYear" />
                </label>

                <label class="search-filter">
                    <span>@ui["search.filter.yearTo"]</span>
                    <input type="number" name="yearTo" inputmode="numeric" min="1" max="9999"
                           value="@Model.YearTo" placeholder="@results.Facets.MaxYear" />
                </label>
            </div>

            @if (Model.HasFilters)
            {
                <a class="text-link search-clear" href="@Model.ClearFiltersUrl">@ui["search.filters.clear"]</a>
            }
        </details>
    </form>

    @if (Model.Query.Length > 0)
    {
        @if (results.Items.Count == 0)
        {
            <section class="search-empty">
                <strong>@ui["search.empty.title"]</strong>
                <span>@ui["search.empty.body"]</span>
            </section>
        }
        else
        {
            <p class="search-count" role="status">@ui.Format("search.results.count", ("count", results.Total))</p>

            <ol class="search-results">
                @foreach (var item in results.Items)
                {
                    var href = MediaSearchTargets.Href(item);
                    <li class="search-result">
                        <div class="search-result-copy">
                            @if (href is not null)
                            {
                                <a class="search-result-title" href="@href">@item.Title</a>
                            }
                            else
                            {
                                <span class="search-result-title">@item.Title</span>
                            }
                            <p class="search-result-meta">
                                @if (item.Kind == MediaSearchResultKind.Franchise)
                                {
                                    <span>@ui["search.result.franchise"]</span>
                                    <span>@ui.Format("search.result.works", ("count", item.MemberCount))</span>
                                }
                                else
                                {
                                    foreach (var type in item.Types)
                                    {
                                        <span>@Model.TypeLabel(type)</span>
                                    }

                                    if (item.Facts.Year is { } year)
                                    {
                                        <span>@year</span>
                                    }
                                }
                            </p>
                        </div>

                        @if (item.Kind == MediaSearchResultKind.Work)
                        {
                            <ul class="search-badges">
                                <li class="search-badge @(item.Facts.HasLocalContent ? "search-badge-available" : "search-badge-library")">
                                    <span class="search-badge-dot" aria-hidden="true"></span>
                                    @ui[item.Facts.HasLocalContent ? "library.mediaCard.availability.available" : "library.mediaCard.availability.local"]
                                </li>
                                @if (item.Facts.Wanted)
                                {
                                    <li class="search-badge search-badge-wanted">
                                        <span class="search-badge-dot" aria-hidden="true"></span>
                                        @ui["search.badge.wanted"]
                                    </li>
                                }
                                @if (item.Facts.Monitored)
                                {
                                    <li class="search-badge search-badge-monitored">
                                        <span class="search-badge-dot" aria-hidden="true"></span>
                                        @ui["search.badge.monitored"]
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ol>

            @if (Model.CurrentPage > 1 || results.HasMore)
            {
                <nav class="search-pager" aria-label="@ui["search.pager.aria"]">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="button" rel="prev" href="@Model.PageUrl(Model.CurrentPage - 1)">@ui["search.pager.previous"]</a>
                    }
                    @if (results.HasMore)
                    {
                        <a class="button" rel="next" href="@Model.PageUrl(Model.CurrentPage + 1)">@ui["search.pager.next"]</a>
                    }
                </nav>
            }
        }

        <p class="search-providers">
            <a class="text-link" href="/?q=@Uri.EscapeDataString(Model.Query)">@ui["search.providers"]</a>
        </p>
    }
</div>
