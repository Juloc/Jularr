@page "/Discover"
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Discovery
@using Jularr.Web.Ui
@model Jularr.Web.Pages.Discover.IndexModel
@* Layout and hierarchy follow docs/mockups/discover (binding): the search field with the compact Filters
   control, the media-type switch and the rows below it. The address is the only state; the titles are
   fetched from the Body handler after first paint so this GET stays local (#186). *@
@{
    var ui = Model.Ui;
    var query = Model.Query;
    var active = query.ActiveFilterCount;
    ViewData["Title"] = ui["discover.index.title"];

    var thisYear = DateTime.UtcNow.Year;
    var years = Enumerable.Range(thisYear - 24, 25).Reverse().ToList();
    if (query.Year is { } selectedYear && !years.Contains(selectedYear))
    {
        years.Add(selectedYear);
    }

    var browseModes = new List<(DiscoveryMode Mode, string LabelKey)>
    {
        (DiscoveryMode.Trending, "discover.tabs.trending"),
        (DiscoveryMode.Top, "discover.tabs.top")
    };
    if (query.Category is DiscoveryCategory.Book or DiscoveryCategory.Movie or DiscoveryCategory.Series)
    {
        browseModes.Add((DiscoveryMode.New, "discover.tabs.new"));
    }

    if (query.Category is DiscoveryCategory.Movie or DiscoveryCategory.Series)
    {
        browseModes.Add((DiscoveryMode.Upcoming, "discover.tabs.upcoming"));
    }
    else
    {
        browseModes.Add((DiscoveryMode.MyList, "discover.tabs.myAniList"));
    }

    var availabilities = new[]
    {
        (DiscoverAvailabilityFilter.InLibrary, "discover.filter.availabilityLibrary"),
        (DiscoverAvailabilityFilter.Requested, "discover.filter.availabilityRequested"),
        (DiscoverAvailabilityFilter.NotInLibrary, "discover.filter.availabilityNew")
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/discover-browse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discover-request.css" asp-append-version="true" />
}

<div class="dc-page" data-discover @DiscoverFeedMarkup.Attributes(Url, ui, Model.IsOwner)>
    @* The title and the search field are gone on purpose: the header search is the one search of the app and submits to this page. *@
    <form class="dc-searchbar" method="get" action="@DiscoverBrowseQuery.BasePath" data-dc-form>
        @if (query.Category != DiscoveryCategory.All)
        {
            <input type="hidden" name="category" value="@DiscoverBrowseQuery.CategoryName(query.Category)" />
        }

        @if (query.IsSearch)
        {
            <input type="hidden" name="q" value="@query.Text" />
        }

        <details class="dc-pop" data-dc-pop>
            <summary class="dc-btn@(active > 0 ? " is-active" : "")"
                     aria-label="@(active > 0 ? ui.Format("library.browse.filtersActiveAria", ("count", active)) : ui["library.browse.filters"])">
                <partial name="_DiscoverIcon" model='"filter"' />
                <span class="dc-btn-label">@ui["library.browse.filters"]</span>
                @if (active > 0)
                {
                    <span class="dc-badge">@active</span>
                }
            </summary>
            <span class="dc-pop-backdrop" data-dc-close></span>
            <div class="dc-pop-panel" role="dialog" aria-label="@ui["library.browse.filters"]">
                <div class="dc-pop-head">
                    <h2>@ui["library.browse.filters"]</h2>
                    @if (active > 0)
                    {
                        <a class="dc-reset" href="@query.WithoutFilters().Href">@ui["library.browse.filter.reset"]</a>
                    }
                    <button type="button" class="dc-icon-btn" data-dc-close aria-label="@ui["library.browse.close"]">
                        <partial name="_DiscoverIcon" model='"close"' />
                    </button>
                </div>

                <div class="dc-groups">
                    <fieldset class="dc-group" data-dc-browse-group hidden="@query.IsSearch">
                        <legend>@ui["discover.filter.groupBrowse"]</legend>
                        @foreach (var (mode, labelKey) in browseModes)
                        {
                            <label class="dc-check">
                                <input type="radio" name="mode" value="@DiscoverBrowseQuery.ModeName(mode)" checked="@(query.Mode == mode)" />
                                <span>@ui[labelKey]</span>
                            </label>
                        }
                    </fieldset>

                    <fieldset class="dc-group">
                        <legend>@ui["library.browse.filter.groupMetadata"]</legend>
                        <label class="dc-select">
                            <span>@ui["discover.filter.genre"]</span>
                            <select name="genre">
                                <option value="">@ui["library.browse.filter.any"]</option>
                                @foreach (var genre in DiscoveryRequest.KnownGenres)
                                {
                                    <option value="@genre" selected="@(query.Genre == genre)">@ui[DiscoverGenres.Key(genre)!]</option>
                                }
                            </select>
                        </label>
                        <label class="dc-select">
                            <span>@ui["library.browse.filter.year"]</span>
                            <select name="year">
                                <option value="">@ui["library.browse.filter.any"]</option>
                                @foreach (var year in years)
                                {
                                    <option value="@year" selected="@(query.Year == year)">@year</option>
                                }
                            </select>
                        </label>
                        <label class="dc-select">
                            <span>@ui["library.browse.filter.status"]</span>
                            <select name="status">
                                <option value="">@ui["library.browse.filter.any"]</option>
                                @foreach (var status in Enum.GetValues<MediaReleaseStatus>())
                                {
                                    <option value="@DiscoverBrowseQuery.StatusName(status)" selected="@(query.Status == status)">@ui[MediaBannerCardModel.StatusKey(status)]</option>
                                }
                            </select>
                        </label>
                    </fieldset>

                    <fieldset class="dc-group">
                        <legend>@ui["library.browse.filter.groupAvailability"]</legend>
                        <label class="dc-select">
                            <span class="sr-only">@ui["library.browse.filter.groupAvailability"]</span>
                            <select name="avail">
                                <option value="">@ui["library.browse.filter.any"]</option>
                                @foreach (var (availability, labelKey) in availabilities)
                                {
                                    <option value="@DiscoverBrowseQuery.AvailabilityName(availability)" selected="@(query.Availability == availability)">@ui[labelKey]</option>
                                }
                            </select>
                        </label>
                        @if (Model.Preference.IsSet || query.PreferredLanguage)
                        {
                            <label class="dc-check">
                                <input type="checkbox" name="pref" value="1" checked="@query.PreferredLanguage" />
                                <span>@ui.Format("library.browse.filter.preferred", ("languages", string.Join(" · ", Model.Preference.Codes)))</span>
                            </label>
                        }
                    </fieldset>
                </div>

                <div class="dc-pop-foot">
                    <button type="submit" class="button button-primary">@ui["library.browse.filter.apply"]</button>
                </div>
            </div>
        </details>
    </form>

    <nav class="dc-tabs" aria-label="@ui["discover.categories.aria"]">
        @foreach (var (category, labelKey) in Model.VisibleTabs)
        {
            var selected = category == query.Category;
            <a class="dc-tab@(selected ? " is-active" : "")"
               href="@((query with { Category = category }).Href)"
               aria-current="@(selected ? "page" : null)"
               data-dc-tab>@ui[labelKey]</a>
        }
    </nav>

    <partial name="_DiscoverFeed" model="ui" />

    @if (Model.IsOwner)
    {
        <details class="dc-import" data-dc-import hidden>
            <summary>@ui["discover.import.toggle"]</summary>
            <form method="post"
                  asp-page-handler="ImportSource"
                  class="dc-import-form"
                  data-dc-import-form>
                <div>
                    <strong data-import-title>@ui["discover.import.sourceUrlHeading"]</strong>
                    <span>@ui["discover.import.sourceHint"]</span>
                </div>
                <input type="hidden" name="metadataProvider" data-import-provider />
                <input type="hidden" name="metadataExternalId" data-import-external-id />
                <label>
                    <span>@ui["discover.import.sourceUrlHeading"]</span>
                    <input type="url"
                           name="sourceUrl"
                           required
                           inputmode="url"
                           autocomplete="url"
                           data-import-url
                           placeholder="https://ncode.syosetu.com/…" />
                </label>
                <div class="dc-import-actions">
                    <button class="button button-primary" type="submit">@ui["discover.import.submit"]</button>
                    <button class="button" type="button" data-import-clear>@ui["discover.import.clearMatch"]</button>
                </div>
            </form>
        </details>
    }
</div>

@section Scripts {
    <script src="~/js/work-metadata.js" asp-append-version="true" defer></script>
    <script src="~/js/discover-staging.js" asp-append-version="true" defer></script>
    <script src="~/js/discover.js" asp-append-version="true" defer></script>
    <script src="~/js/discover-request.js" asp-append-version="true" defer></script>
}
