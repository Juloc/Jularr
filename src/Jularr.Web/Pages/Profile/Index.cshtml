@page "{section?}"
@model Jularr.Web.Pages.Profile.IndexModel
@{
    var ui = Model.Ui;
    var section = Model.Section;
    ViewData["Title"] = section is null ? ui["nav.profile"] : ui[section.LabelKey];
}
@section Head {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

@if (section is not null)
{
    <a class="back-link" href="/Profile">← @ui["nav.profile"]</a>
    <header class="page-header profile-header">
        <h1>@ui[section.LabelKey]</h1>
    </header>

    @foreach (var group in section.Groups!)
    {
        @* The Unfinished list is one group under its own page title, so it needs no second heading. *@
        <section class="profile-group" aria-labelledby="@(section.Groups!.Count > 1 ? "profile-group-" + group.TitleKey.Replace('.', '-') : null)">
            @if (section.Groups!.Count > 1)
            {
                <h2 class="profile-group-title" id="profile-group-@group.TitleKey.Replace('.', '-')">@ui[group.TitleKey]</h2>
            }
            <ul class="profile-list">
                @foreach (var item in group.Items)
                {
                    <partial name="_ProfileLink" model="(item, ui)" />
                }
            </ul>
        </section>
    }
}

@if (section is null)
{
    <header class="page-header profile-header">
        <h1>@ui["nav.profile"]</h1>
    </header>

    <nav aria-label="@ui["nav.profile"]">
        <ul class="profile-list">
            @foreach (var item in Model.Links)
            {
                <partial name="_ProfileLink" model="(item, ui)" />
            }
        </ul>
    </nav>

    @* The phone bottom bar has four tabs; the remaining destinations and the account footer live here. *@
    <div class="profile-phone-only">
        @if (Model.Elsewhere.Count > 0)
        {
            <nav aria-label="@ui["profile.moreAria"]">
                <ul class="profile-list">
                    @foreach (var item in Model.Elsewhere)
                    {
                        <partial name="_ProfileLink" model="(item, ui)" />
                    }
                </ul>
            </nav>
        }
        <div class="profile-shell-footer">
            <partial name="_AppAccountFooter" />
        </div>
    </div>
}
