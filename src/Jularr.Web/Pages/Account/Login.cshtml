@page
@model Jularr.Web.Pages.Account.LoginModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["account.login.title"];
}

<section class="auth-card">
    <div class="auth-brand">
        <partial name="_AppBrandMark" />
    </div>

    <span class="eyebrow">@ui["account.login.eyebrow"]</span>
    <h1>@ui["account.login.title"]</h1>
    <p>@ui["account.login.description"]</p>

    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input asp-for="ReturnUrl" type="hidden" />

        <label asp-for="UserName">
            @ui["account.field.userName"]
            <input asp-for="UserName" autocomplete="username" autofocus />
        </label>
        <span asp-validation-for="UserName" class="validation"></span>

        <label asp-for="Password">
            @ui["account.field.password"]
            <input asp-for="Password" type="password" autocomplete="current-password" />
        </label>
        <span asp-validation-for="Password" class="validation"></span>

        <label class="checkbox-row">
            <input asp-for="RememberMe" />
            <span>@ui["account.login.remember"]</span>
        </label>

        <button class="button button-primary" type="submit">@ui["account.login.submit"]</button>
    </form>

    @if (Model.PlexLoginEnabled)
    {
        <p>
            <a class="button button-secondary"
               asp-page="/Account/Plex"
               asp-route-ReturnUrl="@Model.ReturnUrl">
                @ui["account.plex.signIn"]
            </a>
        </p>
    }

    <p><a asp-page="/Account/Register">@ui["account.login.requestAccount"]</a></p>
</section>
