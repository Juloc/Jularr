@model Jularr.Web.Ui.LanguageEditionSelectorModel
@using Jularr.Web.Ui
@*
    Shared Language & Edition selector (docs/mockups/language-edition-selector/SPEC.md). Render with one line:
        <partial name="_LanguageEditionSelector" model="selectorModel" />
    Hosts render it only when selectorModel.IsMeaningful. Reader contract: build the model for the reader's work, render the
    partial, and listen on the dialog (id = Model.Id) for the cancelable "jularr:edition-selected" CustomEvent
    (detail: { selectorId, key, language, url }). Calling preventDefault() stops the default navigation to detail.url so the
    reader can switch in place and restore its locator itself. window.JularrLanguageEditionSelector.showError(id, text)
    shows a local switch failure inside the open dialog. The dialog is a native <dialog>: Escape closes it, focus returns to
    the trigger, and below 720px it is styled as a bottom sheet. The partial never navigates to Request or mutates state itself;
    row actions are plain antiforgery-protected POST forms supplied by the host.
*@
@{
    var ui = Model.Ui;
    var titleId = $"{Model.Id}-title";
    var chipCodes = Model.Editions.Where(x => x.State != EditionState.Unavailable).Select(x => x.LanguageCode).Append(Model.CurrentLanguageCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var statusLabels = new Dictionary<EditionState, string>
    {
        [EditionState.Current] = ui["languageEdition.state.current"],
        [EditionState.Available] = ui["languageEdition.state.available"],
        [EditionState.Partial] = ui["languageEdition.state.partial"],
        [EditionState.Unavailable] = ui["languageEdition.state.unavailable"]
    };
}
<link rel="stylesheet" href="~/css/language-edition-selector.css" asp-append-version="true" />
<script src="~/js/language-edition-selector.js" asp-append-version="true" defer></script>

<button type="button"
        class="button language-edition-trigger"
        data-language-edition-open="@Model.Id"
        aria-haspopup="dialog"
        aria-controls="@Model.Id">
    <partial name="_ReaderIcon" model="@("translate")" />
    <span>@ui["languageEdition.title"]</span>
    <strong>@Model.CurrentLanguage.Name</strong>
</button>

<dialog class="language-edition-dialog"
        id="@Model.Id"
        aria-labelledby="@titleId"
        data-language-edition-dialog>
    <div class="language-edition-header">
        <div>
            <h2 id="@titleId">@ui["languageEdition.title"]</h2>
            <p>@Model.WorkTitle</p>
        </div>
        <form method="dialog">
            <button class="language-edition-close" type="submit" aria-label="@ui["languageEdition.close"]">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
        </form>
    </div>

    <div class="language-edition-language">
        <span class="language-edition-section" id="@Model.Id-language">@ui["languageEdition.language"]</span>
        <div class="language-edition-chips" role="group" aria-labelledby="@Model.Id-language">
            @foreach (var language in Model.Languages.Where(x => chipCodes.Contains(x.Code)))
            {
                var pressed = language.Code.Equals(Model.CurrentLanguageCode, StringComparison.OrdinalIgnoreCase) ? "true" : "false";
                <button type="button" class="language-edition-chip" data-language-edition-chip="@language.Code" aria-pressed="@pressed">@language.Name</button>
            }
        </div>
        <select data-language-edition-language aria-labelledby="@Model.Id-language">
            @foreach (var language in Model.Languages)
            {
                <option value="@language.Code" selected="@(language.Code.Equals(Model.CurrentLanguageCode, StringComparison.OrdinalIgnoreCase))">@language.Name</option>
            }
        </select>
    </div>

    <p class="language-edition-error" role="alert" data-language-edition-error hidden></p>

    <h3 class="language-edition-section">@ui["languageEdition.editions"]</h3>
    <ul class="language-edition-list">
        @foreach (var edition in Model.Editions)
        {
            var isCurrentLanguage = edition.LanguageCode.Equals(Model.CurrentLanguageCode, StringComparison.OrdinalIgnoreCase);
            var provenanceLabel = edition.Provenance == EditionProvenance.Official ? ui["languageEdition.official"] : ui["languageEdition.generated"];
            var stateLabel = statusLabels[edition.State];
            var rowLabel = ui.Format("languageEdition.rowLabel", ("title", edition.Title), ("provenance", provenanceLabel), ("state", stateLabel));
            var isCurrent = edition.State == EditionState.Current;
            <li class="language-edition-row"
                data-language-edition-row
                data-language="@edition.LanguageCode"
                data-state="@edition.State.ToString().ToLowerInvariant()"
                data-provenance="@edition.Provenance.ToString().ToLowerInvariant()"
                hidden="@(!isCurrentLanguage)">
                @if (edition.SelectUrl is not null)
                {
                    <a class="language-edition-select"
                       href="@edition.SelectUrl"
                       data-edition-key="@edition.Key"
                       aria-label="@rowLabel"
                       aria-current="@(isCurrent ? "true" : null)">
                        <span class="language-edition-name">@edition.Title</span>
                        <span class="language-edition-tag" data-provenance="@edition.Provenance.ToString().ToLowerInvariant()">@provenanceLabel</span>
                        <span class="language-edition-description">@edition.Description</span>
                        <span class="language-edition-state">@(edition.Progress ?? stateLabel)</span>
                    </a>
                    <span class="language-edition-radio" data-checked="@(isCurrent ? "true" : "false")" aria-hidden="true"></span>
                }
                else
                {
                    <div class="language-edition-select" aria-label="@rowLabel" role="group">
                        <span class="language-edition-name">@edition.Title</span>
                        <span class="language-edition-tag" data-provenance="@edition.Provenance.ToString().ToLowerInvariant()">@provenanceLabel</span>
                        <span class="language-edition-description">@edition.Description</span>
                        <span class="language-edition-state">@stateLabel</span>
                    </div>
                }

                @if (edition.Action is not null)
                {
                    <form method="post" action="@edition.Action.PostUrl" asp-antiforgery="true" class="language-edition-action">
                        @foreach (var field in edition.Action.Fields)
                        {
                            <input type="hidden" name="@field.Key" value="@field.Value" />
                        }
                        <button class="button" type="submit">@edition.Action.Label</button>
                    </form>
                }
            </li>
        }
    </ul>
</dialog>