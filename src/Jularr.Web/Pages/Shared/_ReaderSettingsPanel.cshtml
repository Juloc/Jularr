@model Jularr.Web.Features.ReaderCore.ReaderSettingsPanelModel
@using Jularr.Web.Data
@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.ReaderPreferences
@using Jularr.Web.Features.Speech
@inject AppDbContext ReaderSettingsDb
@*
    Shared reader settings panel for the Books and Novels prose readers (issue #185).
    Self-contained: it resolves its own UI bundle instead of taking one from the
    caller, since both readers already pass a fully-built ReaderSettingsPanelModel.
*@
@{
    var ui = await UiRequestLocalization.GetBundleAsync(Context, ReaderSettingsDb);
    var capabilities = Model.Document.Capabilities;
}
@if (capabilities.SupportsTts)
{
    @* Read-aloud entry point; reader-tts.js reveals it only when the device can speak. *@
    <button class="reader-tts-toggle"
            type="button"
            data-reader-tts-toggle
            aria-pressed="false"
            aria-label="@ui["reader.settings.readAloudAria"]"
            title="@ui["reader.settings.readAloudAria"]"
            hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
            <path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
        </svg>
    </button>
}
<details class="reader-settings"
         data-reader-settings-panel
         data-reader-settings-container>
    <summary class="reader-settings-trigger"
             aria-label="@ui["reader.settings.toggleAria"]"
             title="@ui["reader.settings.toggleAria"]">Aa</summary>

    <form class="reader-settings-panel"
          method="post"
          asp-page-handler="ReaderSettings"
          asp-route-id="@Model.ChapterId"
          data-reader-settings-form
          data-book-settings-form>
        @if (!string.IsNullOrWhiteSpace(Model.Language))
        {
            <input type="hidden" name="lang" value="@Model.Language" />
        }
        <input type="hidden" name="scope" value="work" />
        <input type="hidden" name="changedKey" value="" />
        <input type="hidden" name="genre" value="" />
        <input type="hidden" name="genrePriority" value="500" />

        <header class="reader-settings-heading">
            <div>
                <strong>@ui["reader.settings.heading"]</strong>
                <small>@Model.Document.Title</small>
            </div>
            <span data-reader-override-state data-book-override-state>
                @(Model.Settings.HasWorkOverride
                    ? ui["reader.settings.override.book"]
                    : Model.Settings.HasGenreOverride
                        ? ui["reader.settings.override.genre"]
                        : Model.Settings.HasTypeOverride
                            ? ui["reader.settings.override.type"]
                            : ui["reader.settings.override.mine"])
            </span>
        </header>

        <div class="reader-settings-fields">
            @if (capabilities.SupportsContinuous || capabilities.SupportsPaged)
            {
                <label>
                    <span>@ui["reader.settings.readingMode"]</span>
                    <select name="ReadingMode"
                            data-reader-setting
                            data-setting-key="readingMode"
                            data-book-setting="readingMode">
                        @if (capabilities.SupportsContinuous)
                        {
                            <option value="continuous">@ui["reader.settings.readingMode.continuous"]</option>
                        }
                        @if (capabilities.SupportsPaged)
                        {
                            <option value="paged">@ui["reader.settings.readingMode.paged"]</option>
                        }
                    </select>
                </label>
            }

            @if (capabilities.SupportsPageCurl || capabilities.SupportsPaged)
            {
                <label>
                    <span>@ui["reader.settings.pageTransition"]</span>
                    <select name="PageTransition"
                            data-reader-setting
                            data-setting-key="pageTransition"
                            data-book-setting="pageTransition">
                        @if (capabilities.SupportsPageCurl)
                        {
                            <option value="curl">@ui["reader.settings.pageTransition.curl"]</option>
                        }
                        <option value="slide">@ui["reader.settings.pageTransition.slide"]</option>
                        <option value="fade">@ui["reader.settings.pageTransition.fade"]</option>
                        <option value="none">@ui["reader.settings.pageTransition.none"]</option>
                    </select>
                </label>
            }

            @if (capabilities.SupportsTwoPage)
            {
                <label class="reader-settings-check">
                    <input type="checkbox"
                           name="TwoPageSpread"
                           value="true"
                           data-reader-setting
                           data-setting-key="twoPageSpread"
                           data-book-setting="twoPageSpread" />
                    <span>@ui["reader.settings.twoPageSpread"]</span>
                </label>
            }

            @if (capabilities.SupportsAutoScroll)
            {
                <label>
                    <span>
                        @ui["reader.settings.autoScroll"]
                        <output data-setting-output="autoScrollSpeed"
                                data-book-setting-output="autoScrollSpeed"></output>
                    </span>
                    <input type="range"
                           name="AutoScrollSpeed"
                           min="10"
                           max="180"
                           step="5"
                           data-reader-setting
                           data-setting-key="autoScrollSpeed"
                           data-book-setting="autoScrollSpeed" />
                </label>
            }

            @if (capabilities.SupportsTypography)
            {
                <label>
                    <span>@ui["reader.settings.fontFamily"]</span>
                    <select name="FontFamily"
                            data-reader-setting
                            data-setting-key="fontFamily"
                            data-book-setting="fontFamily">
                        <option value="literary-serif">@ui["reader.settings.fontFamily.literarySerif"]</option>
                        <option value="book-serif">@ui["reader.settings.fontFamily.bookSerif"]</option>
                        <option value="system-serif">@ui["reader.settings.fontFamily.systemSerif"]</option>
                        <option value="system-sans">@ui["reader.settings.fontFamily.systemSans"]</option>
                        <option value="atkinson">Atkinson Hyperlegible</option>
                        <option value="noto-serif-jp">Noto Serif JP</option>
                        <option value="noto-sans-jp">Noto Sans JP</option>
                        <option value="google:Literata">Literata</option>
                        <option value="google:Lora">Lora</option>
                        <option value="google:Merriweather">Merriweather</option>
                    </select>
                </label>

                <div class="novel-google-font reader-google-font">
                    <input type="search"
                           data-reader-google-font
                           list="reader-google-fonts"
                           placeholder="@ui["reader.settings.customGoogleFontPlaceholder"]" />
                    <datalist id="reader-google-fonts">
                        <option value="Source Serif 4"></option>
                        <option value="Crimson Pro"></option>
                        <option value="EB Garamond"></option>
                        <option value="Noto Serif JP"></option>
                        <option value="Noto Sans JP"></option>
                    </datalist>
                    <button type="button"
                            class="button"
                            data-reader-apply-google-font>@ui["reader.settings.apply"]</button>
                </div>

                <label>
                    <span>
                        @ui["reader.settings.fontSize"]
                        <output data-setting-output="fontSizeRem"
                                data-book-setting-output="fontSizeRem"></output>
                    </span>
                    <input type="range"
                           name="FontSizeRem"
                           min=".85"
                           max="1.8"
                           step=".05"
                           data-reader-setting
                           data-setting-key="fontSizeRem"
                           data-book-setting="fontSizeRem" />
                </label>

                <label>
                    <span>
                        @ui["reader.settings.lineHeight"]
                        <output data-setting-output="lineHeight"
                                data-book-setting-output="lineHeight"></output>
                    </span>
                    <input type="range"
                           name="LineHeight"
                           min="1.4"
                           max="2.6"
                           step=".05"
                           data-reader-setting
                           data-setting-key="lineHeight"
                           data-book-setting="lineHeight" />
                </label>

                <label>
                    <span>
                        @ui["reader.settings.paragraphSpacing"]
                        <output data-setting-output="paragraphSpacingEm"
                                data-book-setting-output="paragraphSpacingEm"></output>
                    </span>
                    <input type="range"
                           name="ParagraphSpacingEm"
                           min="0"
                           max="2.2"
                           step=".1"
                           data-reader-setting
                           data-setting-key="paragraphSpacingEm"
                           data-book-setting="paragraphSpacingEm" />
                </label>

                <label>
                    <span>
                        @ui["reader.settings.textWidth"]
                        <output data-setting-output="textWidthPx"
                                data-book-setting-output="textWidthPx"></output>
                    </span>
                    <input type="range"
                           name="TextWidthPx"
                           min="520"
                           max="1100"
                           step="20"
                           data-reader-setting
                           data-setting-key="textWidthPx"
                           data-book-setting="textWidthPx" />
                </label>

                <label>
                    <span>@ui["reader.settings.textAlignment"]</span>
                    <select name="TextAlignment"
                            data-reader-setting
                            data-setting-key="textAlignment"
                            data-book-setting="textAlignment">
                        <option value="start">@ui["reader.settings.textAlignment.start"]</option>
                        <option value="justify">@ui["reader.settings.textAlignment.justify"]</option>
                    </select>
                </label>

                <label>
                    <span>@ui["reader.settings.chapterStyle"]</span>
                    <select name="ChapterStyle"
                            data-reader-setting
                            data-setting-key="chapterStyle"
                            data-book-setting="chapterStyle">
                        <option value="classic">@ui["reader.settings.chapterStyle.classic"]</option>
                        <option value="modern">@ui["reader.settings.chapterStyle.modern"]</option>
                        <option value="light-novel">@ui["reader.settings.chapterStyle.lightNovel"]</option>
                        <option value="minimal">@ui["reader.settings.chapterStyle.minimal"]</option>
                        <option value="decorative">@ui["reader.settings.chapterStyle.decorative"]</option>
                    </select>
                </label>
            }

            @if (Model.LayoutPreferences)
            {
                @* Checkbox first, hidden "false" second: the binder takes the first value, so
                   an unchecked box posts false instead of leaving the field unset. *@
                @foreach (var item in new[]
                {
                    ("Hyphenation", "hyphenation", "reader.settings.hyphenation", Model.Settings.Hyphenation),
                    ("ParagraphIndent", "paragraphIndent", "reader.settings.paragraphIndent", Model.Settings.ParagraphIndent),
                    ("ShowPageNumbers", "showPageNumbers", "reader.settings.showPageNumbers", Model.Settings.ShowPageNumbers),
                    ("ShowIllustrations", "showIllustrations", "reader.settings.showIllustrations", Model.Settings.ShowIllustrations),
                    ("AutoContinueChapters", "autoContinueChapters", "reader.settings.autoContinueChapters", Model.Settings.AutoContinueChapters)
                })
                {
                    <label class="reader-settings-check">
                        <input type="checkbox"
                               name="@item.Item1"
                               value="true"
                               checked="@item.Item4"
                               data-reader-setting
                               data-setting-key="@item.Item2" />
                        <input type="hidden" name="@item.Item1" value="false" />
                        <span>@ui[item.Item3]</span>
                    </label>
                }
            }

            <label>
                <span>@ui["reader.settings.paperStyle"]</span>
                <select name="PaperStyle"
                        data-reader-setting
                        data-setting-key="paperStyle"
                        data-book-setting="paperStyle">
                    <option value="auto">@ui["reader.settings.auto"]</option>
                    <option value="white">@ui["reader.frame.paper.white"]</option>
                    <option value="cream">@ui["reader.frame.paper.cream"]</option>
                    <option value="sepia">@ui["reader.frame.paper.sepia"]</option>
                    <option value="old-paper">@ui["reader.frame.paper.oldPaper"]</option>
                    <option value="midnight">@ui["reader.frame.paper.midnight"]</option>
                    <option value="oled">@ui["reader.frame.paper.oled"]</option>
                </select>
            </label>

            @if (capabilities.SupportsThemeArtwork)
            {
                <label class="reader-settings-check">
                    <input type="checkbox"
                           name="GenreArtworkEnabled"
                           value="true"
                           data-reader-setting
                           data-setting-key="genreArtworkEnabled"
                           data-book-setting="genreArtworkEnabled" />
                    <span>@ui["reader.settings.genreArtwork"]</span>
                </label>

                <label>
                    <span>@ui["reader.settings.genreTheme"]</span>
                    <select name="GenreTheme"
                            data-reader-setting
                            data-setting-key="genreTheme"
                            data-book-setting="genreTheme"
                            data-reader-genre-select>
                        <option value="auto">@ui["reader.settings.auto"]</option>
                    </select>
                </label>

                <label>
                    <span>@ui["reader.settings.background"]</span>
                    <select name="BackgroundAssetId"
                            data-reader-setting
                            data-setting-key="backgroundAssetId"
                            data-book-setting="backgroundAssetId"
                            data-reader-background-select>
                        <option value="auto">@ui["reader.settings.auto"]</option>
                    </select>
                </label>

                <label>
                    <span>
                        @ui["reader.settings.backgroundIntensity"]
                        <output data-setting-output="backgroundIntensity"
                                data-book-setting-output="backgroundIntensity"></output>
                    </span>
                    <input type="range"
                           name="BackgroundIntensity"
                           min="0"
                           max=".12"
                           step=".005"
                           data-reader-setting
                           data-setting-key="backgroundIntensity"
                           data-book-setting="backgroundIntensity" />
                </label>

                <label>
                    <span>@ui["reader.settings.backgroundMotion"]</span>
                    <select name="BackgroundMotionMode"
                            data-reader-setting
                            data-setting-key="backgroundMotionMode"
                            data-book-setting="backgroundMotionMode">
                        <option value="auto">@ui["reader.settings.auto"]</option>
                        <option value="static">@ui["reader.settings.backgroundMotion.static"]</option>
                        <option value="parallax">@ui["reader.settings.backgroundMotion.parallax"]</option>
                    </select>
                </label>

                <details class="reader-theme-advanced">
                    <summary>@ui["reader.settings.advancedTheme"]</summary>
                    <div class="reader-theme-advanced-grid">
                        @foreach (var item in new[]
                        {
                            ("ThemeEffectStrength", "themeEffectStrength", "reader.settings.theme.effects", "0", "2", ".05"),
                            ("ThemeBrightness", "themeBrightness", "reader.settings.theme.brightness", ".65", "1.35", ".05"),
                            ("ThemeContrast", "themeContrast", "reader.settings.theme.contrast", ".7", "1.3", ".05"),
                            ("ThemeSaturation", "themeSaturation", "reader.settings.theme.saturation", "0", "1.5", ".05"),
                            ("ThemeBlurPx", "themeBlurPx", "reader.settings.theme.blur", "0", "8", ".5"),
                            ("ThemeVignetteStrength", "themeVignetteStrength", "reader.settings.theme.vignette", "0", "2", ".05"),
                            ("ThemeGrainStrength", "themeGrainStrength", "reader.settings.theme.grain", "0", "2", ".05"),
                            ("ThemeTextBackdropStrength", "themeTextBackdropStrength", "reader.settings.theme.textBackdrop", "0", "2", ".05"),
                            ("ThemeParallaxStrength", "themeParallaxStrength", "reader.settings.theme.parallax", "0", "2", ".05"),
                            ("ThemeTintStrength", "themeTintStrength", "reader.settings.theme.tint", "0", "2", ".05")
                        })
                        {
                            <label>
                                <span>
                                    @ui[item.Item3]
                                    <output data-setting-output="@item.Item2"
                                            data-book-setting-output="@item.Item2"></output>
                                </span>
                                <input type="range"
                                       name="@item.Item1"
                                       min="@item.Item4"
                                       max="@item.Item5"
                                       step="@item.Item6"
                                       data-reader-setting
                                       data-setting-key="@item.Item2"
                                       data-book-setting="@item.Item2" />
                            </label>
                        }
                    </div>
                </details>
            }

            <label>
                <span>@ui["reader.settings.bookmarkStyle"]</span>
                <select name="BookmarkStyle"
                        data-reader-setting
                        data-setting-key="bookmarkStyle"
                        data-book-setting="bookmarkStyle">
                    <option value="fabric">@ui["reader.settings.bookmarkStyle.fabric"]</option>
                    <option value="paper">@ui["reader.settings.bookmarkStyle.paper"]</option>
                    <option value="leather">@ui["reader.settings.bookmarkStyle.leather"]</option>
                    <option value="cord">@ui["reader.settings.bookmarkStyle.cord"]</option>
                    <option value="minimal">@ui["reader.settings.bookmarkStyle.minimal"]</option>
                </select>
            </label>

            <label>
                <span>@ui["reader.settings.bookmarkColor"]</span>
                <input type="color"
                       name="BookmarkColor"
                       data-reader-setting
                       data-setting-key="bookmarkColor"
                       data-book-setting="bookmarkColor" />
            </label>
        </div>

        @if (capabilities.SupportsTts)
        {
            var tts = Model.Settings;
            <section class="reader-tts-settings" data-reader-tts-settings aria-label="@ui["reader.settings.readAloudAria"]">
                <script type="application/json" data-reader-tts-text>@Json.Serialize(ui.WithPrefix("reader.tts."))</script>
                <input type="hidden"
                       name="TtsVoiceIds"
                       value="@(SpeechVoiceMap.Serialize(tts.TtsVoiceIds) ?? "")"
                       data-reader-tts-voice-map />

                <p class="reader-tts-status" data-reader-tts-status role="status"></p>

                <label data-reader-tts-field="ttsProviderId">
                    <span>@ui["reader.settings.ttsProvider"]</span>
                    <select name="TtsProviderId" data-reader-tts-setting="ttsProviderId">
                        <option value="auto" selected="@(tts.TtsProviderId == "auto")">@ui["reader.settings.auto"]</option>
                        <option value="device" selected="@(tts.TtsProviderId == "device")">@ui["reader.settings.ttsProvider.device"]</option>
                    </select>
                </label>

                @foreach (var language in Model.Document.Languages)
                {
                    var voiceKey = ReaderPreferenceRules.TtsVoiceFieldKey(language.Tag);
                    var storedVoice = SpeechVoiceMap.VoiceIdFor(tts.TtsVoiceIds, language.Tag);
                    <label data-reader-tts-field="@voiceKey">
                        <span>@ui.Format("reader.settings.ttsVoice", ("language", language.Label))</span>
                        <select data-reader-tts-voice="@language.Tag"
                                data-reader-tts-voice-label="@language.Label">
                            <option value="auto">@ui["reader.settings.auto"]</option>
                            @if (storedVoice is not null)
                            {
                                <option value="@storedVoice" selected>@storedVoice</option>
                            }
                        </select>
                        <small data-reader-tts-voice-status="@language.Tag"></small>
                    </label>
                }

                @foreach (var item in new[]
                {
                    ("TtsRate", "ttsRate", "reader.settings.tts.rate", "0.5", "2.5", tts.TtsRate),
                    ("TtsPitch", "ttsPitch", "reader.settings.tts.pitch", "0.5", "2", tts.TtsPitch),
                    ("TtsVolume", "ttsVolume", "reader.settings.tts.volume", "0", "1", tts.TtsVolume)
                })
                {
                    <label data-reader-tts-field="@item.Item2">
                        <span>
                            @ui[item.Item3]
                            <output data-reader-tts-output="@item.Item2"></output>
                        </span>
                        <input type="range"
                               name="@item.Item1"
                               min="@item.Item4"
                               max="@item.Item5"
                               step="0.05"
                               value="@item.Item6.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               data-reader-tts-setting="@item.Item2" />
                    </label>
                }

                <label class="reader-settings-check" data-reader-tts-field="ttsAutoContinueChapters">
                    <input type="checkbox"
                           name="TtsAutoContinueChapters"
                           value="true"
                           checked="@tts.TtsAutoContinueChapters"
                           data-reader-tts-setting="ttsAutoContinueChapters" />
                    <span>@ui["reader.settings.tts.autoContinue"]</span>
                </label>

                <p class="reader-tts-privacy">
                    @ui["reader.settings.tts.privacyNotice"]
                </p>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AdditionalActionUrl)
             && !string.IsNullOrWhiteSpace(Model.AdditionalActionLabel))
        {
            <div class="reader-settings-extra-action">
                <a class="button" href="@Model.AdditionalActionUrl">
                    @Model.AdditionalActionLabel
                </a>
            </div>
        }
    </form>
</details>

@if (capabilities.SupportsTts)
{
    @* reader-tts.js moves the player bar out of the auto-hiding toolbar. *@
    <div class="reader-tts-bar" data-reader-tts-bar role="region" aria-label="@ui["reader.settings.readAloudAria"]" hidden>
        <span class="reader-tts-bar-status" data-reader-tts-bar-status aria-live="polite"></span>
        <button type="button" data-reader-tts-pause>@ui["reader.settings.tts.pause"]</button>
        <button type="button" data-reader-tts-stop>@ui["reader.settings.tts.stop"]</button>
    </div>
}
