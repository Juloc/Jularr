@model string
@*
    Decorative 24px outline icons for the shared reader chrome (Books, Novels, Manga).
    Labels always live on the surrounding control (aria-label/title from the UI catalog).
*@
<svg class="reader-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Model)
    {
        case "back":
            <path d="m15 18-6-6 6-6" />
            break;
        case "forward":
            <path d="m9 18 6-6-6-6" />
            break;
        case "translate":
            <path d="M3.5 5.5h9M8 3.5v2M5.5 5.5c.4 3.6 2.8 6.4 6 7.6M10.5 5.5c-.7 3.8-3 6.6-6.5 8" />
            <path d="m12.5 20.5 4-9 4 9M13.9 17.5h5.2" />
            break;
        case "palette":
            <path d="M12 3.5a8.5 8.5 0 1 0 0 17c1.2 0 1.8-.9 1.4-1.9l-.3-.8c-.4-1.1.4-2.2 1.6-2.2h1.8a4 4 0 0 0 4-4c0-4.5-3.8-8.1-8.5-8.1z" />
            <path d="M7.6 11.6h.01M9.8 7.9h.01M14.3 7.9h.01" stroke-width="2.6" />
            break;
        case "bookmark":
            <path d="M6.5 3.5h11v17l-5.5-3.8-5.5 3.8z" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m20 20-4.4-4.4" />
            break;
        case "more":
            <path d="M12 5h.01M12 12h.01M12 19h.01" stroke-width="2.8" />
            break;
        case "contents":
            <path d="M9 6.5h11M9 12h11M9 17.5h11M4 6.5h.01M4 12h.01M4 17.5h.01" />
            break;
        case "previous":
            <path d="M17.5 6.5v11L9.5 12z" />
            <path d="M6.5 6v12" />
            break;
        case "next":
            <path d="M6.5 6.5v11l8-5.5z" />
            <path d="M17.5 6v12" />
            break;
        case "play":
            <path d="M8.5 5.8v12.4l9.8-6.2z" fill="currentColor" />
            break;
        case "pause":
            <path d="M9 6v12M15 6v12" stroke-width="2.6" />
            break;
        case "headphones":
            <path d="M4.5 15v-3a7.5 7.5 0 0 1 15 0v3" />
            <path d="M4.5 14.5h3v5.5h-2a1 1 0 0 1-1-1zM19.5 14.5h-3v5.5h2a1 1 0 0 0 1-1z" />
            break;
        case "view":
            <path d="M3 5.5h6a3 3 0 0 1 3 3v11a2.5 2.5 0 0 0-2.5-2.5H3zM21 5.5h-6a3 3 0 0 0-3 3v11a2.5 2.5 0 0 1 2.5-2.5H21z" />
            break;
        case "single-page":
            <path d="M6.5 3.5h11v17h-11z" />
            <path d="M9.5 8h5M9.5 11.5h5M9.5 15h3" />
            break;
        case "fullscreen":
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
            break;
        case "fullscreen-exit":
            <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" />
            <path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7" />
            <circle cx="12" cy="12" r="6.2" />
            break;
        case "sliders":
            <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
            <circle cx="15" cy="7" r="2" />
            <circle cx="9" cy="17" r="2" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "share":
            <path d="M12 14.5v-11M8 7.5l4-4 4 4" />
            <path d="M5.5 12v6.5a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V12" />
            break;
        case "download":
            <path d="M12 3.5v11M7.5 10.5l4.5 4.5 4.5-4.5" />
            <path d="M5 19.5h14" />
            break;
        case "timer":
            <circle cx="12" cy="13.5" r="7.5" />
            <path d="M12 9.5v4l2.5 1.8M9.5 2.5h5" />
            break;
        case "notes":
            <path d="M4.5 19.5h3.8L19 8.8a2.2 2.2 0 0 0-3.1-3.1L5.2 16.4l-.7 3.1z" />
            <path d="m14.5 7 2.5 2.5" />
            break;
        case "highlight":
            <path d="m14.5 4.5 5 5-8.5 8.5H6v-5z" />
            <path d="M3.5 21h7" />
            break;
        case "reading-mode":
            <path d="M7 3.5h10v17H7z" />
            <path d="M10 8h4M10 12h4M10 16h4" />
            break;
        case "auto-scroll":
            <path d="M12 4.5v15M6.5 14l5.5 5.5 5.5-5.5" />
            break;
        case "furigana":
            <path d="M6 9h12M6 9v10M18 9v10M6 14h12" />
            <path d="M9 4.5h6" stroke-width="1.4" />
            break;
        case "screen-on":
            <rect x="6.5" y="2.5" width="11" height="19" rx="2" />
            <path d="M12 8.5v3M9.8 10.2a3.2 3.2 0 1 0 4.4 0" />
            break;
        case "list":
            <path d="M8 6.5h12M8 12h12M8 17.5h12M4 6.5h.01M4 12h.01M4 17.5h.01" />
            break;
        case "details":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 11v5.5M12 7.5h.01" />
            break;
    }
</svg>
