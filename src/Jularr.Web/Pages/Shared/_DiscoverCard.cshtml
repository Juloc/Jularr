@using Jularr.Web.Features.Discovery
@using Jularr.Web.Features.Localization
@model (DiscoverCardView Card, UiTextBundle Ui)
@* One title of Discover (docs/mockups/discover): dominant artwork, title, a compact type and year line and one
   language or request indicator. The card is deliberately simpler than a Library card: no progress. Activating it
   opens the canonical Detail: a link when the title already has a page here, a resolving button when its Work is
   created on opening (Movie, Series), and the Quick View for a title that only exists at a provider. Quick View is
   the explicit preview; hovering never resizes the card or opens another surface. The inert template below is cloned
   by wwwroot/js/discover.js when requested. Styles: wwwroot/css/discover-browse.css. *@
@{
    var card = Model.Card;
    var ui = Model.Ui;
}
<article class="dc-card@(card.IsLocal ? " is-local" : "")"
         data-dc-card
         data-dc-category="@card.Category"
         data-dc-provider="@card.Provider"
         data-dc-external-id="@card.ExternalId"
         data-dc-title="@card.Title"
         data-dc-subtitle="@card.NativeTitle"
         data-dc-author="@card.Author"
         data-dc-cover="@card.PosterUrl"
         data-dc-request-id="@card.RequestId"
         data-dc-watch-request="@(card.IsLocal ? null : card.RequestId)"
         data-dc-request-status="@card.RequestStatus">
    @* The whole card opens the title through the stretched title control; the artwork itself is only a pointer target when that control is a link.
       The Quick View and Request buttons sit on the artwork and appear on hover and focus, so the resting card stays as quiet as the mockup. *@
    @{
        void Art()
        {
            if (card.PosterUrl is { } poster)
            {
                <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            }
            else
            {
                <span class="dc-initial">@card.Initial</span>
            }
        }
    }
    <div class="dc-card-media">
        @if (card.DetailUrl is { } detailUrl)
        {
            <a class="dc-art" href="@detailUrl" tabindex="-1" aria-hidden="true">@{ Art(); }</a>
        }
        else
        {
            <span class="dc-art" aria-hidden="true">@{ Art(); }</span>
        }

        <button type="button" class="dc-card-preview" data-dc-preview
                aria-label="@ui.Format("discover.preview.show", ("title", card.Title))">
            <partial name="_DiscoverIcon" model='"preview"' />
        </button>

        @* The fixed bottom area of the cover: the state at rest, the canonical action on hover and focus (Play or Read for a local title, Start
           watching where it starts at once, else Request). A card click never acquires: Start watching only opens the Detail. *@
        <div class="dc-card-foot">
            <partial name="_DiscoverState" model="card.State" />
            @if (card.IsLocal && (card.PlayUrl ?? card.DetailUrl) is { Length: > 0 } actionUrl)
            {
                var reads = card.PlayUrl is null && card.Category is "manga" or "light-novel" or "book";
                <a class="button button-primary dc-card-action" href="@actionUrl">
                    <partial name="_DiscoverIcon" model='card.PlayUrl is not null ? "play" : reads ? "read" : "library"' />
                    <span>@(card.PlayUrl is not null ? card.PlayLabel : reads ? ui["discover.card.read"] : ui["discover.card.open"])</span>
                </a>
            }
            else if (!card.IsLocal && card.RequestId is null && card.CanRequest)
            {
                @if (card.StartsInstantly)
                {
                    <button type="button" class="button button-primary dc-card-action" data-dc-activate="open">
                        <partial name="_DiscoverIcon" model='"play"' />
                        <span>@ui["discover.card.startWatching"]</span>
                    </button>
                }
                else
                {
                    <button type="button" class="button button-primary dc-card-action dc-card-request" data-dc-card-request>
                        <partial name="_DiscoverIcon" model='"plus"' />
                        <span>@ui["discover.card.request"]</span>
                    </button>
                }
            }
        </div>
    </div>

    <div class="dc-card-body">
        <h3 class="dc-card-title">
            @if (card.DetailUrl is { } titleUrl)
            {
                <a href="@titleUrl" title="@card.Title" data-dc-title-link>@card.Title</a>
            }
            else
            {
                <button type="button" title="@card.Title" data-dc-title-link data-dc-activate="@(card.ResolvesDetail ? "open" : "preview")">@card.Title</button>
            }
        </h3>
        <p class="dc-card-meta">@card.Meta</p>
    </div>

    <template data-dc-template>
        <div class="dc-pv"
             data-category="@card.Category"
             data-provider="@card.Provider"
             data-external-id="@card.ExternalId"
             data-request-id="@card.RequestId"
             data-request-status="@card.RequestStatus"
             data-title="@card.Title"
             data-native-title="@card.NativeTitle"
             data-author="@card.Author"
             data-cover="@card.PosterUrl"
             data-format="@card.Format"
             data-status="@card.RawStatus"
             data-year="@card.Year"
             data-followed="@(card.IsFollowed ? "true" : "false")"
             data-franchise-id="@card.FollowedFranchiseId"
             data-subtitle="@card.Meta">
            @* The hero is the backdrop of the title, else its cover blurred into a backdrop (docs/mockups/media-preview, section 7). The trailer
               is a facade: nothing of YouTube is requested until the sheet is open, and then discover.js starts it muted. *@
            <div class="dc-pv-media">
                @if (card.BackdropUrl is { } backdrop)
                {
                    <img class="dc-pv-backdrop" src="@backdrop" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                }
                else if (card.PosterUrl is { } cover)
                {
                    <img class="dc-pv-backdrop is-derived" src="@cover" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                }

                @if (card.TrailerKey is { } trailerKey)
                {
                    <div class="dc-pv-trailer" data-vd-trailer data-key="@trailerKey" data-frame-title="@ui.Format("library.video.trailerFrameTitle", ("title", card.Title))">
                        <a class="dc-pv-trailer-play" href="https://www.youtube.com/watch?v=@trailerKey" target="_blank" rel="noopener noreferrer"
                           aria-label="@ui.Format("library.video.playTrailer", ("title", card.Title))">
                            <span class="dc-pv-trailer-button" aria-hidden="true"><partial name="_DiscoverIcon" model='"play"' /></span>
                        </a>
                        @* The badge is a second link of the facade: the same click starts the trailer in place. *@
                        <a class="dc-pv-badge" href="https://www.youtube.com/watch?v=@trailerKey" target="_blank" rel="noopener noreferrer">
                            <partial name="_DiscoverIcon" model='"play"' />
                            <span>@ui["discover.preview.trailer"]</span>
                        </a>
                    </div>
                }

                @* The arrows open the title before or after this one in its row; discover.js shows them only where there is one. *@
                <button type="button" class="dc-pv-nav dc-pv-nav-prev" data-dc-sheet-nav="-1" aria-label="@ui["discover.preview.previous"]" hidden>
                    <partial name="_DiscoverIcon" model='"chevron"' />
                </button>
                <button type="button" class="dc-pv-nav dc-pv-nav-next" data-dc-sheet-nav="1" aria-label="@ui["discover.preview.next"]" hidden>
                    <partial name="_DiscoverIcon" model='"chevron"' />
                </button>
            </div>

            <div class="dc-pv-poster">
                @if (card.PosterUrl is { } poster)
                {
                    <img src="@poster" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                }
                else
                {
                    <span class="dc-initial">@card.Initial</span>
                }
            </div>

            <div class="dc-pv-main">
                <h3 class="dc-pv-title">@card.Title</h3>
                @if (card.NativeTitle is { } nativeTitle)
                {
                    <p class="dc-pv-native">@nativeTitle</p>
                }
                <p class="dc-pv-meta">@card.Meta.Replace(" · ", " • ")</p>

                @if (card.Genres.Count > 0)
                {
                    <ul class="dc-pv-genres">
                        @foreach (var genre in card.Genres)
                        {
                            <li>@genre</li>
                        }
                    </ul>
                }

                @if (card.Description is { } description)
                {
                    <p class="dc-pv-desc">@description</p>
                }

                @if (card.Facts.Count > 0 || card.Audio.Count > 0 || card.Subtitles.Count > 0)
                {
                    <dl class="dc-pv-facts">
                        @foreach (var fact in card.Facts)
                        {
                            <div>
                                <dt>@fact.Label</dt>
                                <dd>
                                    @if (fact.Icon is { } factIcon)
                                    {
                                        <span class="dc-pv-fact-icon dc-pv-fact-@factIcon"><partial name="_DiscoverIcon" model="factIcon" /></span>
                                    }
                                    <span>@fact.Value</span>
                                </dd>
                            </div>
                        }
                        @if (card.Audio.Count > 0)
                        {
                            <div><dt>@ui["library.mediaCard.audioLanguages"]</dt><dd>@string.Join(" · ", card.Audio.Select(code => code.ToUpperInvariant()))</dd></div>
                        }
                        @if (card.Subtitles.Count > 0)
                        {
                            <div><dt>@ui["library.mediaCard.subtitleLanguages"]</dt><dd>@string.Join(" · ", card.Subtitles.Select(code => code.ToUpperInvariant()))</dd></div>
                        }
                    </dl>
                }

                <div class="dc-pv-actions">
                    @if (card.PlayUrl is { } playUrl)
                    {
                        <a class="button button-primary" href="@playUrl">
                            <partial name="_DiscoverIcon" model='"play"' />
                            <span>@card.PlayLabel</span>
                        </a>
                    }
                    else if (card.RequestId is { } requestId)
                    {
                        <span class="dc-pv-request"
                              data-dc-request-slot
                              data-dc-live-request="@requestId"
                              data-dc-live-status="@card.RequestStatus">
                        </span>
                    }
                    else if (card.CanRequest)
                    {
                        <span class="dc-pv-request" data-dc-request-slot>
                            <button type="button" class="button button-primary" data-dc-request>
                                <partial name="_DiscoverIcon" model='"plus"' />
                                <span>@ui["discover.card.request"]</span>
                            </button>
                        </span>
                    }
                    else if (card.ImportMangaUrl is { } importUrl)
                    {
                        <a class="button button-primary" href="@importUrl">@ui["discover.preview.addManga"]</a>
                    }
                    else if (card.CanImportSource)
                    {
                        <button type="button" class="button button-primary" data-dc-import-source>@ui["discover.preview.addSource"]</button>
                    }

                    @if (card.CanFollow)
                    {
                        <button type="button" class="button" data-dc-follow aria-pressed="@(card.IsFollowed ? "true" : "false")">
                            <partial name="_DiscoverIcon" model='"follow"' />
                            <span data-dc-follow-label>@ui[card.IsFollowed ? "discover.card.followed" : "discover.card.follow"]</span>
                        </button>
                    }

                    @if (card.CanFollowFranchise)
                    {
                        <button type="button" class="button" data-dc-follow-franchise>@ui["discover.card.followFranchise"]</button>
                    }

                    @if (card.DetailUrl is { } detailsUrl)
                    {
                        <a class="button" href="@detailsUrl">
                            <partial name="_DiscoverIcon" model='"details"' />
                            <span>@ui["discover.preview.details"]</span>
                        </a>
                    }
                    else if (card.ResolvesDetail)
                    {
                        <button type="button" class="button" data-dc-activate="open">
                            <partial name="_DiscoverIcon" model='"details"' />
                            <span>@ui["discover.preview.details"]</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </template>
</article>
