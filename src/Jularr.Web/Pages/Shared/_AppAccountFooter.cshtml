@using Jularr.Web.Features.Appearance
@using Jularr.Web.Features.Localization
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var appVersion = ViewData["AppBuildVersion"] as string ?? AppBuildInfo.Version;
    var isOwner = User.IsInRole(Jularr.Web.Features.Auth.AccountRoles.Owner);
}
@* Phone Profile page footer: the header account menu and theme button are not shown on phones, so these actions live here. *@
<partial name="_AppThemeControl" model="@("labelled")" />
@if (User.Identity?.IsAuthenticated == true)
{
    @* Compact global offline-download indicator (#221): hidden by default, shown by
       offline-library-ui.js only while something is downloading. *@
    <a class="user-menu-offline" href="/Settings/Offline" data-offline-download-indicator hidden></a>
}
<div class="app-account-row">
    <span class="app-account-name">@User.Identity?.Name</span>
    <partial name="_AppSignOut" model="@("app-signout")" />
</div>
@if (isOwner)
{
    <span class="app-account-version" title="@appVersion">@ui["shell.version"] @appVersion</span>
}
