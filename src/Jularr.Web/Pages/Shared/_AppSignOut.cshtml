@using Jularr.Web.Features.Localization
@model string
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
}
@* The shared header account menu owns sign-out on desktop and mobile. The model supplies its button class. *@
<form method="post" asp-page="/Account/Logout" data-offline-logout>
    <button class="@Model" type="submit">
        <partial name="_AppIcon" model="@("signOut")" />
        <span>@ui["nav.signOut"]</span>
    </button>
</form>
