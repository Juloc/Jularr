@using Jularr.Web.Features.Localization
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
}
@* Global search in the content header. Discover reads ?q= and runs the search on load; Ctrl/Cmd+K focuses it (pwa.js). *@
<form class="app-search" role="search" method="get" action="/Discover">
    <partial name="_AppIcon" model="@("search")" />
    <input type="search" name="q" maxlength="120" value="@(Context.Request.Path.StartsWithSegments("/Discover", StringComparison.OrdinalIgnoreCase) ? Context.Request.Query["q"].ToString() : "")" autocomplete="off" spellcheck="false" enterkeyhint="search" data-app-search
           aria-label="@ui["nav.search"]"
           placeholder="@ui["nav.searchPlaceholder"]" />
</form>
