@model (Guid AnimeId, Jularr.Web.Features.Localization.UiTextBundle Ui)
@using Jularr.Web.Features.Acquisition.Ownership
@using Jularr.Web.Features.Acquisition.Pipeline
@inject AnimeAcquisitionPipeline AcquisitionPipeline
@*
    Owner block for one anime: management mode, monitoring, quality profile and the search
    actions. Forms post to the acquisition overview, which redirects back here.
*@
@{
    var ui = Model.Ui;
    var panel = await AcquisitionPipeline.GetAnimePanelAsync(Model.AnimeId, Context.RequestAborted);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}#acquisition";
}
@if (panel is not null)
{
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
    @* No "Acquisition" heading here: this renders inside the Manage sheet's own Acquisition
       group, which already carries that heading (#519). *@
    <section class="panel metadata-panel" id="acquisition">
        <div class="panel-heading">
            <span class="status-pill @(panel.CanAcquire ? "status-ok" : "status-warn")">@SonarrMigration.Describe(panel.Mode)</span>
        </div>

        <div class="acquisition-owner-facts">
            <span>@(panel.Monitored ? ui.Format("library.acquisitionPanel.wantedCount", ("count", panel.WantedCount)) : ui["library.acquisitionPanel.notMonitored"])</span>
            <span>@ui.Format("library.acquisitionPanel.activeDownloads", ("count", panel.ActiveDownloads))</span>
            @if (!panel.ProwlarrConfigured)
            {
                <a asp-page="/Admin/Usenet">@ui["library.acquisitionPanel.noIndexerConfigured"]</a>
            }
            @if (!panel.CanAcquire)
            {
                <a asp-page="/Settings/SonarrMigration" asp-route-q="@panel.AnimeKey">@ui["library.acquisitionPanel.sonarrManaged"]</a>
            }
            @if (panel.LastEvent is { } lastEvent)
            {
                <span>@ui.Format("library.acquisitionPanel.last", ("event", lastEvent))</span>
            }
        </div>

        <form method="post"
              asp-page="/Acquisition/Index"
              asp-page-handler="AnimeSettings"
              class="acquisition-inline-form">
            <input type="hidden" name="animeId" value="@panel.AnimeId" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <label class="acquisition-check">
                <input type="checkbox" name="monitored" value="true" checked="@panel.Monitored" />
                <span>@ui["library.acquisitionPanel.monitored"]</span>
            </label>
            <label class="acquisition-check">
                <input type="checkbox" name="searchOnAdd" value="true" checked="@(panel.Settings?.SearchOnAdd ?? true)" />
                <span>@ui["library.acquisitionPanel.searchWhenMonitoringStarts"]</span>
            </label>
            <label>
                <span>@ui["library.acquisitionPanel.qualityProfile"]</span>
                <select name="profileId">
                    @foreach (var profile in panel.Profiles)
                    {
                        <option value="@profile.Id" selected="@(profile.Id.Equals(panel.ProfileId, StringComparison.OrdinalIgnoreCase))">@profile.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>@ui["library.acquisitionPanel.prowlarrIndexerIds"]</span>
                <input type="text"
                       name="indexerIds"
                       inputmode="numeric"
                       placeholder="@ui["library.acquisitionPanel.allPlaceholder"]"
                       value="@(panel.Settings?.IndexerIds is { Length: > 0 } ids ? string.Join(", ", ids) : "")" />
            </label>
            @if (panel.Roots.Count > 1)
            {
                <label>
                    <span>@ui["library.acquisitionPanel.targetRoot"]</span>
                    <select name="targetRootId">
                        <option value="">@ui["library.acquisitionPanel.currentRootOption"]</option>
                        @foreach (var root in panel.Roots)
                        {
                            <option value="@root.Id" selected="@(panel.Settings?.TargetRootId == root.Id)">@root.Name</option>
                        }
                    </select>
                </label>
            }
            <button class="button" type="submit">@ui["common.save"]</button>
        </form>

        <div class="inline-actions acquisition-owner-actions">
            <form method="post" asp-page="/Acquisition/Index" asp-page-handler="SearchAnime">
                <input type="hidden" name="animeKey" value="@panel.AnimeKey" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button class="button" type="submit" disabled="@(!panel.Monitored || !panel.CanAcquire || !panel.ProwlarrConfigured)">@ui["library.acquisitionPanel.searchWantedNow"]</button>
            </form>
            <a class="button"
               asp-page="/Acquisition/Index"
               asp-route-search="@panel.AnimeKey"
               asp-route-mode="Anime"
               asp-fragment="search-results">@ui["library.acquisitionPanel.interactiveSearch"]</a>
            <a asp-page="/Acquisition/Index">@ui["library.acquisitionPanel.overviewLink"]</a>
        </div>

        @if (panel.RecentHistory.Count > 0)
        {
            <div class="acquisition-owner-facts">
                <strong>@ui["library.acquisitionPanel.recentHistory"]</strong>
            </div>
            <ul class="acquisition-history-list">
                @foreach (var entry in panel.RecentHistory)
                {
                    <li>
                        @entry.OccurredAtUtc.ToLocalTime().ToString("g") · S@(entry.SeasonNumber.ToString("00"))E@(entry.EpisodeNumber.ToString("00")) ·
                        @entry.EventKind ·
                        @if (entry.ReleaseTitle is { } releaseTitle)
                        {
                            @releaseTitle <text> (@entry.QualityKey, @ui.Format("library.acquisitionPanel.score", ("score", entry.Score)))</text>
                        }
                        else
                        {
                            @entry.Reason
                        }
                    </li>
                }
            </ul>
        }
    </section>
}
