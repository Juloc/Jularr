@using Jularr.Web.Data
@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Notifications
@inject AppDbContext NotificationBellDb
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var profileId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var unread = string.IsNullOrWhiteSpace(profileId)
        ? 0
        : await new NotificationStore(NotificationBellDb).CountUnreadAsync(profileId, Context.RequestAborted);
}
<a class="notification-bell app-header-button" href="/Notifications"
   aria-label="@(unread > 0 ? ui.Format("notifications.bell.aria", ("count", unread)) : ui["notifications.bell.ariaNone"])">
    <partial name="_AppIcon" model="@("bell")" />
    @if (unread > 0)
    {
        <span class="notification-bell-badge" aria-hidden="true">@(unread > 99 ? "99+" : unread.ToString())</span>
    }
</a>
