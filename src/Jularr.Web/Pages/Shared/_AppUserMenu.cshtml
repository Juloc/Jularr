@using System.Globalization
@using Jularr.Web.Features.Appearance
@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.Localization
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var appVersion = ViewData["AppBuildVersion"] as string ?? AppBuildInfo.Version;
    var isOwner = User.IsInRole(AccountRoles.Owner);
    var canUseAdmin = JularrPolicies.Allows(User, JularrPolicies.AdminMedia);
    var name = User.Identity?.Name ?? string.Empty;
    var initial = name.Length > 0 ? new StringInfo(name).SubstringByTextElements(0, 1).ToUpperInvariant() : string.Empty;
}
@* The Profile account card closes the sidebar. It opens an upward account menu: Profile, Activity, Settings, Admin when authorized,
   the theme, the offline-download indicator and sign out. Entries for areas that are not built yet (Stats, Ratings, Friends) are not
   listed. A native popover, so Escape, outside click and focus return need no script. *@
<div class="sidebar-account">
    <button class="account-card" type="button" popovertarget="app-user-menu" aria-label="@ui["nav.userMenu"]">
        <span class="app-avatar" aria-hidden="true">@initial</span>
        <span class="account-card-name">@name</span>
        <span class="account-card-more" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    <div class="user-menu" id="app-user-menu" popover>
        <nav class="user-menu-links" aria-label="@ui["nav.userMenu"]">
            <a class="user-menu-item" href="/Profile">
                <partial name="_AppIcon" model="@("profile")" />
                <span>@ui["nav.profile"]</span>
            </a>
            <a class="user-menu-item" href="/Activity">
                <partial name="_AppIcon" model="@("history")" />
                <span>@ui["nav.activity"]</span>
            </a>
            <a class="user-menu-item" href="/Settings">
                <partial name="_AppIcon" model="@("settings")" />
                <span>@ui["nav.settings"]</span>
            </a>
            @if (canUseAdmin)
            {
                <a class="user-menu-item" href="/Admin">
                    <partial name="_AppIcon" model="@("admin")" />
                    <span>@ui["nav.admin"]</span>
                </a>
            }
        </nav>
        <partial name="_AppThemeControl" model="@("labelled")" />
        @* Compact global offline-download indicator (#221): hidden until offline-library-ui.js reports a running download. *@
        <a class="user-menu-offline" href="/Settings/Offline" data-offline-download-indicator hidden></a>
        <partial name="_AppSignOut" model="@("user-menu-item")" />
        @if (isOwner)
        {
            <span class="user-menu-version" title="@appVersion">@ui["shell.version"] @appVersion</span>
        }
    </div>
</div>
