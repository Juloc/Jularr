@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.Instance
@using Jularr.Web.Features.Localization
@using Microsoft.Extensions.DependencyInjection
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var service = Context.RequestServices.GetService<IInstanceModuleService>();
    var settings = service is null ? InstanceModuleSettings.Default : await service.GetAsync(Context.RequestAborted);
    var modules = settings.Modules.Where(pair => pair.Value).Select(pair => pair.Key).ToHashSet();
    var sectionRoot = ViewData["AdminSectionRoot"] as string;
    var links = UiShellNavigation.BuildContextualLinks(sectionRoot is null ? Context.Request.Path : new Microsoft.AspNetCore.Http.PathString(sectionRoot), policy => JularrPolicies.Allows(User, policy), modules);
    if (sectionRoot is not null)
    {
        links = links.Select(link => link with { IsActive = string.Equals(link.Href, Context.Request.Path.Value?.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) }).ToArray();
    }
}
@if (links.Count > 1)
{
    <nav class="admin-section-links @(sectionRoot is null ? "" : "library-type-tabs admreq-section-tabs")" aria-label="@ui[links[0].LabelKey]">
        @foreach (var link in links)
        {
            <a class="@(sectionRoot is null ? "button button-secondary" : "library-type-tab") @(link.IsActive ? "active" : "")" href="@link.Href" aria-current="@(link.IsActive ? "page" : null)">
                <partial name="_AppIcon" model="link.Icon" />
                <span>@ui[link.LabelKey]</span>
            </a>
        }
    </nav>
}
