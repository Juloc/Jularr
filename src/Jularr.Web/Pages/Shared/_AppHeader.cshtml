@using Jularr.Web.Features.Localization
@using Jularr.Web.Features.Auth
@model (UiBreadcrumb? Breadcrumb, bool ShowSearch)
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
    var crumb = Model.Breadcrumb;
    var filter = ViewData["DiscoverFilter"] as Jularr.Web.Features.Discovery.DiscoverFilterView;
    var contextKey = ViewData["HeaderContextKey"] as string;
}
@* The content header, to the right of the sidebar: the back link with the place inside Admin, Settings or Profile on the left, the global
   search in the middle and the notification bell on the right. The brand lives in the sidebar; phones have no sidebar, so the header
   carries the brand mark there. *@
<header class="app-header">
    <div class="app-header-lead">
        <a class="brand app-header-brand" href="/" aria-label="@ui["nav.home"]">
            <partial name="_AppBrandMark" />
        </a>
        @if (contextKey is not null)
        {
            <span class="app-breadcrumb app-breadcrumb-context">@ui[contextKey]</span>
        }
        @if (crumb is not null)
        {
            <nav class="app-breadcrumb" aria-label="@ui.Format("nav.breadcrumbBack", ("area", ui[crumb.Parent.LabelKey]))">
                <a class="app-breadcrumb-back" href="@crumb.Parent.Href">
                    <partial name="_AppIcon" model="@("chevronLeft")" />
                    <span>@ui[crumb.Parent.LabelKey]</span>
                </a>
                @if (crumb.Current is not null)
                {
                    <span class="app-breadcrumb-sep" aria-hidden="true">/</span>
                    <span class="app-breadcrumb-current" aria-current="page">@ui[crumb.Current.LabelKey]</span>
                }
            </nav>
        }
    </div>
    <div class="app-header-search">
        @if (Model.ShowSearch)
        {
            <partial name="_AppSearch" />
        }
    </div>
    <div class="app-header-actions">
        @if (filter is not null)
        {
            <partial name="_DiscoverFilter" model="filter" />
        }
        @if (User.Identity?.IsAuthenticated == true && ViewData["OfflineDownloadsEnabled"] is true)
        {
            <button class="app-header-button" type="button" popovertarget="download-preview" aria-expanded="false" aria-controls="download-preview"
               aria-label="@ui["shell.downloads.offline"]" title="@ui["shell.downloads.offline"]">
                <partial name="_AppIcon" model="@("download")" />
                <span class="notification-bell-badge" data-offline-download-count aria-hidden="true" hidden></span>
            </button>
            <section class="header-preview" id="download-preview" popover data-offline-download-preview aria-label="@ui["shell.downloads.offline"]">
                <div class="header-preview-title"><h2>@ui["shell.downloads.offline"]</h2></div>
                <div class="header-preview-list" data-offline-preview-list aria-live="polite"></div>
                <p data-offline-preview-loading>@ui["shell.preview.loading"]</p>
                <p data-offline-preview-error role="alert" hidden>@ui["shell.preview.error"]</p>
                <template data-offline-preview-icon><span class="header-preview-icon"><partial name="_AppIcon" model="@("download")" /></span></template>
                <div class="header-preview-footer"><a class="button button-secondary" href="/Settings/Offline">@ui["shell.downloads.viewAll"]</a></div>
            </section>
        }
        <partial name="_NotificationBell" />
        <partial name="_AppUserMenu" model='"header"' />
    </div>
</header>
