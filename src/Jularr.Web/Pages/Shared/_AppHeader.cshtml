@using Jularr.Web.Features.Localization
@model string?
@{
    var ui = ViewData["UiTextBundle"] as UiTextBundle ?? UiTextBundle.English;
}
@* The one application header, over the sidebar and the page: brand and mode (Admin, Settings) on the left, the global search in the
   centre on every page, theme, notifications and the account menu on the right. Phones keep the brand, the search and the bell; theme
   and account actions live on Profile there. *@
<header class="app-header">
    <div class="app-header-lead">
        <a class="brand" href="/" aria-label="@ui["nav.home"]">
            <partial name="_AppBrandMark" />
        </a>
        @if (Model is not null)
        {
            <span class="app-header-context">@ui[Model]</span>
        }
    </div>
    <div class="app-header-search">
        <partial name="_AppSearch" />
    </div>
    <div class="app-header-actions">
        <partial name="_AppThemeControl" model="@("header")" />
        <partial name="_NotificationBell" />
        <partial name="_AppUserMenu" />
    </div>
</header>
