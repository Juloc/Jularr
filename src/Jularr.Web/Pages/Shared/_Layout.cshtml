@using Jularr.Web.Data
@using Jularr.Web.Features.Auth
@using Jularr.Web.Features.Instance
@using Microsoft.Extensions.DependencyInjection
@using Jularr.Web.Features.Appearance
@using Jularr.Web.Features.Localization
@using Jularr.Web.Frontend
@inject AppDbContext LocalizationDb
@inject ViteAssetManifest ViteAssets
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var profileId = isAuthenticated
        ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        : null;
    var ui = await UiRequestLocalization.GetBundleAsync(Context, LocalizationDb);
    var appearance = isAuthenticated
        ? await new ProfileAppearanceStore(LocalizationDb).GetAsync(profileId, Context.RequestAborted)
        : ProfileAppearance.Default;
    var instanceAppearance = await new InstanceAppearanceSettingsStore(LocalizationDb)
        .LoadAsync(Context.RequestAborted);
    var themeId = instanceAppearance.AllowProfileThemeOverride && appearance.ThemeId is not null
        ? ThemeCatalog.NormalizeOrOriginal(appearance.ThemeId)
        : instanceAppearance.DefaultThemeId;
    var appTheme = appearance.ThemeMode;
    var effectiveSakura = ThemeCatalog.TryGet(themeId, out var activeTheme) && activeTheme.UsesOriginalArtwork
        ? appearance.SakuraMode
        : AppSakura.Off;
    var themeIconType = activeTheme.UsesOriginalArtwork ? "image/svg+xml" : "image/png";
    var palette = AccentPalette.Build(
        instanceAppearance.AllowProfileAccentOverride ? appearance.AccentColor : null);
    var frontendApp = ViteAssets.Resolve("frontend/entries/app.ts");
    // A module that is off costs the browser nothing: its scripts are not sent, parsed or initialised on any page.
    var moduleSettings = isAuthenticated && Context.RequestServices.GetService<IInstanceModuleService>() is { } moduleService
        ? await moduleService.GetAsync(Context.RequestAborted)
        : InstanceModuleSettings.Default;
    var servesPlayback = moduleSettings.IsEnabled(InstanceModule.Playback);
    var servesReading = moduleSettings.IsEnabled(InstanceModule.Manga) || moduleSettings.IsEnabled(InstanceModule.Novel) || moduleSettings.IsEnabled(InstanceModule.Book);

    ViewData["UiTextBundle"] = ui;
    ViewData["AppThemeMode"] = appTheme;
    ViewData["AppThemeId"] = themeId;
    ViewData["AppBuildVersion"] = AppBuildInfo.Version;
    ViewData["ShowAdminShortcut"] = appearance.ShowAdminShortcut;
}
<!DOCTYPE html>
<html lang="@ui.Locale" dir="@ui.Direction" data-app-version="@AppBuildInfo.Version" data-app-theme="@appTheme" data-app-theme-id="@themeId" data-accent="@palette.Seed" data-sakura="@effectiveSakura">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="@palette.For(appTheme == AppTheme.Dark ? AppTheme.Dark : AppTheme.Light)["--browser-theme-color"]" data-app-theme-color />
    <meta name="application-name" content="Jularr" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Jularr" />
    <title>@ViewData["Title"] - Jularr</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="@activeTheme.LogoPath" type="@themeIconType" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-catalog.css" asp-append-version="true" />
    @foreach (var stylesheet in frontendApp.Stylesheets)
    {
        <link rel="stylesheet" href="@stylesheet" />
    }
    @foreach (var script in frontendApp.PreloadScripts)
    {
        <link rel="modulepreload" href="@script" />
    }
    <style id="app-accent-palette">@Html.Raw(palette.ToStyleSheet())</style>
    <script type="application/json" id="app-shell-text">@Json.Serialize(ui.WithPrefix("pwa."))</script>
    <script src="~/js/app-theme.js" asp-append-version="true" defer></script>
    @if (effectiveSakura != AppSakura.Off || ViewData["NeedsSakura"] is true)
    {
        @* Settings/Appearance asks for the script as well, because switching the effect on there starts it on the running page. *@
        <link rel="stylesheet" href="~/css/sakura.css" asp-append-version="true" />
        <script src="~/js/sakura.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/pwa.js" asp-append-version="true" defer></script>
    @if (frontendApp.EntryScript is not null)
    {
        <script type="module" src="@frontendApp.EntryScript"></script>
    }
    @if (isAuthenticated)
    {
        @* Offline library (#221): loaded on every authenticated page (not just Settings/Offline and
           the "Save offline" action) because the compact global download indicator in
           _AppAccountFooter.cshtml needs the manager everywhere. Previously duplicated per-page;
           see _OfflineLibraryAction.cshtml and Settings/Offline.cshtml. *@
        @if (servesReading || servesPlayback)
        {
            <script type="application/json" id="offline-library-text">@Json.Serialize(ui.WithPrefix("offlineLibrary."))</script>
        }
        @if (servesReading || servesPlayback)
        {
            <script src="~/js/offline-library.js" asp-append-version="true" defer></script>
            <script src="~/js/offline-library-storage.js" asp-append-version="true" defer></script>
            <script src="~/js/offline-library-manager.js" asp-append-version="true" defer></script>
            <script src="~/js/offline-library-ui.js" asp-append-version="true" defer></script>
        }
        @if (servesPlayback)
        {
            @* Media packages are separate from the chapter-only offline library. They keep binary media
               profile-scoped in IndexedDB and expose it through the service worker, never CacheStorage. *@
            <script src="~/js/offline-media.js" asp-append-version="true" defer></script>
            <script src="~/js/offline-media-storage.js" asp-append-version="true" defer></script>
            <script src="~/js/offline-media-manager.js" asp-append-version="true" defer></script>
            <script src="~/js/offline-media-ui.js" asp-append-version="true" defer></script>
        }
        @* Owner-only "Manage" sheet (#519): loaded on every authenticated page, like the offline
           library scripts above, so any consumer detail page can open one. *@
        <link rel="stylesheet" href="~/css/manage-sheet.css" asp-append-version="true" />
        <script src="~/js/manage-sheet.js" asp-append-version="true" defer></script>
        @* Notification bell (#429): rendered in the sidebar/topbar on every authenticated page. *@
        <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(isAuthenticated ? "" : "auth-page")"
      data-profile-id="@profileId">
    <a class="skip-link" href="#main-content">@ui["shell.skipToContent"]</a>
    <div class="app-shell @(isAuthenticated ? "" : "auth-shell")">
        @if (isAuthenticated)
        {
            <partial name="_AppNavigation" />
        }
        <main id="main-content" tabindex="-1" class="@(isAuthenticated ? "app-main" : "auth-main")">
            @if (TempData["Status"] is string status)
            {
                <div class="toast" role="status">@status</div>
            }
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
