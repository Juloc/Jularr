@page "/Music/Album/{workId:guid}"
@model Jularr.Web.Pages.Music.AlbumModel
@{
    var ui = Model.Ui;
    var view = Model.View!;
    var album = view.Album;
    ViewData["Title"] = album.Title;
}
@section Head {
    <link rel="stylesheet" href="~/css/music.css" asp-append-version="true" />
}

<partial name="_LibraryTypeTabs" model="ui" />

<header class="music-header">
    <h1>@album.Title</h1>
    <p class="music-sub"><a class="text-link" asp-page="Artist" asp-route-id="@view.Artist.Id">@view.Artist.Name</a>@(album.Year is { } year ? $" · {year}" : "") · @Model.TypeLabel(album.Type)</p>
</header>

@if (Model.Notice is not null)
{
    <p class="metadata-notice" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<div class="music-actions">
    <span class="music-tag music-tag-@(album.State == Jularr.Web.Features.Music.MusicAlbumState.Available ? "success" : album.State == Jularr.Web.Features.Music.MusicAlbumState.Failed ? "danger" : "neutral")">@Model.StateLabel(album.State)</span>
    @if (album.Tracks > 0)
    {
        <span class="music-sub">@ui.Format("music.tracksInLibrary", ("have", album.TracksWithFiles), ("total", album.Tracks))</span>
    }
    @if (Model.CanRequest)
    {
        <form method="post" asp-page-handler="Request" asp-route-workId="@album.WorkId">
            <button class="button button-primary" type="submit">@ui["music.request"]</button>
        </form>
    }
    @if (Model.CanManage)
    {
        <a class="button button-quiet" href="/Admin/Music/Album/@album.WorkId">@ui["music.manage"]</a>
    }
</div>

@if (view.Tracks.Count == 0)
{
    <p class="music-empty">@ui["admin.music.noTracks"]</p>
}
else
{
    <table class="music-tracks">
        <thead>
            <tr>
                <th scope="col" class="is-numeric">@ui["admin.music.col.disc"]</th>
                <th scope="col" class="is-numeric">@ui["admin.music.col.number"]</th>
                <th scope="col">@ui["admin.music.col.trackTitle"]</th>
                <th scope="col">@ui["music.col.inLibrary"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var track in view.Tracks)
            {
                <tr>
                    <td class="is-numeric">@track.Disc</td>
                    <td class="is-numeric">@track.Number</td>
                    <td>@track.Title</td>
                    <td>@(track.Path is null ? "—" : "✓")<span class="visually-hidden">@(track.Path is null ? ui["music.notInLibrary"] : ui["music.inLibrary"])</span></td>
                </tr>
            }
        </tbody>
    </table>
}
