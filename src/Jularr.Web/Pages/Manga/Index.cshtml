@page "/Manga"
@model Jularr.Web.Pages.Manga.IndexModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["reading.manga.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/manga.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reading-catalog.css" asp-append-version="true" />
}

<header class="manga-library-header">
    <div class="reading-type-switch" aria-label="@ui["manga.nav.readingTypeAria"]">
        <a href="/Novels">@ui["reading.novels.title"]</a>
        <a class="active" href="/Manga">@ui["reading.manga.title"]</a>
    </div>

    @if (Model.Access.CanRequest)
    {
        <details class="manga-import" open="@(Model.SearchQuery.Length > 0)">
            <summary class="button">
                @ui["discover.card.request"]
            </summary>
            <div class="manga-import-panel">
                <form method="get" class="reading-catalog-form">
                    <label for="mangaCatalogQuery">@ui["discover.search.srLabel"]</label>
                    <input id="mangaCatalogQuery"
                           name="q"
                           type="search"
                           value="@Model.SearchQuery"
                           autocomplete="off"
                           placeholder="@ui["discover.search.placeholder"]" />
                    <button class="button button-primary" type="submit">@ui["common.search"]</button>
                </form>

                @if (Model.SearchQuery.Length > 0)
                {
                    @if (Model.SearchResults.Count == 0)
                    {
                        <div class="reading-catalog-empty">@ui["discover.results.emptyTitle"]</div>
                    }
                    else
                    {
                        <div class="reading-catalog-results">
                            @foreach (var result in Model.SearchResults)
                            {
                                <article class="reading-catalog-result">
                                    <div class="reading-catalog-cover">
                                        @if (!string.IsNullOrWhiteSpace(result.Item.CoverImageUrl))
                                        {
                                            <img src="@result.Item.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                        }
                                        else
                                        {
                                            <span>M</span>
                                        }
                                    </div>

                                    <div class="reading-catalog-copy">
                                        <span class="reading-catalog-title">@result.Item.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(result.Item.NativeTitle) &&
                                             !string.Equals(result.Item.NativeTitle, result.Item.Title, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="reading-catalog-native">@result.Item.NativeTitle</span>
                                        }
                                        <span class="reading-catalog-meta">
                                            @if (result.Item.FirstPublishYear is int year)
                                            {
                                                @year
                                            }
                                            @if (result.Item.VolumeCount is int volumes)
                                            {
                                                <text> · </text>
                                                @ui.Format("novels.card.volumeCount", ("count", volumes))
                                            }
                                            @if (result.Item.ChapterCount is int chapters)
                                            {
                                                <text> · </text>
                                                @ui.Format("manga.card.chapterCount", ("count", chapters))
                                            }
                                        </span>
                                    </div>

                                    <div class="reading-catalog-action">
                                        @if (result.LocalUrl is { Length: > 0 } localUrl)
                                        {
                                            <a class="button" href="@localUrl">@ui["books.add.inLibrary"]</a>
                                        }
                                        else if (result.RequestStatus is { Length: > 0 } requestStatus)
                                        {
                                            <button class="button" type="button" disabled>
                                                @ui["requests.status." + requestStatus]
                                            </button>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Add">
                                                <input type="hidden" name="externalId" value="@result.Item.ExternalId" />
                                                <input type="hidden" name="title" value="@result.Item.Title" />
                                                <input type="hidden" name="nativeTitle" value="@result.Item.NativeTitle" />
                                                <input type="hidden" name="coverImageUrl" value="@result.Item.CoverImageUrl" />
                                                <input type="hidden" name="q" value="@Model.SearchQuery" />
                                                <button class="button button-primary" type="submit">
                                                    @ui["discover.card.request"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }

                @if (Model.IsOwner)
                {
                    <div class="reading-catalog-divider">@ui["books.add.manual"]</div>

                    <form method="post"
                          asp-page-handler="Upload"
                          enctype="multipart/form-data">
                        <label for="seriesTitle">@ui["manga.upload.seriesName"]</label>
                        <input id="seriesTitle"
                               name="seriesTitle"
                               type="text"
                               placeholder="@ui["manga.upload.seriesNamePlaceholder"]" />

                        <label for="archives">@ui["manga.upload.archivesLabel"]</label>
                        <input id="archives"
                               name="archives"
                               type="file"
                               accept=".cbz,.zip,application/zip"
                               multiple
                               required />
                        <button class="button button-primary" type="submit">@ui["manga.upload.submit"]</button>
                    </form>

                    <div class="manga-import-divider">@ui["manga.import.serverPathDivider"]</div>

                    <form method="post" asp-page-handler="Import">
                        <label for="sourcePath">@ui["manga.import.sourcePathLabel"]</label>
                        <input id="sourcePath"
                               name="sourcePath"
                               type="text"
                               required
                               placeholder="@ui["manga.import.pathPlaceholder"]" />
                        <button class="button" type="submit">@ui["manga.import.pathSubmit"]</button>
                    </form>
                }
            </div>
        </details>
    }
</header>

@if (Model.ContinueReading.Count > 0)
{
    <section class="manga-section">
        <h1>@ui["home.continueReading"]</h1>
        <div class="manga-continue-list">
            @foreach (var series in Model.ContinueReading)
            {
                <a class="manga-continue-row" href="/Manga/Read/@series.CurrentChapterId?page=@series.CurrentPageIndex">
                    <div class="manga-thumb">
                        @if (!string.IsNullOrWhiteSpace(series.CoverImageUrl))
                        {
                            <img src="@series.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else if (series.PreviewChapterId is Guid preview)
                        {
                            <img src="/Manga/Read/@preview?handler=Page&page=0" alt="" loading="lazy" />
                        }
                    </div>
                    <div>
                        <strong>@series.Title</strong>
                        <span>@ui.Format("manga.card.chapterPage", ("chapter", series.CurrentChapterNumber), ("page", series.CurrentPageIndex + 1), ("pages", series.CurrentPageCount))</span>
                        <div class="manga-progress"><span style="width:@series.ProgressPercent%"></span></div>
                    </div>
                    <span>@series.ProgressPercent%</span>
                </a>
            }
        </div>
    </section>
}

<section class="manga-section">
    <h1>@ui["reading.manga.title"]</h1>

    @if (Model.Series.Count == 0)
    {
        <div class="manga-empty">@ui["manga.index.empty"]</div>
    }
    else
    {
        <div class="manga-grid">
            @foreach (var series in Model.Series)
            {
                <article class="manga-card">
                    <a class="manga-cover" href="/Manga/Series/@series.Id">
                        @if (!string.IsNullOrWhiteSpace(series.CoverImageUrl))
                        {
                            <img src="@series.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else if (series.PreviewChapterId is Guid preview)
                        {
                            <img src="/Manga/Read/@preview?handler=Page&page=0" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span>M</span>
                        }

                        @if (series.HasProgress)
                        {
                            <div class="manga-cover-progress">
                                <span style="width:@series.ProgressPercent%"></span>
                            </div>
                        }
                    </a>

                    <div class="manga-card-copy">
                        <a href="/Manga/Series/@series.Id">@series.Title</a>
                        <span>@ui.Format("manga.card.chapterCount", ("count", series.ChapterCount))</span>
                        @if (series.HasProgress)
                        {
                            <a class="manga-resume" href="/Manga/Read/@series.CurrentChapterId?page=@series.CurrentPageIndex">
                                @ui.Format("manga.card.continueChapter", ("chapter", series.CurrentChapterNumber))
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
