@page "/Manga/Read/{id:guid}"
@model Jularr.Web.Pages.Manga.ReadModel
@using Jularr.Web.Pages.Manga
@{
    var ui = Model.Ui;
    var chapter = Model.Chapter;
    var number = ReadModel.FormatNumber(chapter.Number);
    var distinctTitle = ReadModel.DistinctTitle(chapter.Number, chapter.Title);
    var chapterHeading = distinctTitle is null
        ? ui.Format("manga.reader.chapterNumber", ("chapter", number))
        : ui.Format("manga.reader.chapterWithTitle", ("chapter", number), ("title", distinctTitle));
    var seriesUrl = $"/Manga/Series/{chapter.SeriesId}";
    var pageUrl = $"/Manga/Read/{chapter.Id}?handler=Page&page=";
    string ChapterName(double value) =>
        ui.Format("manga.reader.chapterNumber", ("chapter", ReadModel.FormatNumber(value)));
    string? PreviousHref() => Model.PreviousChapter is { } previous
        ? $"/Manga/Read/{previous.Id}?page={Math.Max(0, previous.PageCount - 1)}"
        : null;
    string? NextHref() => Model.NextChapter is { } next ? $"/Manga/Read/{next.Id}" : null;

    var jsonOptions = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
    var chaptersJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Chapters.Select(item => new
        {
            id = item.Id,
            number = ReadModel.FormatNumber(item.Number),
            title = ReadModel.DistinctTitle(item.Number, item.Title),
            pageCount = item.PageCount
        }),
        jsonOptions);
    var bookmarksJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Bookmarks.Select(item => new
        {
            id = item.Id,
            chapterId = item.ChapterId,
            pageIndex = item.PageIndex,
            label = item.Label ?? ""
        }),
        jsonOptions);
    var readerText = ui.WithPrefix("manga.reader.")
        .Append(new KeyValuePair<string, string>("common.remove", ui["common.remove"]))
        .ToDictionary(x => x.Key, x => x.Value);

    // Server-side the view mode is single, double or continuous (the shared
    // ReaderPreferences shape); the three scroll views share "continuous".
    var modes = new[]
    {
        ("single", "reader.frame.singlePage"),
        ("double", "reader.frame.twoPages"),
        ("continuous", "manga.reader.mode.vertical"),
        ("horizontal", "manga.reader.mode.horizontal"),
        ("webtoon", "manga.reader.mode.webtoon")
    };
    var schemes = new[] { "auto", "light", "sepia", "dark" };

    ViewData["Title"] = $"{chapter.SeriesTitle} · {chapterHeading}";

    void ModeIcon(string mode)
    {
        <svg class="reader-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"
             fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            @switch (mode)
            {
                case "single":
                    <path d="M7 3.5h10v17H7z" /><path d="M12 3.5v17" opacity=".35" />
                    break;
                case "double":
                    <path d="M3 5.5h8.2v13H3zM12.8 5.5H21v13h-8.2z" />
                    break;
                case "continuous":
                    <path d="M7 2.5h10v8H7zM7 13.5h10v8H7z" /><path d="M20.5 9v6M19 13.5l1.5 1.5 1.5-1.5" />
                    break;
                case "horizontal":
                    <path d="M2.5 7h8v10h-8zM13.5 7h8v10h-8z" /><path d="M9 20.5h6M13.5 19l1.5 1.5-1.5 1.5" />
                    break;
                default:
                    <path d="M8 2.5h8v19H8z" /><path d="M8 9h8M8 15.5h8" opacity=".45" />
                    break;
            }
        </svg>
    }
}
@section Head {
    <link rel="stylesheet" href="~/css/reader-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manga-reader.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/reader-shell.js" asp-append-version="true"></script>
    <script src="~/js/manga-reader.js" asp-append-version="true"></script>
}

<div class="reader-frame reader-frame-fixed manga-reader"
     data-manga-reader
     data-unified-reader
     data-reader-frame
     data-reader-content-type="manga"
     data-reading-mode="paged"
     data-profile="@Model.ProfileId"
     data-chapter-id="@chapter.Id"
     data-series-id="@chapter.SeriesId"
     data-page-count="@chapter.PageCount"
     data-page="@Model.InitialPage"
     data-page-url="@pageUrl"
     data-direction="@(chapter.Direction == "ltr" ? "ltr" : "rtl")"
     data-series-direction="@(chapter.Direction == "ltr" ? "ltr" : "rtl")"
     data-default-mode="@Model.ReaderSettings.UiMode"
     data-previous-href="@PreviousHref()"
     data-next-href="@NextHref()"
     style="--manga-bookmark-color:@Model.ReaderSettings.BookmarkColor">

    <script type="application/json" data-reader-frame-text>@Json.Serialize(ui.WithPrefix("reader.frame."))</script>
    <script type="application/json" data-manga-reader-text>@Json.Serialize(readerText)</script>
    <script type="application/json" data-manga-chapters>@Html.Raw(chaptersJson)</script>
    <script type="application/json" data-manga-bookmarks>@Html.Raw(bookmarksJson)</script>

    <header class="reader-frame-top" data-reader-chrome-primary>
        <a class="reader-frame-icon" href="@seriesUrl" aria-label="@ui["reader.frame.back"]" title="@ui["reader.frame.back"]">
            <partial name="_ReaderIcon" model="@("back")" />
        </a>

        <div class="reader-frame-title">
            <strong>@chapter.SeriesTitle</strong>
            <span>@chapterHeading</span>
        </div>

        <nav class="manga-chapter-pill reader-frame-desktop" aria-label="@ui["manga.reader.chapterNavAria"]">
            @if (PreviousHref() is string previousHref)
            {
                <a class="reader-frame-icon" href="@previousHref" aria-label="@ui["reader.frame.previousChapter"]" title="@ui["reader.frame.previousChapter"]">
                    <partial name="_ReaderIcon" model="@("back")" />
                </a>
            }
            else
            {
                <button class="reader-frame-icon" type="button" disabled aria-label="@ui["reader.frame.previousChapter"]">
                    <partial name="_ReaderIcon" model="@("back")" />
                </button>
            }
            <span>@ui.Format("manga.reader.chapterPill", ("chapter", number), ("last", Model.LastChapterNumber))</span>
            @if (NextHref() is string nextHref)
            {
                <a class="reader-frame-icon" href="@nextHref" aria-label="@ui["reader.frame.nextChapter"]" title="@ui["reader.frame.nextChapter"]">
                    <partial name="_ReaderIcon" model="@("forward")" />
                </a>
            }
            else
            {
                <button class="reader-frame-icon" type="button" disabled aria-label="@ui["reader.frame.nextChapter"]">
                    <partial name="_ReaderIcon" model="@("forward")" />
                </button>
            }
        </nav>

        <div class="reader-frame-actions" data-offline-media-item data-offline-media-kind="manga" data-offline-media-id="@chapter.Id">
            <button class="reader-frame-icon" type="button"
                    data-offline-media-save="@chapter.Id" data-offline-media-kind="manga"
                    aria-label="@ui["offlineLibrary.action.saveButton"]" title="@ui["offlineLibrary.action.saveButton"]">
                <partial name="_ReaderIcon" model="@("download")" />
            </button>
            <progress data-offline-media-progress max="100" value="0" hidden></progress>
            <small data-offline-media-status></small>
            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-desktop" type="button"
                        data-reader-menu-toggle="palette"
                        aria-haspopup="menu" aria-expanded="false" aria-controls="manga-menu-palette"
                        aria-label="@ui["reader.frame.colorScheme"]" title="@ui["reader.frame.colorScheme"]">
                    <partial name="_ReaderIcon" model="@("palette")" />
                </button>
                <div class="reader-menu" id="manga-menu-palette" data-reader-menu="palette" role="menu" aria-label="@ui["reader.frame.colorScheme"]" hidden>
                    @foreach (var scheme in schemes)
                    {
                        <button type="button" role="menuitemradio" aria-checked="false" data-manga-scheme="@scheme">
                            <span class="manga-scheme-dot" data-scheme="@scheme" aria-hidden="true"></span>
                            <span>@ui[$"manga.reader.scheme.{scheme}"]</span>
                            <partial name="_ReaderIcon" model="@("check")" />
                        </button>
                    }
                    <button type="button" role="menuitem" data-reader-menu-toggle="settings">@ui["reader.frame.moreAppearance"]</button>
                </div>
            </div>

            <button class="reader-frame-icon reader-frame-desktop" type="button"
                    data-manga-bookmark
                    aria-pressed="false"
                    aria-label="@ui["manga.reader.bookmarkPageAria"]" title="@ui["manga.reader.bookmarkPageAria"]">
                <partial name="_ReaderIcon" model="@("bookmark")" />
            </button>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-desktop" type="button"
                        data-reader-menu-toggle="search"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="manga-menu-search"
                        aria-label="@ui["manga.reader.chapterSearchPlaceholder"]" title="@ui["manga.reader.chapterSearchPlaceholder"]">
                    <partial name="_ReaderIcon" model="@("search")" />
                </button>
                <div class="reader-menu reader-menu-search" id="manga-menu-search" data-reader-menu="search" role="dialog" aria-label="@ui["manga.reader.chapterSearchPlaceholder"]" hidden>
                    <form class="reader-search-form" role="search" data-manga-search-form>
                        <input type="search" autocomplete="off" maxlength="80"
                               placeholder="@ui["manga.reader.chapterSearchPlaceholder"]"
                               aria-label="@ui["manga.reader.chapterSearchPlaceholder"]"
                               data-manga-search-input />
                    </form>
                    <p class="reader-menu-status" role="status" data-manga-search-status hidden>@ui["manga.reader.searchEmpty"]</p>
                    <ol class="reader-search-results" data-manga-search-results></ol>
                </div>
            </div>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon" type="button"
                        data-reader-menu-toggle="more"
                        aria-haspopup="menu" aria-expanded="false" aria-controls="manga-menu-more"
                        aria-label="@ui["reader.frame.more"]" title="@ui["reader.frame.more"]">
                    <partial name="_ReaderIcon" model="@("more")" />
                </button>
                <div class="reader-menu reader-menu-more" id="manga-menu-more" data-reader-menu="more" role="menu" aria-label="@ui["reader.frame.more"]" hidden>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-manga-bookmark aria-pressed="false">
                        <partial name="_ReaderIcon" model="@("bookmark")" />
                        <span>@ui["manga.reader.bookmarkPageAria"]</span>
                    </button>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-reader-menu-toggle="search">
                        <partial name="_ReaderIcon" model="@("search")" />
                        <span>@ui["manga.reader.chapterSearchPlaceholder"]</span>
                    </button>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-reader-menu-toggle="palette">
                        <partial name="_ReaderIcon" model="@("palette")" />
                        <span>@ui["reader.frame.colorScheme"]</span>
                    </button>
                    <button type="button" role="menuitem" data-reader-contents-open="notes">
                        <partial name="_ReaderIcon" model="@("notes")" />
                        <span>@ui["manga.reader.tabNotes"]</span>
                    </button>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-reader-fullscreen-toggle aria-pressed="false">
                        <partial name="_ReaderIcon" model="@("fullscreen")" />
                        <span data-reader-fullscreen-label>@ui["reader.frame.fullscreen"]</span>
                    </button>
                    <button type="button" role="menuitem" data-reader-share>
                        <partial name="_ReaderIcon" model="@("share")" />
                        <span>@ui["reader.frame.share"]</span>
                    </button>
                    <button type="button" role="menuitem" data-reader-menu-toggle="settings">
                        <partial name="_ReaderIcon" model="@("settings")" />
                        <span>@ui["reader.frame.settings"]</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="reader-frame-body">
        <aside class="reader-contents manga-contents" id="manga-reader-contents" data-reader-contents aria-label="@ui["reader.frame.contents"]" hidden>
            <div class="reader-contents-head">
                <div class="reader-contents-tabs" role="tablist" aria-label="@ui["reader.frame.contentsTabsAria"]">
                    <button type="button" role="tab" id="manga-tab-chapters" aria-controls="manga-panel-chapters" aria-selected="true" data-reader-contents-tab="chapters">@ui["reader.frame.contents"]</button>
                    <button type="button" role="tab" id="manga-tab-bookmarks" aria-controls="manga-panel-bookmarks" aria-selected="false" tabindex="-1" data-reader-contents-tab="bookmarks">@ui["manga.reader.tabBookmarks"]</button>
                    <button type="button" role="tab" id="manga-tab-notes" aria-controls="manga-panel-notes" aria-selected="false" tabindex="-1" data-reader-contents-tab="notes">@ui["manga.reader.tabNotes"]</button>
                </div>
                <button class="reader-frame-icon" type="button" data-reader-contents-close
                        aria-label="@ui["reader.frame.closeContents"]" title="@ui["reader.frame.closeContents"]">
                    <partial name="_ReaderIcon" model="@("close")" />
                </button>
            </div>

            <section class="reader-contents-panel" id="manga-panel-chapters" role="tabpanel" aria-labelledby="manga-tab-chapters" data-reader-contents-panel="chapters">
                <ol class="manga-volumes">
                    @foreach (var volume in Model.Volumes)
                    {
                        <li>
                            <details class="manga-volume" open="@volume.ContainsCurrent">
                                <summary>
                                    <img class="manga-volume-cover" src="/Manga/Read/@volume.First.Id?handler=Page&page=0"
                                         alt="" width="36" height="52" loading="lazy" decoding="async" />
                                    <span class="manga-volume-copy">
                                        <strong>@(volume.Number is int volumeNumber ? ui.Format("manga.series.volume", ("volume", volumeNumber)) : ui["manga.chapters.title"])</strong>
                                        <small>@ui.Format("manga.reader.chapterRange", ("first", ReadModel.FormatNumber(volume.First.Number)), ("last", ReadModel.FormatNumber(volume.Last.Number)))</small>
                                    </span>
                                    <span class="manga-volume-chevron"><partial name="_ReaderIcon" model="@("forward")" /></span>
                                </summary>
                                <ol class="reader-contents-list">
                                    @foreach (var item in volume.Chapters)
                                    {
                                        var current = item.Id == chapter.Id;
                                        <li>
                                            <a class="reader-contents-row manga-contents-chapter"
                                               href="/Manga/Read/@item.Id"
                                               aria-current="@(current ? "page" : null)"
                                               title="@ReadModel.DistinctTitle(item.Number, item.Title)">
                                                <span class="reader-contents-title">@ChapterName(item.Number)</span>
                                                @if (current)
                                                {
                                                    <partial name="_ReaderIcon" model="@("play")" />
                                                }
                                            </a>
                                        </li>
                                    }
                                </ol>
                            </details>
                        </li>
                    }
                </ol>
            </section>
            <section class="reader-contents-panel" id="manga-panel-bookmarks" role="tabpanel" aria-labelledby="manga-tab-bookmarks" data-reader-contents-panel="bookmarks" hidden>
                <p class="reader-contents-empty" data-manga-bookmarks-empty>@ui["manga.reader.bookmarksEmpty"]</p>
                <ol class="reader-contents-list" data-manga-bookmark-list></ol>
            </section>
            <section class="reader-contents-panel" id="manga-panel-notes" role="tabpanel" aria-labelledby="manga-tab-notes" data-reader-contents-panel="notes" hidden>
                <form class="manga-note-form" data-manga-note-form>
                    <textarea rows="3" maxlength="120" required
                              data-manga-note-input
                              placeholder="@ui.Format("manga.reader.notePlaceholder", ("page", Model.InitialPage + 1))"
                              aria-label="@ui.Format("manga.reader.notePlaceholder", ("page", Model.InitialPage + 1))"></textarea>
                    <button class="button" type="submit">@ui["manga.reader.saveNote"]</button>
                </form>
                <p class="reader-contents-empty" data-manga-notes-empty>@ui["manga.reader.notesEmpty"]</p>
                <ol class="reader-contents-list" data-manga-note-list></ol>
            </section>
        </aside>
        <div class="reader-contents-backdrop" data-reader-contents-backdrop hidden></div>

        <main class="manga-stage" data-manga-stage data-reader-surface tabindex="-1" aria-label="@chapterHeading">
            <div class="manga-spread" data-manga-spread>
                <img data-manga-slot alt="" draggable="false" hidden />
                <img data-manga-slot alt="" draggable="false" hidden />
            </div>
            <div class="manga-strip" data-manga-strip hidden></div>
            @if (Model.NextChapter is { } upcoming)
            {
                <a class="manga-continue" href="@NextHref()" data-manga-continue hidden>
                    <span>@ui.Format("manga.reader.continueWith", ("chapter", ChapterName(upcoming.Number)))</span>
                    <partial name="_ReaderIcon" model="@("forward")" />
                </a>
            }
        </main>
    </div>

    <footer class="reader-frame-bottom" data-reader-chrome>
        <button class="reader-frame-icon reader-frame-desktop" type="button"
                data-reader-contents-toggle aria-controls="manga-reader-contents" aria-expanded="false"
                aria-label="@ui["reader.frame.contents"]" title="@ui["reader.frame.contents"]">
            <partial name="_ReaderIcon" model="@("contents")" />
        </button>

        <div class="reader-progress manga-progress">
            <button class="reader-frame-icon" type="button" data-reader-page-step="-1"
                    aria-label="@ui["reader.frame.previousPage"]" title="@ui["reader.frame.previousPage"]">
                <partial name="_ReaderIcon" model="@("back")" />
            </button>
            <div class="reader-progress-track manga-progress-track">
                <input type="range" min="0" max="@Math.Max(0, chapter.PageCount - 1)" step="1" value="@Model.InitialPage"
                       data-reader-progress-slider
                       aria-label="@ui["reader.frame.progressAria"]" />
                <div class="manga-ticks" data-manga-ticks></div>
            </div>
            <button class="reader-frame-icon" type="button" data-reader-page-step="1"
                    aria-label="@ui["reader.frame.nextPage"]" title="@ui["reader.frame.nextPage"]">
                <partial name="_ReaderIcon" model="@("forward")" />
            </button>
            <output class="reader-progress-text" data-reader-progress-text aria-live="off">@ui.Format("manga.reader.pagePosition", ("page", Model.InitialPage + 1), ("total", chapter.PageCount))</output>
        </div>

        <div class="reader-frame-tail">
            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-desktop" type="button"
                        data-reader-menu-toggle="view"
                        aria-haspopup="menu" aria-expanded="false" aria-controls="manga-menu-view"
                        aria-label="@ui["reader.frame.view"]" title="@ui["reader.frame.view"]">
                    <partial name="_ReaderIcon" model="@("view")" />
                </button>
                <div class="reader-menu reader-menu-up" id="manga-menu-view" data-reader-menu="view" role="menu" aria-label="@ui["reader.frame.view"]" hidden>
                    @foreach (var (mode, labelKey) in modes)
                    {
                        <button type="button" role="menuitemradio" aria-checked="false" data-manga-view="@mode">
                            @{ ModeIcon(mode); }
                            <span>@ui[labelKey]</span>
                            <partial name="_ReaderIcon" model="@("check")" />
                        </button>
                    }
                </div>
            </div>

            <button class="reader-frame-icon reader-frame-desktop" type="button" data-reader-fullscreen-toggle aria-pressed="false"
                    aria-label="@ui["reader.frame.fullscreen"]" title="@ui["reader.frame.fullscreen"]">
                <partial name="_ReaderIcon" model="@("fullscreen")" />
            </button>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-desktop" type="button"
                        data-reader-menu-toggle="settings"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="manga-menu-settings"
                        aria-label="@ui["reader.frame.settings"]" title="@ui["reader.frame.settings"]">
                    <partial name="_ReaderIcon" model="@("settings")" />
                </button>
                <div class="reader-menu reader-menu-up manga-sheet" id="manga-menu-settings" data-reader-menu="settings" role="dialog" aria-label="@ui["reader.frame.settings"]" hidden>
                    <section class="manga-sheet-card" aria-labelledby="manga-card-view">
                        <h2 id="manga-card-view">@ui["reader.frame.view"]</h2>
                        <div class="manga-sheet-choices">
                            @foreach (var (mode, labelKey) in modes)
                            {
                                <button type="button" aria-pressed="false" data-manga-view="@mode">
                                    <span class="manga-sheet-thumb">@{ ModeIcon(mode); }</span>
                                    <span>@ui[labelKey]</span>
                                </button>
                            }
                        </div>
                    </section>

                    <section class="manga-sheet-card" aria-labelledby="manga-card-zoom">
                        <h2 id="manga-card-zoom">@ui["manga.reader.card.zoom"]</h2>
                        <div class="manga-sheet-range">
                            <button type="button" data-manga-zoom-step="-10" aria-label="@ui["manga.reader.zoomOut"]" title="@ui["manga.reader.zoomOut"]">−</button>
                            <input type="range" min="50" max="300" step="10" value="100" data-manga-setting="zoom" aria-label="@ui["manga.reader.zoom"]" />
                            <button type="button" data-manga-zoom-step="10" aria-label="@ui["manga.reader.zoomIn"]" title="@ui["manga.reader.zoomIn"]">+</button>
                            <output data-manga-setting-output="zoom">100%</output>
                        </div>
                        <label class="manga-sheet-toggle" data-manga-modes="double">
                            <span>@ui["manga.reader.firstPageAlone"]</span>
                            <input type="checkbox" data-manga-setting="firstPageAlone" />
                        </label>
                        <label class="manga-sheet-toggle" data-manga-modes="single double horizontal">
                            <span>@ui["manga.reader.rightToLeft"]</span>
                            <input type="checkbox" data-manga-setting="rightToLeft" />
                        </label>
                        <label class="manga-sheet-toggle" hidden="@(Model.NextChapter is null)">
                            <span>@ui["manga.reader.autoNext"]</span>
                            <input type="checkbox" data-manga-setting="autoNext" />
                        </label>
                    </section>

                    <section class="manga-sheet-card" aria-labelledby="manga-card-scheme">
                        <h2 id="manga-card-scheme">@ui["reader.frame.colorScheme"]</h2>
                        <div class="manga-sheet-choices">
                            @foreach (var scheme in schemes)
                            {
                                <button type="button" aria-pressed="false" data-manga-scheme="@scheme">
                                    <span class="manga-sheet-thumb manga-scheme-thumb" data-scheme="@scheme">
                                        <img src="@(pageUrl)@Model.InitialPage" alt="" loading="lazy" decoding="async" />
                                    </span>
                                    <span>@ui[$"manga.reader.scheme.{scheme}"]</span>
                                </button>
                            }
                        </div>
                    </section>

                    <section class="manga-sheet-card" aria-labelledby="manga-card-more">
                        <h2 id="manga-card-more">@ui["manga.reader.card.more"]</h2>
                        <label class="manga-sheet-toggle">
                            <span>@ui["manga.reader.sharpen"]</span>
                            <input type="checkbox" data-manga-setting="sharpen" />
                        </label>
                        <label class="manga-sheet-toggle" data-manga-modes="single double">
                            <span>@ui["manga.reader.cropBorders"]</span>
                            <input type="checkbox" data-manga-setting="crop" />
                        </label>
                        <label class="manga-sheet-range manga-sheet-gap" data-manga-modes="double continuous horizontal">
                            <span>@ui["manga.reader.pageGap"]</span>
                            <input type="range" min="0" max="48" step="2" value="8" data-manga-setting="gap" />
                            <output data-manga-setting-output="gap">8 px</output>
                        </label>
                        <label class="manga-sheet-toggle">
                            <span>@ui["manga.reader.fitWidth"]</span>
                            <input type="checkbox" data-manga-setting="fitWidth" />
                        </label>
                    </section>

                    <div class="manga-sheet-actions">
                        <button class="button" type="button" data-manga-save-default>@ui["manga.reader.saveDefault"]</button>
                        <button class="button" type="button" data-manga-reset-series hidden="@(!Model.ReaderSettings.HasSeriesOverride)">@ui["manga.reader.resetToDefault"]</button>
                    </div>
                </div>
            </div>
        </div>

        <nav class="reader-frame-tools reader-frame-mobile" aria-label="@ui["reader.frame.toolsAria"]">
            <button type="button" data-reader-contents-toggle aria-controls="manga-reader-contents" aria-expanded="false">
                <partial name="_ReaderIcon" model="@("contents")" />
                <span>@ui["reader.frame.contents"]</span>
            </button>
            <button type="button" data-reader-contents-open="bookmarks">
                <partial name="_ReaderIcon" model="@("bookmark")" />
                <span>@ui["manga.reader.tabBookmarks"]</span>
            </button>
            <button type="button" data-reader-menu-toggle="settings" aria-haspopup="dialog" aria-expanded="false" aria-controls="manga-menu-settings">
                <span class="reader-frame-glyph-inline" aria-hidden="true"></span>
                <span>@ui["reader.frame.appearance"]</span>
            </button>
            <button type="button" data-reader-menu-toggle="more" aria-haspopup="menu" aria-expanded="false" aria-controls="manga-menu-more">
                <partial name="_ReaderIcon" model="@("more")" />
                <span>@ui["reader.frame.more"]</span>
            </button>
        </nav>
    </footer>

    <svg class="manga-filters" width="0" height="0" aria-hidden="true" focusable="false">
        <filter id="manga-sharpen" color-interpolation-filters="sRGB">
            <feConvolveMatrix order="3" preserveAlpha="true" kernelMatrix="0 -0.6 0 -0.6 3.4 -0.6 0 -0.6 0" />
        </filter>
    </svg>

    <form method="post" asp-page-handler="Preference" asp-route-id="@chapter.Id" data-preference-form hidden>
        <input type="hidden" name="scope" value="series" />
        <input type="hidden" name="mode" value="@Model.ReaderSettings.UiMode" />
    </form>
    <form method="post" asp-page-handler="ResetPreference" asp-route-id="@chapter.Id" data-reset-preference-form hidden></form>
    <form method="post" asp-page-handler="Progress" asp-route-id="@chapter.Id" data-progress-form hidden>
        <input type="hidden" name="pageIndex" value="@Model.InitialPage" />
    </form>
    <form method="post" asp-page-handler="Bookmark" asp-route-id="@chapter.Id" data-bookmark-form hidden>
        <input type="hidden" name="pageIndex" value="@Model.InitialPage" />
        <input type="hidden" name="label" value="" />
    </form>
    <form method="post" asp-page-handler="RemoveBookmark" asp-route-id="@chapter.Id" data-remove-bookmark-form hidden>
        <input type="hidden" name="bookmarkId" value="" />
    </form>

    <div class="manga-reader-toast" data-reader-toast hidden role="status" aria-live="polite"></div>
</div>
