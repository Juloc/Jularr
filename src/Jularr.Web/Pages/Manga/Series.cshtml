@page "/Manga/Series/{id:guid}"
@using Jularr.Web.Features.Tracking
@using Jularr.Web.Ui
@using Microsoft.AspNetCore.Html
@model Jularr.Web.Pages.Manga.SeriesModel
@{
    var ui = Model.Ui;
    var series = Model.Series;
    var current = Model.Progress is null
        ? null
        : series.Chapters.FirstOrDefault(x => x.Id == Model.Progress.ChapterId);
    ViewData["Title"] = series.Title;
}
@section Head {
    <link rel="stylesheet" href="~/css/manga.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/library-presentation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/franchise-links.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media-facts.css" asp-append-version="true" />
}

<div class="reading-type-switch manga-series-switch">
    <a href="/Novels">@ui["reading.novels.title"]</a>
    <a class="active" href="/Manga">@ui["reading.manga.title"]</a>
</div>

<header class="manga-series-header">
    <div class="manga-series-cover">
        @if (!string.IsNullOrWhiteSpace(series.CoverImageUrl))
        {
            <img src="@series.CoverImageUrl" alt="" referrerpolicy="no-referrer" />
        }
        else if (series.Chapters.FirstOrDefault() is { } preview)
        {
            <img src="/Manga/Read/@preview.Id?handler=Page&page=0" alt="" />
        }
    </div>

    <div>
        <h1>@series.Title</h1>
        <div class="manga-series-meta">
            @if (!string.IsNullOrWhiteSpace(series.NativeTitle))
            {
                <span lang="ja">@series.NativeTitle</span>
            }
            <span>@ui.Format("manga.series.chapterCount", ("count", series.Chapters.Count))</span>
            <span>@series.Direction.ToUpperInvariant()</span>
            @if (!string.IsNullOrWhiteSpace(series.Status))
            {
                <span>@series.Status.Replace("_", " ").ToLowerInvariant()</span>
            }
        </div>

        @if (Model.Facts is not null)
        {
            <partial name="_MediaFacts" model="Model.Facts" />
        }

        @if (!string.IsNullOrWhiteSpace(series.Description))
        {
            <p>@series.Description</p>
        }

        <div class="manga-series-actions">
            @if (current is not null)
            {
                <a class="button button-primary"
                   href="/Manga/Read/@current.Id?page=@Model.Progress!.PageIndex">
                    @ui.Format("manga.card.continueChapter", ("chapter", current.Number))
                </a>
            }
            else if (series.Chapters.FirstOrDefault() is { } first)
            {
                <a class="button button-primary" href="/Manga/Read/@first.Id">@ui["manga.series.startReading"]</a>
            }

            <a class="button"
               href="@Url.Page("/Settings/LearningScope", new {
                   mediaType = Jularr.Web.Features.Learning.LearningMediaType.Manga,
                   scope = "work",
                   workKey = series.Id.ToString(),
                   label = series.Title,
                   returnUrl = $"/Manga/Series/{series.Id}"
               })">
                @ui["manga.series.languageToolsLink"]
            </a>

            @if (Model.ManageWorkId is { } manageWorkId)
            {
                <a class="button" href="/Admin/Manga/Work/@manageWorkId">@ui["admin.manga.manage"]</a>
            }

            @if (Model.IsOwner)
            {
                Func<dynamic?, IHtmlContent> metadataGroup = @<div>
                        <form method="get" class="manga-metadata-search">
                            <input type="search" name="q" value="@Model.Query" placeholder="@ui["manga.series.matchPlaceholder"]" />
                            <button class="button" type="submit">@ui["common.search"]</button>
                        </form>

                        @if (Model.SearchError is string searchError)
                        {
                            <p class="muted" role="status">@searchError</p>
                        }

                        @if (Model.SearchResults.Count > 0)
                        {
                            <div class="manga-metadata-results">
                                @foreach (var candidate in Model.SearchResults)
                                {
                                    <article>
                                        @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                                        {
                                            <img src="@candidate.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                        }
                                        <div>
                                            <strong>@candidate.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                                            {
                                                <span lang="ja">@candidate.NativeTitle</span>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="Match" asp-route-id="@series.Id">
                                            <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                                            <button class="button" type="submit">@ui["manga.series.useCandidate"]</button>
                                        </form>
                                    </article>
                                }
                            </div>
                        }
                    </div>;

                    Func<dynamic?, IHtmlContent> filesGroup = @<div class="manga-inline-actions">
                        <a class="button" href="/Library/PresentationGroups/@series.Id?media=manga">@ui["library.presentation.manageLink"]</a>
                        <form method="post" asp-page-handler="Refresh" asp-route-id="@series.Id">
                            <button class="button" type="submit">@ui["manga.series.refreshSource"]</button>
                        </form>
                        <form method="post" asp-page-handler="Direction" asp-route-id="@series.Id">
                            <input type="hidden" name="direction" value="@(series.Direction == "rtl" ? "ltr" : "rtl")" />
                            <button class="button" type="submit">
                                @ui.Format("manga.series.switchDirection", ("direction", series.Direction == "rtl" ? "LTR" : "RTL"))
                            </button>
                        </form>
                    </div>;

                    Func<dynamic?, IHtmlContent> mappingGroup = @<div>
                        @if (Model.ExternalProgress is { } mangaMappingProgress)
                        {
                            var mangaMappingPanel = new ExternalProgressPanel(
                                mangaMappingProgress,
                                Url.Page(null, "ExternalProgress", new { id = series.Id })!,
                                MatchUrl: null,
                                MappingUrl: $"/Settings/MappingSegments?mediaType=manga&localId={series.Id}",
                                CanManageMapping: true,
                                Ui: ui);
                            <partial name="_ExternalProgressManage" model="mangaMappingPanel" />
                        }
                    </div>;

                    var mangaNeedsReview = Model.ExternalProgress?.MappingBasis == ExternalMappingBasis.NeedsReview;
                    var mangaGroups = new List<ManageSheetGroup>
                    {
                        new(ui["manage.group.metadata"], metadataGroup(null)),
                        new(ui["manage.group.files"], filesGroup(null))
                    };
                    if (Model.ExternalProgress is not null)
                    {
                        mangaGroups.Add(new ManageSheetGroup(ui["manage.group.mapping"], mappingGroup(null)));
                    }

                    var mangaManageSheet = new ManageSheetModel(
                        "manga-manage",
                        ui["manage.trigger"],
                        series.Title,
                        mangaGroups,
                        ui,
                        mangaNeedsReview ? new ManageSheetReviewBadge(ui["manage.needsReview"], "/Settings/MappingReview") : null,
                        OpenOnLoad: Model.Query.Length > 0);
                <partial name="_ManageSheet" model="mangaManageSheet" />
            }
        </div>
    </div>
</header>

<partial name="_FranchiseLinks" model="new Jularr.Web.Features.Franchises.FranchiseLinksViewModel(ui, Model.Franchises, Model.FranchiseGroups)" />

@await Component.InvokeAsync("UpcomingReleases", new { mediaType = Jularr.Web.Features.Calendar.ReleaseMediaType.Manga, mediaId = series.Id, ui })

@if (Model.ExternalProgress is { } externalProgress)
{
    var externalPanel = new Jularr.Web.Features.Tracking.ExternalProgressPanel(
        externalProgress,
        Url.Page(null, "ExternalProgress", new { id = series.Id })!,
        // Segment mappings can point at another AniList part than the series match.
        externalProgress.MappingBasis == Jularr.Web.Features.Tracking.ExternalMappingBasis.Matched
            ? series.CoverImageUrl
            : null,
        Ui: ui);
    <partial name="_ExternalProgress" model="externalPanel" />
}

<section class="manga-chapters">
    <h2>@ui["manga.chapters.title"]</h2>
    @if (Model.PresentationSections.Count > 0)
    {
        @foreach (var presentationSection in Model.PresentationSections)
        {
            <details class="presentation-group" open>
                <summary class="presentation-group-summary">
                    <span class="presentation-group-name">@presentationSection.Name</span>
                    <span class="presentation-group-count">@ui.Format("library.presentation.itemCount", ("count", presentationSection.Items.Count), ("units", ui["library.presentation.chapters"]))</span>
                </summary>
                @foreach (var chapter in presentationSection.Items)
                {
                    var isCurrent = current?.Id == chapter.Id;
                    var earlier = current is not null && chapter.Number < current.Number;
                    <a class="manga-chapter-row @(isCurrent ? "current" : earlier ? "earlier" : "")" href="/Manga/Read/@chapter.Id">
                        <span>@chapter.Number</span>
                        <strong>@chapter.Title</strong>
                        @if (chapter.VolumeNumber is int volume)
                        {
                            <small>@ui.Format("manga.series.volume", ("volume", volume))</small>
                        }
                        <small>@ui.Format("manga.series.pageCount", ("count", chapter.PageCount))</small>
                        @if (isCurrent)
                        {
                            <span class="manga-current-dot"></span>
                        }
                    </a>
                }
            </details>
        }
    }
    else
    {
        @foreach (var chapter in series.Chapters)
        {
            var isCurrent = current?.Id == chapter.Id;
            var earlier = current is not null && chapter.Number < current.Number;
            <a class="manga-chapter-row @(isCurrent ? "current" : earlier ? "earlier" : "")" href="/Manga/Read/@chapter.Id">
                <span>@chapter.Number</span>
                <strong>@chapter.Title</strong>
                @if (chapter.VolumeNumber is int volume)
                {
                    <small>@ui.Format("manga.series.volume", ("volume", volume))</small>
                }
                <small>@ui.Format("manga.series.pageCount", ("count", chapter.PageCount))</small>
                @if (isCurrent)
                {
                    <span class="manga-current-dot"></span>
                }
            </a>
        }
    }
</section>
