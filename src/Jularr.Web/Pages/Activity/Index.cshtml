@page
@model Jularr.Web.Pages.Activity.IndexModel
@using Jularr.Web.Features.Acquisition.Access
@using Jularr.Web.Features.Progress
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["nav.activity"];
    static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
    static string Shown(DateTime value) => value.ToString("yyyy-MM-dd HH:mm") + " UTC";
}
@section Head {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<header class="page-header profile-header">
    <h1>@ui["nav.activity"]</h1>
</header>

@if (Model.IsEmpty)
{
    <p class="muted">@ui["activity.empty"]</p>
}

@if (Model.Playback.Count > 0)
{
    <section class="activity-section" data-activity-playback>
        <h2>@ui["activity.watched"]</h2>
        <ol class="activity-list">
            @foreach (var entry in Model.Playback)
            {
                <li class="activity-row">
                    <a class="activity-title" href="/Library/Episode/@entry.EpisodeId">@entry.AnimeTitle</a>
                    <span class="activity-meta">
                        @ui.Format("home.continueWatching.episode", ("season", entry.SeasonNumber.ToString("00")), ("episode", entry.EpisodeNumber))
                        ·
                        @(entry.ReachedEnd
                            ? ui["home.history.finished"]
                            : ui.Format("home.history.stoppedAt", ("time", EpisodeProgressService.FormatPosition(entry.PositionMs))))
                    </span>
                    <time datetime="@Iso(entry.LastPlayedAt)">@Shown(entry.LastPlayedAt)</time>
                </li>
            }
        </ol>
    </section>
}

@if (Model.Reading.Count > 0)
{
    <section class="activity-section" data-activity-reading>
        <h2>@ui["activity.reading"]</h2>
        <ol class="activity-list">
            @foreach (var item in Model.Reading)
            {
                <li class="activity-row">
                    <a class="activity-title" href="@item.ResumeUrl">@item.Title</a>
                    <span class="activity-meta">
                        @Model.ReadingSummary(item)
                    </span>
                    <time datetime="@Iso(item.LastReadAt)">@Shown(item.LastReadAt)</time>
                </li>
            }
        </ol>
    </section>
}

@if (Model.Requests.Count > 0)
{
    <section class="activity-section" data-activity-requests>
        <h2>@ui["activity.requests"]</h2>
        <ol class="activity-list">
            @foreach (var request in Model.Requests)
            {
                var status = AcquisitionAccessNames.Status(request.Status);
                <li class="activity-row">
                    @if (request.ResultUrl is { } resultUrl)
                    {
                        <a class="activity-title" href="@resultUrl">@request.Title</a>
                    }
                    @if (request.ResultUrl is null)
                    {
                        <strong class="activity-title">@request.Title</strong>
                    }
                    <span class="activity-meta">
                        @ui["admin.requests.kind." + AcquisitionAccessNames.Kind(request.Kind)]
                        @if (!string.IsNullOrWhiteSpace(request.Subtitle))
                        {
                            <text> · @request.Subtitle</text>
                        }
                        <span class="status-pill request-status-@status">@ui[ConsumerAcquisitionLabels.StatusKey(status)]</span>
                    </span>
                    <time datetime="@Iso(request.UpdatedAt)">@Shown(request.UpdatedAt)</time>
                </li>
            }
        </ol>
    </section>
}
