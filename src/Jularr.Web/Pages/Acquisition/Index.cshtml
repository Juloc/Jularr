@page
@model Jularr.Web.Pages.Acquisition.IndexModel
@using Jularr.Web.Features.Acquisition.Import
@using Jularr.Web.Features.Acquisition.Monitoring
@using Jularr.Web.Features.Acquisition.Ownership
@using Jularr.Web.Features.Acquisition.Pipeline
@using Jularr.Web.Features.Acquisition.Prowlarr
@using Jularr.Web.Features.Operations
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["acquisition.title"];
    var overview = Model.Overview;
    var scheduler = Model.Scheduler;
    var search = Model.SearchResult;

    string DescribeMode(AnimeManagementMode mode) => mode switch
    {
        AnimeManagementMode.ReadOnlyCoexistence => ui["settings.sonarrMigration.mode.readOnlyCoexistence"],
        AnimeManagementMode.ParallelAcquisition => ui["settings.sonarrMigration.mode.parallelAcquisition"],
        AnimeManagementMode.JularrManaged => ui["settings.sonarrMigration.mode.jularrManaged"],
        _ => mode.ToString()
    };

    string LogLevelLabel(OperationLogLevel level) => level switch
    {
        OperationLogLevel.Information => ui["admin.logs.level.information"],
        OperationLogLevel.Warning => ui["admin.logs.level.warning"],
        OperationLogLevel.Error => ui["admin.logs.level.error"],
        _ => level.ToString()
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
}

<header class="page-header acquisition-console-header">
    <div>
        <span class="eyebrow">@ui["acquisition.eyebrow"]</span>
        <h1>@ui["acquisition.title"]</h1>
        <p>@ui["acquisition.subtitle"]</p>
    </div>
    <form method="post" asp-page-handler="RunNow">
        <button class="button button-primary" type="submit" disabled="@(!Model.ProwlarrConfigured)">@ui["acquisition.searchAllNow"]</button>
    </form>
</header>

<section class="acquisition-signal-grid" aria-label="@ui["acquisition.title"]">
    <a href="#active-downloads" class="acquisition-signal-card">
        <span>@ui["acquisition.downloadsHeading"]</span>
        <strong>@overview.ActiveDownloads.Count</strong>
        <small>@ui.Format("acquisition.activeCount", ("count", overview.ActiveDownloads.Count))</small>
    </a>
    <a href="#wanted" class="acquisition-signal-card">
        <span>@ui["acquisition.wantedHeading"]</span>
        <strong>@overview.Wanted.Count</strong>
        <small>@ui.Format("acquisition.episodesCount", ("count", overview.Wanted.Count))</small>
    </a>
    <a href="#manual-import" class="acquisition-signal-card @(overview.ImportsNeedingAttention.Count > 0 ? "needs-attention" : "")">
        <span>@ui["acquisition.needsDecisionHeading"]</span>
        <strong>@overview.ImportsNeedingAttention.Count</strong>
        <small>@ui.Format("acquisition.importsCount", ("count", overview.ImportsNeedingAttention.Count))</small>
    </a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="acquisition-notice" role="status">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}
@if (!string.IsNullOrWhiteSpace(Model.ConfigurationError))
{
    <p class="metadata-error" role="alert">@Model.ConfigurationError</p>
}

<div class="settings-grid acquisition-control-grid">
    <section class="panel">
        <div class="panel-heading"><h2>@ui["acquisition.connectionsHeading"]</h2></div>
        <div class="acquisition-connection-list">
            <div class="acquisition-connection">
                <a asp-page="/Admin/Usenet">@ui["acquisition.indexersLink"]</a>
                <span class="status-pill @(Model.ProwlarrConfigured ? "status-ok" : "status-warn")">@(Model.ProwlarrConfigured ? ui["acquisition.configured"] : ui["acquisition.notConfigured"])</span>
            </div>
            <div class="acquisition-connection">
                <a asp-page="/Admin/Usenet">@ui["acquisition.downloadClientsLink"]</a>
                <span class="status-pill @(Model.SabnzbdConfigured ? "status-ok" : "status-warn")">@(Model.SabnzbdConfigured ? ui["acquisition.configured"] : ui["acquisition.notConfigured"])</span>
            </div>
            <div class="acquisition-connection">
                <a asp-page="/Settings/SonarrMigration">@ui["settings.sonarrMigration.title"]</a>
                <span class="muted">@ui["acquisition.perAnimeManagementModeNote"]</span>
            </div>
            <div class="acquisition-connection">
                <a asp-page="/Settings/Acquisition">@ui["settings.acquisition.heading"]</a>
                <span class="muted">@ui["acquisition.importModeNote"]</span>
            </div>
        </div>
    </section>
</div>

@if (Model.RecentHistory.Count > 0)
{
    <section class="panel">
        <div class="panel-heading"><h2>@ui["acquisition.recentHistoryHeading"]</h2></div>
        <div class="acquisition-history-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@ui["acquisition.column.when"]</th>
                        <th>@ui["acquisition.column.anime"]</th>
                        <th>@ui["acquisition.column.episode"]</th>
                        <th>@ui["acquisition.column.event"]</th>
                        <th>@ui["acquisition.column.release"]</th>
                        <th>@ui["acquisition.column.quality"]</th>
                        <th>@ui["acquisition.column.score"]</th>
                        <th>@ui["acquisition.column.reason"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.RecentHistory)
                    {
                        <tr>
                            <td>@entry.OccurredAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@(Model.AnimeTitles.TryGetValue(entry.AnimeId, out var title) ? title : entry.AnimeId.ToString())</td>
                            <td>S@(entry.SeasonNumber.ToString("00"))E@(entry.EpisodeNumber.ToString("00"))</td>
                            <td>@entry.EventKind</td>
                            <td>@entry.ReleaseTitle</td>
                            <td>@entry.QualityKey</td>
                            <td>@entry.Score</td>
                            <td>@entry.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (search is not null)
{
    <section class="panel" id="search-results">
        <div class="panel-heading">
            <h2>@ui.Format("acquisition.searchResultsHeading", ("title", search.Target.Anime.Title), ("scope", search.Episode is { } searched ? AnimeAcquisitionPipeline.Label(searched) : search.Mode.ToString()))</h2>
            <a asp-page="/Acquisition/Index">@ui["acquisition.close"]</a>
        </div>
        @if (search.Error is not null)
        {
            <p class="metadata-error">@search.Error</p>
        }
        @foreach (var warning in search.Warnings)
        {
            <p class="muted">@ui.Format("acquisition.prowlarrWarning", ("message", warning.Message), ("query", warning.Query))</p>
        }
        @if (search.Error is null && search.Candidates.Count == 0)
        {
            <p class="muted">@ui["acquisition.noProwlarrResults"]</p>
        }
        else if (search.Candidates.Count > 0)
        {
            <div class="operation-list">
                @foreach (var candidate in search.Candidates)
                {
                    <div class="operation-row operation-row-detailed">
                        <div class="operation-copy acquisition-wrap">
                            <div class="operation-title-line">
                                <strong>@candidate.Release.Title</strong>
                            </div>
                            <span>
                                @candidate.Score.QualityKey · @ui.Format("acquisition.scoreValue", ("score", candidate.Score.Score))
                                · @(candidate.Release.Indexer ?? ui["acquisition.unknownIndexer"])
                                @if (candidate.Release.SizeBytes is { } size)
                                {
                                    <text> · @((size / 1024d / 1024d / 1024d).ToString("0.00")) GB</text>
                                }
                                @if (candidate.Release.AgeDays is { } age)
                                {
                                    <text> · @age d</text>
                                }
                            </span>
                            <small>@candidate.Decision.Reason @string.Join(" ", candidate.Score.RejectionReasons)</small>
                        </div>
                        <div class="operation-row-meta">
                            <span class="status-pill @(candidate.Decision.Grab ? "status-ok" : "status-warn")">@(candidate.Decision.Grab ? ui["acquisition.accepted"] : ui["acquisition.rejected"])</span>
                            @if (candidate.Release.InternalDownloadUri is not null)
                            {
                                <form method="post" asp-page-handler="Grab">
                                    <input type="hidden" name="animeKey" value="@search.Target.Anime.Key" />
                                    <input type="hidden" name="season" value="@Model.Season" />
                                    <input type="hidden" name="episode" value="@Model.Episode" />
                                    <input type="hidden" name="mode" value="@search.Mode" />
                                    <input type="hidden" name="releaseIdentity" value="@candidate.Release.Identity" />
                                    <button class="button @(candidate.Decision.Grab ? "button-primary" : "")" type="submit">@(candidate.Decision.Grab ? ui["acquisition.grab"] : ui["acquisition.grabAnyway"])</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@if (overview.ImportsNeedingAttention.Count > 0)
{
    <section class="panel" id="manual-import">
        <div class="panel-heading">
            <h2>@ui["acquisition.needsDecisionHeading"]</h2>
            <span>@ui.Format("acquisition.importsCount", ("count", overview.ImportsNeedingAttention.Count))</span>
        </div>
        @foreach (var record in overview.ImportsNeedingAttention)
        {
            <article class="acquisition-import">
                <div class="operation-title-line">
                    <strong>@record.AnimeTitle</strong>
                    <span class="status-pill status-warn">@(record.Status == AnimeImportStatus.Failed ? ui["acquisition.failed"] : ui["acquisition.manualImport"])</span>
                </div>
                <p class="muted">@record.Message</p>
                @if (!string.IsNullOrWhiteSpace(record.DownloadPath))
                {
                    <p class="muted acquisition-wrap">@ui["acquisition.downloadLabel"] <code>@record.DownloadPath</code></p>
                }
                @foreach (var file in record.Files.Where(file => file.Status is AnimeImportFileStatus.ManualRequired or AnimeImportFileStatus.Failed))
                {
                    var target = file.Targets.FirstOrDefault();
                    <div class="acquisition-import-file">
                        <div class="acquisition-wrap">
                            <strong>@System.IO.Path.GetFileName(file.SourcePath)</strong>
                            <small class="muted">@(file.Error ?? string.Join(" ", file.Reasons))</small>
                        </div>
                        <form method="post" asp-page-handler="ManualImport" class="acquisition-inline-form">
                            <input type="hidden" name="recordId" value="@record.Id" />
                            <input type="hidden" name="sourcePath" value="@file.SourcePath" />
                            <label>
                                <span>@ui["acquisition.seasonLabel"]</span>
                                <input type="number" name="season" min="0" value="@(target?.SeasonNumber ?? 1)" required />
                            </label>
                            <label>
                                <span>@ui["acquisition.episodeLabel"]</span>
                                <input type="number" name="episode" min="1" value="@target?.EpisodeNumber" required />
                            </label>
                            <button class="button" type="submit">@ui["acquisition.import"]</button>
                        </form>
                    </div>
                }
                <form method="post" asp-page-handler="DismissImport" class="inline-actions">
                    <input type="hidden" name="recordId" value="@record.Id" />
                    @if (record.ImportOperationId is { } importOperation)
                    {
                        <a asp-page="/Admin/Operation" asp-route-id="@importOperation">@ui["acquisition.details"]</a>
                    }
                    <button class="button" type="submit">@ui["acquisition.dismiss"]</button>
                </form>
            </article>
        }
    </section>
}

<section class="panel" id="active-downloads">
    <div class="panel-heading">
        <h2>@ui["acquisition.downloadsHeading"]</h2>
        <span>@ui.Format("acquisition.activeCount", ("count", overview.ActiveDownloads.Count))</span>
    </div>
    @if (overview.ActiveDownloads.Count == 0)
    {
        <p class="muted">@ui["acquisition.noDownloadsRunning"]</p>
    }
    else
    {
        <div class="operation-list">
            @foreach (var download in overview.ActiveDownloads)
            {
                <a class="operation-row operation-row-detailed" asp-page="/Admin/Operation" asp-route-id="@download.Operation.Id">
                    <div class="operation-copy">
                        <strong>@download.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(download.Operation.Message))
                        {
                            <small>@download.Operation.Message</small>
                        }
                        @if (download.Operation.ProgressPercent is { } progress)
                        {
                            <div class="operation-progress" aria-label="@progress% complete">
                                <span style="width:@progress%"></span>
                            </div>
                        }
                    </div>
                    <div class="operation-row-meta">
                        <span class="status-pill">@download.Operation.StatusLabel</span>
                    </div>
                </a>
            }
        </div>
    }
</section>

<section class="panel" id="wanted">
    <div class="panel-heading">
        <h2>@ui["acquisition.wantedHeading"]</h2>
        <span>@ui.Format("acquisition.episodesCount", ("count", overview.Wanted.Count))</span>
    </div>
    @if (overview.Wanted.Count == 0)
    {
        <p class="muted">@ui["acquisition.nothingWanted"]</p>
    }
    else
    {
        <div class="operation-list">
            @foreach (var row in overview.Wanted.Take(200))
            {
                <div class="operation-row">
                    <div class="operation-copy">
                        <strong>@row.Title · @AnimeAcquisitionPipeline.Label(row.Key)</strong>
                        <span>
                            @ui.Format(
                                "acquisition.wantedSince",
                                ("reason", row.Reason == AnimeWantedReason.Missing ? ui["acquisition.reason.missing"] : ui["acquisition.reason.upgradeWanted"]),
                                ("time", row.SinceUtc.ToLocalTime().ToString("g")))
                        </span>
                    </div>
                    <div class="operation-row-meta">
                        <a class="button"
                           asp-page="/Acquisition/Index"
                           asp-route-search="@row.Key.AnimeKey"
                           asp-route-season="@row.Key.SeasonNumber"
                           asp-route-episode="@row.Key.EpisodeNumber"
                           asp-route-mode="Episode"
                           asp-fragment="search-results">@ui["common.search"]</a>
                    </div>
                </div>
            }
        </div>
        @if (overview.Wanted.Count > 200)
        {
            <p class="muted">@ui.Format("acquisition.moreWantedNotShown", ("count", overview.Wanted.Count - 200))</p>
        }
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["acquisition.monitoredHeading"]</h2>
        <span>@overview.Monitored.Count</span>
    </div>
    @if (overview.Monitored.Count == 0)
    {
        <p class="muted">@ui["acquisition.noneMonitored"]</p>
    }
    else
    {
        <div class="operation-list">
            @foreach (var anime in overview.Monitored)
            {
                <div class="operation-row">
                    <div class="operation-copy">
                        <a asp-page="/Library/Anime" asp-route-id="@anime.AnimeId" asp-fragment="acquisition"><strong>@anime.Title</strong></a>
                        <span>
                            @ui.Format(
                                "acquisition.monitoredSummary",
                                ("mode", DescribeMode(anime.Mode)),
                                ("profile", anime.ProfileId),
                                ("wanted", anime.WantedCount))
                            @if (anime.IndexerIds.Length > 0)
                            {
                                <text> · @ui.Format("acquisition.indexersList", ("list", string.Join(", ", anime.IndexerIds)))</text>
                            }
                        </span>
                    </div>
                    <div class="operation-row-meta inline-actions">
                        <a class="button" asp-page="/Acquisition/Index" asp-route-search="@anime.AnimeKey" asp-route-mode="Anime" asp-fragment="search-results">@ui["acquisition.interactive"]</a>
                        <form method="post" asp-page-handler="SearchAnime">
                            <input type="hidden" name="animeKey" value="@anime.AnimeKey" />
                            <button class="button" type="submit" disabled="@(anime.Mode == AnimeManagementMode.ReadOnlyCoexistence)">@ui["acquisition.searchNow"]</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["acquisition.recentDecisionsHeading"]</h2>
        <a asp-page="/Admin/Logs" asp-route-module="@AnimeAcquisitionPipeline.LogModule">@ui["acquisition.all"]</a>
    </div>
    @if (overview.RecentDecisions.Count == 0)
    {
        <p class="muted">@ui["acquisition.noDecisionsYet"]</p>
    }
    else
    {
        <div class="admin-log-list">
            @foreach (var entry in overview.RecentDecisions)
            {
                <a class="admin-log-row admin-log-@entry.Level.ToString().ToLowerInvariant()"
                   asp-page="/Admin/Operation"
                   asp-route-id="@entry.OperationId">
                    <time>@entry.CreatedAtUtc.ToLocalTime().ToString("g")</time>
                    <span>@LogLevelLabel(entry.Level)</span>
                    <strong>@entry.Module</strong>
                    <p>@entry.Message</p>
                </a>
            }
        </div>
    }
</section>

@if (overview.RecentImports.Count > 0)
{
    <section class="panel">
        <div class="panel-heading"><h2>@ui["acquisition.recentImportsHeading"]</h2></div>
        <div class="operation-list">
            @foreach (var record in overview.RecentImports)
            {
                <div class="operation-row">
                    <div class="operation-copy">
                        <strong>@record.AnimeTitle</strong>
                        <small>@record.Message</small>
                    </div>
                    <div class="operation-row-meta">
                        <span class="status-pill @(record.Status == AnimeImportStatus.Imported ? "status-ok" : "")">@record.Status</span>
                        <small>@record.UpdatedAtUtc.ToLocalTime().ToString("g")</small>
                    </div>
                </div>
            }
        </div>
    </section>
}
