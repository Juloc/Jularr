@page
@model Jularr.Web.Pages.Notifications.IndexModel
@using Jularr.Web.Features.Events
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["notifications.inbox.title"];

    string MessageText(Jularr.Web.Features.Notifications.NotificationItem item)
    {
        var pairs = (item.MessageParams ?? new Dictionary<string, string>())
            .Select(pair => (pair.Key, (object?)pair.Value))
            .ToArray();
        return ui.Format(item.MessageKey, pairs);
    }
}

<header class="page-header">
    <div>
        <h1>@ui["notifications.inbox.title"]</h1>
    </div>
</header>

<nav class="notification-tabs" aria-label="@ui["notifications.inbox.title"]">
    <a class="@(!Model.UnreadOnly ? "active" : "")" asp-route-unreadOnly="false">@ui["notifications.inbox.filterAll"]</a>
    <a class="@(Model.UnreadOnly ? "active" : "")" asp-route-unreadOnly="true">@ui["notifications.inbox.filterUnread"]</a>
</nav>

<div class="notification-actions">
    <form method="post" asp-page-handler="MarkAllRead">
        <input type="hidden" name="unreadOnly" value="@Model.UnreadOnly" />
        <button class="button" type="submit">@ui["notifications.inbox.markAllRead"]</button>
    </form>
    <form method="post" asp-page-handler="ClearRead">
        <input type="hidden" name="unreadOnly" value="@Model.UnreadOnly" />
        <button class="button" type="submit">@ui["notifications.inbox.clearRead"]</button>
    </form>
    <a class="button" href="/Profile/Notifications">@ui["notifications.inbox.settingsLink"]</a>
</div>

<section class="panel">
    @if (Model.Items.Count == 0)
    {
        <p class="muted">@ui[Model.UnreadOnly ? "notifications.inbox.emptyUnread" : "notifications.inbox.empty"]</p>
    }
    else
    {
        <div class="notification-list">
            @foreach (var item in Model.Items)
            {
                <div class="notification-row @(item.IsRead ? "" : "unread")">
                    <div class="notification-copy">
                        <div class="notification-title-line">
                            @if (!item.IsRead)
                            {
                                <span class="notification-dot" aria-hidden="true"></span>
                            }
                            <span>@MessageText(item)</span>
                            @if (item.OccurrenceCount > 1)
                            {
                                <span class="notification-occurrence">@ui.Format("notifications.inbox.occurrences", ("count", item.OccurrenceCount))</span>
                            }
                        </div>
                        <span class="notification-meta">
                            @ui[JularrEventCategories.Of(item.Category).LabelKey] · @item.CreatedAtUtc.ToLocalTime().ToString("g")
                        </span>
                    </div>
                    <div class="notification-row-actions">
                        @if (Jularr.Web.Features.Notifications.NotificationLinks.LocalPath(item.DeepLink) is { } deepLink)
                        {
                            <a class="button" href="@deepLink">@ui["notifications.inbox.viewLink"]</a>
                        }
                        @if (!item.IsRead)
                        {
                            <form method="post" asp-page-handler="MarkRead">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="unreadOnly" value="@Model.UnreadOnly" />
                                <button class="button" type="submit">@ui["notifications.inbox.markRead"]</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>
