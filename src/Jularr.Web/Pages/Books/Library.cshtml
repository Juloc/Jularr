@page "/Books/Library/{id:guid}"
@using Jularr.Web.Ui
@model Jularr.Web.Pages.Books.LibraryModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.Book.Work.MetadataTitle ?? Model.Book.Work.Title;
    var title = Model.Book.Work.MetadataTitle ?? Model.Book.Work.Title;
    var translatedCount = Model.Book.Chapters.Count(x => x.HasTranslation);
    var firstChapter = Model.Book.Progress?.ChapterId
        ?? Model.Book.Chapters.FirstOrDefault()?.Id;
    var currentChapter = Model.Book.Progress is null
        ? null
        : Model.Book.Chapters.FirstOrDefault(x => x.Id == Model.Book.Progress.ChapterId);
    var progressPercent = Model.Book.Progress?.PositionPermille / 10 ?? 0;
    var unitLabel = Model.IsPdf
        ? ui["books.library.pagesHeading"]
        : ui["books.library.chaptersHeading"];
    var backLink = new ContextBackLinkModel(
        $"/Books?lang={Model.TargetLanguage}",
        $"← {ui["nav.books"]}",
        "books-back");
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/context-back-link.js" asp-append-version="true"></script>
}

<partial name="_ContextBackLink" model="backLink" />

<header class="book-detail-header book-library-header book-reading-hero">
    <div class="book-detail-cover">
        @if (!string.IsNullOrWhiteSpace(Model.Book.Work.CoverImageUrl))
        {
            <img src="@Model.Book.Work.CoverImageUrl"
                 alt=""
                 referrerpolicy="no-referrer" />
        }
        else
        {
            <span>B</span>
        }
    </div>

    <div class="book-detail-copy">
        <div class="reading-detail-kicker">
            <span>@unitLabel</span>
            <span>@Model.Book.Chapters.Count</span>
            @if (translatedCount > 0)
            {
                <span>@translatedCount @ui["books.library.translated"]</span>
            }
        </div>
        <h1>@title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Book.Work.Author))
        {
            <p class="book-author">@Model.Book.Work.Author</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Book.Work.Description))
        {
            <p class="book-summary">@Model.Book.Work.Description</p>
        }
        @if (Model.Book.Subjects.Count > 0)
        {
            <div class="book-tags">
                @foreach (var genre in Model.Book.Subjects.Take(8))
                {
                    <span>@genre</span>
                }
            </div>
        }

        @if (Model.Book.Progress is not null)
        {
            <section class="reading-progress-card" aria-label="@ui["reader.continueReading"]">
                <div>
                    <span>@ui["reader.continueReading"]</span>
                    @if (currentChapter is not null)
                    {
                        <strong>@currentChapter.Title</strong>
                    }
                </div>
                <strong>@progressPercent%</strong>
                <div class="reading-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
                    <span style="width:@progressPercent%"></span>
                </div>
            </section>
        }

        <div class="book-actions book-reading-primary-actions">
            @if (firstChapter is Guid chapterId)
            {
                <a class="button button-primary"
                   href="/Books/Read/@chapterId?lang=@Model.TargetLanguage">
                    @(Model.Book.Progress is null ? ui["books.library.startReading"] : ui["reader.continueReading"])
                </a>
            }
            <a class="button"
               href="@Url.Page("/Settings/LearningScope", new {
                   mediaType = Jularr.Web.Features.Learning.LearningMediaType.Book,
                   scope = "work",
                   workKey = Model.Book.Work.Id.ToString(),
                   label = title,
                   returnUrl = $"/Books/Library/{Model.Book.Work.Id}?lang={Model.TargetLanguage}"
               })">
                @ui["books.library.languageToolsLearning"]
            </a>
        </div>

        <div class="book-language-row book-reading-language-row">
            @if (Model.LanguageEdition.IsMeaningful)
            {
                <partial name="_LanguageEditionSelector" model="Model.LanguageEdition" />
            }
        </div>

        @* Reflects the cache, not the resolved capability: showing how many
           chapters already have a translated variant is core reader status
           and must not depend on Learning (#369). *@
        <div class="book-translation-summary">
            @if (Model.SourceIsTarget)
            {
                <span>@ui["books.library.originalLanguageSelected"]</span>
            }
            else
            {
                <span>@ui.Format(Model.IsPdf ? "books.library.pagesTranslated" : "books.library.chaptersTranslated", ("translated", translatedCount), ("total", Model.Book.Chapters.Count))</span>
                <div class="book-card-progress">
                    <span style="width:@(Model.Book.Chapters.Count == 0 ? 0 : translatedCount * 100 / Model.Book.Chapters.Count)%"></span>
                </div>
            }
        </div>

        <partial name="_OfflineLibraryAction" model="new Jularr.Web.Features.OfflineLibrary.OfflineLibraryActionViewModel(Model.Book.Work.Id, title)" />
    </div>
</header>

@if (Model.IsOwner)
{
    <details class="book-library-management">
        <summary>@ui["books.library.manageBook"]</summary>
        <div class="book-library-management-actions">
            <a class="button" href="/Books/ChapterArt/@Model.Book.Work.Id">@ui["chapterArt.title"]</a>
            @if (!Model.SourceIsTarget && Model.TranslationEnabled)
            {
                <form method="post"
                      asp-page-handler="Regenerate"
                      asp-route-id="@Model.Book.Work.Id"
                      onsubmit="return confirm('@ui.Format("books.library.confirmRegenerate", ("language", Jularr.Web.Features.Books.BookLanguageCatalog.GetName(Model.TargetLanguage)))');">
                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                    <button class="button" type="submit">
                        @ui.Format("books.library.regenerateButton", ("language", Jularr.Web.Features.Books.BookLanguageCatalog.GetName(Model.TargetLanguage)))
                    </button>
                </form>
            }

            @if (Model.IsPdf)
            {
                <form method="post" asp-page-handler="ReanalyzePdf" asp-route-id="@Model.Book.Work.Id">
                    <button class="button" type="submit">@ui["books.library.pdfReanalyze"]</button>
                </form>
            }

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Book.Work.Id"
                  onsubmit="return confirm('@ui["books.library.confirmRemove"]');">
                <button class="button book-danger-button" type="submit">
                    @ui["books.library.removeButton"]
                </button>
            </form>
        </div>
        @if (Model.PdfAnalysis is { } analysis)
        {
            <p>
                @ui.Format(
                    "books.library.pdfAnalysis",
                    ("class", ui["books.library.pdfClass." + analysis.Classification.Class.ToString().ToLowerInvariant()]),
                    ("confidence", (int)Math.Round(analysis.Classification.Decision.Confidence * 100)),
                    ("logical", analysis.LogicalPages.Count),
                    ("physical", analysis.PhysicalPageCount),
                    ("duplicates", analysis.Diagnostics.DuplicatePagesRemoved),
                    ("furniture", analysis.Diagnostics.FurnitureParagraphsRemoved),
                    ("version", analysis.AnalyzerVersion))
            </p>
        }
        <p>
            @ui["books.library.manageNote"]
        </p>
    </details>
}

<section class="book-chapter-list">
    <div class="books-results-heading">
        <strong>@(Model.IsPdf ? ui["books.library.pagesHeading"] : ui["books.library.chaptersHeading"])</strong>
        <span>@Model.Book.Chapters.Count</span>
    </div>

    @if (Model.IsPdf)
    {
        @* A PDF's chapters are its pages: listed as ranges, each opening at its first page. *@
        @foreach (var range in Model.PageRanges)
        {
            <a class="book-chapter-row book-page-range"
               href="/Books/Read/@range.FirstChapterId?lang=@Model.TargetLanguage">
                <strong>@ui.Format("books.library.pageRange", ("from", range.FirstPage), ("to", range.LastPage))</strong>
                @if (Model.SourceIsTarget)
                {
                    <small>@ui["books.read.original"]</small>
                }
                else if (range.TranslatedCount == range.PageCount)
                {
                    <small class="ready">@ui["books.library.translated"]</small>
                }
                else if (range.TranslatedCount > 0)
                {
                    <small>@ui.Format("books.library.pagesTranslated", ("translated", range.TranslatedCount), ("total", range.PageCount))</small>
                }
                else
                {
                    <small>@ui["books.library.originalAvailable"]</small>
                }
            </a>
        }
    }
    else
    {
        @foreach (var chapter in Model.Book.Chapters)
        {
            <a class="book-chapter-row"
               href="/Books/Read/@chapter.Id?lang=@Model.TargetLanguage">
                <span class="book-chapter-number">@chapter.Number</span>
                <strong>@chapter.Title</strong>
                @if (Model.SourceIsTarget)
                {
                    <small>@ui["books.read.original"]</small>
                }
                else if (chapter.HasTranslation)
                {
                    <small class="ready">@ui["books.library.translated"]</small>
                }
                else
                {
                    <small>@ui["books.library.originalAvailable"]</small>
                }
            </a>
        }
    }
</section>
