@page "/Books/Library/{id:guid}"
@using Jularr.Web.Features.Books
@using Jularr.Web.Features.MediaFacts
@using Jularr.Web.Ui
@model Jularr.Web.Pages.Books.LibraryModel
@{
    var ui = Model.Ui;
    var work = Model.Book.Work;
    var title = work.MetadataTitle ?? work.Title;
    var totalUnits = Model.Book.Chapters.Count;
    var translatedUnits = Model.TranslatedCount;
    var job = Model.TranslationJob;
    var targetName = BookLanguageCatalog.GetName(Model.TargetLanguage);
    var progressText = ui.Format(Model.IsPdf ? "books.library.pagesTranslated" : "books.library.chaptersTranslated", ("translated", translatedUnits), ("total", totalUnits));
    var translationPercent = totalUnits == 0 ? 0 : translatedUnits * 100 / totalUnits;
    var firstChapter = Model.Book.Progress?.ChapterId ?? Model.Book.Chapters.FirstOrDefault()?.Id;
    var currentChapter = Model.Book.Progress is null ? null : Model.Book.Chapters.FirstOrDefault(x => x.Id == Model.Book.Progress.ChapterId);
    var progressPercent = Model.Book.Progress?.PositionPermille / 10 ?? 0;
    var unitLabel = Model.IsPdf ? ui["books.library.pagesHeading"] : ui["books.library.chaptersHeading"];
    var coverUrl = string.IsNullOrWhiteSpace(work.CoverImageUrl)
        ? null
        : work.CoverImageUrl.StartsWith("/Books/Cover/", StringComparison.Ordinal) ? work.CoverImageUrl + "?w=480" : work.CoverImageUrl;
    var learningUrl = Url.Page("/Settings/LearningScope", new
    {
        mediaType = Jularr.Web.Features.Learning.LearningMediaType.Book,
        scope = "work",
        workKey = work.Id.ToString(),
        label = title,
        returnUrl = $"/Books/Library/{work.Id}?lang={Model.TargetLanguage}"
    });
    var languageChips = Model.EditionRows
        .Where(x => x.IsOriginal || x.TranslatedUnits > 0)
        .Select(x => new MediaFactsLanguageChip(
            x.Code.ToUpperInvariant(),
            x.IsOriginal || x.TranslatedUnits >= totalUnits ? null : ui.Format("mediaFacts.coverageFraction", ("available", x.TranslatedUnits), ("total", totalUnits)),
            !x.IsOriginal && x.TranslatedUnits < totalUnits,
            !x.IsOriginal && x.TranslatedUnits < totalUnits ? ui["mediaFacts.coveragePartial"] : null))
        .ToList();
    var facts = new MediaFactsStripModel(
        ui["mediaFacts.factsAria"],
        null,
        [],
        ui["mediaFacts.languagesAria"],
        [new MediaFactsLanguageGroup(ui["mediaFacts.text"], MediaFactsLanguageUsage.Text, languageChips)]);
    var backLink = new ContextBackLinkModel($"/Books?lang={Model.TargetLanguage}", $"← {ui["nav.books"]}", "books-back");
    ViewData["Title"] = title;
}
@section Head {
    <link rel="stylesheet" href="~/css/books.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media-facts.css" asp-append-version="true" />
    @if (job.IsActive)
    {
        <meta http-equiv="refresh" content="8" />
    }
}
@section Scripts {
    <script src="~/js/context-back-link.js" asp-append-version="true"></script>
    <script src="~/js/book-cover-fallback.js" asp-append-version="true" defer></script>
    <script src="~/js/book-library-detail.js" asp-append-version="true" defer></script>
}

<partial name="_ContextBackLink" model="backLink" />

<header class="book-detail-header book-reading-hero"@(coverUrl is null ? "" : Html.Raw($" style=\"--hero-cover:url('{coverUrl}')\""))>
    <div class="book-detail-cover">
        @if (coverUrl is not null)
        {
            <img src="@coverUrl" alt="" referrerpolicy="no-referrer" data-book-cover data-title="@title" />
        }
        else
        {
            <span class="book-cover-placeholder">@title</span>
        }
    </div>

    <div class="book-detail-copy">
        <div class="reading-detail-kicker">
            <span>@unitLabel</span>
            <span>@totalUnits</span>
        </div>
        <h1>@title</h1>
        @if (!string.IsNullOrWhiteSpace(work.Author))
        {
            <p class="book-author">@work.Author</p>
        }
        @if (!string.IsNullOrWhiteSpace(work.Description))
        {
            <p class="book-summary">@work.Description</p>
        }
        @if (Model.Book.Subjects.Count > 0)
        {
            <div class="book-tags">
                @foreach (var genre in Model.Book.Subjects.Take(8))
                {
                    <span>@genre</span>
                }
            </div>
        }

        @if (Model.Book.Progress is not null)
        {
            <section class="reading-progress-card" aria-label="@ui["reader.continueReading"]">
                <div>
                    <span>@ui["reader.continueReading"]</span>
                    @if (currentChapter is not null)
                    {
                        <strong>@currentChapter.Title</strong>
                    }
                </div>
                <strong>@progressPercent%</strong>
                <div class="reading-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
                    <span style="width:@progressPercent%"></span>
                </div>
            </section>
        }

        <div class="book-actions book-reading-primary-actions">
            @if (firstChapter is Guid chapterId)
            {
                <a class="button button-primary" href="/Books/Read/@chapterId?lang=@Model.TargetLanguage">
                    @(Model.Book.Progress is null ? ui["books.library.startReading"] : ui["reader.continueReading"])
                </a>
            }
            @if (Model.LanguageEdition.IsMeaningful)
            {
                <partial name="_LanguageEditionSelector" model="Model.LanguageEdition" />
            }
            <a class="button" href="@learningUrl">@ui["books.library.languageToolsLearning"]</a>
            <partial name="_OfflineLibraryAction" model="new Jularr.Web.Features.OfflineLibrary.OfflineLibraryActionViewModel(work.Id, title)" />
        </div>

        <partial name="_MediaFacts" model="facts" />
    </div>
</header>

<div class="book-detail-body">
    <aside class="book-detail-side">
        <section class="book-side-card book-editions" aria-labelledby="book-editions-title">
            <h2 id="book-editions-title">@ui["books.library.editionsHeading"]</h2>
            <ul class="book-edition-list">
                @foreach (var row in Model.EditionRows)
                {
                    var isCurrent = row.Code.Equals(Model.TargetLanguage, StringComparison.OrdinalIgnoreCase);
                    <li>
                        <a class="book-edition-row" href="/Books/Library/@work.Id?lang=@Uri.EscapeDataString(row.Code)" aria-current="@(isCurrent ? "true" : null)">
                            <span class="book-edition-name">@BookLanguageCatalog.GetName(row.Code)</span>
                            <span class="book-edition-tag" data-provenance="@(row.IsOriginal ? "official" : "generated")">@(row.IsOriginal ? ui["languageEdition.official"] : ui["languageEdition.generated"])</span>
                            <span class="book-edition-state">
                                @if (row.IsOriginal)
                                {
                                    @ui["languageEdition.originalDescription"]
                                }
                                else if (row.TranslatedUnits == 0)
                                {
                                    @ui["languageEdition.state.unavailable"]
                                }
                                else if (row.TranslatedUnits >= totalUnits)
                                {
                                    @ui["books.library.translated"]
                                }
                                else
                                {
                                    @ui.Format(Model.IsPdf ? "books.library.pagesTranslated" : "books.library.chaptersTranslated", ("translated", row.TranslatedUnits), ("total", totalUnits))
                                }
                            </span>
                        </a>
                    </li>
                }
            </ul>

            @if (Model.SourceIsTarget)
            {
                <div class="book-translation-control" data-state="original">
                    <p class="book-translation-status">@ui["books.library.originalLanguageSelected"]</p>
                    @if (Model.LanguageEdition.IsMeaningful)
                    {
                        <button type="button" class="button button-primary" data-language-edition-open="@Model.LanguageEdition.Id">
                            <partial name="_ReaderIcon" model="@("translate")" />
                            @ui["books.library.chooseTranslation"]
                        </button>
                    }
                </div>
            }
            else
            {
                var state = job.State switch
                {
                    BookTranslationJobState.Queued => "queued",
                    BookTranslationJobState.Running => "running",
                    BookTranslationJobState.Failed => "failed",
                    _ => translatedUnits == 0 ? "none" : translatedUnits >= totalUnits ? "complete" : "partial"
                };
                <div class="book-translation-control" data-state="@state">
                    <p class="book-translation-status">
                        @switch (state)
                        {
                            case "queued":
                                @ui["books.library.translationQueuedState"]
                                break;
                            case "running":
                                @ui.Format("books.library.translationRunning", ("language", targetName))
                                break;
                            case "failed":
                                @ui["books.library.translationFailed"]
                                break;
                            case "none":
                                @ui.Format("books.library.translationNotStarted", ("language", targetName))
                                break;
                            case "complete":
                                @ui["books.library.translated"]
                                break;
                            default:
                                @ui.Format("books.library.translationPartial", ("language", targetName))
                                break;
                        }
                    </p>
                    @if (state != "none")
                    {
                        <div class="book-card-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@translationPercent" aria-label="@progressText">
                            <span style="width:@translationPercent%"></span>
                        </div>
                        <p class="book-translation-count">@progressText</p>
                    }
                    @if (state == "failed" && Model.IsOwner && !string.IsNullOrWhiteSpace(job.Error))
                    {
                        <p class="book-translation-error">@job.Error</p>
                    }

                    @if (!job.IsActive)
                    {
                        <div class="book-translation-actions">
                            @if (state != "complete")
                            {
                                <form method="post" asp-page-handler="TranslateBook" asp-route-id="@work.Id">
                                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                                    <button class="button button-primary" type="submit">
                                        <partial name="_ReaderIcon" model="@("translate")" />
                                        @(state == "none" ? ui["books.library.startTranslation"] : state == "failed" ? ui["books.library.retryTranslation"] : ui["books.library.continueTranslation"])
                                    </button>
                                </form>
                            }
                            @if (Model.IsOwner && state != "none")
                            {
                                <form method="post" asp-page-handler="Regenerate" asp-route-id="@work.Id" data-confirm="@ui.Format("books.library.confirmRegenerate", ("language", targetName))">
                                    <input type="hidden" name="lang" value="@Model.TargetLanguage" />
                                    <button class="button" type="submit">@ui.Format("books.library.regenerateButton", ("language", targetName))</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        @if (Model.IsOwner)
        {
            <section class="book-side-card book-manage" aria-labelledby="book-manage-title">
                <h2 id="book-manage-title">@ui["books.library.manageBook"]</h2>
                <div class="book-manage-actions">
                    <a class="button" href="/Books/ChapterArt/@work.Id">@ui["chapterArt.title"]</a>
                    @if (Model.IsPdf)
                    {
                        <form method="post" asp-page-handler="ReanalyzePdf" asp-route-id="@work.Id">
                            <button class="button" type="submit">@ui["books.library.pdfReanalyze"]</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Delete" asp-route-id="@work.Id" data-confirm="@ui["books.library.confirmRemove"]">
                        <button class="button book-danger-button" type="submit">@ui["books.library.removeButton"]</button>
                    </form>
                </div>
                @if (Model.PdfAnalysis is { } analysis)
                {
                    <p class="book-manage-note">
                        @ui.Format(
                            "books.library.pdfAnalysis",
                            ("class", ui["books.library.pdfClass." + analysis.Classification.Class.ToString().ToLowerInvariant()]),
                            ("confidence", (int)Math.Round(analysis.Classification.Decision.Confidence * 100)),
                            ("logical", analysis.LogicalPages.Count),
                            ("physical", analysis.PhysicalPageCount),
                            ("duplicates", analysis.Diagnostics.DuplicatePagesRemoved),
                            ("furniture", analysis.Diagnostics.FurnitureParagraphsRemoved),
                            ("version", analysis.AnalyzerVersion))
                    </p>
                }
                <p class="book-manage-note">@ui["books.library.manageNote"]</p>
            </section>
        }
    </aside>

    <section class="book-chapter-list">
        <div class="books-results-heading">
            <h2>@unitLabel</h2>
            <span>@totalUnits</span>
        </div>

        @if (Model.IsPdf)
        {
            @* A PDF's chapters are its pages: listed as ranges, each opening at its first page. *@
            @foreach (var range in Model.PageRanges)
            {
                <a class="book-chapter-row book-page-range" href="/Books/Read/@range.FirstChapterId?lang=@Model.TargetLanguage">
                    <strong>@ui.Format("books.library.pageRange", ("from", range.FirstPage), ("to", range.LastPage))</strong>
                    @if (Model.SourceIsTarget)
                    {
                        <small>@ui["books.read.original"]</small>
                    }
                    else if (range.TranslatedCount == range.PageCount)
                    {
                        <small class="ready">@ui["books.library.translated"]</small>
                    }
                    else if (range.TranslatedCount > 0)
                    {
                        <small>@ui.Format("books.library.pagesTranslated", ("translated", range.TranslatedCount), ("total", range.PageCount))</small>
                    }
                    else
                    {
                        <small>@ui["books.library.originalAvailable"]</small>
                    }
                </a>
            }
        }
        else
        {
            @foreach (var chapter in Model.Book.Chapters)
            {
                <a class="book-chapter-row" href="/Books/Read/@chapter.Id?lang=@Model.TargetLanguage">
                    <span class="book-chapter-number">@chapter.Number</span>
                    <strong>@chapter.Title</strong>
                    @if (Model.SourceIsTarget)
                    {
                        <small>@ui["books.read.original"]</small>
                    }
                    else if (chapter.HasTranslation)
                    {
                        <small class="ready">@ui["books.library.translated"]</small>
                    }
                    else
                    {
                        <small>@ui["books.library.originalAvailable"]</small>
                    }
                </a>
            }
        }
    </section>
</div>
