@page "/Books/Read/{id:guid}"
@model Jularr.Web.Pages.Books.ReadModel
@using Jularr.Web.Features.Books
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
    var ui = Model.Ui;
    var work = Model.Reader.Work;
    var chapter = Model.Reader.Chapter;
    var bookTitle = work.MetadataTitle ?? work.Title;
    // A PDF book shows its pages (books-reader-pdf.js with the vendored pdf.js)
    // in the same paper frame; text-only controls are not rendered for it.
    var pdf = Model.Pdf;
    var isPdf = pdf is not null;
    ViewData["Title"] = isPdf ? bookTitle : chapter.Title;
    var target = Model.Reader.TargetLanguage;
    var sourceIsTarget = Model.Reader.SourceLanguage.Equals(target, StringComparison.OrdinalIgnoreCase);
    // Cached translated text is always readable (#369): reading an existing
    // translated variant is core reader behaviour and must not depend on the
    // Learning Translation capability. Only generating a *new* translation
    // (the "Translate into" menu entry) stays gated on Model.TranslationEnabled.
    var translatedParagraphs = sourceIsTarget ? Array.Empty<string>() : Model.Reader.TranslatedParagraphs;
    var hasAlternate = translatedParagraphs.Count > 0;
    // A PDF translates page by page from its own translated-text panel, so its menu has no chapter-level translate entry.
    var canTranslate = Model.TranslationEnabled && !sourceIsTarget && !hasAlternate && !isPdf;
    var defaultView = Model.RequestedView switch
    {
        "original" => "original",
        "translated" when hasAlternate || isPdf => "translated",
        "both" when hasAlternate && !isPdf => "both",
        _ => hasAlternate && !isPdf ? "translated" : "original"
    };
    var initialProgress = Model.InitialPositionPermille;
    var jsonOptions = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
    var pdfPagesJson = isPdf ? System.Text.Json.JsonSerializer.Serialize(pdf!.PageChapterIds) : "[]";
    string PdfAsset(string path) => FileVersions.AddFileVersionToPath(HttpContext.Request.PathBase, path);
    var pdfLibUrl = PdfAsset("/lib/pdfjs/pdf.min.mjs");
    var settingsJson = System.Text.Json.JsonSerializer.Serialize(Model.ReaderSettings, jsonOptions);
    var highlightsJson = System.Text.Json.JsonSerializer.Serialize(Model.CurrentHighlights, jsonOptions);
    var bookmarksJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Reader.Bookmarks.Select(x => new { x.Id, x.PositionPermille, x.Language }),
        jsonOptions);
    var bookBibleUrl = Model.IsOwner && !sourceIsTarget && !isPdf
        ? $"/Books/TranslationMemory/{work.Id}?lang={target}"
        : null;
    var readerSettingsPanel = new Jularr.Web.Features.ReaderCore.ReaderSettingsPanelModel(
        chapter.Id,
        Model.ReaderDocument,
        Model.ReaderSettings,
        target,
        bookBibleUrl,
        bookBibleUrl is null ? null : ui["books.bible.title"]);
    var supportsTts = Model.ReaderDocument.Capabilities.SupportsTts;
    // Many EPUB chapters start with their own heading; the opening then shows
    // only the number and ornament and keeps the title for screen readers.
    var titleRepeatsInText = Model.Reader.OriginalParagraphs.Count > 0
        && string.Equals(Model.Reader.OriginalParagraphs[0].Trim(), chapter.Title.Trim(), StringComparison.OrdinalIgnoreCase);
    var sourceName = BookLanguageCatalog.GetName(Model.Reader.SourceLanguage);
    var targetName = BookLanguageCatalog.GetName(target);
    var chapterLabel = ui.Format("books.chapter.number", ("number", chapter.Number));
    var titleIsChapterLabel = string.Equals(chapter.Title.Trim(), chapterLabel, StringComparison.OrdinalIgnoreCase);
    var bookUrl = $"/Books/Library/{work.Id}?lang={target}";
    var hasCover = !string.IsNullOrWhiteSpace(work.CoverImageUrl);
    var coverModel = new Jularr.Web.Features.ReaderCore.ReaderCoverModel(bookTitle, hasCover ? $"/Books/Cover/{work.Id}?w=96" : null);
    var viewQuery = defaultView == "original" ? "" : $"&view={defaultView}";
    var paperStyles = new[]
    {
        ("white", "reader.frame.paper.white"),
        ("cream", "reader.frame.paper.cream"),
        ("sepia", "reader.frame.paper.sepia"),
        ("old-paper", "reader.frame.paper.oldPaper"),
        ("midnight", "reader.frame.paper.midnight"),
        ("oled", "reader.frame.paper.oled")
    };
    var showTranslationChoices = !sourceIsTarget && (isPdf || hasAlternate || canTranslate || Model.HasWorkTranslationLanguage);
    var sheetTranslation = showTranslationChoices
        ? new Jularr.Web.Features.ReaderCore.ReaderSheetTranslation(
            "original",
            "translated",
            "both",
            ui.Format("reader.frame.viewOriginal", ("language", Model.Reader.SourceLanguage.ToUpperInvariant())),
            ui.Format("reader.frame.viewGenerated", ("language", target.ToUpperInvariant())),
            isPdf ? null : ui["reader.frame.viewBoth"],
            isPdf || hasAlternate,
            canTranslate ? ui.Format("books.read.translateInto", ("language", targetName)) : null)
        : null;
    var papers = paperStyles.Select(paper => new Jularr.Web.Features.ReaderCore.ReaderSheetPaper(paper.Item1, ui[paper.Item2])).ToList();
    var appearanceSheet = new Jularr.Web.Features.ReaderCore.ReaderAppearanceSheetModel("book", Model.ReaderDocument.Capabilities, papers, sheetTranslation, false, false);

    // Zoom for fixed pages; it takes the place of font size and line spacing.
    async Task PdfZoomRow(string? cssClass)
    {
        <div class="reader-menu-row book-pdf-zoom @cssClass" role="group" aria-label="@ui["books.read.zoom"]">
            <partial name="_ReaderIcon" model="@("view")" />
            <span>@ui["books.read.zoom"] <output data-book-pdf-zoom-value>100%</output></span>
            <div class="reader-segmented">
                <button type="button" data-book-pdf-fit="page" aria-pressed="true">@ui["books.read.fitPage"]</button>
                <button type="button" data-book-pdf-fit="width" aria-pressed="false">@ui["books.read.fitWidth"]</button>
                <button type="button" data-book-pdf-zoom="-1" aria-label="@ui["books.read.zoomOut"]" title="@ui["books.read.zoomOut"]">−</button>
                <button type="button" data-book-pdf-zoom="1" aria-label="@ui["books.read.zoomIn"]" title="@ui["books.read.zoomIn"]">+</button>
            </div>
        </div>
    }
}
@section Head {
    <link rel="stylesheet" href="~/css/reader-themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reader-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/book-reader.css" asp-append-version="true" />
    @if (isPdf)
    {
        <link rel="modulepreload" href="@pdfLibUrl" />
    }
}
@section Scripts {
    <script src="~/js/reader-themes.js" asp-append-version="true"></script>
    <script src="~/js/offline-library-repository.js" asp-append-version="true"></script>
    @if (isPdf)
    {
        <script src="~/js/books-reader-pdf.js" asp-append-version="true"></script>
    }
    <script src="~/js/books-reader.js" asp-append-version="true"></script>
    <script src="~/js/reader-shell.js" asp-append-version="true"></script>
    <script src="~/js/tts.js" asp-append-version="true"></script>
    <script src="~/js/reader-tts.js" asp-append-version="true"></script>
}

<div class="book-reader-page reader-frame reader-frame-prose"
     data-book-reader
     data-unified-reader
     data-reader-frame
     data-reader-content-type="@Model.ReaderDocument.ContentTypeKey"
     data-reader-layout="@Model.ReaderDocument.LayoutKind.ToString().ToLowerInvariant()"
     data-reader-personalization
     data-book-format="@(isPdf ? "pdf" : "epub")"
     data-view="@defaultView"
     data-target-language="@target"
     data-work-id="@Model.Reader.Work.Id"
     data-chapter-id="@chapter.Id"
     data-chapter-number="@chapter.Number"
     data-chapter-count="@Model.ChapterCount"
     data-has-translation="@(hasAlternate ? "true" : "false")"
     data-progress="@initialProgress"
     data-anchor-paragraph="@(Model.RequestedParagraph?.ToString() ?? "")"
     data-reading-mode="@Model.ReaderSettings.ReadingMode"
     data-paper-style="@Model.ReaderSettings.PaperStyle"
     data-chapter-style="@Model.ReaderSettings.ChapterStyle">

    <script type="application/json" data-book-settings-json>@Html.Raw(settingsJson)</script>
    <script type="application/json" data-book-highlights-json>@Html.Raw(highlightsJson)</script>
    <script type="application/json" data-book-bookmarks-json>@Html.Raw(bookmarksJson)</script>
    <script type="application/json" data-reader-frame-text>@Json.Serialize(ui.WithPrefix("reader.frame."))</script>
    <script type="application/json" data-book-reader-text>@Json.Serialize(ui.WithPrefix("books.read."))</script>
    @if (isPdf)
    {
        <script type="application/json" data-book-pdf-pages-json>@Html.Raw(pdfPagesJson)</script>
    }

    <header class="reader-frame-top" data-reader-chrome-primary>
        <a class="reader-frame-icon" href="@bookUrl" aria-label="@ui["reader.frame.back"]" title="@ui["reader.frame.back"]">
            <partial name="_ReaderIcon" model="@("back")" />
        </a>

        <partial name="_ReaderCover" model="@coverModel" />

        <div class="reader-frame-title">
            <strong>@bookTitle</strong>
            @if (isPdf)
            {
                <span data-book-pdf-position></span>
            }
            else
            {
                <span>
                    @if (!titleIsChapterLabel)
                    {
                        <span data-book-chapter-context>@chapterLabel</span>
                        <text> · </text>
                    }
                    <span data-book-chapter-title>@chapter.Title</span>
                </span>
            }
        </div>

        <div class="reader-frame-actions">
            <button class="reader-frame-icon reader-frame-labelled reader-frame-desktop" type="button"
                    data-reader-contents-toggle aria-controls="book-reader-contents" aria-expanded="false"
                    aria-label="@ui["reader.frame.contents"]" title="@ui["reader.frame.contents"]">
                <partial name="_ReaderIcon" model="@("contents")" />
                <span class="reader-frame-label">@ui["reader.frame.contents"]</span>
            </button>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-labelled" type="button"
                        data-reader-menu-toggle="search"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="book-menu-search"
                        aria-label="@ui["reader.frame.search"]" title="@ui["reader.frame.search"]">
                    <partial name="_ReaderIcon" model="@("search")" />
                    <span class="reader-frame-label">@ui["reader.frame.search"]</span>
                </button>
                <div class="reader-menu reader-menu-search" id="book-menu-search" data-reader-menu="search" role="dialog" aria-label="@ui["reader.frame.search"]" hidden>
                    <form class="reader-search-form" data-book-search-form role="search">
                        <input type="search" name="q" autocomplete="off" maxlength="120"
                               placeholder="@ui["books.read.searchPlaceholder"]"
                               aria-label="@ui["books.read.searchPlaceholder"]"
                               data-book-search-input />
                    </form>
                    <p class="reader-menu-status" data-book-search-status role="status">@ui["books.read.searchHint"]</p>
                    <ol class="reader-search-results" data-book-search-results></ol>
                </div>
            </div>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-labelled reader-frame-desktop" type="button"
                        data-reader-menu-toggle="language"
                        aria-haspopup="menu" aria-expanded="false" aria-controls="book-menu-language"
                        aria-label="@ui["reader.frame.language"]" title="@ui["reader.frame.language"]">
                    <partial name="_ReaderIcon" model="@("translate")" />
                    <span class="reader-frame-label">@ui["reader.frame.language"]</span>
                </button>
                <div class="reader-menu" id="book-menu-language" data-reader-menu="language" role="menu" aria-label="@ui["reader.frame.language"]" hidden>
                    <button type="button" role="menuitemradio" data-reader-view="original" aria-checked="false">
                        <span>@ui.Format("books.read.viewOriginal", ("language", sourceName))</span>
                        <partial name="_ReaderIcon" model="@("check")" />
                    </button>
                    @if (showTranslationChoices)
                    {
                        <button type="button" role="menuitemradio" data-reader-view="translated" aria-checked="false" disabled="@(!isPdf && !hasAlternate)">
                            <span>@targetName <small class="reader-menu-tag">@ui["reader.frame.generatedTag"]</small></span>
                            <partial name="_ReaderIcon" model="@("check")" />
                        </button>
                        @if (!isPdf)
                        {
                            <button type="button" role="menuitemradio" data-reader-view="both" aria-checked="false" hidden="@(!hasAlternate)">
                                <span>@ui.Format("books.read.viewBoth", ("language", targetName))</span>
                                <partial name="_ReaderIcon" model="@("check")" />
                            </button>
                        }
                    }
                    @if (canTranslate)
                    {
                        <form method="post" asp-page-handler="Translate" asp-route-id="@chapter.Id" data-book-translate-form>
                            <input type="hidden" name="lang" value="@target" />
                            <button type="submit" role="menuitem" data-translation-state>
                                @ui.Format("books.read.translateInto", ("language", targetName))
                            </button>
                        </form>
                    }
                    @foreach (var language in Model.CachedTranslationLanguages)
                    {
                        <a role="menuitem" href="/Books/Read/@chapter.Id?lang=@language&view=translated">
                            @BookLanguageCatalog.GetName(language) <small class="reader-menu-tag">@ui["reader.frame.generatedTag"]</small>
                        </a>
                    }
                </div>
            </div>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-labelled reader-frame-desktop" type="button"
                        data-reader-menu-toggle="appearance"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="book-menu-appearance"
                        aria-label="@ui["reader.frame.appearance"]" title="@ui["reader.frame.appearance"]">
                    <span class="reader-frame-glyph-inline" aria-hidden="true"></span>
                    <span class="reader-frame-label">@ui["reader.frame.appearance"]</span>
                </button>
                <partial name="_ReaderAppearanceSheet" model="@appearanceSheet" />
            </div>

            <button class="reader-frame-icon reader-frame-labelled" type="button"
                    data-bookmark-button
                    aria-pressed="false"
                    aria-label="@ui["books.read.bookmarkPage"]" title="@ui["books.read.bookmarkPage"]">
                <partial name="_ReaderIcon" model="@("bookmark")" />
                <span class="reader-frame-label">@ui["reader.frame.bookmark"]</span>
            </button>

            <div class="reader-menu-anchor">
                <button class="reader-frame-icon reader-frame-labelled" type="button"
                        data-reader-menu-toggle="more"
                        aria-haspopup="menu" aria-expanded="false" aria-controls="book-menu-more"
                        aria-label="@ui["reader.frame.more"]" title="@ui["reader.frame.more"]">
                    <partial name="_ReaderIcon" model="@("more")" />
                    <span class="reader-frame-label">@ui["reader.frame.more"]</span>
                </button>
                <div class="reader-menu reader-menu-more" id="book-menu-more" data-reader-menu="more" role="menu" aria-label="@ui["reader.frame.more"]" hidden>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-reader-contents-open="chapters">
                        <partial name="_ReaderIcon" model="@("contents")" />
                        <span>@ui["reader.frame.contents"]</span>
                    </button>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-reader-menu-toggle="appearance">
                        <span class="reader-frame-glyph-inline" aria-hidden="true"></span>
                        <span>@ui["reader.frame.appearance"]</span>
                    </button>
                    <button type="button" role="menuitem" class="reader-frame-mobile" data-reader-menu-toggle="language">
                        <partial name="_ReaderIcon" model="@("translate")" />
                        <span>@ui["reader.frame.language"]</span>
                    </button>
                    @if (!isPdf)
                    {
                        <button type="button" role="menuitem" data-reader-contents-open="notes">
                            <partial name="_ReaderIcon" model="@("notes")" />
                            <span>@ui["books.read.tabNotes"]</span>
                        </button>
                    }
                    @if (supportsTts)
                    {
                        <button type="button" role="menuitem" data-reader-tts-toggle aria-pressed="false" hidden>
                            <partial name="_ReaderIcon" model="@("headphones")" />
                            <span>@ui["reader.frame.readAloud"]</span>
                        </button>
                        <button type="button" role="menuitem" data-reader-settings-open="tts">
                            <partial name="_ReaderIcon" model="@("sliders")" />
                            <span>@ui["reader.frame.audioSettings"]</span>
                        </button>
                    }
                    @if (isPdf)
                    {
                        await PdfZoomRow(null);
                    }
                    else
                    {
                        <button type="button" role="menuitem" data-book-autoscroll-toggle aria-pressed="false" data-reader-mode-only="continuous">
                            <partial name="_ReaderIcon" model="@("auto-scroll")" />
                            <span>@ui["reader.frame.autoScroll"]</span>
                        </button>
                    }
                    <div class="reader-menu-row" role="group" aria-label="@ui["reader.frame.timer"]">
                        <partial name="_ReaderIcon" model="@("timer")" />
                        <span data-reader-timer-label>@ui["reader.frame.timer"]</span>
                        <div class="reader-segmented">
                            @foreach (var minutes in new[] { 15, 30, 60 })
                            {
                                <button type="button" data-reader-timer="@minutes" aria-pressed="false">@ui.Format("reader.frame.timerMinutes", ("minutes", minutes))</button>
                            }
                            <button type="button" data-reader-timer="0" aria-pressed="true">@ui["reader.frame.timerOff"]</button>
                        </div>
                    </div>
                    <div class="reader-menu-offline" data-offline-save="@work.Id" data-offline-media-item data-offline-media-kind="book" data-offline-media-id="@work.Id">
                        <partial name="_ReaderIcon" model="@("download")" />
                        <button type="button" role="menuitem" data-offline-save-button disabled>@ui["offlineLibrary.action.saveButton"]</button>
                        <small data-offline-save-status>@ui["offlineLibrary.action.checking"]</small>
                    </div>
                    <div class="reader-menu-offline">
                        <partial name="_ReaderIcon" model="@("download")" />
                        <button type="button" role="menuitem" data-offline-media-save="@work.Id" data-offline-media-kind="book">@ui["offlineLibrary.action.saveButton"]</button>
                        <progress data-offline-media-progress max="100" value="0" hidden></progress>
                        <small data-offline-media-status></small>
                    </div>
                    <button type="button" role="menuitem" data-reader-fullscreen-toggle aria-pressed="false">
                        <partial name="_ReaderIcon" model="@("fullscreen")" />
                        <span data-reader-fullscreen-label>@ui["reader.frame.fullscreen"]</span>
                    </button>
                    <button type="button" role="menuitem" data-reader-share>
                        <partial name="_ReaderIcon" model="@("share")" />
                        <span>@ui["reader.frame.share"]</span>
                    </button>
                    <button type="button" role="menuitem" data-reader-settings-open="reading">
                        <partial name="_ReaderIcon" model="@("settings")" />
                        <span>@ui["reader.frame.settings"]</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="reader-frame-body">
        <aside class="reader-contents" id="book-reader-contents" data-reader-contents aria-label="@ui["reader.frame.contents"]" hidden>
            <div class="reader-contents-head">
                <div class="reader-contents-tabs" role="tablist" aria-label="@ui["reader.frame.contentsTabsAria"]">
                    <button type="button" role="tab" id="book-tab-chapters" aria-controls="book-panel-chapters" aria-selected="true" data-reader-contents-tab="chapters">@(isPdf ? ui["reader.frame.contents"] : ui["books.read.tabChapters"])</button>
                    <button type="button" role="tab" id="book-tab-bookmarks" aria-controls="book-panel-bookmarks" aria-selected="false" tabindex="-1" data-reader-contents-tab="bookmarks">@ui["books.read.tabBookmarks"]</button>
                    @if (!isPdf)
                    {
                        <button type="button" role="tab" id="book-tab-notes" aria-controls="book-panel-notes" aria-selected="false" tabindex="-1" data-reader-contents-tab="notes">@ui["books.read.tabNotes"]</button>
                    }
                    <button type="button" role="tab" id="book-tab-details" aria-controls="book-panel-details" aria-selected="false" tabindex="-1" data-reader-contents-tab="details">@ui["books.read.tabDetails"]</button>
                </div>
                <button class="reader-frame-icon" type="button" data-reader-contents-close
                        aria-label="@ui["reader.frame.closeContents"]" title="@ui["reader.frame.closeContents"]">
                    <partial name="_ReaderIcon" model="@("close")" />
                </button>
            </div>

            <section class="reader-contents-panel" id="book-panel-chapters" role="tabpanel" aria-labelledby="book-tab-chapters" data-reader-contents-panel="chapters">
                <input class="reader-contents-search" type="search" autocomplete="off"
                       placeholder="@(isPdf ? ui["books.read.searchContents"] : ui["books.read.searchChapters"])"
                       aria-label="@(isPdf ? ui["books.read.searchContents"] : ui["books.read.searchChapters"])"
                       data-book-chapter-search />
                <ol class="reader-contents-list" data-book-chapter-list></ol>
            </section>
            <section class="reader-contents-panel" id="book-panel-bookmarks" role="tabpanel" aria-labelledby="book-tab-bookmarks" data-reader-contents-panel="bookmarks" hidden>
                <ol class="reader-contents-list" data-book-bookmark-list></ol>
            </section>
            @if (!isPdf)
            {
                <section class="reader-contents-panel" id="book-panel-notes" role="tabpanel" aria-labelledby="book-tab-notes" data-reader-contents-panel="notes" hidden>
                    <ol class="reader-contents-list" data-book-highlight-list></ol>
                </section>
            }
            <section class="reader-contents-panel" id="book-panel-details" role="tabpanel" aria-labelledby="book-tab-details" data-reader-contents-panel="details" hidden>
                <div class="book-details">
                    @if (hasCover)
                    {
                        <img src="/Books/Cover/@work.Id?w=240" alt="" width="120" height="180" loading="lazy" decoding="async" />
                    }
                    <div>
                        <strong>@bookTitle</strong>
                        <dl>
                            @if (!string.IsNullOrWhiteSpace(work.Author))
                            {
                                <dt>@ui["books.read.author"]</dt>
                                <dd>@work.Author</dd>
                            }
                            <dt>@ui["books.read.languageLabel"]</dt>
                            <dd>@sourceName</dd>
                            <dt>@(isPdf ? ui["books.read.pageCount"] : ui["books.read.chapterCount"])</dt>
                            <dd>@Model.ChapterCount</dd>
                        </dl>
                    </div>
                </div>
                <a class="reader-contents-link" href="@bookUrl">@ui["books.read.openBookPage"]</a>
            </section>
        </aside>
        <div class="reader-contents-backdrop" data-reader-contents-backdrop hidden></div>

        @if (isPdf)
        {
            <main class="book-stage" data-reader-surface aria-label="@bookTitle">
                <div class="book-pdf-spread"
                     data-book-pdf
                     lang="@Model.Reader.SourceLanguage"
                     data-pdf-file="@pdf!.FileUrl"
                     data-pdf-lib="@pdfLibUrl"
                     data-pdf-worker="@PdfAsset("/lib/pdfjs/pdf.worker.min.mjs")"
                     data-pdf-cmaps="@Url.Content("~/lib/pdfjs/cmaps/")"
                     data-pdf-fonts="@Url.Content("~/lib/pdfjs/standard_fonts/")"
                     data-pdf-wasm="@Url.Content("~/lib/pdfjs/wasm/")"></div>
                <p class="book-pdf-status" data-book-pdf-status role="status" hidden></p>
                <section class="book-pdf-translation" data-book-pdf-translation data-state="pending" lang="@target" aria-live="polite" hidden>
                    <p class="book-pdf-translation-label" data-book-pdf-translation-label hidden>@ui.Format("books.read.generatedTranslation", ("language", targetName))</p>
                    <div class="book-text" data-book-pdf-translation-text></div>
                    <p class="book-pdf-translation-status" data-book-pdf-translation-status role="status"></p>
                    <form method="post" asp-page-handler="Translate" data-book-pdf-translate-form hidden>
                        <input type="hidden" name="lang" value="@target" />
                        <button type="submit" class="button" data-language-name="@targetName">@ui.Format("books.read.translateInto", ("language", targetName))</button>
                    </form>
                </section>
            </main>
        }
        else
        {
        <main class="book-stage" data-reader-surface aria-label="@chapter.Title">
            <div class="book-spread" data-book-spread>
                <div class="book-stack book-stack-left" data-book-stack="left" aria-hidden="true"></div>
                <div class="book-stack book-stack-right" data-book-stack="right" aria-hidden="true"></div>
                <div class="book-sheet book-sheet-left" aria-hidden="true">
                    <span class="book-art-mountains"></span>
                    <span class="book-page-number" data-book-page-number="left"></span>
                </div>
                <div class="book-sheet book-sheet-right" aria-hidden="true">
                    <span class="book-art-mountains"></span>
                    <span class="book-page-number" data-book-page-number="right"></span>
                </div>
                <span class="book-art-branch book-art-branch-top art-tint" aria-hidden="true"></span>
                <span class="book-art-branch book-art-branch-side art-tint" aria-hidden="true"></span>
                <div class="book-turn-shade" data-book-turn-shade aria-hidden="true"></div>

                <div class="book-flow" data-book-flow>
                    <div class="book-columns" data-book-columns data-book-reader-content>
                    <partial name="_ChapterArtwork" model='new Jularr.Web.Features.ChapterArtwork.ChapterArtworkSlot(work.Id, chapter.Number, ui["chapterArt.aiGenerated"])' />
                    <header class="book-opening">
                        @if (!titleIsChapterLabel)
                        {
                            <span class="book-opening-number" data-book-chapter-number>@chapterLabel</span>
                        }
                        <svg class="book-opening-art" viewBox="0 0 48 8" aria-hidden="true" focusable="false">
                            <path d="M1 4h17M30 4h17" />
                            <circle cx="24" cy="4" r="2.2" />
                        </svg>
                        <h1 data-book-opening-title>@chapter.Title</h1>
                    </header>

                    <article class="book-text" data-book-original data-book-language="original" lang="@Model.Reader.SourceLanguage"
                             hidden="@(defaultView == "translated")">
                        @for (var index = 0; index < Model.Reader.OriginalParagraphs.Count; index++)
                        {
                            <p data-book-paragraph="@index" class="@(index == 0 && titleRepeatsInText ? "book-title-echo" : null)">@Model.Reader.OriginalParagraphs[index]</p>
                        }
                    </article>

                    <article class="book-text" data-book-translated data-book-language="@target" lang="@target"
                             hidden="@(!hasAlternate || defaultView == "original")">
                        @for (var index = 0; index < translatedParagraphs.Count; index++)
                        {
                            <p data-book-paragraph="@index">@translatedParagraphs[index]</p>
                        }
                    </article>
                    </div>
                </div>
            </div>
        </main>
        }
    </div>

    <footer class="reader-frame-bottom" data-reader-chrome>
        @if (isPdf)
        {
            @* Outline sections, or pages when the PDF has no outline (books-reader.js). *@
            <button class="reader-frame-nav" type="button" data-book-pdf-section="-1"
                    aria-label="@ui["reader.frame.previousPage"]" title="@ui["reader.frame.previousPage"]">
                <partial name="_ReaderIcon" model="@("back")" />
                <span class="reader-frame-label">@ui["reader.frame.previousPage"]</span>
            </button>
        }
        else if (Model.Reader.PreviousChapterId is Guid previous)
        {
            <a class="reader-frame-nav" href="/Books/Read/@previous?lang=@target@viewQuery"
               data-book-chapter-link="previous"
               aria-label="@ui["reader.frame.previousChapter"]" title="@ui["reader.frame.previousChapter"]">
                <partial name="_ReaderIcon" model="@("back")" />
                <span class="reader-frame-label">@ui["reader.frame.previousChapter"]</span>
            </a>
        }
        else
        {
            <button class="reader-frame-nav" type="button" disabled aria-label="@ui["reader.frame.previousChapter"]">
                <partial name="_ReaderIcon" model="@("back")" />
                <span class="reader-frame-label">@ui["reader.frame.previousChapter"]</span>
            </button>
        }

        <div class="reader-progress">
            <label class="reader-progress-track">
                <input type="range" min="0" max="0" step="1" value="0"
                       data-reader-progress-slider
                       aria-label="@ui["reader.frame.progressAria"]" />
            </label>
            <output class="reader-progress-text" data-reader-progress-text aria-live="off"></output>
        </div>

        @if (isPdf)
        {
            <button class="reader-frame-nav" type="button" data-book-pdf-section="1"
                    aria-label="@ui["reader.frame.nextPage"]" title="@ui["reader.frame.nextPage"]">
                <span class="reader-frame-label">@ui["reader.frame.nextPage"]</span>
                <partial name="_ReaderIcon" model="@("forward")" />
            </button>
        }
        else if (Model.Reader.NextChapterId is Guid next)
        {
            <a class="reader-frame-nav" href="/Books/Read/@next?lang=@target@viewQuery"
               data-book-chapter-link="next"
               data-reader-next-chapter="@next"
               aria-label="@ui["reader.frame.nextChapter"]" title="@ui["reader.frame.nextChapter"]">
                <span class="reader-frame-label">@ui["reader.frame.nextChapter"]</span>
                <partial name="_ReaderIcon" model="@("forward")" />
            </a>
        }
        else
        {
            <button class="reader-frame-nav" type="button" disabled aria-label="@ui["reader.frame.nextChapter"]">
                <span class="reader-frame-label">@ui["reader.frame.nextChapter"]</span>
                <partial name="_ReaderIcon" model="@("forward")" />
            </button>
        }


    </footer>

    <div class="reader-frame-settings">
        <partial name="_ReaderSettingsPanel" model="@readerSettingsPanel" />
    </div>

    @if (!isPdf)
    {
    <form method="post"
          asp-page-handler="Highlight"
          asp-route-id="@chapter.Id"
          data-book-highlight-form
          hidden>
        <input type="hidden" name="lang" value="@target" />
        <input type="hidden" name="anchorLanguage" value="original" />
        <input type="hidden" name="paragraphIndex" value="0" />
        <input type="hidden" name="startOffset" value="0" />
        <input type="hidden" name="endOffset" value="0" />
        <input type="hidden" name="note" value="" />
    </form>

    <div class="book-selection-toolbar" data-book-selection-toolbar hidden>
        <div class="book-selection-actions">
            <button type="button" data-book-highlight-button>
                <partial name="_ReaderIcon" model="@("highlight")" />
                <span>@ui["books.read.highlight"]</span>
            </button>
            <button type="button" data-book-note-button>
                <partial name="_ReaderIcon" model="@("notes")" />
                <span>@ui["books.read.note"]</span>
            </button>
        </div>
        <form class="book-selection-note" data-book-note-form hidden>
            <textarea rows="3" maxlength="1000" data-book-note-input
                      placeholder="@ui["books.read.notePlaceholder"]"
                      aria-label="@ui["books.read.notePlaceholder"]"></textarea>
            <button type="submit">@ui["books.read.saveNote"]</button>
        </form>
    </div>
    }

    <div class="book-reader-toast" data-book-toast hidden role="status" aria-live="polite"></div>
</div>
<partial name="_LanguageInspector" model="Jularr.Web.Features.Learning.LanguageAssistance.LanguageInspectorHost.ForBookChapter(work.Id, chapter.Id, Model.Reader.SourceLanguage)" />
