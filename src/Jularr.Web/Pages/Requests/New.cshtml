@page
@model Jularr.Web.Pages.Requests.NewModel
@using Jularr.Web.Features.Acquisition.Access
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["requests.new.title"];
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
}

<header class="page-header">
    <h1>@ui["requests.new.title"]</h1>
</header>

<section class="panel request-new">
    <div class="request-new-title">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <div class="request-cover">
                <img src="@Model.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
            </div>
        }
        <div class="request-copy">
            <strong>@Model.Title</strong>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <span>@Model.Subtitle</span>
            }
        </div>
    </div>

    <form method="post" class="request-form">
        <input type="hidden" name="ExternalId" value="@Model.ExternalId" />
        <input type="hidden" name="Title" value="@Model.Title" />
        <input type="hidden" name="Subtitle" value="@Model.Subtitle" />
        <input type="hidden" name="CoverImageUrl" value="@Model.CoverImageUrl" />

        @if (Model.Error is { } error)
        {
            <p class="validation" role="alert">@error</p>
        }

        <fieldset class="request-field">
            <legend>@ui["requests.new.scope"]</legend>
            <div class="request-choices">
                <label><input type="radio" name="Scope" value="series" checked="@(Model.Scope == "series")" /> @ui["requests.new.scope.series"]</label>
                <label><input type="radio" name="Scope" value="seasons" checked="@(Model.Scope == "seasons")" /> @ui["requests.new.scope.seasons"]</label>
                <label><input type="radio" name="Scope" value="episodes" checked="@(Model.Scope == "episodes")" /> @ui["requests.new.scope.episodes"]</label>
            </div>
        </fieldset>

        <label class="request-field request-field-seasons">
            <span>@ui["requests.new.seasons"]</span>
            <input type="text" name="Seasons" value="@Model.Seasons" placeholder="@ui["requests.new.seasonsPlaceholder"]" autocomplete="off" />
        </label>

        <div class="request-field request-field-episodes">
            <label>
                <span>@ui["requests.new.episodes"]</span>
                <input type="text" name="Episodes" value="@Model.Episodes" placeholder="@ui["requests.new.episodesPlaceholder"]" autocomplete="off" />
            </label>
            <label>
                <span>@ui["requests.new.episodeSeason"]</span>
                <input type="number" name="EpisodeSeason" value="@Model.EpisodeSeason" min="1" max="@AcquisitionRequestOptions.MaxSeasonNumber" />
            </label>
        </div>

        <label class="request-field">
            <span>@ui["requests.new.audio"]</span>
            <select name="Audio">
                <option value="">@ui["requests.new.anyLanguage"]</option>
                @foreach (var (tag, name) in RequestLanguages.Choices)
                {
                    <option value="@tag" selected="@(Model.Audio == tag)">@name</option>
                }
            </select>
        </label>

        <label class="request-field">
            <span>@ui["requests.new.subtitles"]</span>
            <select name="Subtitles">
                <option value="">@ui["requests.new.anyLanguage"]</option>
                <option value="off" selected="@(Model.Subtitles == "off")">@ui["requests.new.noSubtitles"]</option>
                @foreach (var (tag, name) in RequestLanguages.Choices)
                {
                    <option value="@tag" selected="@(Model.Subtitles == tag)">@name</option>
                }
            </select>
        </label>

        @if (Model.SelectableProfiles.Count > 0)
        {
            <label class="request-field">
                <span>@ui["requests.new.profile"]</span>
                <select name="QualityProfileId">
                    <option value="">@ui["requests.new.defaultProfile"]</option>
                    @foreach (var profile in Model.SelectableProfiles)
                    {
                        <option value="@profile.Id" selected="@(Model.QualityProfileId == profile.Id)">@profile.Name</option>
                    }
                </select>
            </label>
        }

        <div class="request-form-actions">
            <button class="button button-primary" type="submit">
                @ui["requests.new.submitRequest"]
            </button>
            <a class="button" href="/Requests">@ui["common.cancel"]</a>
        </div>
    </form>
</section>
