@using Jularr.Web.Features.Calendar
@model ReleaseEventRowModel
@{
    var release = Model.Event;
    var presenter = Model.Presenter;
    var href = presenter.Href(release);
    var unit = presenter.UnitLabel(release);
    var (stateLabel, stateTone) = presenter.State(release.Local);
    var when = Model.ShowDate ? presenter.DateLabel(release.Date) : presenter.TimeLabel(release.Date);
    var meta = new[]
    {
        Model.Compact ? null : presenter.MediaLabel(release.MediaType),
        when,
        presenter.ProviderLabel(release.Provider)
    }.Where(part => !string.IsNullOrEmpty(part));
    var typeClass = "calendar-type-" + ReleaseCalendarPresenter.FilterValue(release.MediaType).ToLowerInvariant();

    void Content()
    {
        if (!Model.Compact)
        {
            <span class="calendar-event-cover" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(release.CoverImageUrl))
                {
                    <img src="@release.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                }
            </span>
        }
        <span class="calendar-event-copy">
            @if (Model.Compact)
            {
                <strong>@(string.IsNullOrEmpty(unit) ? presenter.MediaLabel(release.MediaType) : unit)</strong>
            }
            else
            {
                <strong>@release.Title</strong>
                @if (!string.IsNullOrEmpty(unit))
                {
                    <span>@unit</span>
                }
            }
            <small>@string.Join(" · ", meta)</small>
        </span>
        <span class="calendar-state calendar-state-@stateTone">@stateLabel</span>
    }
}
<li class="calendar-event @typeClass@(Model.Compact ? " is-compact" : "")">
    @if (href is null)
    {
        <div class="calendar-event-link">@{ Content(); }</div>
    }
    else
    {
        <a class="calendar-event-link" href="@href">@{ Content(); }</a>
    }
</li>
