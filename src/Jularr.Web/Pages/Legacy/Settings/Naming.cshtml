@page "/Settings/Naming"
@using Jularr.Web.Features.Acquisition.Naming
@model Jularr.Web.Pages.Settings.NamingModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.naming.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Admin/Sonarr">@ui["settings.naming.backToSonarr"]</a>
        <h1>@ui["settings.naming.title"]</h1>
        <p>@ui["settings.naming.pageDescription"]</p>
    </div>
    <a class="button" asp-page="/Legacy/Settings/ReadingNaming">@ui["settings.naming.readingNamingLink"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="metadata-error" style="color:inherit">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error">@Model.Error</p>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.naming.profilesHeading"]</h2>
            <span>@Model.State.Profiles.Length</span>
        </div>
        <ul>
            @foreach (var profile in Model.State.Profiles)
            {
                var isDefault = profile.Id.Equals(Model.State.DefaultProfileId, StringComparison.OrdinalIgnoreCase);
                var usage = Model.UsageCount(profile.Id);
                <li>
                    <a asp-page="/Legacy/Settings/Naming" asp-route-edit="@profile.Id"><strong>@profile.Name</strong></a>
                    <span class="muted">@profile.Id@(isDefault ? $" · {ui["settings.naming.default"]}" : "")@(usage > 0 ? $" · {ui.Format("settings.naming.assignments", ("count", usage))}" : "")</span>
                </li>
            }
        </ul>
        <div class="inline-actions">
            @foreach (var preset in AnimeNamingPresets.All)
            {
                <a class="button" asp-page="/Legacy/Settings/Naming" asp-route-preset="@preset.Id">@ui.Format("settings.naming.newFromPreset", ("name", preset.Name))</a>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.naming.selectionHeading"]</h2>
            <span>@ui["settings.naming.selectionPriority"]</span>
        </div>
        <form method="post" asp-page-handler="Default" class="form-stack">
            <label>
                <span>@ui["settings.naming.defaultProfileLabel"]</span>
                <select name="profileId">
                    @foreach (var profile in Model.State.Profiles)
                    {
                        <option value="@profile.Id" selected="@(profile.Id.Equals(Model.State.DefaultProfileId, StringComparison.OrdinalIgnoreCase))">@profile.Name</option>
                    }
                </select>
            </label>
            <div class="inline-actions"><button class="button" type="submit">@ui["settings.naming.setDefault"]</button></div>
        </form>

        @foreach (var root in Model.Roots)
        {
            Model.State.LibraryProfileAssignments.TryGetValue(root.Id.ToString("D"), out var assigned);
            <form method="post" asp-page-handler="Library" class="form-stack">
                <input type="hidden" name="rootId" value="@root.Id" />
                <label>
                    <span>@ui.Format("settings.naming.libraryLabel", ("name", root.Name))</span>
                    <select name="profileId">
                        <option value="" selected="@(assigned is null)">@ui["settings.naming.useDefault"]</option>
                        @foreach (var profile in Model.State.Profiles)
                        {
                            <option value="@profile.Id" selected="@(profile.Id.Equals(assigned, StringComparison.OrdinalIgnoreCase))">@profile.Name</option>
                        }
                    </select>
                </label>
                <div class="inline-actions"><button class="button" type="submit">@ui["common.save"]</button></div>
            </form>
        }
        <p class="muted">@ui["settings.naming.perAnimeNote"]</p>
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@(Model.IsExistingProfile ? ui.Format("settings.naming.editProfile", ("name", Model.Input.Name)) : ui["settings.naming.newProfile"])</h2>
        <span>@Model.Input.Id</span>
    </div>

    <form method="post" class="form-stack">
        <label>
            <span>@ui["settings.naming.nameLabel"]</span>
            <input asp-for="Input.Name" maxlength="80" required />
        </label>
        @if (Model.IsExistingProfile)
        {
            <input type="hidden" asp-for="Input.Id" />
        }
        else
        {
            <label>
                <span>@ui["settings.naming.profileIdLabel"]</span>
                <input asp-for="Input.Id" maxlength="64" pattern="[a-z0-9-]+" required />
            </label>
        }
        <label>
            <span>@ui["settings.naming.seriesFolderFormatLabel"]</span>
            <input asp-for="Input.SeriesFolderFormat" spellcheck="false" />
        </label>
        <label class="checkbox-row">
            <input type="checkbox" asp-for="Input.UseSeasonFolders" />
            <span>@ui["settings.naming.useSeasonFolders"]</span>
        </label>
        <label>
            <span>@ui["settings.naming.seasonFolderFormatLabel"]</span>
            <input asp-for="Input.SeasonFolderFormat" spellcheck="false" />
        </label>
        <label>
            <span>@ui["settings.naming.specialsFolderFormatLabel"]</span>
            <input asp-for="Input.SpecialsFolderFormat" spellcheck="false" />
        </label>
        <label>
            <span>@ui["settings.naming.standardEpisodeFormatLabel"]</span>
            <input asp-for="Input.StandardEpisodeFormat" spellcheck="false" />
        </label>
        <label>
            <span>@ui["settings.naming.dailyEpisodeFormatLabel"]</span>
            <input asp-for="Input.DailyEpisodeFormat" spellcheck="false" />
        </label>
        <label>
            <span>@ui["settings.naming.animeEpisodeFormatLabel"]</span>
            <input asp-for="Input.AnimeEpisodeFormat" spellcheck="false" />
            <small class="muted">@ui["settings.naming.animeEpisodeFormatHint"]</small>
        </label>
        <label>
            <span>@ui["settings.naming.multiEpisodeStyleLabel"]</span>
            <select asp-for="Input.MultiEpisodeStyle">
                <option value="@AnimeMultiEpisodeStyle.Extend">@ui["settings.naming.multiEpisode.extend"]</option>
                <option value="@AnimeMultiEpisodeStyle.Duplicate">@ui["settings.naming.multiEpisode.duplicate"]</option>
                <option value="@AnimeMultiEpisodeStyle.Repeat">@ui["settings.naming.multiEpisode.repeat"]</option>
                <option value="@AnimeMultiEpisodeStyle.Scene">@ui["settings.naming.multiEpisode.scene"]</option>
                <option value="@AnimeMultiEpisodeStyle.Range">@ui["settings.naming.multiEpisode.range"]</option>
                <option value="@AnimeMultiEpisodeStyle.PrefixedRange">@ui["settings.naming.multiEpisode.prefixedRange"]</option>
            </select>
        </label>
        <label class="checkbox-row">
            <input type="checkbox" asp-for="Input.ReplaceIllegalCharacters" />
            <span>@ui["settings.naming.replaceIllegalCharacters"]</span>
        </label>
        <label>
            <span>@ui["settings.naming.colonReplacementLabel"]</span>
            <select asp-for="Input.ColonReplacement">
                <option value="@AnimeColonReplacement.Smart">@ui["settings.naming.colon.smart"]</option>
                <option value="@AnimeColonReplacement.Delete">@ui["settings.naming.colon.delete"]</option>
                <option value="@AnimeColonReplacement.Dash">@ui["settings.naming.colon.dash"]</option>
                <option value="@AnimeColonReplacement.SpaceDash">@ui["settings.naming.colon.spaceDash"]</option>
                <option value="@AnimeColonReplacement.SpaceDashSpace">@ui["settings.naming.colon.spaceDashSpace"]</option>
                <option value="@AnimeColonReplacement.Custom">@ui["settings.naming.colon.custom"]</option>
            </select>
        </label>
        <label>
            <span>@ui["settings.naming.customColonReplacementLabel"]</span>
            <input asp-for="Input.CustomColonReplacement" maxlength="10" />
        </label>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="validation">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="inline-actions">
            <button class="button" type="submit" asp-page-handler="Preview">@ui["settings.naming.preview"]</button>
            <button class="button button-primary" type="submit" asp-page-handler="Save">@ui["settings.naming.saveProfile"]</button>
        </div>
    </form>

    @if (Model.IsExistingProfile)
    {
        <form method="post" asp-page-handler="Delete" class="inline-actions">
            <input type="hidden" name="profileId" value="@Model.Input.Id" />
            <button class="button" type="submit">@ui["settings.naming.deleteProfile"]</button>
        </form>
    }
</section>

@if (Model.Preview.Count > 0)
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.naming.previewHeading"]</h2>
            <span>@ui["settings.naming.sonarrSample"]</span>
        </div>
        <dl class="status-list">
            @foreach (var line in Model.Preview)
            {
                <div><dt class="muted">@line.Label</dt><dd><code>@line.Value</code></dd></div>
            }
        </dl>
    </section>
}

<section class="panel">
    <details>
        <summary>Tokens</summary>
        <p class="muted">Write <code>{Series.Title}</code> or <code>{Series_Title}</code> to change the word separator, all-lowercase or all-uppercase token names to change case, and characters such as <code>{[Release Group]}</code> or <code>{-Release Group}</code> inside the braces to add text only when the value exists.</p>
        <ul>
            <li><strong>Series</strong>: <code>{Series Title}</code> <code>{Series CleanTitle}</code> <code>{Series TitleYear}</code> <code>{Series CleanTitleYear}</code> <code>{Series TitleWithoutYear}</code> <code>{Series CleanTitleWithoutYear}</code> <code>{Series TitleThe}</code> <code>{Series CleanTitleThe}</code> <code>{Series TitleFirstCharacter}</code> <code>{Series Year}</code></li>
            <li><strong>Provider IDs</strong>: <code>{AniListId}</code> <code>{MalId}</code> <code>{TvdbId}</code> <code>{TmdbId}</code> <code>{ImdbId}</code></li>
            <li><strong>Numbering</strong>: <code>{season:00}</code> <code>{episode:00}</code> <code>{absolute:000}</code> <code>{Air-Date}</code></li>
            <li><strong>Episode</strong>: <code>{Episode Title}</code> <code>{Episode CleanTitle}</code></li>
            <li><strong>Quality</strong>: <code>{Quality Full}</code> <code>{Quality Title}</code> <code>{Quality Proper}</code> <code>{Quality Key}</code></li>
            <li><strong>Release</strong>: <code>{Release Group}</code> <code>{MediaInfo VideoCodec}</code> <code>{MediaInfo VideoBitDepth}</code> <code>{MediaInfo VideoDynamicRangeType}</code> <code>{MediaInfo AudioCodec}</code> <code>{MediaInfo AudioChannels}</code> <code>{MediaInfo AudioLanguages}</code> <code>{MediaInfo AudioLanguagesAll}</code> <code>{MediaInfo SubtitleLanguages}</code> <code>{MediaInfo Simple}</code> <code>{MediaInfo Full}</code></li>
        </ul>
        <p class="muted">Release tokens come from the release name (Jularr's release parser), not from probing the file.</p>
    </details>
</section>
