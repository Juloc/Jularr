@page "/Settings/Language/Legacy"
@model Jularr.Web.Pages.Settings.LanguageModel
@{
    ViewData["Title"] = Model.Ui["settings.language.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">← @Model.Ui["settings.title"]</a>
        <h1>@Model.Ui["settings.language.title"]</h1>
        <p>@Model.Ui["settings.language.description"]</p>
    </div>
</header>

<section class="panel">
    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label>
            <span>@Model.Ui["settings.language.title"]</span>
            <select asp-for="Locale">
                @foreach (var locale in Model.Locales)
                {
                    <option value="@locale.Locale">
                        @locale.NativeName · @locale.EnglishName (@locale.Locale)
                        @if (!locale.IsSource)
                        {
                            <text> · @locale.CoveragePercent%</text>
                        }
                    </option>
                }
            </select>
            <small class="muted">
                @Model.Ui["settings.language.description"]
            </small>
        </label>

        <button class="button button-primary" type="submit">
            @Model.Ui["settings.language.save"]
        </button>
    </form>
</section>

@if (Model.Locales.Count <= 1)
{
    <section class="panel">
        <p class="muted">
            Only English is available right now. An Owner can add and AI-generate more interface languages in Admin → Languages.
        </p>
    </section>
}
