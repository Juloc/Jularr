@page "/Settings/DownloadClients/Edit/{id:guid?}"
@model Jularr.Web.Pages.Settings.DownloadClients.EditModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.IsNew ? ui["settings.downloadClients.addTitle"] : ui["settings.downloadClients.editTitle"];
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Admin/Usenet">← @ui["admin.usenet.title"]</a>
        <h1>@(Model.IsNew ? ui["settings.downloadClients.addTitle"] : ui["settings.downloadClients.editTitle"])</h1>
    </div>
</header>

@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<form method="post" class="panel usenet-form">
    <label>
        <span>@ui["settings.downloadClients.field.name"]</span>
        <input asp-for="Name" required />
    </label>
    <label>
        <span>@ui["settings.downloadClients.field.priority"]</span>
        <input asp-for="Priority" type="number" min="1" />
    </label>
    <label class="is-wide">
        <span>@ui["settings.downloadClients.field.baseUrl"]</span>
        <input asp-for="BaseUrl" required placeholder="http://sabnzbd:8080" />
    </label>
    <label class="is-wide">
        <span>@(Model.IsNew ? ui["settings.downloadClients.field.apiKey"] : ui["settings.downloadClients.field.apiKeyKeepCurrent"])</span>
        <input asp-for="Secret" type="password" autocomplete="new-password" />
    </label>
    @if (Model.ShowBooks)
    {
        <label>
            <span>@ui["settings.downloadClients.field.booksCategory"]</span>
            <input asp-for="BooksCategory" placeholder="books" />
        </label>
    }
    @if (Model.ShowAnime)
    {
        <label>
            <span>@ui["settings.downloadClients.field.animeCategory"]</span>
            <input asp-for="AnimeCategory" placeholder="anime" />
        </label>
    }
    @if (Model.ShowTv)
    {
        <label>
            <span>@ui["admin.usenet.tvCategory"]</span>
            <input asp-for="TvCategory" placeholder="tv" />
        </label>
    }
    @if (Model.ShowMovie)
    {
        <label>
            <span>@ui["admin.usenet.movieCategory"]</span>
            <input asp-for="MovieCategory" placeholder="movies" />
        </label>
    }
    @if (Model.ShowManga)
    {
        <label>
            <span>@ui["settings.downloadClients.field.mangaCategory"]</span>
            <input asp-for="MangaCategory" placeholder="manga" />
        </label>
    }
    @if (Model.ShowLightNovels)
    {
        <label>
            <span>@ui["settings.downloadClients.field.lightNovelCategory"]</span>
            <input asp-for="LightNovelCategory" placeholder="lightnovels" />
        </label>
    }
    <p class="muted is-wide">@ui["settings.downloadClients.categoriesHint"]</p>
    <label class="usenet-form-check">
        <input asp-for="Enabled" type="checkbox" />
        <span>@ui["settings.connectionTable.enabled"]</span>
    </label>
    <div class="usenet-form-actions is-wide">
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
        <a class="button button-quiet" asp-page="/Admin/Usenet">@ui["common.cancel"]</a>
    </div>
</form>
