@page "/Settings/Indexers/Edit/{id:guid?}"
@model Jularr.Web.Pages.Settings.Indexers.EditModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = Model.IsNew ? ui["settings.indexers.addTitle"] : ui["settings.indexers.editTitle"];
}
@section Head {
    <link rel="stylesheet" href="~/css/acquisition.css" asp-append-version="true" />
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Admin/Usenet">← @ui["admin.usenet.title"]</a>
        <h1>@(Model.IsNew ? ui["settings.indexers.addTitle"] : ui["settings.indexers.editTitle"])</h1>
    </div>
</header>

@if (Model.Error is not null)
{
    <p class="metadata-error" role="alert">@Model.Error</p>
}

<form method="post" class="panel usenet-form">
    <label>
        <span>@ui["settings.downloadClients.field.name"]</span>
        <input asp-for="Name" required />
    </label>
    <label>
        <span>@ui["settings.indexers.field.type"]</span>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<Jularr.Web.Features.Acquisition.Indexers.IndexerType>()"></select>
    </label>
    <label class="is-wide">
        <span>@ui["settings.downloadClients.field.baseUrl"]</span>
        <input asp-for="BaseUrl" required placeholder="https://indexer.example" />
    </label>
    <label class="is-wide">
        <span>@(Model.IsNew ? ui["settings.indexers.field.apiKey"] : ui["settings.indexers.field.apiKeyKeepCurrent"])</span>
        <input asp-for="ApiKey" type="password" autocomplete="new-password" />
    </label>
    <label>
        <span>@ui["settings.indexers.field.categories"]</span>
        <input asp-for="Categories" placeholder="5000, 5070" />
    </label>
    <label>
        <span>@ui["settings.indexers.field.bookCategories"]</span>
        <input asp-for="BookCategories" placeholder="7020, 7000" />
        <small>@ui["settings.indexers.field.bookCategoriesHint"]</small>
    </label>
    <label>
        <span>@ui["settings.indexers.field.indexerIds"]</span>
        <input asp-for="IndexerIds" />
    </label>
    <label>
        <span>@ui["settings.indexers.field.searchLimit"]</span>
        <input asp-for="SearchLimit" type="number" min="1" max="1000" />
    </label>
    <label>
        <span>@ui["settings.indexers.field.priority"]</span>
        <input asp-for="Priority" type="number" min="1" />
    </label>
    <label class="usenet-form-check">
        <input asp-for="Enabled" type="checkbox" />
        <span>@ui["settings.connectionTable.enabled"]</span>
    </label>
    <label class="usenet-form-check">
        <input asp-for="AutomaticSearch" type="checkbox" />
        <span>@ui["settings.indexers.field.automaticSearch"]</span>
    </label>
    <label class="usenet-form-check">
        <input asp-for="InteractiveSearch" type="checkbox" />
        <span>@ui["settings.indexers.field.interactiveSearch"]</span>
    </label>
    <div class="usenet-form-actions is-wide">
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
        <a class="button button-quiet" asp-page="/Admin/Usenet">@ui["common.cancel"]</a>
    </div>
</form>
