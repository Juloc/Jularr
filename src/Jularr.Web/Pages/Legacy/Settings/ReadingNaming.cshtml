@page "/Settings/ReadingNaming"
@using Jularr.Web.Features.Acquisition.Access
@model Jularr.Web.Pages.Settings.ReadingNamingModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.readingNaming.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" href="@Model.BackUrl">@ui["settings.readingNaming.backToNaming"]</a>
        <h1>@ui["settings.readingNaming.title"]</h1>
        <p>@ui["settings.readingNaming.pageDescription"]</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="metadata-error" style="color:inherit">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error">@Model.Error</p>
}

<nav class="inline-actions" aria-label="@ui["settings.readingNaming.kindTabsAria"]">
    @foreach (var kind in Model.Kinds)
    {
        <a class="button @(kind == Model.Kind ? "button-primary" : "")" asp-page="/Legacy/Settings/ReadingNaming" asp-route-kind="@kind">
            @ui[$"settings.readingNaming.kind.{kind}"]
        </a>
    }
</nav>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui.Format("settings.readingNaming.editHeading", ("kind", ui[$"settings.readingNaming.kind.{Model.Kind}"]))</h2>
        <span>@Model.Input.Name</span>
    </div>

    <form method="post" class="form-stack">
        <input type="hidden" asp-for="Input.MediaKind" />
        <label>
            <span>@ui["settings.readingNaming.nameLabel"]</span>
            <input asp-for="Input.Name" maxlength="80" required />
        </label>
        <label>
            <span>@ui["settings.readingNaming.seriesFolderFormatLabel"]</span>
            <input asp-for="Input.SeriesFolderFormat" spellcheck="false" />
        </label>
        <label>
            <span>@ui["settings.readingNaming.fileFormatLabel"]</span>
            <input asp-for="Input.FileFormat" spellcheck="false" />
        </label>

        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="validation">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="inline-actions">
            <button class="button" type="submit" asp-page-handler="Preview">@ui["settings.readingNaming.preview"]</button>
            <button class="button button-primary" type="submit" asp-page-handler="Save">@ui["settings.readingNaming.saveProfile"]</button>
        </div>
    </form>

    <div class="inline-actions">
        <a class="button" asp-page="/Legacy/Settings/ReadingNaming" asp-route-kind="@Model.Kind" asp-route-preset="default">@ui["settings.readingNaming.useDefaultPreset"]</a>
        <a class="button" asp-page="/Legacy/Settings/ReadingNaming" asp-route-kind="@Model.Kind" asp-route-preset="structured">@ui["settings.readingNaming.useStructuredPreset"]</a>
    </div>
</section>

@if (Model.Preview.Count > 0)
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.readingNaming.previewHeading"]</h2>
            <span>@ui["settings.readingNaming.sample"]</span>
        </div>
        <dl class="status-list">
            @foreach (var line in Model.Preview)
            {
                <div><dt class="muted">@line.Label</dt><dd><code>@line.Value</code></dd></div>
            }
        </dl>
    </section>
}

<section class="panel">
    <details>
        <summary>@ui["settings.readingNaming.tokensSummary"]</summary>
        <p class="muted">@ui["settings.readingNaming.tokensHelp"]</p>
        <ul>
            <li><strong>@ui["settings.readingNaming.tokens.workHeading"]</strong>: <code>{Series}</code> <code>{Author}</code> <code>{Language}</code></li>
            <li><strong>@ui["settings.readingNaming.tokens.fileHeading"]</strong>: <code>{Title}</code> <code>{Volume}</code> <code>{Volume Number:00}</code> <code>{Volume Title}</code> <code>{Chapter}</code> <code>{Chapter Number:000}</code> <code>{Format}</code> <code>{Original Title}</code></li>
        </ul>
        <p class="muted">@ui["settings.readingNaming.tokensHint"]</p>
    </details>
</section>
