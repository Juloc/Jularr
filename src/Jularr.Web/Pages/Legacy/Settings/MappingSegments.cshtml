@page "/Settings/MappingSegments"
@model Jularr.Web.Pages.Settings.MappingSegmentsModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.mappingSegments.title"];
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["settings.mappingSegments.eyebrow"]</span>
        <h1>@ui["settings.mappingSegments.title"]</h1>
        <p>@ui["settings.mappingSegments.pageDescription"]</p>
    </div>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mappingSegments.addSegment"]</h2>
            <span>@ui["settings.scope.owner"]</span>
        </div>

        <form method="post" asp-page-handler="Add" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label>
                <span>@ui["settings.mappingSegments.mediaTypeLabel"]</span>
                <select asp-for="MediaType">
                    <option value="manga">@ui["settings.mappingSegments.mangaOption"]</option>
                    <option value="novel">@ui["settings.mappingSegments.novelOption"]</option>
                </select>
            </label>

            <label>
                <span>@ui["settings.mappingSegments.localIdLabel"]</span>
                <input asp-for="LocalId" autocomplete="off" />
                <span asp-validation-for="LocalId" class="validation"></span>
            </label>

            <div class="form-grid">
                <label>
                    <span>@ui["settings.mappingSegments.localChapterStart"]</span>
                    <input asp-for="LocalChapterStart" type="number" min="0.001" step="0.001" />
                </label>
                <label>
                    <span>@ui["settings.mappingSegments.localChapterEnd"]</span>
                    <input asp-for="LocalChapterEnd" type="number" min="0.001" step="0.001" />
                </label>
                <label>
                    <span>@ui["settings.mappingSegments.remoteChapterStart"]</span>
                    <input asp-for="RemoteChapterStart" type="number" min="1" />
                </label>
            </div>

            <label>
                <span>@ui["settings.mappingSegments.externalIdLabel"]</span>
                <input asp-for="ExternalId" inputmode="numeric" autocomplete="off" />
                <span asp-validation-for="ExternalId" class="validation"></span>
            </label>

            <label>
                <span>@ui["settings.mappingSegments.preferredTitleLabel"]</span>
                <input asp-for="PreferredTitle" autocomplete="off" />
            </label>

            <label>
                <span>@ui["settings.mappingSegments.remoteChapterCountLabel"]</span>
                <input asp-for="RemoteChapterCount" type="number" min="1" />
            </label>

            <div class="form-grid">
                <label>
                    <span>@ui["settings.mappingSegments.localVolumeStart"]</span>
                    <input asp-for="LocalVolumeStart" type="number" min="1" />
                </label>
                <label>
                    <span>@ui["settings.mappingSegments.localVolumeEnd"]</span>
                    <input asp-for="LocalVolumeEnd" type="number" min="1" />
                </label>
                <label>
                    <span>@ui["settings.mappingSegments.remoteVolumeStart"]</span>
                    <input asp-for="RemoteVolumeStart" type="number" min="1" />
                </label>
            </div>

            <p class="muted">
                @ui["settings.mappingSegments.authorityNote"]
            </p>

            <button class="button button-primary" type="submit">@ui["settings.mappingSegments.addMapping"]</button>
        </form>
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["settings.mappingSegments.configuredHeading"]</h2>
        <span>@Model.Mappings.Count</span>
    </div>

    @if (Model.Mappings.Count == 0)
    {
        <p class="muted">@ui["settings.mappingSegments.empty"]</p>
    }
    else
    {
        <div class="status-list">
            @foreach (var mapping in Model.Mappings)
            {
                var targetUrl = Jularr.Web.Pages.Settings.MappingSegmentsModel.TargetUrl(mapping);
                <div>
                    <span>
                        @ui.Format(
                            "settings.mappingSegments.summaryLine",
                            ("mediaType", mapping.MediaType),
                            ("localStart", mapping.LocalChapterStart),
                            ("localEnd", mapping.LocalChapterEnd),
                            ("externalId", mapping.ExternalId),
                            ("remoteStart", mapping.RemoteChapterStart))
                    </span>
                    <strong>@(mapping.PreferredTitle ?? ui.Format("settings.mappingSegments.defaultTitle", ("externalId", mapping.ExternalId)))</strong>

                    @if (mapping.LocalVolumeStart is not null)
                    {
                        <small>
                            @ui.Format(
                                "settings.mappingSegments.volumeSummary",
                                ("localStart", mapping.LocalVolumeStart),
                                ("localEnd", mapping.LocalVolumeEnd),
                                ("remoteStart", mapping.RemoteVolumeStart))
                        </small>
                    }

                    <div class="inline-actions">
                        @if (targetUrl is not null)
                        {
                            <a class="button" href="@targetUrl">@ui["settings.mappingSegments.openLocalWork"]</a>
                        }

                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="id" value="@mapping.Id" />
                            <button class="button" type="submit">@ui["settings.mappingSegments.remove"]</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</section>
