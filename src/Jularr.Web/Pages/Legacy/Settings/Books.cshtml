@page "/Settings/Books"
@model Jularr.Web.Pages.Settings.BooksModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.books.title"];
}

<header class="page-header">
    <div>
        <a class="back-link" asp-page="/Settings/Index">← @ui["nav.settings"]</a>
        <h1>@ui["settings.books.title"]</h1>
        <p>@ui["settings.books.pageDescription"]</p>
    </div>
</header>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.books.hardcover.heading"]</h2>
            <span class="status-pill @(Model.HardcoverEnabled ? "status-ok" : "")">
                @(Model.HardcoverEnabled ? ui["settings.books.hardcover.status.enabled"] : ui["settings.books.hardcover.status.disabled"])
            </span>
        </div>
        <p class="muted">@ui["settings.books.hardcover.description"]</p>

        @if (!Model.IsOwner)
        {
            <p class="muted">@ui["settings.books.ownerOnly"]</p>
        }
        else
        {
            <form method="post" asp-page-handler="Save" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <label>
                    <span>@ui["settings.books.hardcover.apiKey"]</span>
                    <input asp-for="HardcoverApiKey" type="password" autocomplete="new-password" />
                    @if (Model.HardcoverEnabled)
                    {
                        <small class="muted">@ui["settings.books.hardcover.apiKeyKeep"]</small>
                    }
                </label>
                <p>
                    <a href="@Jularr.Web.Features.Books.BookCatalogService.HardcoverNewTokenUrl" target="_blank" rel="noopener noreferrer">
                        @ui["settings.books.hardcover.tokenLink"]
                    </a>
                </p>
                <div class="form-actions">
                    <button class="button button-primary" type="submit">@ui["common.save"]</button>
                    @if (Model.HardcoverEnabled)
                    {
                        <button class="button" type="submit" asp-page-handler="Remove" formnovalidate>@ui["settings.books.hardcover.remove"]</button>
                    }
                </div>
            </form>
        }
    </section>
</div>
