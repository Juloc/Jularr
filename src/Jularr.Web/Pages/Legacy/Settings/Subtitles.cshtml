@page "/Settings/Subtitles"
@using Jularr.Web.Features.Providers
@using Jularr.Web.Features.Subtitles
@using Jularr.Web.Features.Watchlist
@model Jularr.Web.Pages.Settings.SubtitlesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.subtitles.title"];

    string MediaTypeLabel(WatchlistMediaType mediaType) => mediaType switch
    {
        WatchlistMediaType.Anime => ui["settings.subtitles.mediaType.anime"],
        WatchlistMediaType.Tv => ui["settings.subtitles.mediaType.tv"],
        WatchlistMediaType.Movie => ui["settings.subtitles.mediaType.movie"],
        WatchlistMediaType.Manga => ui["settings.subtitles.mediaType.manga"],
        WatchlistMediaType.LightNovel => ui["settings.subtitles.mediaType.lightNovel"],
        WatchlistMediaType.Book => ui["settings.subtitles.mediaType.book"],
        _ => mediaType.ToString()
    };
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Admin/Subtitles">@ui["common.backToSettings"]</a>
        <h1>@ui["settings.subtitles.title"]</h1>
        <p>@ui["settings.subtitles.pageDescription"]</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <p class="metadata-error" style="color:inherit">@Model.Notice</p>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error">@Model.Error</p>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.subtitles.profilesHeading"]</h2>
            <span>@Model.Profiles.Count</span>
        </div>
        <ul>
            @foreach (var profile in Model.Profiles)
            {
                <li>
                    <a asp-page="/Legacy/Settings/Subtitles" asp-route-edit="@profile.Id"><strong>@profile.Name</strong></a>
                    <span class="muted">
                        @ui.Format("settings.subtitles.languageCount", ("count", profile.Items.Count))
                        @(profile.IsGlobalDefault ? $" · {ui["settings.subtitles.default"]}" : "")
                        @(profile.AssignmentCount > 0 ? $" · {ui.Format("settings.subtitles.assignments", ("count", profile.AssignmentCount))}" : "")
                    </span>
                </li>
            }
        </ul>
        <div class="inline-actions">
            <a class="button" asp-page="/Legacy/Settings/Subtitles">@ui["settings.subtitles.newProfile"]</a>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.subtitles.assignmentHeading"]</h2>
            <span>@ui["settings.subtitles.assignmentFallbackNote"]</span>
        </div>

        @foreach (var mediaType in Enum.GetValues<WatchlistMediaType>())
        {
            Model.MediaTypeAssignments.TryGetValue(mediaType, out var assigned);
            <form method="post" asp-page-handler="AssignMediaType" class="form-stack">
                <input type="hidden" name="mediaType" value="@mediaType" />
                <label>
                    <span>@MediaTypeLabel(mediaType)</span>
                    <select name="profileId">
                        <option value="" selected="@(assigned is null)">@ui["settings.subtitles.useDefault"]</option>
                        @foreach (var profile in Model.Profiles)
                        {
                            <option value="@profile.Id" selected="@(profile.Id == assigned)">@profile.Name</option>
                        }
                    </select>
                </label>
                <div class="inline-actions"><button class="button" type="submit">@ui["common.save"]</button></div>
            </form>
        }

        @foreach (var root in Model.Roots)
        {
            Model.LibraryRootAssignments.TryGetValue(root.Id, out var assigned);
            <form method="post" asp-page-handler="AssignLibraryRoot" class="form-stack">
                <input type="hidden" name="libraryRootId" value="@root.Id" />
                <label>
                    <span>@ui.Format("settings.subtitles.libraryLabel", ("name", root.Name))</span>
                    <select name="profileId">
                        <option value="" selected="@(assigned is null)">@ui["settings.subtitles.useDefault"]</option>
                        @foreach (var profile in Model.Profiles)
                        {
                            <option value="@profile.Id" selected="@(profile.Id == assigned)">@profile.Name</option>
                        }
                    </select>
                </label>
                <div class="inline-actions"><button class="button" type="submit">@ui["common.save"]</button></div>
            </form>
        }
        <p class="muted">@ui["settings.subtitles.animeOnlyNote"]</p>
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@(Model.IsExistingProfile ? ui.Format("settings.subtitles.editProfile", ("name", Model.Input.Name)) : ui["settings.subtitles.newProfile"])</h2>
    </div>

    <form method="post" asp-page-handler="Save" class="form-stack">
        @if (Model.IsExistingProfile)
        {
            <input type="hidden" asp-for="Input.Id" />
        }
        <label>
            <span>@ui["settings.subtitles.nameLabel"]</span>
            <input asp-for="Input.Name" maxlength="120" required />
        </label>
        <label>
            <span>@ui["settings.subtitles.itemsLabel"]</span>
            <textarea asp-for="Input.ItemsText" rows="6" spellcheck="false" placeholder="en&#10;en,forced&#10;de,sdh"></textarea>
            <small class="muted">@ui["settings.subtitles.itemsHint"]</small>
        </label>
        <label>
            <span>@ui["settings.subtitles.cutoffLabel"]</span>
            <input asp-for="Input.CutoffPositionText" placeholder="@ui["settings.subtitles.cutoffPlaceholder"]" />
            <small class="muted">@ui["settings.subtitles.cutoffHint"]</small>
        </label>

        <div class="inline-actions">
            <button class="button button-primary" type="submit">@ui["settings.subtitles.saveProfile"]</button>
        </div>
    </form>

    @if (Model.IsExistingProfile)
    {
        <div class="inline-actions">
            <form method="post" asp-page-handler="SetDefault">
                <input type="hidden" name="profileId" value="@Model.Input.Id" />
                <button class="button" type="submit">@ui["settings.subtitles.makeDefault"]</button>
            </form>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" name="profileId" value="@Model.Input.Id" />
                <button class="button" type="submit">@ui["settings.subtitles.deleteProfile"]</button>
            </form>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["settings.subtitles.providersHeading"]</h2>
        <span>@(Model.HasProviders ? ui.Format("settings.subtitles.providersConfiguredCount", ("count", Model.Providers.Count)) : ui["settings.subtitles.noProvidersConfigured"])</span>
    </div>

    @if (Model.HasProviders)
    {
        <ul>
            @foreach (var provider in Model.Providers)
            {
                var health = Model.HealthOf(provider);
                <li>
                    <strong>@provider.DisplayName</strong>
                    @switch (health.Status)
                    {
                        case ProviderHealthStatus.Healthy:
                            <span class="status-pill status-ok">@ui["settings.subtitles.health.healthy"]</span>
                            break;
                        case ProviderHealthStatus.Degraded:
                            <span class="status-pill status-warn">@ui["settings.subtitles.health.degraded"]</span>
                            break;
                        case ProviderHealthStatus.Unavailable:
                            <span class="status-pill status-error">@ui["settings.subtitles.health.unavailable"]</span>
                            break;
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p class="muted">@ui["settings.subtitles.noProvidersHelp"]</p>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["settings.subtitles.opensubtitles.heading"]</h2>
        @if (Model.OpenSubtitlesConnection.Configured)
        {
            <span class="status-pill status-ok">@ui.Format("settings.subtitles.opensubtitles.connectedAs", ("username", Model.OpenSubtitlesConnection.Username ?? ""))</span>
        }
    </div>

    <p class="muted">@ui["settings.subtitles.opensubtitles.description"]</p>

    @if (Model.OpenSubtitlesConnection.Configured)
    {
        <form method="post" asp-page-handler="RemoveOpenSubtitles">
            <button class="button" type="submit">@ui["common.remove"]</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="SaveOpenSubtitles" class="form-stack">
            <label>
                <span>@ui["settings.subtitles.opensubtitles.apiKeyLabel"]</span>
                <input asp-for="OpenSubtitlesForm.ApiKey" type="password" autocomplete="new-password" required />
            </label>
            <label>
                <span>@ui["settings.subtitles.opensubtitles.usernameLabel"]</span>
                <input asp-for="OpenSubtitlesForm.Username" autocomplete="off" required />
            </label>
            <label>
                <span>@ui["settings.subtitles.opensubtitles.passwordLabel"]</span>
                <input asp-for="OpenSubtitlesForm.Password" type="password" autocomplete="new-password" required />
            </label>
            <div class="inline-actions">
                <button class="button button-primary" type="submit">@ui["settings.subtitles.opensubtitles.testAndSave"]</button>
            </div>
        </form>
    }
</section>
