@page "/Settings/MappingReview"
@using Jularr.Web.Features.Mapping
@model Jularr.Web.Pages.Settings.MappingReviewModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["settings.mappingReview.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/mapping.css" asp-append-version="true" />
}

@functions {
    private string RoleLabel(MappingProviderRole role) => role switch
    {
        MappingProviderRole.DisplayMetadata => Model.Ui["settings.mapping.role.displayMetadata"],
        MappingProviderRole.EpisodeStructure => Model.Ui["settings.mapping.role.episodeStructure"],
        MappingProviderRole.AcquisitionIdentity => Model.Ui["settings.mapping.role.acquisitionIdentity"],
        MappingProviderRole.ProgressTracking => Model.Ui["settings.mapping.role.progressTracking"],
        MappingProviderRole.Artwork => Model.Ui["settings.mapping.role.artwork"],
        MappingProviderRole.CrossReferenceIds => Model.Ui["settings.mapping.role.crossReferenceIds"],
        _ => role.ToString()
    };

    private string ProviderLabel(string provider) =>
        Model.Ui[$"settings.mapping.provider.{provider}"];

    private string StateClass(AnimeMappingState state) => state switch
    {
        AnimeMappingState.Exact => "map-state map-exact",
        AnimeMappingState.Partial => "map-state map-partial",
        AnimeMappingState.Missing => "map-state map-missing",
        AnimeMappingState.Conflict => "map-state map-conflict",
        AnimeMappingState.Unmapped => "map-state map-unmapped",
        _ => "map-state"
    };

    private string StateLabel(AnimeMappingState state) => state switch
    {
        AnimeMappingState.Exact => Model.Ui["settings.mapping.state.exact"],
        AnimeMappingState.Partial => Model.Ui["settings.mapping.state.partial"],
        AnimeMappingState.Missing => Model.Ui["settings.mapping.state.missing"],
        AnimeMappingState.Conflict => Model.Ui["settings.mapping.state.conflict"],
        AnimeMappingState.Unmapped => Model.Ui["settings.mapping.state.unmapped"],
        _ => state.ToString()
    };
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["settings.mappingReview.eyebrow"]</span>
        <h1>@ui["settings.mappingReview.title"]</h1>
        <p>@ui["settings.mappingReview.pageDescription"]</p>
    </div>
</header>

<p class="inline-actions">
    <a class="button button-quiet" asp-page="/Admin/MergeReview/Index">@ui["settings.mapping.mergeReview.link"]</a>
</p>

@if (Model.AnimeId is { } animeId)
{
    <p><a href="/Settings/MappingReview">@ui["settings.mapping.backToQueue"]</a></p>

    <section class="panel">
        <div class="panel-heading">
            <h2>@Model.AnimeTitle</h2>
            <span>@ui["settings.mapping.apply.eyebrow"]</span>
        </div>

        @* Per-anime provider roles *@
        <h3>@ui["settings.mapping.roles.workHeading"]</h3>
        <p class="muted">@ui["settings.mapping.roles.workDescription"]</p>
        <div class="map-roles">
            @foreach (var assignment in Model.WorkRoles)
            {
                <div class="map-role-row">
                    <span class="map-role-name">@RoleLabel(assignment.Role)</span>
                    <form method="post" asp-page-handler="SetWorkRole" class="map-role-set">
                        <input type="hidden" name="animeId" value="@animeId" />
                        <input type="hidden" name="role" value="@MappingProviderRoles.StorageKey(assignment.Role)" />
                        <select name="provider" aria-label="@RoleLabel(assignment.Role)">
                            @foreach (var provider in MappingProviders.AllowedFor(assignment.Role))
                            {
                                <option value="@provider" selected="@(provider == assignment.Provider)">@ProviderLabel(provider)</option>
                            }
                        </select>
                        <button class="button" type="submit">@ui["settings.mapping.roles.save"]</button>
                    </form>
                    <form method="post" asp-page-handler="SetWorkRole">
                        <input type="hidden" name="animeId" value="@animeId" />
                        <input type="hidden" name="role" value="@MappingProviderRoles.StorageKey(assignment.Role)" />
                        <input type="hidden" name="provider" value="" />
                        <button class="button button-quiet" type="submit">@ui["settings.mapping.roles.useGlobal"]</button>
                    </form>
                    <span class="map-role-source">
                        @(assignment.Source == ProviderRoleSource.WorkOverride
                            ? ui["settings.mapping.roles.sourceOverride"]
                            : ui["settings.mapping.roles.sourceInherited"])
                    </span>
                </div>
            }
        </div>
    </section>

    @if (Model.Candidates.Count > 0)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.mapping.candidates.heading"]</h2>
            </div>
            <div class="status-list">
                @foreach (var candidate in Model.Candidates)
                {
                    <div>
                        <span>@candidate.Provider:@candidate.ExternalId@(string.IsNullOrWhiteSpace(candidate.Format) ? "" : " · " + candidate.Format)</span>
                        <strong>@candidate.Title</strong>
                        @if (candidate.Score > 0)
                        {
                            <small>@ui.Format("settings.mappingReview.confidenceScore", ("score", candidate.Score))</small>
                        }
                        @if (candidate.Evidence.Count > 0)
                        {
                            <small>@string.Join(" · ", candidate.Evidence)</small>
                        }
                        <form method="post" asp-page-handler="PreviewRange">
                            <input type="hidden" name="animeId" value="@animeId" />
                            <input type="hidden" name="RangeSeason" value="1" />
                            <input type="hidden" name="RangeLocalStart" value="1" />
                            <input type="hidden" name="RangeExternalId" value="@candidate.ExternalId" />
                            <input type="hidden" name="RangeRemoteStart" value="1" />
                            <input type="hidden" name="RangeRemoteCount" value="@(candidate.UnitCount?.ToString() ?? "")" />
                            <button class="button button-quiet" type="submit">@ui["settings.mapping.candidates.use"]</button>
                        </form>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.ShownPreview is { } shown)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@(Model.ProposedPreview is not null ? ui["settings.mapping.preview.proposedHeading"] : ui["settings.mapping.preview.currentHeading"])</h2>
                <span>@ui.Format("settings.mapping.preview.summary", ("exact", shown.ExactCount), ("partial", shown.PartialCount), ("missing", shown.MissingCount), ("conflict", shown.ConflictCount), ("unmapped", shown.UnmappedCount))</span>
            </div>

            @if (shown.Problems.Count > 0)
            {
                <ul class="map-problems">
                    @foreach (var problem in shown.Problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            }

            @if (shown.Episodes.Count == 0)
            {
                <p class="muted">@ui["settings.mapping.preview.noEpisodes"]</p>
            }
            else
            {
                <table class="map-table">
                    <thead>
                        <tr>
                            <th>@ui["settings.mapping.preview.local"]</th>
                            <th>@ui["settings.mapping.preview.state"]</th>
                            <th>@ui["settings.mapping.preview.provider"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in shown.Episodes)
                        {
                            <tr>
                                <td>
                                    S@(row.SeasonNumber.ToString("00"))E@(row.Number.ToString("00"))
                                    @if (row.IsSpecial)
                                    {
                                        <small class="muted"> @ui["settings.mapping.preview.special"]</small>
                                    }
                                </td>
                                <td><span class="@StateClass(row.State)">@StateLabel(row.State)</span></td>
                                <td>
                                    @if (row.Provider is not null && row.RemoteEpisode is not null)
                                    {
                                        <text>@row.Provider:@row.ExternalId · @ui.Format("settings.mapping.preview.remoteEpisode", ("number", row.RemoteEpisode))</text>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }

    @if (Model.AppliedRanges.Count > 0)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.mapping.applied.heading"]</h2>
            </div>
            <div class="status-list">
                @foreach (var range in Model.AppliedRanges)
                {
                    <div class="map-range-row">
                        <span>S@(range.SeasonNumber.ToString("00"))E@(range.LocalStart.ToString("00"))–@range.LocalEnd.ToString("00") → @range.Provider:@range.ExternalId @ui.Format("settings.mapping.preview.remoteEpisode", ("number", range.RemoteStart))</span>
                        <form method="post" asp-page-handler="RemoveRange">
                            <input type="hidden" name="animeId" value="@animeId" />
                            <input type="hidden" name="season" value="@range.SeasonNumber" />
                            <input type="hidden" name="localStart" value="@range.LocalStart" />
                            <button class="button button-quiet" type="submit">@ui["settings.mapping.applied.remove"]</button>
                        </form>
                    </div>
                }
            </div>
        </section>
    }

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mapping.form.heading"]</h2>
            <span>@ui["settings.mapping.form.hint"]</span>
        </div>

        @if (Model.RangeError is not null)
        {
            <p class="map-error" role="alert">@Model.RangeError</p>
        }

        <form method="post" asp-page-handler="PreviewRange" class="map-form">
            <input type="hidden" name="animeId" value="@animeId" />
            <div class="map-form-grid">
                <label>@ui["settings.mapping.form.season"]
                    <input type="number" name="RangeSeason" value="@Model.RangeSeason" min="0" />
                </label>
                <label>@ui["settings.mapping.form.localStart"]
                    <input type="number" name="RangeLocalStart" value="@Model.RangeLocalStart" min="1" />
                </label>
                <label>@ui["settings.mapping.form.localEnd"]
                    <input type="number" name="RangeLocalEnd" value="@(Model.RangeLocalEnd?.ToString() ?? "")" min="1" />
                </label>
                <label>@ui["settings.mapping.form.externalId"]
                    <input type="text" name="RangeExternalId" value="@Model.RangeExternalId" inputmode="numeric" />
                </label>
                <label>@ui["settings.mapping.form.remoteStart"]
                    <input type="number" name="RangeRemoteStart" value="@Model.RangeRemoteStart" min="1" />
                </label>
                <label>@ui["settings.mapping.form.remoteCount"]
                    <input type="number" name="RangeRemoteCount" value="@(Model.RangeRemoteCount?.ToString() ?? "")" min="1" />
                </label>
            </div>
            <label class="map-check">
                <input type="checkbox" name="RangeUnmapped" value="true" @(Model.RangeUnmapped ? "checked" : "") />
                @ui["settings.mapping.form.unmapped"]
            </label>
            <div class="inline-actions">
                <button class="button" type="submit">@ui["settings.mapping.form.preview"]</button>
                <button class="button button-primary" type="submit" asp-page-handler="ApplyRange">@ui["settings.mapping.form.apply"]</button>
            </div>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mapping.unmapped.heading"]</h2>
        </div>
        <p class="muted">@ui["settings.mapping.unmapped.description"]</p>
        <form method="post" asp-page-handler="MarkUnmapped">
            <input type="hidden" name="animeId" value="@animeId" />
            <button class="button" type="submit">@ui["settings.mapping.unmapped.action"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mapping.audit.heading"]</h2>
        </div>
        @if (Model.Audit.Count == 0)
        {
            <p class="muted">@ui["settings.mapping.audit.empty"]</p>
        }
        else
        {
            <div class="status-list">
                @foreach (var entry in Model.Audit)
                {
                    <div>
                        <span>@entry.CreatedAt.ToLocalTime().ToString("g") · @entry.Action</span>
                        <strong>@entry.Summary</strong>
                        @if (!string.IsNullOrWhiteSpace(entry.Details))
                        {
                            <small class="map-audit-details">@entry.Details</small>
                        }
                    </div>
                }
            </div>
        }
    </section>
}
else
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["settings.mapping.roles.globalHeading"]</h2>
            <span>@ui["settings.mapping.roles.globalEyebrow"]</span>
        </div>
        <p class="muted">@ui["settings.mapping.roles.globalDescription"]</p>
        <div class="map-roles">
            @foreach (var assignment in Model.GlobalRoles)
            {
                <div class="map-role-row">
                    <span class="map-role-name">@RoleLabel(assignment.Role)</span>
                    <form method="post" asp-page-handler="SetGlobalRole" class="map-role-set">
                        <input type="hidden" name="role" value="@MappingProviderRoles.StorageKey(assignment.Role)" />
                        <select name="provider" aria-label="@RoleLabel(assignment.Role)">
                            @foreach (var provider in MappingProviders.AllowedFor(assignment.Role))
                            {
                                <option value="@provider" selected="@(provider == assignment.Provider)">@ProviderLabel(provider)</option>
                            }
                        </select>
                        <button class="button" type="submit">@ui["settings.mapping.roles.save"]</button>
                    </form>
                    <span class="map-role-source">
                        @(assignment.Source == ProviderRoleSource.GlobalDefault
                            ? ui["settings.mapping.roles.sourceGlobal"]
                            : ui["settings.mapping.roles.sourceBuiltIn"])
                    </span>
                </div>
            }
        </div>
    </section>

    @if (Model.Tasks.Count == 0)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["settings.mappingReview.empty.title"]</h2>
                <span>@ui["settings.mappingReview.clear"]</span>
            </div>
            <p class="muted">@ui["settings.mappingReview.empty.body"]</p>
        </section>
    }
    else
    {
        <div class="settings-grid">
            @foreach (var task in Model.Tasks)
            {
                var targetUrl = Jularr.Web.Pages.Settings.MappingReviewModel.TargetUrl(task);

                <section class="panel">
                    <div class="panel-heading">
                        <h2>@task.LocalTitle</h2>
                        <span>@task.MediaType · @task.Purpose</span>
                    </div>

                    <p>@task.Reason</p>

                    @if (task.Candidates.Count > 0)
                    {
                        <div class="status-list">
                            @foreach (var candidate in task.Candidates)
                            {
                                <div>
                                    <span>
                                        @candidate.Provider:@candidate.ExternalId
                                        @if (!string.IsNullOrWhiteSpace(candidate.Format))
                                        {
                                            <text> · @candidate.Format</text>
                                        }
                                    </span>
                                    <strong>@candidate.Title</strong>
                                    @if (candidate.Score > 0)
                                    {
                                        <small>@ui.Format("settings.mappingReview.confidenceScore", ("score", candidate.Score))</small>
                                    }
                                    @if (candidate.Evidence.Count > 0)
                                    {
                                        <small>@string.Join(" · ", candidate.Evidence)</small>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <p class="muted">
                        @ui.Format("settings.mappingReview.updatedAt", ("time", task.UpdatedAt.ToLocalTime().ToString("g")))
                    </p>

                    <div class="inline-actions">
                        @if (targetUrl is not null)
                        {
                            <a class="button button-primary" href="@targetUrl">@ui["settings.mappingReview.reviewMapping"]</a>
                        }

                        <form method="post" asp-page-handler="Dismiss">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button class="button" type="submit">@ui["settings.mappingReview.dismiss"]</button>
                        </form>
                    </div>
                </section>
            }
        </div>
    }
}
