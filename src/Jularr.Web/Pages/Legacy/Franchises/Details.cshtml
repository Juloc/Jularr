@page "/Franchises/{id:guid}"
@model Jularr.Web.Pages.Franchises.DetailsModel
@using Jularr.Web.Features.Franchises
@using Jularr.Web.Features.Watchlist
@{
    var ui = Model.Ui;
    var title = FranchiseLabels.Title(ui, Model.Franchise.Title);
    ViewData["Title"] = title;
}

@section Head {
    <link rel="stylesheet" href="~/css/discover.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/franchise.css" asp-append-version="true" />
}

<div class="franchise-page">
    <header class="franchise-header">
        <div>
            <a class="franchise-back" href="/Watchlist">@ui["franchise.back"]</a>
            <h1>@title</h1>
            <p>@ui.Format("franchise.memberCount", ("count", Model.Franchise.MemberCount))</p>
        </div>
        <div class="franchise-header-actions">
            @if (Model.IsFollowed)
            {
                <form method="post" asp-page-handler="Unfollow">
                    <input type="hidden" name="id" value="@Model.Franchise.Id" />
                    <button class="button" type="submit">@ui["watchlist.unfollowFranchise"]</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Follow">
                    <input type="hidden" name="id" value="@Model.Franchise.Id" />
                    <button class="button button-primary" type="submit">@ui["watchlist.followFranchise"]</button>
                </form>
            }

            @if (Model.CanRefresh)
            {
                <form method="post" asp-page-handler="Refresh">
                    <input type="hidden" name="id" value="@Model.Franchise.Id" />
                    <button class="button" type="submit">@ui["watchlist.refreshFranchise"]</button>
                </form>
            }
        </div>
    </header>

    @if (Model.Members.Count == 0)
    {
        <p class="franchise-empty">@ui["franchise.pendingMembers"]</p>
    }

    @foreach (var group in Model.Members.GroupBy(view => view.Member.Media.Identity.MediaType).OrderBy(group => group.Key))
    {
        <section class="franchise-group">
            <div class="franchise-section-heading">
                <h2>@ui[DetailsModel.TypeLabelKey(group.Key)]</h2>
                <span>@group.Count()</span>
            </div>

            <div class="discover-grid franchise-grid">
                @foreach (var view in group.OrderBy(view => view.Member.Media.Year ?? int.MaxValue).ThenBy(view => view.Member.Media.Title, StringComparer.CurrentCultureIgnoreCase))
                {
                    var item = view.Member.Media;
                    var format = WatchlistLabels.FormatKey(item.Format) is { } formatKey ? ui[formatKey] : null;
                    var providerUrl = item.Identity.ProviderUrl;
                    <article class="discover-card franchise-card@(view.IsHidden ? " is-hidden" : "")">
                        <div class="discover-cover">
                            @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                            {
                                <img src="@item.CoverImageUrl" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <span class="discover-cover-placeholder">@WatchlistLabels.Initial(item.Title)</span>
                            }
                        </div>
                        <div class="discover-card-copy">
                            <div class="discover-card-kicker">
                                <span>@ui[DetailsModel.TypeLabelKey(item.Identity.MediaType)]</span>
                                @if (view.Library is not null)
                                {
                                    <span class="discover-local">@ui["discover.card.inLibrary"]</span>
                                }
                                else if (view.IsHidden)
                                {
                                    <span class="franchise-hidden">@ui["franchise.hidden"]</span>
                                }
                                else if (view.IsFollowed)
                                {
                                    <span class="discover-local">@ui["discover.card.followed"]</span>
                                }
                            </div>
                            <div class="discover-card-title">@item.Title</div>
                            @if (!string.IsNullOrWhiteSpace(item.NativeTitle) && item.NativeTitle != item.Title)
                            {
                                <div class="discover-native-title">@item.NativeTitle</div>
                            }
                            <div class="discover-card-meta">
                                @if (format is not null)
                                {
                                    <span>@format</span>
                                }
                                @if (item.Year is { } year)
                                {
                                    <span>@year</span>
                                }
                            </div>
                            @if (view.RelationLabel is not null)
                            {
                                <div class="franchise-relation">@view.RelationLabel</div>
                            }
                            <div class="discover-card-actions">
                                @if (view.Library is { } local)
                                {
                                    <a class="primary" href="@local.DetailsUrl">@ui["watchlist.open"]</a>
                                }
                                @if (Model.IsFollowed)
                                {
                                    <form method="post" asp-page-handler="@(view.IsHidden ? "ShowMember" : "HideMember")">
                                        <input type="hidden" name="id" value="@Model.Franchise.Id" />
                                        <input type="hidden" name="key" value="@item.Identity.Key" />
                                        <button type="submit">@(view.IsHidden ? ui["franchise.showMember"] : ui["watchlist.remove"])</button>
                                    </form>
                                }
                                @if (providerUrl is not null)
                                {
                                    <a class="discover-provider-link" href="@providerUrl" target="_blank" rel="noopener noreferrer">AniList</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
