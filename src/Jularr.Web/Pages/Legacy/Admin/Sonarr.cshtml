@page "/Admin/Sonarr"
@model Jularr.Web.Pages.Admin.SonarrModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.sonarr.title"];
}

<header class="page-header">
    <div>
        <h1>@ui["admin.sonarr.heading"]</h1>
        <p>@ui["admin.sonarr.subtitle"]</p>
    </div>
    <a class="button" href="/Library">@ui["admin.sonarr.backToLibrary"]</a>
</header>

<partial name="~/Pages/Admin/_AdminNavigation.cshtml" model="Model.Ui" />
<p class="muted">@ui["admin.sonarr.perAnime"] <a asp-page="/Settings/SonarrMigration">@ui["admin.sonarr.migrationLink"]</a> &middot; <a asp-page="/Legacy/Settings/Naming">@ui["admin.sonarr.namingLink"]</a></p>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.sonarr.connection"]</h2>
            <span>@(Model.HasSavedApiKey ? ui["admin.sonarr.saved"] : ui["admin.sonarr.notConfigured"])</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notice))
        {
            <p class="metadata-error" style="color:inherit">@Model.Notice</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <p class="metadata-error">@Model.Error</p>
        }

        <form method="post" class="form-stack">
            <label>
                <span>@ui["admin.sonarr.urlLabel"]</span>
                <input asp-for="BaseUrl" placeholder="http://sonarr:8989" />
            </label>
            <label>
                <span>@ui["admin.sonarr.apiKeyLabel"]</span>
                <input asp-for="ApiKey"
                       type="password"
                       autocomplete="new-password"
                       placeholder="@(Model.HasSavedApiKey ? ui["admin.sonarr.apiKeyKeepPlaceholder"] : ui["admin.sonarr.apiKeyPlaceholder"])" />
            </label>

            <div class="inline-actions">
                <button class="button"
                        type="submit"
                        asp-page-handler="Save">
                    @ui["common.save"]
                </button>
                <button class="button"
                        type="submit"
                        asp-page-handler="Test">
                    @ui["admin.sonarr.testConnection"]
                </button>
                <button class="button button-primary"
                        type="submit"
                        asp-page-handler="Import">
                    @ui["admin.sonarr.importAction"]
                </button>
            </div>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.sonarr.howItWorks"]</h2>
            <span>@ui["admin.sonarr.nonDestructive"]</span>
        </div>
        <p class="muted">
            @ui.Format("admin.sonarr.explanation1", ("path", "/data/artwork")) @ui["admin.sonarr.explanation1b"]
        </p>
        <p class="muted">
            @ui["admin.sonarr.explanation2"]
        </p>
        <p class="muted">
            @ui["admin.sonarr.explanation3"]
        </p>
    </section>

    @if (Model.LastImport is { } import)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["admin.sonarr.lastImport"]</h2>
                <span>@ui.Format("admin.sonarr.matchedCount", ("count", import.MatchedCount))</span>
            </div>
            <div class="metric-grid">
                <div class="metric-card">
                    <span>@ui["admin.sonarr.sonarrSeries"]</span>
                    <strong>@import.SonarrSeriesCount</strong>
                </div>
                <div class="metric-card">
                    <span>@ui["admin.sonarr.posters"]</span>
                    <strong>@import.PosterCount</strong>
                </div>
                <div class="metric-card">
                    <span>@ui["admin.sonarr.fanart"]</span>
                    <strong>@import.FanartCount</strong>
                </div>
                <div class="metric-card">
                    <span>@ui["admin.sonarr.unmatched"]</span>
                    <strong>@import.UnmatchedCount</strong>
                </div>
            </div>

            @if (import.UnmatchedTitles.Count > 0)
            {
                <p class="muted">@ui["admin.sonarr.unmatchedTitles"]</p>
                <ul>
                    @foreach (var title in import.UnmatchedTitles)
                    {
                        <li>@title</li>
                    }
                </ul>
            }

            @if (import.FailedCount > 0)
            {
                <p class="metadata-error">@ui.Format("admin.sonarr.failedDownloads", ("count", import.FailedCount))</p>
            }
        </section>
    }
</div>
