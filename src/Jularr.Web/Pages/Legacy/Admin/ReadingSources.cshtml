@page "/Admin/ReadingSources"
@model Jularr.Web.Pages.Admin.ReadingSourcesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.readingSources.title"];
}

<header class="page-header">
    <div>
        <a class="muted" asp-page="/Admin/Index">← @ui["common.back"]</a>
        <h1>@ui["admin.readingSources.title"]</h1>
        <p>@ui["admin.readingSources.subtitle"]</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="panel" role="alert">@Model.LoadError</div>
}

<form method="post" asp-page-handler="Save" class="form-stack">
    @* One source per row, with the app's form controls (form-stack, checkbox-row). *@
    @foreach (var source in Model.Sources)
    {
        <section class="panel">
            <div class="panel-heading">
                <div>
                    <h2>@source.Definition.Name</h2>
                    <p class="muted">@ui[source.Definition.DescriptionKey]</p>
                    <p class="muted"><strong>@ui[source.Definition.CapabilityKey]</strong> · @ui[source.Definition.LicensingKey]</p>
                </div>
            </div>

            <div class="form-stack">
                <label class="checkbox-row">
                    <input type="checkbox"
                           name="enabledProviders"
                           value="@source.Definition.Key"
                           checked="@source.Preference.Enabled" />
                    @ui["admin.readingSources.enabled"]
                </label>

                <label for="priority-@source.Definition.Key">
                    @ui["admin.readingSources.priority"]
                    <input id="priority-@source.Definition.Key"
                           type="number"
                           min="1"
                           max="999"
                           name="priority[@source.Definition.Key]"
                           value="@source.Preference.Priority" />
                </label>
                <p class="muted">
                    @ui["admin.readingSources.priorityHint"]
                    @(source.Definition.SupportsDirectImport
                        ? ui["admin.readingSources.directImport"]
                        : source.Definition.CanAdd
                            ? ui["admin.readingSources.requestFlow"]
                            : ui["admin.readingSources.referenceOnly"])
                </p>
                <p class="muted" role="status">@ui[source.Health.UiKey]</p>

                @if (ViewData.ModelState.TryGetValue(source.Definition.Key, out var errorState) &&
                     errorState.Errors.Count > 0)
                {
                    <p class="validation" role="alert">@errorState.Errors[0].ErrorMessage</p>
                }
            </div>
        </section>
    }

    <div class="form-actions">
        <button class="button button-primary" type="submit">@ui["common.save"]</button>
    </div>
</form>
