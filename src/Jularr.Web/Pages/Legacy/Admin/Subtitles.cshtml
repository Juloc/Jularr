@page "/Admin/Subtitles"
@using Jularr.Web.Features.Subtitles
@model Jularr.Web.Pages.Admin.SubtitlesModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["admin.subtitles.title"];

    string PreparationStatusLabel(LearningTextPreparationStatus status) => status switch
    {
        LearningTextPreparationStatus.Queued => ui["admin.operations.status.queued"],
        LearningTextPreparationStatus.Processing => ui["admin.subtitles.status.processing"],
        LearningTextPreparationStatus.Failed => ui["admin.operations.status.failed"],
        _ => ui["admin.subtitles.status.notPrepared"]
    };
}

<header class="page-header">
    <div>
        <span class="eyebrow">@ui["admin.subtitles.eyebrow"]</span>
        <h1>@ui.Format("admin.subtitles.heading", ("language", Model.ContentLanguageName))</h1>
        <p>@ui["admin.subtitles.fallbackOrder"]</p>
    </div>
</header>

<partial name="~/Pages/Admin/_AdminNavigation.cshtml" model="Model.Ui" />

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="subtitle-source-message status-error">@Model.ErrorMessage</div>
}

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.subtitles.coverage"]</h2>
            <span>@ui.Format("admin.subtitles.readyRatio", ("ready", Model.Coverage.ReadyEpisodes), ("total", Model.Coverage.TotalEpisodes))</span>
        </div>

        <p class="muted">
            @ui.Format("admin.subtitles.coverage.ready", ("count", Model.Coverage.ReadyEpisodes)) ·
            @ui.Format("admin.subtitles.coverage.queued", ("count", Model.Coverage.QueuedEpisodes)) ·
            @ui.Format("admin.subtitles.coverage.processing", ("count", Model.Coverage.ProcessingEpisodes)) ·
            @ui.Format("admin.subtitles.coverage.failed", ("count", Model.Coverage.FailedEpisodes)) ·
            @ui.Format("admin.subtitles.coverage.notPrepared", ("count", Model.Coverage.MissingEpisodes))
        </p>

        @if (Model.Coverage.ReadyEpisodes < Model.Coverage.TotalEpisodes)
        {
            <form method="post" asp-page-handler="PrepareAll">
                <button class="button button-primary" type="submit">
                    @ui["admin.subtitles.prepareAllMissing"]
                </button>
            </form>
        }
        else
        {
            <span class="status-pill status-ok">@ui["admin.subtitles.allHaveLearningText"]</span>
        }
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["admin.subtitles.jimaku"]</h2>
            <span>@(Model.Jimaku.Configured ? ui["admin.subtitles.connected"] : ui["admin.subtitles.optional"])</span>
        </div>

        <p class="muted">
            @ui["admin.subtitles.jimakuDescription"]
        </p>

        @if (Model.Jimaku.Configured)
        {
            <p>
                <span class="status-pill status-ok">@ui["admin.subtitles.apiKeyConfigured"]</span>
                @if (Model.Jimaku.UpdatedAt is { } updatedAt)
                {
                    <small>@ui.Format("admin.subtitles.updatedAt", ("time", updatedAt.ToLocalTime().ToString("g")))</small>
                }
            </p>
            <form method="post" asp-page-handler="DisconnectJimaku">
                <button class="button" type="submit">@ui["admin.subtitles.removeJimakuKey"]</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="SaveJimaku" class="form-stack">
                <label>
                    <span>@ui["admin.subtitles.jimakuApiKeyLabel"]</span>
                    <input asp-for="JimakuApiKey"
                           type="password"
                           autocomplete="new-password"
                           required />
                </label>
                <button class="button button-primary" type="submit">
                    @ui["admin.subtitles.testAndSave"]
                </button>
            </form>
        }
    </section>
</div>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.subtitles.episodesWithoutText"]</h2>
        <span>@ui.Format("admin.subtitles.shownCount", ("count", Model.MissingEpisodes.Count))</span>
    </div>

    @if (Model.MissingEpisodes.Count == 0)
    {
        <p class="muted">@ui["admin.subtitles.noMissingEpisodes"]</p>
    }
    else
    {
        <div class="root-list">
            @foreach (var episode in Model.MissingEpisodes)
            {
                <div class="root-row">
                    <div>
                        <strong>@episode.AnimeTitle · S@(episode.SeasonNumber.ToString("00"))E@(episode.EpisodeNumber.ToString("00"))</strong>
                        <span>@episode.EpisodeTitle</span>
                        <small>
                            @if (episode.State.Status == LearningTextPreparationStatus.Failed)
                            {
                                @ui.Format("admin.subtitles.failedWithReason", ("reason", episode.State.Message ?? ui["admin.subtitles.unknownError"]))
                            }
                            else
                            {
                                @PreparationStatusLabel(episode.State.Status)
                            }
                        </small>
                    </div>

                    <form method="post" asp-page-handler="Retry">
                        <input type="hidden" name="episodeId" value="@episode.EpisodeId" />
                        <button class="button" type="submit">
                            @(episode.State.Status == LearningTextPreparationStatus.Failed ? ui["admin.operation.retry"] : ui["admin.subtitles.prepare"])
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["admin.subtitles.completenessHeading"]</h2>
        <span>@ui.Format("admin.subtitles.shownCount", ("count", Model.Completions.Count))</span>
    </div>
    <p class="muted">@ui["admin.subtitles.completenessHelp"]</p>

    @if (Model.Completions.Count == 0)
    {
        <p class="muted">@ui["admin.subtitles.noEpisodesDiscovered"]</p>
    }
    else
    {
        <div class="root-list">
            @foreach (var completion in Model.Completions)
            {
                <div class="root-row">
                    <div>
                        <strong>@completion.AnimeTitle · S@(completion.SeasonNumber.ToString("00"))E@(completion.EpisodeNumber.ToString("00"))</strong>
                        <span>@completion.ProfileName</span>
                        <small>
                            @switch (completion.Status)
                            {
                                case SubtitleProfileCompletionStatus.Complete:
                                    <span class="status-pill status-ok">@ui["admin.subtitles.completion.complete"]</span>
                                    break;
                                case SubtitleProfileCompletionStatus.CutoffMet:
                                    <span class="status-pill status-ok">@ui["admin.subtitles.completion.cutoffMet"]</span>
                                    break;
                                default:
                                    <span class="status-pill status-warning">@ui.Format("admin.subtitles.completion.missingCount", ("count", completion.Missing.Count))</span>
                                    break;
                            }
                        </small>
                    </div>

                    @if (completion.Missing.Count > 0)
                    {
                        <div class="inline-actions">
                            @foreach (var missing in completion.Missing)
                            {
                                <a class="button"
                                   asp-page="/Legacy/Admin/Subtitles"
                                   asp-route-searchEpisodeId="@completion.EpisodeId"
                                   asp-route-searchLanguage="@missing.LanguageTag"
                                   asp-route-searchForced="@missing.Forced"
                                   asp-route-searchSdh="@missing.Sdh">
                                    @ui.Format("admin.subtitles.searchFor", ("language", missing.LanguageTag))
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>

@if (Model.SearchEpisode is { } searchEpisode)
{
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui.Format("admin.subtitles.search.heading", ("language", Model.SearchLanguage ?? ""))</h2>
            <span>@searchEpisode.AnimeTitle · S@(searchEpisode.SeasonNumber.ToString("00"))E@(searchEpisode.EpisodeNumber.ToString("00"))</span>
        </div>

        @if (!Model.HasProviders)
        {
            <p class="muted">@ui["admin.subtitles.search.noProviders"]</p>
            <a class="button" asp-page="/Legacy/Settings/Subtitles">@ui["admin.subtitles.search.configureProviders"]</a>
        }
        else
        {
            // A provider that failed (rate limited, rejected credentials, unreachable) is reported
            // even when it returned nothing, so an empty list is never mistaken for "no subtitles exist".
            var failedOutcomes = Model.SearchOutcomes.Where(o => !string.IsNullOrWhiteSpace(o.Error)).ToList();

            @foreach (var failed in failedOutcomes)
            {
                <div class="subtitle-source-message status-error">@failed.ProviderDisplayName: @failed.Error</div>
            }

            @if (Model.SearchOutcomes.Any(o => o.Results.Count > 0))
            {
                <div class="root-list">
                    @foreach (var outcome in Model.SearchOutcomes)
                    {
                        @foreach (var result in outcome.Results)
                        {
                            <div class="root-row">
                                <div>
                                    <strong>@result.ReleaseName</strong>
                                    <span>@outcome.ProviderDisplayName@(result.UploaderOrSource is { } uploader ? $" · {uploader}" : "")</span>
                                </div>
                                <form method="post" asp-page-handler="ImportSearchResult">
                                    <input type="hidden" name="episodeId" value="@searchEpisode.EpisodeId" />
                                    <input type="hidden" name="providerId" value="@result.ProviderId" />
                                    <input type="hidden" name="resultToken" value="@result.ResultToken" />
                                    <input type="hidden" name="language" value="@result.LanguageTag" />
                                    <input type="hidden" name="forced" value="@result.Forced" />
                                    <input type="hidden" name="sdh" value="@result.Sdh" />
                                    <input type="hidden" name="releaseName" value="@result.ReleaseName" />
                                    <input type="hidden" name="uploader" value="@result.UploaderOrSource" />
                                    <button class="button button-primary" type="submit">@ui["admin.subtitles.search.import"]</button>
                                </form>
                            </div>
                        }
                    }
                </div>
            }
            else if (failedOutcomes.Count == 0)
            {
                <p class="muted">@ui["admin.subtitles.search.noResults"]</p>
            }
        }
    </section>
}
