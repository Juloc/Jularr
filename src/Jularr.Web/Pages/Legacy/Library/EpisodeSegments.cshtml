@page "/Library/Episode/{id:guid}/segments"
@using System.Globalization
@using Jularr.Web.Features.MediaSegments
@model Jularr.Web.Pages.Library.EpisodeSegmentsModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format(
        "library.episodeSegments.pageTitle",
        ("anime", Model.AnimeTitle),
        ("episode", Model.EpisodeNumber));
    var threshold = Model.SkipConfidenceThreshold.ToString("0.##", CultureInfo.InvariantCulture);

    string SourceLabel(MediaSegmentSource source) => source switch
    {
        MediaSegmentSource.Manual => ui["library.episodeSegments.source.manual"],
        MediaSegmentSource.Imported => ui["library.episodeSegments.source.imported"],
        MediaSegmentSource.Provider => ui["library.episodeSegments.source.provider"],
        MediaSegmentSource.Detector => ui["library.episodeSegments.source.detector"],
        _ => MediaSegmentPolicy.SourceName(source)
    };
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Library/Episode/@Model.EpisodeId">← @Model.AnimeTitle · E@(Model.EpisodeNumber.ToString("00"))</a>
        <span class="eyebrow">S@(Model.SeasonNumber.ToString("00")) · E@(Model.EpisodeNumber.ToString("00"))</span>
        <h1>@ui["library.episodeSegments.title"]</h1>
        <p>
            @ui.Format("library.episodeSegments.thresholdNotice", ("threshold", threshold))
            @ui["library.episodeSegments.manualWinsNotice"]
        </p>
    </div>
</header>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["library.episodeSegments.markersHeading"]</h2>
        <span>@ui["library.episodeSegments.timecodeFormatHint"]</span>
    </div>

    <div class="episode-list">
        @foreach (var row in Model.Rows)
        {
            <div class="episode-row">
                <div class="episode-main">
                    <strong>@row.Label</strong>
                    @if (row.Resolved is { } resolved)
                    {
                        <span>
                            @MediaTimecode.Format(resolved.StartMs) – @MediaTimecode.Format(resolved.EndMs)
                            · @SourceLabel(resolved.Source)
                            (@resolved.Method @resolved.Version)
                            · @ui.Format("library.episodeSegments.confidence", ("value", resolved.Confidence.ToString("0.##", CultureInfo.InvariantCulture)))
                        </span>
                        <span class="status-pill @(resolved.CanSkip ? "status-ok" : "status-warn")">
                            @(resolved.CanSkip ? ui["library.episodeSegments.skipOffered"] : ui["library.episodeSegments.belowThreshold"])
                        </span>
                    }
                    else
                    {
                        <span>@ui["library.episodeSegments.noMarker"]</span>
                    }
                    @foreach (var candidate in row.Candidates.Where(x => row.Resolved is null || x.Source != row.Resolved.Source))
                    {
                        <small class="muted">
                            @ui.Format("library.episodeSegments.superseded", ("source", SourceLabel(candidate.Source)))
                            @MediaTimecode.Format(candidate.StartMs) – @MediaTimecode.Format(candidate.EndMs)
                        </small>
                    }
                </div>
                <form method="post"
                      class="inline-actions"
                      asp-page-handler="Save"
                      asp-route-id="@Model.EpisodeId">
                    <input type="hidden" name="kind" value="@row.Kind" />
                    <input name="start"
                           aria-label="@ui.Format("library.episodeSegments.startAria", ("label", row.Label))"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="@ui["library.episodeSegments.startPlaceholder"]"
                           size="8"
                           value="@(row.Manual is { } manualStart ? MediaTimecode.Format(manualStart.StartMs) : "")" />
                    <input name="end"
                           aria-label="@ui.Format("library.episodeSegments.endAria", ("label", row.Label))"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="@ui["library.episodeSegments.endPlaceholder"]"
                           size="8"
                           value="@(row.Manual is { } manualEnd ? MediaTimecode.Format(manualEnd.EndMs) : "")" />
                    <button class="button" type="submit">@ui["common.save"]</button>
                </form>
                @if (row.Manual is not null)
                {
                    <form method="post"
                          asp-page-handler="Remove"
                          asp-route-id="@Model.EpisodeId">
                        <input type="hidden" name="kind" value="@row.Kind" />
                        <button class="button" type="submit">@ui["library.episodeSegments.removeManual"]</button>
                    </form>
                }
            </div>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["library.episodeSegments.generatedNavigationHeading"]</h2>
        <span>@ui["library.episodeSegments.generatedNavigationCaption"]</span>
    </div>
    <div class="inline-actions">
        <span class="status-pill @(Model.Trickplay.IsReady ? "status-ok" : "")">
            @ui.Format("library.episodeSegments.seekPreviewsStatus", ("state", Model.Trickplay.State switch
            {
                TrickplayState.Ready => ui.Format("library.episodeSegments.seekPreviews.ready", ("count", Model.Trickplay.Index!.ThumbnailCount)),
                TrickplayState.Queued or TrickplayState.Generating => ui["library.episodeSegments.seekPreviews.generating"],
                TrickplayState.Failed => ui["library.episodeSegments.seekPreviews.failed"],
                _ => ui["library.episodeSegments.seekPreviews.notGenerated"]
            }))
        </span>
        @if (Model.Trickplay.Message is { } trickplayMessage)
        {
            <small class="muted">@trickplayMessage</small>
        }
        <form method="post" asp-page-handler="RegeneratePreviews" asp-route-id="@Model.EpisodeId">
            <button class="button" type="submit">@ui["library.episodeSegments.rebuildSeekPreviews"]</button>
        </form>
        @if (Model.DetectorEnabled)
        {
            <form method="post" asp-page-handler="Detect" asp-route-id="@Model.EpisodeId">
                <button class="button" type="submit">@ui["library.episodeSegments.rerunDetection"]</button>
            </form>
            <form method="post" asp-page-handler="DetectSeason" asp-route-id="@Model.EpisodeId">
                <button class="button" type="submit">@ui["library.episodeSegments.detectSeason"]</button>
            </form>
            <small class="muted">
                @ui.Format("library.episodeSegments.detectSeasonHint", ("season", Model.SeasonNumber))
            </small>
        }
        else
        {
            <small class="muted">@ui["library.episodeSegments.detectorNotConfigured"]</small>
        }
    </div>
</section>
