@page "/Library/AnimeRepair/{id:guid}"
@model Jularr.Web.Pages.Library.AnimeRepairModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.Format("library.animeRepair.pageTitle", ("anime", Model.AnimeTitle));
}

<header class="page-header">
    <div>
        <a class="back-link" href="/Library/Anime/@Model.AnimeId">&larr; @Model.AnimeTitle</a>
        <span class="eyebrow">@ui["library.animeRepair.eyebrow"]</span>
        <h1>@ui["library.animeRepair.title"]</h1>
        <p>@ui["library.animeRepair.description"]</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="metadata-error">@Model.Error</p>
}
@if (Model.OperationId is Guid operationId)
{
    <p><a href="/Admin/Operation/@operationId">@ui["library.animeRepair.viewOperationLog"]</a></p>
}

<section class="panel">
    <div class="panel-heading">
        <h2>@ui["library.animeRepair.folderHeading"]</h2>
    </div>
    @if (Model.Folder is { } folder)
    {
        <p><code>@folder.RootName / @folder.Folder</code></p>
        @if (Model.ActiveScans.Count > 0)
        {
            <p class="metadata-error">@ui["library.animeRepair.scanAlreadyRunning"]</p>
        }
    }
    else
    {
        <p class="muted">@ui["library.animeRepair.noMediaFiles"]</p>
    }
</section>

<div class="settings-grid">
    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["library.animeRepair.rescanHeading"]</h2>
            <span>@ui["library.animeRepair.rescanCaption"]</span>
        </div>
        <p class="muted">@ui["library.animeRepair.rescanDescription"]</p>
        <form method="post" asp-page-handler="Rescan" asp-route-id="@Model.AnimeId">
            <button class="button button-primary" type="submit" @(Model.Folder is null ? "disabled" : "")>@ui["library.animeRepair.rescanButton"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["library.animeRepair.refreshLocalHeading"]</h2>
            <span>@ui["library.animeRepair.refreshLocalCaption"]</span>
        </div>
        <p class="muted">@ui["library.animeRepair.refreshLocalDescription"]</p>
        <form method="post" asp-page-handler="RefreshLocal" asp-route-id="@Model.AnimeId">
            <button class="button" type="submit" @(Model.Folder is null ? "disabled" : "")>@ui["library.animeRepair.refreshLocalHeading"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["library.animeRepair.reanalyzeHeading"]</h2>
            <span>@ui["library.animeRepair.reanalyzeCaption"]</span>
        </div>
        <p class="muted">@ui["library.animeRepair.reanalyzeDescription"]</p>
        <form method="post" asp-page-handler="Reanalyze" asp-route-id="@Model.AnimeId">
            <button class="button" type="submit" @(Model.Folder is null ? "disabled" : "")>@ui["library.animeRepair.reanalyzeHeading"]</button>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>@ui["library.animeRepair.optimizeHeading"]</h2>
        </div>
        <p class="muted">@ui["library.animeRepair.optimizeDescription"]</p>
        <form method="post" asp-page-handler="Optimize" asp-route-id="@Model.AnimeId">
            <button class="button" type="submit" @(Model.Folder is null ? "disabled" : "")>@ui["library.animeRepair.optimizeHeading"]</button>
        </form>
    </section>

    @if (Model.Metadata is { } metadata)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>@ui["library.animeRepair.refreshMetadataHeading"]</h2>
                <span>@metadata.Provider &middot; ID @metadata.ExternalId</span>
            </div>
            <p class="muted">@ui["library.animeRepair.refreshMetadataDescription"]</p>
            <form method="post" asp-page-handler="RefreshMetadata" asp-route-id="@Model.AnimeId">
                <button class="button" type="submit">@ui["library.animeRepair.refreshMetadataHeading"]</button>
            </form>
        </section>
    }
</div>

<section class="panel metadata-panel" id="identify-match">
    <div class="panel-heading">
        <h2>@ui["library.animeRepair.identifyHeading"]</h2>
        @if (Model.Metadata is { } current)
        {
            <span>@ui.Format("library.animeRepair.currentlyMatched", ("provider", current.Provider), ("externalId", current.ExternalId))</span>
        }
        else
        {
            <span>@ui["library.animeRepair.notMatchedYet"]</span>
        }
    </div>

    <form method="get" class="metadata-search">
        <input type="search"
               name="q"
               value="@Model.SearchQuery"
               aria-label="@ui["library.animeTitleAria"]"
               placeholder="@ui["library.searchAniListPlaceholder"]" />
        <button class="button button-primary" type="submit">@ui["library.searchAniList"]</button>
    </form>

    @if (Model.Candidates.Count > 0)
    {
        <div class="metadata-results">
            @foreach (var result in Model.Candidates)
            {
                var candidate = result.Candidate;
                var isCurrentMatch =
                    Model.Metadata?.Provider == candidate.Provider &&
                    Model.Metadata?.ExternalId == candidate.ExternalId;
                <article class="metadata-result">
                    <div class="metadata-result-poster">
                        @if (!string.IsNullOrWhiteSpace(candidate.CoverImageUrl))
                        {
                            <img src="@candidate.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <span>@candidate.PreferredTitle[..1]</span>
                        }
                    </div>
                    <div class="metadata-result-copy">
                        <strong>@candidate.PreferredTitle</strong>
                        @if (!string.IsNullOrWhiteSpace(candidate.NativeTitle))
                        {
                            <span lang="ja">@candidate.NativeTitle</span>
                        }
                        <small>
    @candidate.Provider &middot; ID @candidate.ExternalId &middot; @ui.Format("library.animeRepair.candidateScore", ("score", result.Score))
                            @if (candidate.SeasonYear is int year)
                            {
                                <text> &middot; @year</text>
                            }
                            @if (candidate.EpisodeCount is int count)
                            {
                                <text> &middot; @ui.Format("library.episodeCountAbbrev", ("count", count))</text>
                            }
                        </small>
                        @if (result.Evidence.Count > 0)
                        {
                            <ul class="muted">
                                @foreach (var reason in result.Evidence)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        }
                    </div>
                    <div>
                        <form method="post" asp-page-handler="Match" asp-route-id="@Model.AnimeId">
                            <input type="hidden" name="provider" value="@candidate.Provider" />
                            <input type="hidden" name="externalId" value="@candidate.ExternalId" />
                            <button class="button @(isCurrentMatch ? "" : "button-primary")" type="submit" @(isCurrentMatch ? "disabled" : "")>
                                @(isCurrentMatch ? ui["library.matched"] : ui["library.animeRepair.confirmMatch"])
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <p class="muted">@ui.Format("library.animeRepair.noCandidatesFound", ("query", Model.SearchQuery))</p>
    }
</section>
