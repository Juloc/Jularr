@page "/Watchlist"
@model Jularr.Web.Pages.Watchlist.IndexModel
@using Jularr.Web.Features.Franchises
@using Jularr.Web.Features.Watchlist
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui["watchlist.title"];
}

@section Head {
    <link rel="stylesheet" href="~/css/ui-data-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/watchlist.css" asp-append-version="true" />
}

<div class="watchlist-page">
    <header class="watchlist-header">
        <h1>@ui["watchlist.title"]</h1>
        <a class="button button-primary" href="/">@ui["watchlist.discover"]</a>
        @if (Model.IsTargetView)
        {
            <a class="button" href="/Watchlist">@ui["watchlist.title"]</a>
        }
        @if (!Model.IsTargetView)
        {
            <nav class="inline-actions" aria-label="@ui["library.anime.viewAria"]">
                <a class="button" href="/Watchlist?view=cards"
                   aria-current="@(Model.ViewMode != "table" ? "page" : null)">@ui["library.anime.view.grid"]</a>
                <a class="button" href="/Watchlist?view=table"
                   aria-current="@(Model.ViewMode == "table" ? "page" : null)">@ui["library.anime.view.list"]</a>
            </nav>
        }
    </header>

    @if (Model.TotalCount == 0)
    {
        <section class="watchlist-empty">
            <strong>@ui["watchlist.emptyTitle"]</strong>
            <span>@ui["watchlist.emptyBody"]</span>
        </section>
    }
    else
    {
        @foreach (var component in Model.PageDefinition.Content)
        {
            <partial name="@component.PartialName" model="@component.ViewModel" />
        }
        @if (Model.PageCount > 1)
        {
            <nav class="inline-actions" aria-label="@ui["admin.history.pagerAria"]">
                @if (Model.CurrentPage > 1)
                {
                    <a class="button"
                       href="/Watchlist?page=@(Model.CurrentPage - 1)@(Model.ViewMode == "table" ? "&view=table" : "")"
                       rel="prev">@ui["admin.history.page.previous"]</a>
                }
                <span aria-current="page">@Model.CurrentPage / @Model.PageCount</span>
                @if (Model.CurrentPage < Model.PageCount)
                {
                    <a class="button"
                       href="/Watchlist?page=@(Model.CurrentPage + 1)@(Model.ViewMode == "table" ? "&view=table" : "")"
                       rel="next">@ui["admin.history.page.next"]</a>
                }
            </nav>
        }
    }

    @if ((Model.FranchisePage.TotalCount ?? 0) > 0)
    {
        <section class="watchlist-franchises">
            <h2>@ui["watchlist.franchises"]</h2>
            <div class="watchlist-franchise-list">
                @foreach (var franchise in Model.Franchises)
                {
                    <article>
                        <div>
                            <a class="watchlist-franchise-link" href="/Franchises/@franchise.Id">@FranchiseLabels.Title(ui, franchise.Title)</a>
                            <span>@ui.Format("watchlist.memberCount", ("count", franchise.MemberCount))</span>
                        </div>
                        <div class="watchlist-actions">
                            <form method="post" asp-page-handler="RefreshFranchise">
                                <input type="hidden" name="franchiseId" value="@franchise.Id" />
                                <button class="button" type="submit">@ui["watchlist.refreshFranchise"]</button>
                            </form>
                            <form method="post" asp-page-handler="UnfollowFranchise">
                                <input type="hidden" name="franchiseId" value="@franchise.Id" />
                                <button class="button" type="submit">@ui["watchlist.unfollowFranchise"]</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
            @if (Model.FranchisePageCount > 1)
            {
                <nav class="inline-actions" aria-label="@ui["admin.history.pagerAria"]">
                    @if (Model.CurrentFranchisePage > 1)
                    {
                        <a class="button"
                           href="/Watchlist?page=@Model.CurrentPage&amp;franchisePage=@(Model.CurrentFranchisePage - 1)@(Model.ViewMode == "table" ? "&view=table" : "")"
                           rel="prev">@ui["admin.history.page.previous"]</a>
                    }
                    <span aria-current="page">@Model.CurrentFranchisePage / @Model.FranchisePageCount</span>
                    @if (Model.CurrentFranchisePage < Model.FranchisePageCount)
                    {
                        <a class="button"
                           href="/Watchlist?page=@Model.CurrentPage&amp;franchisePage=@(Model.CurrentFranchisePage + 1)@(Model.ViewMode == "table" ? "&view=table" : "")"
                           rel="next">@ui["admin.history.page.next"]</a>
                    }
                </nav>
            }
        </section>
    }
</div>
