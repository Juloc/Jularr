<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Jularr.Backend/Jularr.Backend.csproj" />
    <ProjectReference Include="../Jularr.Workers/Jularr.Workers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets/Generated/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="EnsureCompiledFrontendAssets" BeforeTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Assets/Generated/manifest.json')"
           Text="Missing fingerprinted frontend assets. Run npm ci and npm run build in src/Jularr.Frontend before dotnet publish." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Assets/Generated/icons.json')"
           Text="Missing fingerprinted SVG sprite. Run npm run build before dotnet publish." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Localization/Catalogs/*.json" />
  </ItemGroup>
</Project>
