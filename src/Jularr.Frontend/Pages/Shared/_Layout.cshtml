@inject UiText T
@inject FrontendAssets Assets
@{
    var isPreview = ViewData["ShellPreview"] is true;
    var currentPage = ViewContext.ViewData.Model as JularrPage;
    var showShell = (User.Identity?.IsAuthenticated == true || isPreview)
        && (currentPage?.Definition.Shell ?? true);
    var isPlayer = currentPage?.Definition.IsPlayer ?? false;
    var isReader = currentPage?.Definition.IsReader ?? false;
    var title = currentPage?.Definition.DocumentTitle ?? (currentPage?.Definition.TitleKey is { } titleKey ? T[titleKey]
        : ViewData["Title"] as string ?? T["app.name"]);
    ViewData["Title"] = title;
    var pageAssets = currentPage?.Definition.AssetEntries.ToArray() ?? [];
    // The Reader keeps document-lifetime rendering resources; leaving it is a full navigation.
    var inPlace = (showShell || isPlayer) && !isReader;
}
<!DOCTYPE html>
<html lang="@T.Locale" dir="@(T.IsRightToLeft ? "rtl" : "ltr")" data-skin="clean" data-mode="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#17161e" />
    <title>@title · @T.InstanceName</title>
    <link rel="icon" type="image/svg+xml" sizes="any" href="@Assets.ImageUrl("Assets/Shared/favicon.svg")" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets.ImageUrl("Assets/Shared/icon-32.png")" />
    <link rel="apple-touch-icon" href="@Assets.ImageUrl("Assets/Shared/apple-touch-icon.png")" />
    @Assets.Styles("Assets/Shared/shell.entry.scss")
    @if (!showShell)
    {
        @Assets.Styles(pageAssets)
    }
    @Assets.Scripts("Modules/Appearance/theme.entry.ts")
    @if (inPlace)
    {
        @Assets.Scripts("Modules/Navigation/navigation.entry.ts")
    }
    @if (showShell && !isPreview && !isReader)
    {
        @Assets.Scripts("Framework/Components/ContinueReadingBar.entry.ts")
    }
    @if (showShell && !isReader)
    {
        @Assets.Scripts("Framework/Components/SavePill.entry.ts")
        @Assets.Scripts("Pages/Shared/Breadcrumb.entry.ts")
        @Assets.Scripts("Pages/Shared/Shell.entry.ts")
        @Assets.Scripts("Framework/Components/LinkMenu.entry.ts")
    }
    @if (!showShell)
    {
        @Assets.Scripts(pageAssets)
    }
    @await RenderSectionAsync("Head", required: false)
</head>
@* App pages swap #app-content in place (with their own assets); the player page keeps its player beside it. *@
<body class="@(isReader ? "app-page reader-page" : isPlayer ? "player-page" : showShell ? "app-page" : "auth-page")" hx-boost:inherited="@(inPlace ? "true" : null)"
    hx-target:inherited="@(inPlace ? "#app-content" : null)" hx-select:inherited="@(inPlace ? "#app-content" : null)" hx-swap:inherited="@(inPlace ? "outerHTML" : null)">
    <a class="skip-link" href="#main-content">@T["shell.skip"]</a>
    @if (showShell)
    {
        <div id="app-content" class="app-content" data-shell="app" data-autoplay-previews="@(T.AutoplayPreviews && !string.Equals(Context.Request.Headers["Save-Data"], "on", StringComparison.OrdinalIgnoreCase) ? "true" : "false")" hx-history-elt>
            @Assets.Styles(pageAssets)
            <div class="app-layout">
                <partial name="_AppShell" />
                <main class="app-main" id="main-content" tabindex="-1">@RenderBody()@if (!isReader) { @(new UiHtml(new SavePill(), T)) }</main>
            </div>
            @Assets.Scripts(pageAssets)
        </div>
    }
    else if (isPlayer)
    {
        <div id="app-content" class="app-content" data-shell="player" hx-history-elt></div>
        <main class="player-main" id="main-content" tabindex="-1">@RenderBody()</main>
    }
    else
    {
        <main class="auth-main" id="main-content" tabindex="-1">@RenderBody()</main>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
