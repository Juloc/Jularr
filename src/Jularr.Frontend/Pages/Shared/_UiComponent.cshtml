@model IUiComponent
@inject UiText T
@switch (Model)
{
    case Panel panel:
        <section class="ui-panel">
            @foreach (var child in panel.Content)
            {
                <partial name="_UiComponent" model="child" />
            }
        </section>
        break;
    case MasterDetail masterDetail:
        <div class="ui-master-detail">
            <section class="ui-master">
                @foreach (var child in masterDetail.Master)
                {
                    <partial name="_UiComponent" model="child" />
                }
            </section>
            <section class="ui-detail">
                @foreach (var child in masterDetail.Detail)
                {
                    <partial name="_UiComponent" model="child" />
                }
            </section>
        </div>
        break;
    case UiHeading heading:
        <header class="page-heading">
            <h1>@T[heading.TitleKey]</h1>
            @if (heading.DetailKey is not null)
            {
                <p>@T[heading.DetailKey]</p>
            }
        </header>
        break;
    case UiSubnav nav:
        <nav class="page-subnav" aria-label="@T["nav.primary"]">
            @foreach (var item in nav.Items)
            {
                var selected = string.Equals(Context.Request.Path.Value, item.Href, StringComparison.OrdinalIgnoreCase);
                <a href="@item.Href" class="@(selected ? "is-active" : "")"
                   aria-current="@(selected ? "page" : null)">@T[item.Key]</a>
            }
        </nav>
        break;
    case UiScope scope:
        <ul class="page-scope">
            @foreach (var key in scope.Keys)
            {
                <li>@T[key]</li>
            }
        </ul>
        break;
    case UiToolbar toolbar:
        <div class="page-toolbar" aria-label="@T["toolbar.label"]">
            @if (toolbar.Search)
            {
                <input type="search" disabled aria-label="@T["toolbar.search"]" placeholder="@T["toolbar.search"]" />
            }
            @if (toolbar.Filters)
            {
                <button type="button" disabled>@T["toolbar.filter"]</button>
            }
            @if (toolbar.Sort)
            {
                <button type="button" disabled>@T["toolbar.sort"]</button>
            }
            @if (toolbar.ViewSwitch)
            {
                <button type="button" disabled>@T["toolbar.view"]</button>
            }
        </div>
        break;
    case UiTable table:
        <div class="page-table-wrap">
            <table class="page-table">
                <thead><tr>
                    @foreach (var header in table.Headers)
                    {
                        <th scope="col">@T[header]</th>
                    }
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
        break;
    case UiMediaRail rail:
        <section class="media-rail">
            <h2>@T[rail.HeadingKey]</h2>
            <div class="media-rail-items"></div>
        </section>
        break;
    case UiMediaGrid _:
        <div class="media-grid"></div>
        break;
    case UiDetailHero _:
        <header class="detail-hero"></header>
        break;
    case UiMediaColumns _:
        <div class="detail-columns">
            <section><h2>@T["details.structure"]</h2></section>
            <section><h2>@T["details.units"]</h2></section>
            <aside><h2>@T["details.related"]</h2></aside>
        </div>
        break;
    case UiSettingsGroup group:
        <section class="settings-group">
            <h2>@T[group.HeadingKey]</h2>
            <ul>
                @foreach (var item in group.Rows)
                {
                    <li>
                        <span class="settings-row-label">@T[item.Key]</span>
                        @if (item.DescriptionKey is not null)
                        {
                            <span class="settings-row-description">@T[item.DescriptionKey]</span>
                        }
                    </li>
                }
            </ul>
        </section>
        break;
    case UiSection section:
        <section class="page-section">
            <h2>@T[section.HeadingKey]</h2>
            @foreach (var item in section.Items)
            {
                <partial name="_UiComponent" model="item" />
            }
        </section>
        break;
    case UiPlayer _:
        <div class="player-surface">
            <video class="player-video" controls playsinline preload="none"
                   aria-label="@T["player.title"]"></video>
        </div>
        break;
    case Tabs tabs:
        @foreach (var tab in tabs.Items)
        {
            <section class="page-section">
                <h2>@T[tab.Key]</h2>
                @foreach (var item in tab.Content)
                {
                    <partial name="_UiComponent" model="item" />
                }
            </section>
        }
        break;
}
