@using Jularr.Frontend.Pages.Shared
@inject UiText T
@inject ShellNavigation Navigation
@inject FrontendAssets Assets
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var definition = (ViewContext.ViewData.Model as JularrPage)?.Definition;
    var titleKey = definition?.TitleKey ?? "nav.home";
}
@(new UiHtml(new Shell(titleKey, currentPath, Navigation, Assets, Context.Request.Query["q"].FirstOrDefault(), currentPath == "/" ? Context.Request.Query["type"].FirstOrDefault() : null, definition?.Parents, definition?.DocumentTitle), T))
