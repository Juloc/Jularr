@page "/ShellPreview"
@model Jularr.Frontend.Pages.ShellPreviewModel
@inject UiText T
@{
    ViewData["ShellPreview"] = true;
    ViewData["Title"] = T["shell.preview"];
}
<h1 class="page-title">@T["shell.preview"]</h1>
@foreach (var component in Model.Definition.Content)
{
    <partial name="_UiComponent" model="component" />
}
<div class="preview-controls" role="group" aria-label="Appearance">
    <button class="button" type="button" data-set-skin="clean">Clean</button>
    <button class="button" type="button" data-set-skin="original">Original</button>
    <button class="button" type="button" data-set-mode="light">Light</button>
    <button class="button" type="button" data-set-mode="dark">Dark</button>
    <button class="button" type="button" data-set-mode="system">System</button>
</div>
