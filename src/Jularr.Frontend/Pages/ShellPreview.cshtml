@page "/ShellPreview"
@model Jularr.Frontend.Pages.ShellPreviewModel
@inject UiText T
@{
    ViewData["ShellPreview"] = true;
    ViewData["Title"] = Model.Definition.TitleKey is { } titleKey ? T[titleKey] : T["shell.preview"];
}
<nav class="preview-screen-links" aria-label="@T["shell.preview"]">
    @foreach (var view in Jularr.Frontend.Pages.ShellPreviewModel.Views)
    {
        <a href="/ShellPreview?view=@view.Slug" aria-current="@(Model.SelectedView == view.Slug ? "page" : null)">@T[view.LabelKey]</a>
    }
</nav>
<partial name="_PageBody" model="Model.Definition" />
<div class="preview-controls" role="group" aria-label="@T["preview.appearance"]">
    <button class="button" type="button" data-set-skin="clean">@T["preview.skin.clean"]</button>
    <button class="button" type="button" data-set-skin="original">@T["preview.skin.original"]</button>
    <button class="button" type="button" data-set-mode="light">@T["preview.mode.light"]</button>
    <button class="button" type="button" data-set-mode="dark">@T["preview.mode.dark"]</button>
    <button class="button" type="button" data-set-mode="system">@T["preview.mode.system"]</button>
</div>
