{
  "name": "jularr-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node Tools/speech-licenses.mjs && node Tools/emulator-assets.mjs && node Tools/pdf-assets.mjs && vite build && node Tools/build-icons.mjs && node Tools/finish-assets.mjs",
    "check": "tsc --noEmit && npm run build",
    "test": "node --test Tools/*.test.mjs",
    "verify:ui": "node Tools/verify-ui-resources.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "htmx.org": "4.0.0",
    "jassub": "^2.5.23",
    "pdfjs-dist": "6.4.299"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false
  }
}
