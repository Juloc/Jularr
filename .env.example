# An immutable Jularr release tag, never latest.
JULARR_VERSION=
# A long random password for the bundled PostgreSQL.
JULARR_DB_PASSWORD=
# Required: existing host folder or mounted NAS path visible to Docker.
# For example: JULARR_MEDIA=/mnt/arr_bay4_media
# The same /media path inside Jularr is selectable for native Usenet and direct/browser downloads.
# Choose separate existing Incomplete and Complete subfolders in the Jularr storage picker.
# Use ./media only deliberately when you want to store data on the Docker host itself.
JULARR_MEDIA=
# The address of a browser that already runs, for the sources that put a browser check in front of
# their pages (for example http://127.0.0.1:9222, the browser of the container itself).
JULARR_BROWSER_ADDRESS=

# Optional existing private Ollama server; e.g. http://ollama:11434 in a trusted Docker network.
JULARR_OLLAMA_ENDPOINT=

# Optional: confirm bytes free on Ollama's persistent model volume; 0 disables model download.
JULARR_OLLAMA_VERIFIED_FREE_BYTES=0
