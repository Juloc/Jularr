# Optional browser sidecar; no public CDP ports.
FROM mcr.microsoft.com/dotnet/aspnet:10.0
USER root
COPY deploy/browser/browser.sh /usr/local/bin/jularr-browser
RUN chmod +x /usr/local/bin/jularr-browser \
    && jularr-browser install \
    && mkdir -p /data/browser \
    && chown -R app:app /data/browser
USER app
ENV JULARR_BROWSER_HOME=/data/browser \
    JULARR_BROWSER_FORWARD_BIND=0.0.0.0
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:9223/json/version >/dev/null || exit 1
ENTRYPOINT ["jularr-browser", "run"]
