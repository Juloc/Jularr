#!/usr/bin/env bash
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
zero_sha='0000000000000000000000000000000000000000'
remote_name="$1"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${local_sha}" == "${zero_sha}" ]]; then
    continue
  fi

  if [[ "${remote_sha}" == "${zero_sha}" ]]; then
    default_ref="$(git symbolic-ref -q "refs/remotes/${remote_name}/HEAD" || true)"
    if [[ -n "${default_ref}" ]]; then
      range="$(git rev-parse "${default_ref}")..${local_sha}"
    else
      range="${local_sha}"
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi

  # Existing clean-start history stays unchanged.
  base_ref="refs/remotes/${remote_name}/clean-start"
  if [[ "${remote_ref}" == refs/heads/* && "${remote_ref}" != refs/heads/clean-start && "${remote_ref}" != refs/heads/dev && "${remote_ref}" != refs/heads/main ]] && git merge-base --is-ancestor "${base_ref}" "${local_sha}" 2>/dev/null; then
    "${repository_root}/scripts/verify-authorship.sh" --range "${range}" --exclude "$(git rev-parse "${base_ref}")"
  else
    "${repository_root}/scripts/verify-authorship.sh" --range "${range}"
  fi
done
