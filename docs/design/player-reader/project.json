  "rules": [
    "Opaque base controls; Player popovers may use subtle translucency. No bevels or 3D gradients.",
    "Buttons and single-line fields use the shared pill radius.",
    "Native legend cutouts, not painted label backgrounds.",
    "One canonical media card across Discover, Library and Continue.",
    "Semantic availability colours never follow the accent.",
    "Pages compose controls. Production permissions and validation remain Backend-owned."
  ],
  "values": {
    "accent-seed": "#7c3aed",
    "radius-control": "999px",
    "radius-card": "24px",
    "radius-panel": "12px",
    "radius-dialog": "18px",
    "spacing": "16px",
    "font-size": "14px",
    "font-family": "Segoe UI, system-ui, sans-serif",
    "border-width": "1px"
  },
  "families": {
    "button": {
      "radius": "{radius-control}",
      "padding-inline": "15px",
